<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.byz.sat-pull</string>
  <key>ProgramArguments</key>
  <array>
    <string>__PY__</string>
    <string>__KIT__/sat-mbox.py</string>
    <string>pull</string>
    <string>--seats-file</string>
    <string>__SEATS_FILE__</string>
  </array>
  <key>WorkingDirectory</key><string>__ROOT__</string>
  <key>StartInterval</key><integer>60</integer>
  <key>RunAtLoad</key><false/>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>FT_MBOX_DIR</key><string>__COMM__</string>
    <key>SAT_STATE</key><string>__STATE__</string>
    <key>SAT_SEATS_FILE</key><string>__SEATS_FILE__</string>
    <key>SAT_QUEUE_CAP</key><string>10</string>
  </dict>
  <key>StandardOutPath</key><string>/tmp/byz-sat-pull.log</string>
  <key>StandardErrorPath</key><string>/tmp/byz-sat-pull.log</string>
</dict>
</plist>
