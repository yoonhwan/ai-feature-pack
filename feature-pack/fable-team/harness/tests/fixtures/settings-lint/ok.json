{
  "hooks": {
    "SessionStart": [
      {"hooks": [{"type": "command", "command": "bash .claude/hooks/a.sh"}]}
    ],
    "PreToolUse": [
      {"matcher": "Bash", "hooks": [
        {"type": "command", "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/a.sh"},
        {"type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/b.sh arg"}
      ]}
    ],
    "UserPromptSubmit": [
      {"hooks": [{"type": "command", "command": "if [ -f /nonexistent ]; then echo skip; fi"}]}
    ]
  }
}
