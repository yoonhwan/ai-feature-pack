+    if cards is not None:
+        if not cards.is_absolute():
+            base = root / ".worktrees" / doc["_cards_wt"] if doc.get("_cards_wt") else root
+            cards = base / cards
+        if not cards.is_dir():
+            raise ValueError("카드 폴더 없음 " + str(cards))
+        for folder in ("대기", "진행"):
+            for card in (cards / folder).glob("*.md"):
+                record = root / ".fable-team/state/card-assign" / (card.stem + ".json")
+                row = json.loads(record.read_text(encoding="utf-8")) if record.exists() else {}
+                assigned = row.get("state") == "seat" and row.get("seat") in names
+                unassigned = doc.get("_master") == seat and row.get("state", "none") == "none"
