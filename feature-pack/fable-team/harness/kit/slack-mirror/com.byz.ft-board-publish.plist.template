<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.byz.ft-board-publish</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/bash</string>
    <string>__FT_BIN__/ft-board-publish.sh</string>
  </array>
  <key>StartInterval</key><integer>300</integer>
  <key>RunAtLoad</key><false/>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>FT_ROOT</key><string>__BYZ_ROOT__</string>
    <key>FT_BOARD_ONLY_CHANGED</key><string>1</string>
  </dict>
  <key>StandardOutPath</key><string>/tmp/byz-ft-board-publish.log</string>
  <key>StandardErrorPath</key><string>/tmp/byz-ft-board-publish.log</string>
</dict>
</plist>
