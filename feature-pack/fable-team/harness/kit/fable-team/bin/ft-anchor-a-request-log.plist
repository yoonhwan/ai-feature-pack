<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- r1571 앵커 A «잊지 않는 장치» launchd 템플릿 — 1시간 간격 1개(카드 ⓕ).
     설치는 h(사람 승인): h 묶음 문서 §알림 설치 가 __SCRIPT__ / __LOGS__ 를 치환해
     ~/Library/LaunchAgents/com.byz.ft-anchor-a-request-log.plist 로 쓰고 bootstrap 한다(치환 전 직접 bootstrap 금지).
     해제도 h: 끄기·지우기 h 의 마지막 단계에서 bootout + 파일 제거. 이 스크립트는 스스로 내려가지 않는다(자동 bootout 0). -->
<plist version="1.0"><dict>
  <key>Label</key><string>com.byz.ft-anchor-a-request-log</string>
  <key>ProgramArguments</key><array>
    <string>/bin/bash</string>
    <string>__SCRIPT__</string>
  </array>
  <key>EnvironmentVariables</key><dict>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>LANG</key><string>ko_KR.UTF-8</string>
    <key>FT_ANCHOR_LOGS</key><string>__LOGS__</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>StartInterval</key><integer>3600</integer>
  <key>ProcessType</key><string>Background</string>
  <key>ThrottleInterval</key><integer>60</integer>
  <key>StandardOutPath</key><string>/tmp/ft-anchor-a-request-log.log</string>
  <key>StandardErrorPath</key><string>/tmp/ft-anchor-a-request-log.log</string>
</dict></plist>
