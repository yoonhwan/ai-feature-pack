# fable-team 문턱 한 곳 (r1427). 복사해서 <루트>/.fable-team/thresholds.env 또는 ~/.claude/fable-team/thresholds.env 로.
# 증류 게이트 · 리줌 게이트 · 좌석 복구가 모두 이 값을 본다. 바꾼 뒤에는 아무것도 재설치할 필요 없다(읽기만).
FT_DISTILL_WARN=250000
FT_DISTILL_BLOCK=300000
FT_DISTILL_RECV=250000
FT_DISTILL_NEWWORK=300000
FT_RESUME_MAX=150000
# FT_DISTILL_NEWWORK 생략 시 = 경고선 값(경고 도달 = 새 일 금지)
