#!/usr/bin/env sh
# 위임 shim — core.hooksPath 가 .fable-team/githooks 로 전환되면서
# .beads/hooks/post-checkout 가 실행되지 않게 되는 것을 막는다(push 게이트 부작용 방지).
# 키트 정본 = 하네스 kit/fable-team/githooks/post-checkout · 설치 = harness/install.sh --apply --project <루트> (r449)

# ── r835 보장 층: 팀 워크트리(.worktrees/*)는 «처음 보는» 체크아웃 때 sparse 로 정한다 — 워크트리 표식 파일 ─────────
# 왜: 맨손 `git worktree add` 로 만든 팀 워크트리가 풀 체크아웃(1.43GiB · 나노 sparse 0.24GiB) — 45분 4곳 6Gi.
#     명령 글자·«이전 HEAD = 0» 한 번뿐인 사건으로는 닫히지 않았다(외부 DA r1·r2 HOLD) → 워크트리 자신의 상태로 판별한다.
# 표식 = $(git rev-parse --git-dir)/ft-wt-mode (워크트리별 gitdir · 리포 추적 밖) · 값 `sparse` | `full <사유>` | `legacy-full`
# 조건: top 이 <주 워크트리>/.worktrees/ 아래 ∧ 주 워크트리에 design/teams/ ∧ 표식 없음 (이전 HEAD 값과 무관)
#   - FT_WT_FULL=<사유 10자 이상> → 표식 `full <사유>` + <주 워크트리>/.fable-team/state/wt-add-full.log 1줄 · sparse 0
#   - 이미 sparse(ft-wt-add --team · ft-nano-spawn 이 자기 팀 패턴을 골라 둠) → 표식 `sparse` 만(패턴 그대로)
#   - 그 밖 → sparse-checkout set --no-cone `/*` `!/design/teams/*/`(팀을 모르므로 팀 폴더 0) + 표식 `sparse` + stderr 안내
#   - 표식 있음 → 아무것도 안 함(사람이 바꾼 상태 존중 · 되풀이 0) · sparse 적용 실패 = stderr ERROR 1줄(체크아웃은 이미 끝남 → rc 0)
#   - r843: 표식은 쓴 뒤 다시 읽어 값 대조 — 못 쓰면 stderr ERROR + rc 1(외부 DA r3: 못 쓴 FULL 표식을 지나가 다음 checkout 이 sparse 로 덮음)
#     sparse 로 바꾸기 «전» 표식 자리를 먼저 써 본다 — 못 쓰는 워크트리는 체크아웃 상태 변경 0 · checkout 마다 같은 ERROR
#   - r843 r4: 표식 «있음» = -e 또는 -L(끊긴 심링크 포함) · 못 읽음·심링크·폴더 = stderr ERROR 1줄 + rc 1 + 상태 변경 0
#   - r843 r6(외부 DA r4 반례 3 · 오빠 결정 3): 실패 처리를 한 자리로 모은다 — 읽기 확인·표식 쓰기·sparse 설정 중 하나라도 실패면
#     `_ftw_fail` = pending 삭제 + 표식 삭제 + core.sparseCheckout 원복(설정 전 값) + ERROR 1줄 + rc 1 · 다음 checkout 은 «표식 없음» 에서 처음부터
#     산출은 구조 루트 아래 임시 자리(`<표식>.pending.<pid>/ft-wt-mode`)에 먼저 만들고, 검증을 통과한 뒤 **mv 1회** 로 진짜 자리에 옮긴다
#     읽기 확인은 «rc 와 출력» 을 둘 다 본다(rc≠0 = 실패 · 출력만 비교하면 읽기 실패를 성공으로 읽는다 — DA r4)
#   - 훅이 닫는 길 = checkout·switch·worktree add 뿐. reset·read-tree 같은 저수준 길은 ft-disk-alarm 하루 1회 탐지(ft-wt-mode-stamp --unmarked)
# 기존 워크트리는 설치 때 ft-wt-mode-stamp.sh --apply 로 표식을 먼저 찍는다(다음 checkout 에 갑자기 sparse 되는 길 차단).
_ftw_rc=0
_ftw_pend=""; _ftw_moved=0; _ftw_drop=0; _ftw_sc_changed=0; _ftw_out=""; _ftw_wtcfg=0; _ftw_pre_wtcfg_absent=0; _ftw_pre_wt=unset; _ftw_pre_local=unset; _ftw_pre_info=0
_ftw_read() {  # <파일> — rc 와 출력을 «둘 다» 본다(rc≠0 = 실패) · _ftw_out 에 값을 남긴다
  _ftw_out="$(cat "$1" 2>/dev/null)"; [ "$?" = 0 ]
}
_ftw_pre_capture() {  # 설정 전 값 — «스코프별»(워크트리·공용) 로 읽는다 · 공용 설정 쓰기 0 을 지키려면 섞으면 안 된다
  _ftw_wtcfg=0
  if [ "$(git config --bool extensions.worktreeConfig 2>/dev/null)" = true ]; then _ftw_wtcfg=1; else _ftw_pre_wtcfg_absent=1; fi
  if [ "$_ftw_wtcfg" = 1 ]; then
    _ftw_pre_wt="$(git config --worktree --bool core.sparseCheckout 2>/dev/null)"; [ -n "$_ftw_pre_wt" ] || _ftw_pre_wt=unset
  fi
  _ftw_pre_local="$(git config --local --bool core.sparseCheckout 2>/dev/null)"; [ -n "$_ftw_pre_local" ] || _ftw_pre_local=unset
  _ftw_pre_info=0; [ ! -e "$_gd/info/sparse-checkout" ] || _ftw_pre_info=1
}
_ftw_restore() {  # 원복은 «값이 달라진 스코프» 만 — 워크트리 값만 되돌리고 공용(local) 값이 그대로면 쓰기 0
  if [ "$_ftw_sc_changed" = 1 ]; then  # sparse 로 바뀌었으면 git 자신의 되돌림(파일 복원 + 설정 제거) 을 먼저 — config 만 되돌리면 파일이 빠진 반쪽
    _fc="$(git config --bool core.sparseCheckout 2>/dev/null)"; [ "$_fc" = true ] && git sparse-checkout disable >/dev/null 2>&1
  fi
  for _fp in worktree local; do
    if [ "$_fp" = worktree ]; then [ "$_ftw_wtcfg" = 1 ] || continue; _fv="$_ftw_pre_wt"
    else _fv="$_ftw_pre_local"; fi
    _fc="$(git config --"$_fp" --bool core.sparseCheckout 2>/dev/null)"; [ -n "$_fc" ] || _fc=unset
    [ "$_fc" = "$_fv" ] && continue
    if [ "$_fv" = unset ]; then git config --"$_fp" --unset core.sparseCheckout 2>/dev/null
    else git config --"$_fp" --bool core.sparseCheckout "$_fv" 2>/dev/null; fi
  done
  [ "$_ftw_pre_info" = 1 ] || rm -f "$_gd/info/sparse-checkout" 2>/dev/null
  # r843 r9: 캐치 때 extensions.worktreeConfig 가 «없었으면» 그것도 «없음» 으로 되돌린다(우리가 켜진 것을 남기면 다음 실행이 풀 상태를 sparse 로 믿는다)
  if [ "$_ftw_pre_wtcfg_absent" = 1 ] && [ "$(git config --bool extensions.worktreeConfig 2>/dev/null)" = true ]; then
    git config --unset extensions.worktreeConfig 2>/dev/null
    rm -f "$_gd/config.worktree" 2>/dev/null
  fi
}
_ftw_fail() {  # <단계> <사유> — 반쪽 상태를 남기지 않는 «한 자리»: pending 삭제 · (옮겼거나 읽기 실패한) 표식 삭제 · 설정 원복 · rc1 + ERROR 1줄
  [ -z "$_ftw_pend" ] || rm -rf "$_ftw_pend" 2>/dev/null
  if [ "$_ftw_moved" = 1 ] || [ "$_ftw_drop" = 1 ]; then rm -f "$_mark" 2>/dev/null; fi
  _ftw_restore
  echo "ERROR ft-wt-mode $1 실패 — $2 · 표식·sparse 설정 원복(임시 자리 0) · 체크아웃 상태 그대로 · 다음 checkout 에 처음부터" >&2
  _ftw_rc=1; return 1
}
_ftw_pending() {  # <값> — 이동 «전» 임시 자리에 쓰고 다시 읽어 rc+값 확인 · 최종 자리는 아직 0(설정이 rc0 이기 전엔 노출 0)
  _ftw_pend="$_mark.pending.$$"
  rm -rf "$_ftw_pend" 2>/dev/null
  mkdir -p "$_ftw_pend" 2>/dev/null || { _ftw_fail "표식 자리" "pending 폴더를 못 만듬 $_ftw_pend"; return 1; }
  ( printf '%s\n' "$1" > "$_ftw_pend/ft-wt-mode" ) 2>/dev/null \
    || { _ftw_fail "표식 쓰기" "«$1» 를 pending 에 못 쓺(쓰기 실패)"; return 1; }
  _ftw_read "$_ftw_pend/ft-wt-mode" && [ "$_ftw_out" = "$1" ] \
    || { _ftw_fail "표식 쓰기" "«$1» 쓰고 다시 읽은 값이 다름 또는 읽기 rc≠0 $_ftw_pend/ft-wt-mode"; return 1; }
  return 0
}
_ftw_commit() {  # <값> — 설정이 rc0 인 «뒤» 최종 자리로 mv 1회 · 실패는 전부 _ftw_fail
  mv "$_ftw_pend/ft-wt-mode" "$_mark" 2>/dev/null \
    || { _ftw_fail "표식 이동" "pending → $_mark mv 실패"; return 1; }
  _ftw_moved=1
  _ftw_read "$_mark" && [ "$_ftw_out" = "$1" ] \
    || { _ftw_fail "표식 쓰기" "«$1» mv 뒤 읽은 값이 다름 또는 읽기 rc≠0 $_mark"; return 1; }
  rm -rf "$_ftw_pend" 2>/dev/null
  return 0
}
_ftw_len() { python3 -c 'import sys; print(len(sys.argv[1].strip()))' "$1" 2>/dev/null || echo 0; }
_ftw_tool_patterns() {  # 도구가 이미 고른 패턴 파일(info/sparse-checkout)判别 — 0 = 있음(그대로 쓴다) · 2 = 없음 · 1 = 읽기 실패(fail_closed 기록)
  [ -e "$_gd/info/sparse-checkout" ] || return 2
  _ftw_read "$_gd/info/sparse-checkout" || { _ftw_fail "패턴 읽기" "info/sparse-checkout 을 못 읽어0 생성 패턴을 판단할 수 없음"; return 1; }
  [ -n "$_ftw_out" ] || return 2
  return 0
}
_ftw_slot_bad() {  # <이유> — 표식이 «일반 파일이 아님»(심링크·폴더) = ERROR + rc1 · 상태 변경 0 · 값·읽기 문제는 _ftw_fail 로 간다
  echo "ERROR ft-wt-mode 표식 자리 이상 $_mark — $1 · 체크아웃 상태 그대로(다음 checkout 마다 같은 ERROR · 손으로 고치거나 지워라)" >&2
  _ftw_rc=1
}
_ftw_has() {  # 표식 자리 있음 판별(값 해석 0) — 0 = 읽힘(손대지 않음) · 2 = 없음 · 1 = 일반 파일 아님/읽기 실패(ERROR 기록)
  if [ -L "$_mark" ]; then _ftw_slot_bad "심링크 표식 자리(일반 파일 아님)"; return 1; fi
  if [ -d "$_mark" ]; then _ftw_slot_bad "폴더(일반 파일 아님)"; return 1; fi
  [ -e "$_mark" ] || return 2
  if [ -f "$_mark" ] && [ -r "$_mark" ] && _ftw_read "$_mark"; then return 0; fi
  _ftw_drop=1; _ftw_fail "표식 읽기" "표식 자리 있음인데 못 읽음(rc≠0 또는 일반 파일 아님) $_mark"; return 1
}
_top="$(git rev-parse --show-toplevel 2>/dev/null)"
if [ "${FT_R835_SPARSE_HOOK:-0}" != 1 ] && [ -n "$_top" ]; then
  _gcd="$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)"
  _root="$(cd "$_gcd/.." 2>/dev/null && pwd -P)"
  _topr="$(cd "$_top" 2>/dev/null && pwd -P)"
  _gd="$(git rev-parse --path-format=absolute --git-dir 2>/dev/null)"
  _mark="$_gd/ft-wt-mode"
  _ftw_pre_capture
  case "$_topr" in
    "$_root"/.worktrees/*)
      if [ -n "$_root" ] && [ -d "$_root/design/teams" ]; then
        FT_R835_SPARSE_HOOK=1; export FT_R835_SPARSE_HOOK
        _ftw_has; case $? in
          1) :;;   # 있으나 믿을 수 없음 — _ftw_slot_bad 가 ERROR·rc1 기록 · 상태 변경 0
          0) :;;   # 있음(값 무관) — 손대지 않음
          *)         # 없음(ENOENT) — 표식을 «먼저» 쓰고 확인한 뒤에만 상태를 바꾼다(r843 r5 · DA ①②)
            _n=0; [ -z "${FT_WT_FULL:-}" ] || _n="$(_ftw_len "$FT_WT_FULL")"
            if [ "$_n" -ge 10 ]; then
              if _ftw_pending "full $FT_WT_FULL" && _ftw_commit "full $FT_WT_FULL"; then
                _seat="${FT_SEAT:-$(tmux display-message -p '#S' 2>/dev/null)}"
                mkdir -p "$_root/.fable-team/state" \
                  && printf '%s · %s · %s · %s\n' "$(date '+%F %T')" "${_seat:-?}" "$_topr" "$FT_WT_FULL" >> "$_root/.fable-team/state/wt-add-full.log"
                echo "[r835] FT_WT_FULL — 풀 체크아웃 유지 · 표식 $_mark" >&2
              fi
            else
              [ -z "${FT_WT_FULL:-}" ] || echo "  FT_WT_FULL 사유 짧음(${_n}자 · 10자 이상) — 무시하고 sparse" >&2
              _ftw_tool_patterns; _tp=$?
              if [ "$_tp" != 1 ] && _ftw_pending sparse; then
                if [ "$_tp" = 0 ]; then  # 도구(ft-wt-add --team · ft-nano-spawn)가 고른 패턴 — 덮지 않고 표식만
                  _ftw_commit sparse && echo "  도구가 고른 sparse 패턴 그대로(남의 팀 폴더 0 은 그 도구 몫) · $_topr" >&2
                elif printf '/*\n!/design/teams/*/\n' | git sparse-checkout set --no-cone --stdin >/dev/null 2>&1; then
                  _ftw_sc_changed=1
                  if _ftw_commit sparse; then
                    echo "[r835] 팀 워크트리를 sparse 로 정함(남의 팀 폴더 0) · $_topr" >&2
                    echo "  자기 팀 폴더 = git -C $_topr sparse-checkout add /design/teams/<팀>/ · 다음부터 ft-wt-add.sh <이름> --team <팀>" >&2
                  fi
                else
                  _ftw_fail "sparse 설정" "sparse-checkout set 실패(체크아웃 그대로) $_topr"
                fi
              fi
            fi;;
        esac
      fi;;
  esac
fi
# ────────────────────────────────────────────────────────────────────────────────

if [ -x "$_top/.beads/hooks/post-checkout" ]; then
  [ "$_ftw_rc" != 0 ] || exec "$_top/.beads/hooks/post-checkout" "$@"
  "$_top/.beads/hooks/post-checkout" "$@"
fi
exit "$_ftw_rc"
