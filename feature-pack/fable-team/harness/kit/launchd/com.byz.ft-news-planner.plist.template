<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.byz.ft-news-planner</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/bash</string>
    <string>__FT_BIN__/ft-news-ledger.sh</string>
  </array>
  <key>WorkingDirectory</key><string>__BYZ_ROOT__</string>
  <key>StartInterval</key><integer>60</integer>
  <key>RunAtLoad</key><false/>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>FT_ROOT</key><string>__BYZ_ROOT__</string>
    <key>FT_NEWS_MODE</key><string>auto</string>
    <key>FT_NEWS_STATUS_INTERVAL</key><string>1800</string>
    <key>FT_NEWS_STALE_MIN</key><string>180</string>
  </dict>
  <key>StandardOutPath</key><string>/tmp/byz-ft-news-planner.log</string>
  <key>StandardErrorPath</key><string>/tmp/byz-ft-news-planner.log</string>
</dict>
</plist>
