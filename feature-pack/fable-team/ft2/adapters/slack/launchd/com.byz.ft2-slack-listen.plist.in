<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- r1806 ft2 Slack Socket 상주 수신기 launchd 틀. 자격 값은 담지 않는다(자격 파일 경로만).
     치환: @FT2_HOME@(~/.claude/fable-team/ft2) @ROOT@ @CHANNEL@(쉼표 · 주 채널 먼저 · 예 C0CGUDJ9NTS,C0C9GRFHJE5 = #byz-dev-test,#byz-desk · r1833) @ENV_FILE@ @OWNER_SEATS@ @USERS@(쉼표).
     기동마다 @FT2_HOME@/CURRENT 가 가리키는 버전의 core/cli.py 를 부른다(버전이 바뀌어도 틀은 그대로).
     등록·kickstart·해제 = 설치 h(사람 승인) 몫 · @ROOT@/.fable-team/teams/planner/slack/ 폴더는 설치가 먼저 만든다. -->
<plist version="1.0"><dict>
  <key>Label</key><string>com.byz.ft2-slack-listen</string>
  <key>ProgramArguments</key><array>
    <string>/opt/homebrew/bin/python3</string>
    <string>-c</string>
    <string>import runpy,sys;h=sys.argv[1];v=open(h+'/CURRENT').read().strip();p=h+'/versions/'+v+'/core/cli.py';sys.argv=[p]+sys.argv[2:];runpy.run_path(p,run_name='__main__')</string>
    <string>@FT2_HOME@</string>
    <string>slack</string><string>listen</string>
    <string>--root</string><string>@ROOT@</string>
    <string>--team</string><string>planner</string>
    <string>--channel</string><string>@CHANNEL@</string>
    <string>--env</string><string>@ENV_FILE@</string>
    <string>--owner-seats</string><string>@OWNER_SEATS@</string>
    <string>--users</string><string>@USERS@</string>
  </array>
  <key>WorkingDirectory</key><string>@ROOT@</string>
  <key>EnvironmentVariables</key><dict>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    <key>LANG</key><string>ko_KR.UTF-8</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>ProcessType</key><string>Background</string>
  <key>StandardOutPath</key><string>@ROOT@/.fable-team/teams/planner/slack/listen.log</string>
  <key>StandardErrorPath</key><string>@ROOT@/.fable-team/teams/planner/slack/listen.log</string>
</dict></plist>
