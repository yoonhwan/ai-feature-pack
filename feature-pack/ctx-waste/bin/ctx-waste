SECTIONS = "0123456"


def of(lang, key):
    return STR[lang][key]


# ---------------------------------------------------------------- helpers
def bar(value, vmax, width=24):
    if vmax <= 0:
        return "·" * width
    n = max(0, min(width, int(round(width * value / vmax))))
    return BAR * n + "·" * (width - n)


def nfmt(n):
    return format(int(n), ",")


def kfmt(n):
    n = float(n)
    if n >= 1e9:
        return "%.2fB" % (n / 1e9)
    if n >= 1e6:
        return "%.1fM" % (n / 1e6)
    if n >= 1e3:
        return "%.1fk" % (n / 1e3)
    return nfmt(n)


def pct(a, b):
    return 0.0 if b <= 0 else 100.0 * a / b


def est_tokens(text):
    cjk = 0
    for ch in text:
        o = ord(ch)
        if 0xAC00 <= o <= 0xD7AF or 0x2E80 <= o <= 0x9FFF or 0x3000 <= o <= 0x30FF:
            cjk += 1
    return int(cjk / 1.5 + (len(text) - cjk) / 3.8)


def shorten(p, width=46):
    s = p.replace(HOME, "~")
    return s if len(s) <= width else "…" + s[-width + 1:]


def parse_ts(s):
    """ISO8601 or epoch(ms) -> epoch seconds (UTC)."""
    if isinstance(s, (int, float)):
        return s / 1000.0 if s > 1e11 else float(s)
    if not s:
        return None
    t = str(s)[:19]
    try:
        return calendar.timegm(time.strptime(t, "%Y-%m-%dT%H:%M:%S"))
    except ValueError:
        return None


# ---------------------------------------------------------------- runtimes
class RT:
    def __init__(self, key, memory, sessions=None, parser=None, proc=None, home=None):
        self.key = key
        self.home = home or ("~/." + key)
        self.memory = memory          # list of glob patterns for always-loaded files
        self.sessions = sessions      # glob root for session logs
        self.parser = parser          # name of parser function
        self.proc = proc or key       # process name keyword


RUNTIMES = [
    RT("claude",
       ["~/.claude/CLAUDE.md", "~/.claude/rules/*.md", "{project}/CLAUDE.md",
        "{project}/.claude/rules/*.md", "{claude_mem}"],
       "~/.claude/projects", "claude", "claude"),
    RT("codex",
       ["~/.codex/AGENTS.md", "~/.codex/AGENTS.user.md"],
       "~/.codex/sessions", "codex", "codex"),
    RT("pi",
       ["~/.pi/agent/AGENTS.md"],
       "~/.pi/agent/sessions", "pi", "pi"),
    RT("opencode",
       ["~/.config/opencode/AGENTS.md"],
       None, "opencode", "opencode", "~/.config/opencode"),
    RT("hermes",
       ["~/.hermes/SOUL.md", "~/.hermes/AGENTS.md"],
       "~/.hermes/sessions", None, "hermes"),
    RT("openclaw",
       ["~/.openclaw/AGENTS.md"],
       None, None, "openclaw"),
    RT("commandcode",
       ["~/.commandcode/AGENTS.md"],
       None, None, "commandcode"),
]
BY_KEY = {r.key: r for r in RUNTIMES}


def expand(p, project):
    slug = project.replace("/", "-").replace("_", "-")
    claude_mem = "~/.claude/projects/%s/memory/MEMORY.md" % slug
    return os.path.expanduser(p.format(project=project, claude_mem=claude_mem))


def memory_of(rt, project):
    rows, seen = [], set()
    for pat in rt.memory:
        for p in sorted(glob.glob(expand(pat, project))):
            if p in seen or not os.path.isfile(p):
                continue
            seen.add(p)
            try:
                txt = open(p, encoding="utf-8", errors="ignore").read()
            except OSError:
                continue
            rows.append({"path": p, "chars": len(txt), "tokens": est_tokens(txt)})
    rows.sort(key=lambda r: -r["tokens"])
    return rows


def running_counts():
    """Count live agent processes per runtime (best effort, one ps call)."""
    out = collections.Counter()
    try:
        ps = subprocess.run(["ps", "-Ao", "command="], capture_output=True, text=True, timeout=7).stdout
    except Exception:
        return out
    pats = {
        "claude": re.compile(r"(^|/)claude(\s|$)"),
        "codex": re.compile(r"(^|/)codex(\s|$)"),
        "pi": re.compile(r"(^|/)pi(\s|$)"),
        "hermes": re.compile(r"hermes", re.I),
        "opencode": re.compile(r"opencode", re.I),
        "openclaw": re.compile(r"openclaw", re.I),
        "commandcode": re.compile(r"command-?code", re.I),
    }
    for line in ps.splitlines():
        if "grep" in line:
            continue
        for k, rx in pats.items():
            if rx.search(line):
                out[k] += 1
    return out


# ---------------------------------------------------------------- parsers
def rec(t, sess, model, read, write, inp, out, w1h=None, w5m=None):
    ctx = read + write + inp
    w = read * W_READ + (w1h if w1h is not None else write) * W_W1H
    if w5m:
        w = read * W_READ + w1h * W_W1H + w5m * W_W5M
    return {"t": t, "sess": sess, "model": model, "read": read, "write": write,
            "inp": inp, "out": out, "ctx": ctx, "w": w + out * W_OUT}


def parse_claude(files, cutoff):
    recs = {}
    for f in files:
        sess = os.path.basename(f).split(".")[0][:8]
        try:
            fh = open(f, encoding="utf-8", errors="ignore")
        except OSError:
            continue
        for line in fh:
            if '"usage"' not in line:
                continue
            try:
                d = json.loads(line)
            except ValueError:
                continue
            msg = d.get("message") or {}
            u = msg.get("usage") or {}
            mid = msg.get("id")
            if not u or not mid or mid in recs:
                continue
            t = parse_ts(d.get("timestamp"))
            if t is None or t < cutoff:
                continue
            cc = u.get("cache_creation") or {}
            w1h = cc.get("ephemeral_1h_input_tokens") or 0
            w5m = cc.get("ephemeral_5m_input_tokens") or 0
            if not (w1h or w5m):
                w1h = u.get("cache_creation_input_tokens") or 0
            recs[mid] = rec(t, sess, msg.get("model") or "?",
                            u.get("cache_read_input_tokens") or 0, w1h + w5m,
                            u.get("input_tokens") or 0, u.get("output_tokens") or 0,
                            w1h, w5m)
        fh.close()
    return list(recs.values())


def parse_codex(files, cutoff):
    recs = []
    for f in files:
        sess = os.path.basename(f).split("-")[-1][:8]
        try:
            fh = open(f, encoding="utf-8", errors="ignore")
        except OSError:
            continue
        for line in fh:
            if "token_usage_record" not in line:
                continue
            try:
                d = json.loads(line)
            except ValueError:
                continue
            p = d.get("payload") or {}
            u = p.get("usage") or {}
            if not u:
                continue
            t = parse_ts(d.get("timestamp"))
            if t is None or t < cutoff:
                continue
            cached = u.get("cached_input_tokens") or 0
            total_in = u.get("input_tokens") or 0
            recs.append(rec(t, (p.get("thread_id") or sess)[:8], d.get("model") or "codex",
                            cached, u.get("cache_write_input_tokens") or 0,
                            max(total_in - cached, 0), u.get("output_tokens") or 0))
        fh.close()
    return recs


def parse_pi(files, cutoff):
    recs = []
    for f in files:
        stem = os.path.basename(f)[:-6]
        sess = (stem.split("_")[1] if "_" in stem else stem)[:8]
        try:
            fh = open(f, encoding="utf-8", errors="ignore")
        except OSError:
            continue
        for line in fh:
            if '"usage"' not in line:
                continue
            try:
                d = json.loads(line)
            except ValueError:
                continue
            msg = d.get("message") or {}
            u = msg.get("usage") or {}
            if not u:
                continue
            t = parse_ts(d.get("timestamp"))
            if t is None or t < cutoff:
                continue
            recs.append(rec(t, sess, msg.get("model") or "pi",
                            u.get("cacheRead") or 0, u.get("cacheWrite") or 0,
                            u.get("input") or 0, u.get("output") or 0))
        fh.close()
    return recs


def parse_opencode(_files, cutoff):
    db = os.path.expanduser("~/.local/share/opencode/opencode.db")
    if not os.path.isfile(db) or not os.access(db, os.R_OK):
        return []
    sql = ("select session_id, data from message where time_created > %d"
           % int(cutoff * 1000))
    try:
        out = subprocess.run(["sqlite3", db, sql], capture_output=True, text=True, timeout=20).stdout
    except Exception:
        return []
    recs = []
    for line in out.splitlines():
        if "|" not in line:
            continue
        sid, data = line.split("|", 1)
        try:
            d = json.loads(data)
        except ValueError:
            continue
        tk = d.get("tokens") or {}
        if not tk:
            continue
        cache = tk.get("cache") or {}
        t = parse_ts((d.get("time") or {}).get("created"))
        if t is None or t < cutoff:
            continue
        recs.append(rec(t, (sid or "?")[:8], d.get("modelID") or "opencode",
                        cache.get("read") or 0, cache.get("write") or 0,
                        tk.get("input") or 0, tk.get("output") or 0))
    return recs


PARSERS = {"claude": parse_claude, "codex": parse_codex, "pi": parse_pi, "opencode": parse_opencode}


def scan(rt, hours):
    cutoff = time.time() - hours * 3600
    if rt.parser not in PARSERS or not rt.sessions:
        return []
    root = os.path.expanduser(rt.sessions)
    files = [f for f in glob.glob(os.path.join(root, "**", "*.jsonl"), recursive=True)
             if os.path.getmtime(f) > cutoff]
    files = files[:4000]
    return PARSERS[rt.parser](files, cutoff)


# ---------------------------------------------------------------- analysis
def analyze(recs, rewrite_at):
    by = collections.defaultdict(list)
    for r in recs:
        by[r["sess"]].append(r)
    for v in by.values():
        v.sort(key=lambda r: r["t"])
    bd = {"read": 0.0, "rewrite": 0.0, "delta": 0.0, "out": 0.0}
    n_rew = 0
    for r in recs:
        bd["read"] += r["read"] * W_READ
        bd["out"] += r["out"] * W_OUT
        if r["write"] > rewrite_at:
            bd["rewrite"] += r["write"] * W_W1H
            n_rew += 1
        else:
            bd["delta"] += r["write"] * W_W1H
    bd["total"] = sum(bd.values())
    first_rew = sum(1 for rs in by.values() if rs and rs[0]["write"] > rewrite_at)
    mid_rew = sum(1 for rs in by.values() for r in rs[1:] if r["write"] > rewrite_at)
    ctxs = [r["ctx"] for r in recs]
    stats = {"sessions": len(by), "requests": len(recs), "rewrites": n_rew,
             "first_rew": first_rew, "mid_rew": mid_rew,
             "avg_ctx": int(sum(ctxs) / len(ctxs)) if ctxs else 0,
             "max_ctx": max(ctxs) if ctxs else 0,
             "last": max((r["t"] for r in recs), default=0)}
    top = sorted(((sum(r["w"] for r in rs), k, len(rs),
                   int(sum(r["ctx"] for r in rs) / len(rs)), max(r["ctx"] for r in rs))
                  for k, rs in by.items()), reverse=True)
    return {"burn": bd, "stats": stats, "top": top}


def analyze_request(path):
    try:
        raw = open(path, encoding="utf-8", errors="ignore").read()
    except OSError as e:
        print("  ! cannot read request body: %s" % e, file=sys.stderr)
        return None
    start = 0
    m = raw.find("=== REQUEST BODY ===")
    if m >= 0:
        start = m + len("=== REQUEST BODY ===")
    dec = json.JSONDecoder()
    d = None
    for i in range(start, len(raw)):
        if raw[i] != "{":
            continue
        try:
            obj, _ = dec.raw_decode(raw, i)
        except ValueError:
            continue
        if isinstance(obj, dict) and "messages" in obj and "tools" in obj:
            d = obj
            break
    if d is None:
        return None
    tools = [{"name": t.get("name"),
              "chars": len(json.dumps(t, ensure_ascii=False)),
              "deferred": bool(t.get("defer_loading"))} for t in d.get("tools") or []]
    tools.sort(key=lambda r: -r["chars"])
    msgs = d.get("messages") or []
    blocks = []
    if msgs:
        c = msgs[0].get("content")
        if isinstance(c, list):
            blocks = [b.get("text", "") for b in c if isinstance(b, dict) and b.get("type") == "text"]
        elif isinstance(c, str):
            blocks = [c]
    return {"model": d.get("model"), "tools": tools, "first_blocks": blocks,
            "n_msgs": len(msgs),
            "system_chars": len(json.dumps(d.get("system") or "", ensure_ascii=False)),
            "total_chars": len(json.dumps(d, ensure_ascii=False))}


# ---------------------------------------------------------------- report
def main():
    ap = argparse.ArgumentParser(
        prog="ctx-waste",
        description="Local context waste audit for AI coding agents (read-only)")
    ap.add_argument("--lang", choices=["en", "ko"], default="en", help="output language (default en)")
    ap.add_argument("--runtime", default="auto",
                    help="auto | all | " + " | ".join(r.key for r in RUNTIMES))
    ap.add_argument("--hours", type=float, default=3.0, help="window in hours (default 3)")
    ap.add_argument("--project", default=os.getcwd(), help="project root (default cwd)")
    ap.add_argument("--request", default=None, help="captured request body file (optional)")
    ap.add_argument("--rewrite-tokens", type=int, default=REWRITE_TOKENS,
                    help="full-rewrite threshold in cache-write tokens (default 150000)")
    ap.add_argument("--budget", type=int, default=250_000, help="distill budget in tokens (default 250000)")
    ap.add_argument("--top", type=int, default=6, help="session rows per runtime (default 6)")
    ap.add_argument("--json", action="store_true", help="machine readable")
    a = ap.parse_args()
    L = a.lang
    S = lambda k: STR[L][k]

    procs = running_counts()
    data = {}
    for rt in RUNTIMES:
        mem = memory_of(rt, a.project)
        recs = scan(rt, a.hours)
        an = analyze(recs, a.rewrite_tokens) if recs else None
        data[rt.key] = {"rt": rt, "memory": mem, "analysis": an,
                        "running": procs.get(rt.key, 0),
                        "installed": bool(recs) or os.path.isdir(os.path.expanduser(rt.home))}
    reqinfo = analyze_request(a.request) if a.request else None

    with_data = [k for k, v in data.items() if v["analysis"]]
    if a.runtime == "all":
        order = with_data
    elif a.runtime != "auto":
        order = [a.runtime] if a.runtime in data else []
    else:
        order = sorted(with_data, key=lambda k: (-data[k]["analysis"]["stats"]["requests"],
                                                 -data[k]["analysis"]["stats"]["last"]))

    if a.json:
        out = {"lang": L, "hours": a.hours, "project": a.project,
               "runtimes": {k: {"installed": v["installed"], "running": v["running"],
                                "memory": v["memory"],
                                "memory_tokens": sum(r["tokens"] for r in v["memory"]),
                                "stats": (v["analysis"]["stats"] if v["analysis"] else None),
                                "burn": (v["analysis"]["burn"] if v["analysis"] else None)}
                            for k, v in data.items()},
               "order": order,
               "tools": reqinfo["tools"] if reqinfo else None}
        print(json.dumps(out, ensure_ascii=False, indent=1))
        return 0

    tot_sess = sum(v["analysis"]["stats"]["sessions"] for v in data.values() if v["analysis"])
    tot_req = sum(v["analysis"]["stats"]["requests"] for v in data.values() if v["analysis"])
    print(S("title"))
    print(S("window") % (a.hours, len(with_data), tot_sess, nfmt(tot_req)))
    print()

    # [0] environment
    print(S("env"))
    print(S("env_head") % tuple(S("hdr")))
    for rt in RUNTIMES:
        v = data[rt.key]
        st = v["analysis"]["stats"] if v["analysis"] else None
        last = time.strftime("%H:%M", time.localtime(st["last"])) if st and st["last"] else S("dash")
        kind = (S("kind_usage") if st else (S("kind_mem") if v["memory"] else S("kind_none")))
        print(S("env_row") % (rt.key, S("yes") if v["installed"] else S("no"),
                              v["running"], st["sessions"] if st else 0, last, kind))
    print()

    for idx, key in enumerate(order, 1):
        v = data[key]
        an = v["analysis"]
        tag = key
        if not an:
            print("[%d] %s — %s" % (idx, key, S("mem_only")))
            continue
        st, bd = an["stats"], an["burn"]
        # memory
        print(S("mem") % tag)
        if not v["memory"]:
            print(S("none"))
        else:
            mx = max(r["tokens"] for r in v["memory"])
            for r in v["memory"][:8]:
                flag = "!" if r["chars"] > 4000 else " "
                print("  %s %7s %s %s %-40s %s" % (flag, nfmt(r["tokens"]), S("tok"), bar(r["tokens"], mx),
                                                    shorten(r["path"], 40), nfmt(r["chars"])))
            print(S("total") % (nfmt(sum(r["tokens"] for r in v["memory"])),
                                nfmt(sum(r["chars"] for r in v["memory"]))))
        # request anatomy (first runtime only)
        if reqinfo and idx == 1:
            live = [t for t in reqinfo["tools"] if not t["deferred"]]
            mx = max([t["chars"] for t in live], default=1)
            print(S("req") % (tag, reqinfo["model"]))
            for t in live[:8]:
                print("     %7s  %s %s" % (nfmt(t["chars"]), bar(t["chars"], mx), t["name"]))
            print(S("tool_live") % (len(live), nfmt(sum(t["chars"] for t in live)),
                                    len([t for t in reqinfo["tools"] if t["deferred"]])))
            print(S("first_msg") % (nfmt(sum(len(b) for b in reqinfo["first_blocks"])),
                                    reqinfo["n_msgs"], nfmt(reqinfo["system_chars"])))
        # burn
        print(S("burn") % (tag, kfmt(bd["total"])))
        rows = [(S("burn_rewrite"), bd["rewrite"], "%d" % st["rewrites"]),
                (S("burn_read"), bd["read"], ""),
                (S("burn_delta"), bd["delta"], "%d" % (st["requests"] - st["rewrites"])),
                (S("burn_out"), bd["out"], "")]
        for name, val, note in rows:
            print("  %-18s %5.1f%% %s %9s %s" % (name, pct(val, bd["total"]),
                                                 bar(val, bd["total"]), kfmt(val), note))
        # context
        print(S("ctx") % tag)
        print(S("ctx_row") % (nfmt(st["avg_ctx"]), nfmt(st["max_ctx"])))
        print(S("ctx_rew") % (st["first_rew"], st["mid_rew"]))
        mt = sum(r["tokens"] for r in v["memory"])
        if st["avg_ctx"] and mt:
            print(S("ctx_fixed") % pct(mt, st["avg_ctx"]))
        # top sessions
        print(S("top") % tag)
        print(S("top_head") % tuple(S("topcols")))
        for w, sess, n, avgc, maxc in an["top"][:a.top]:
            print("  %-12s %5d %10s %10s %10s" % (sess, n, nfmt(avgc), nfmt(maxc), kfmt(w)))
        print()

    # break-even for primary
    if order and data[order[0]]["analysis"]:
        v = data[order[0]]
        st = v["analysis"]["stats"]
        prefix = sum(r["tokens"] for r in v["memory"])
        turns = st["requests"] / max(st["sessions"], 1)
        print(S("be") + " — " + order[0])
        budget = a.budget
        if prefix <= 0 or not st["avg_ctx"]:
            print("  " + S("bers"))
        else:
            if st["avg_ctx"] <= budget:
                budget = max(int(st["avg_ctx"] * 0.5), 40_000)
                print(S("be_low") % (nfmt(st["avg_ctx"]), nfmt(a.budget), nfmt(budget)))
            restart = prefix * W_W1H
            save = (st["avg_ctx"] - budget) * W_READ
            if save <= 0:
                print("  " + S("bers"))
            else:
                print(S("be_restart") % (kfmt(restart), nfmt(prefix), W_W1H))
                print(S("be_save") % (kfmt(save), nfmt(budget)))
                print(S("be_pt") % (restart / save, turns,
                                    S("be_gain") if turns > restart / save else S("be_keep")))
        print()

    # recommendations
    print(S("reco"))
    recos = []
    for key in (order or list(data)):
        v = data[key]
        big = [r for r in v["memory"] if r["chars"] > 4000]
        if big:
            recos.append("[%s] " % key + S("reco_mem") % (len(big), nfmt(sum(r["chars"] for r in big))))
        if v["analysis"]:
            st, bd = v["analysis"]["stats"], v["analysis"]["burn"]
            if st["rewrites"]:
                recos.append("[%s] " % key + S("reco_rew") % (st["rewrites"], pct(bd["rewrite"], bd["total"])))
    if reqinfo:
        fat = [t for t in reqinfo["tools"] if not t["deferred"] and t["chars"] > 3000]
        if fat:
            recos.append(S("reco_tools") % (len(fat), nfmt(sum(t["chars"] for t in fat)),
                                            ", ".join(t["name"] for t in fat[:4])))
    if not recos:
        recos.append(S("reco_none"))
    for i, r in enumerate(recos, 1):
        print("  %d. %s" % (i, r))
    print()
    print(S("assume") % (W_READ, W_W1H, W_W5M, W_OUT))
    return 0


if __name__ == "__main__":
    sys.exit(main())
