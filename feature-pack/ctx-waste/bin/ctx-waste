#!/usr/bin/env python3
"""ctx-waste — 로컬 AI 코딩 에이전트 컨텍스트 낭비 감사기 (읽기 전용).

무엇을 보는가:
  [1] 자동 로드 메모리  — 매 요청 앞에 붙는 파일(CLAUDE.md / rules/ / MEMORY.md)의 크기
  [2] 세션 소모 구조    — 캐시 읽기 / 전면 재작성 / 델타 쓰기 / 출력의 가중 비중
  [3] 요청당 컨텍스트   — 평균·최대, 고정 프리픽스 추정
  [4] 낭비 상위 세션    — 어느 세션이 전면 재작성을 일으켰나
  [5] 증류 손익분기     — 재시작 비용 vs 턴당 절감 (문턱을 어디로 둘지)
  [6] 권고

안전: 쓰기 0, 네트워크 0. 파일을 읽기만 한다.
가중치(근사): cache_read 0.1 · cache_write(1h) 2.0 · cache_write(5m) 1.25 · output 5.0.
  Anthropic 공개 단가 비율을 따르되, 실제 한도 산식은 비공개다. 상대 비교용으로만 쓴다.
"""
import argparse
import calendar
import collections
import glob
import json
import os
import sys
import time

W_READ, W_W1H, W_W5M, W_OUT = 0.1, 2.0, 1.25, 5.0
REWRITE_TOKENS = 150_000      # 이 이상을 한 요청에서 캐시에 새로 쓰면 "전면 재작성"으로 본다
BAR = "█"


def est_tokens(text):
    """문자 → 토큰 근사. CJK는 1.5자/토큰, 라틴은 3.8자/토큰."""
    cjk = 0
    for ch in text:
        o = ord(ch)
        if 0xAC00 <= o <= 0xD7AF or 0x2E80 <= o <= 0x9FFF or 0x3000 <= o <= 0x30FF:
            cjk += 1
    return int(cjk / 1.5 + (len(text) - cjk) / 3.8)


def bar(value, vmax, width=24):
    if vmax <= 0:
        return "·" * width
    n = int(round(width * value / vmax))
    n = max(0, min(width, n))
    return BAR * n + "·" * (width - n)


def nfmt(n):
    return format(int(n), ",")


def kfmt(n):
    """1만 이상은 만 단위로."""
    if n >= 100_000_000:
        return "%.2f억" % (n / 100_000_000)
    if n >= 10_000:
        return "%s만" % format(int(round(n / 10_000)), ",")
    return nfmt(n)


def pct(a, b):
    return 0.0 if b <= 0 else 100.0 * a / b


# ---------------------------------------------------------------- [1] 메모리
def memory_files(project):
    home = os.path.expanduser("~")
    out = []
    for p in [os.path.join(home, ".claude", "CLAUDE.md")]:
        out.append(p)
    out += sorted(glob.glob(os.path.join(home, ".claude", "rules", "*.md")))
    if project:
        out.append(os.path.join(project, "CLAUDE.md"))
        out += sorted(glob.glob(os.path.join(project, ".claude", "rules", "*.md")))
        slug = project.replace("/", "-").replace("_", "-")
        mem = os.path.join(home, ".claude", "projects", slug, "memory", "MEMORY.md")
        out.append(mem)
    seen, rows = set(), []
    for p in out:
        if not p or p in seen or not os.path.isfile(p):
            continue
        seen.add(p)
        try:
            txt = open(p, encoding="utf-8", errors="ignore").read()
        except OSError:
            continue
        rows.append({"path": p, "chars": len(txt), "tokens": est_tokens(txt)})
    rows.sort(key=lambda r: -r["tokens"])
    return rows


# ---------------------------------------------------------------- [2] 세션
def scan_sessions(hours):
    home = os.path.expanduser("~")
    base = os.path.join(home, ".claude", "projects")
    cutoff = time.time() - hours * 3600
    files = [f for f in glob.glob(os.path.join(base, "**", "*.jsonl"), recursive=True)
             if os.path.getmtime(f) > cutoff]
    seen = {}
    for f in files:
        sess = os.path.basename(f).split(".")[0][:8]
        proj = os.path.basename(os.path.dirname(f))
        try:
            fh = open(f, encoding="utf-8", errors="ignore")
        except OSError:
            continue
        for line in fh:
            if '"usage"' not in line:
                continue
            try:
                d = json.loads(line)
            except ValueError:
                continue
            msg = d.get("message") or {}
            usage = msg.get("usage") or {}
            mid = msg.get("id")
            ts = d.get("timestamp")
            if not usage or not ts or not mid or mid in seen:
                continue
            try:
                t = calendar.timegm(time.strptime(ts[:19], "%Y-%m-%dT%H:%M:%S"))
            except ValueError:
                continue
            if t < cutoff:
                continue
            cc = usage.get("cache_creation") or {}
            rec = {
                "t": t, "sess": sess, "proj": proj, "model": msg.get("model") or "?",
                "read": usage.get("cache_read_input_tokens") or 0,
                "w1h": cc.get("ephemeral_1h_input_tokens") or 0,
                "w5m": cc.get("ephemeral_5m_input_tokens") or 0,
                "inp": usage.get("input_tokens") or 0,
                "out": usage.get("output_tokens") or 0,
            }
            rec["ctx"] = rec["read"] + rec["w1h"] + rec["w5m"] + rec["inp"]
            rec["write"] = rec["w1h"] + rec["w5m"]
            rec["w"] = (rec["read"] * W_READ + rec["w1h"] * W_W1H +
                        rec["w5m"] * W_W5M + rec["out"] * W_OUT)
            seen[mid] = rec
        fh.close()
    reqs = list(seen.values())
    by = collections.defaultdict(list)
    for r in reqs:
        by[r["sess"]].append(r)
    for v in by.values():
        v.sort(key=lambda r: r["t"])
    return files, reqs, by


def burn_breakdown(reqs, rewrite_at):
    read = sum(r["read"] for r in reqs) * W_READ
    wrew = sum(r["write"] for r in reqs if r["write"] > rewrite_at) * W_W1H
    wdel = sum(r["write"] for r in reqs if r["write"] <= rewrite_at) * W_W1H
    out = sum(r["out"] for r in reqs) * W_OUT
    total = read + wrew + wdel + out
    return {"read": read, "rewrite": wrew, "delta": wdel, "out": out, "total": total}


# ---------------------------------------------------------------- [3] 요청 본문
def analyze_request(path):
    """프록시가 남긴 요청 본문 로그(1개)를 해부한다. 없으면 None.

    지원 형식:
      ① 순수 JSON 본문 파일
      ② "=== REQUEST BODY ===" 같은 마커 뒤에 본문이 붙은 프록시 로그
    """
    try:
        raw = open(path, encoding="utf-8", errors="ignore").read()
    except OSError as e:
        print("  ! 요청 본문을 못 읽음: %s" % e, file=sys.stderr)
        return None
    start = 0
    marker = raw.find("=== REQUEST BODY ===")
    if marker >= 0:
        start = marker + len("=== REQUEST BODY ===")
    d = None
    dec = json.JSONDecoder()
    for i in range(start, len(raw)):
        if raw[i] != "{":
            continue
        try:
            obj, _end = dec.raw_decode(raw, i)
        except ValueError:
            continue
        if isinstance(obj, dict) and "messages" in obj and "tools" in obj:
            d = obj
            break
    if d is None:
        return None
    tools = []
    for t in d.get("tools") or []:
        tools.append({"name": t.get("name"), "chars": len(json.dumps(t, ensure_ascii=False)),
                      "deferred": bool(t.get("defer_loading"))})
    tools.sort(key=lambda r: -r["chars"])
    msgs = d.get("messages") or []
    blocks = []
    if msgs:
        content = msgs[0].get("content")
        if isinstance(content, list):
            for b in content:
                if isinstance(b, dict) and b.get("type") == "text":
                    blocks.append(b.get("text", ""))
        elif isinstance(content, str):
            blocks.append(content)
    return {"model": d.get("model"), "tools": tools, "first_blocks": blocks,
            "n_msgs": len(msgs),
            "system_chars": len(json.dumps(d.get("system") or "", ensure_ascii=False)),
            "total_chars": len(json.dumps(d, ensure_ascii=False))}


# ---------------------------------------------------------------- 보고
def main():
    ap = argparse.ArgumentParser(
        prog="ctx-waste",
        description="로컬 AI 코딩 에이전트의 컨텍스트 낭비를 그래프로 보여준다 (읽기 전용)")
    ap.add_argument("--hours", type=float, default=3.0, help="집계 구간(시간). 기본 3")
    ap.add_argument("--project", default=os.getcwd(), help="프로젝트 루트. 기본 현재 폴더")
    ap.add_argument("--request", default=None, help="프록시가 남긴 요청 본문 파일 1개(선택)")
    ap.add_argument("--rewrite-tokens", type=int, default=REWRITE_TOKENS,
                    help="전면 재작성 판정 기준(캐시 신규 쓰기 토큰). 기본 150000")
    ap.add_argument("--budget", type=int, default=250_000, help="권고 증류 문턱(토큰). 기본 250000")
    ap.add_argument("--top", type=int, default=8, help="세션 표 행 수. 기본 8")
    ap.add_argument("--json", action="store_true", help="기계 판독용 JSON")
    a = ap.parse_args()

    mem = memory_files(a.project)
    files, reqs, by = scan_sessions(a.hours)
    reqinfo = analyze_request(a.request) if a.request else None
    bd = burn_breakdown(reqs, a.rewrite_tokens)

    rewrites = [r for r in reqs if r["write"] > a.rewrite_tokens]
    first_rew = 0
    mid_rew = 0
    for sess, rs in by.items():
        if rs and rs[0]["write"] > a.rewrite_tokens:
            first_rew += 1
        for r in rs[1:]:
            if r["write"] > a.rewrite_tokens:
                mid_rew += 1
    avg_ctx = int(sum(r["ctx"] for r in reqs) / len(reqs)) if reqs else 0
    max_ctx = max([r["ctx"] for r in reqs], default=0)
    mem_tokens = sum(r["tokens"] for r in mem)
    tool_tokens = 0
    if reqinfo:
        tool_tokens = sum(tool_tok(r["chars"]) for r in reqinfo["tools"] if not r["deferred"])

    if a.json:
        print(json.dumps({
            "hours": a.hours, "project": a.project,
            "memory": mem, "memory_tokens": mem_tokens,
            "sessions": len(by), "requests": len(reqs),
            "avg_context": avg_ctx, "max_context": max_ctx,
            "burn": bd, "rewrites": {"total": len(rewrites), "session_first": first_rew, "mid": mid_rew},
            "tools": (reqinfo["tools"] if reqinfo else None),
            "fixed_prefix_tokens": mem_tokens + tool_tokens,
        }, ensure_ascii=False, indent=1))
        return 0

    print("ctx-waste — 로컬 컨텍스트 낭비 감사 (읽기 전용)")
    print("구간: 최근 %g시간 · jsonl %d개 · 세션 %d개 · 고유 요청 %d건 · 프로젝트 %s"
          % (a.hours, len(files), len(by), len(reqs), a.project))
    print()

    # [1] 메모리
    print("[1] 자동 로드 메모리 — 매 요청 앞에 붙는다")
    if not mem:
        print("  (자동 로드 파일 없음)")
    else:
        mx = max(r["tokens"] for r in mem)
        for r in mem[:10]:
            flag = "!" if r["chars"] > 4000 else " "
            print("  %s %7s 토큰 %s %-46s %s자"
                  % (flag, nfmt(r["tokens"]), bar(r["tokens"], mx), shorten(r["path"]), nfmt(r["chars"])))
        if len(mem) > 10:
            print("  … 그 외 %d개" % (len(mem) - 10))
    print("  합계 %s 토큰 · %s자" % (nfmt(mem_tokens), nfmt(sum(r["chars"] for r in mem))))
    print()

    # [2] 요청 본문(선택)
    if reqinfo:
        print("[2] 요청 본문 해부 — %s (본문 %s자)" % (reqinfo["model"], nfmt(reqinfo["total_chars"])))
        live = [t for t in reqinfo["tools"] if not t["deferred"]]
        mx = max([t["chars"] for t in live], default=1)
        for t in live[:8]:
            print("     %7s자 %s %s" % (nfmt(t["chars"]), bar(t["chars"], mx), t["name"]))
        dnum = len([t for t in reqinfo["tools"] if t["deferred"]])
        print("  비defer 툴 %d개 %s자 · defer 툴 %d개(로드 전 0토큰)"
              % (len(live), nfmt(sum(t["chars"] for t in live)), dnum))
        print("  첫 user 메시지 %s자 · 메시지 %d개 · system %s자"
              % (nfmt(sum(len(b) for b in reqinfo["first_blocks"])), reqinfo["n_msgs"],
                 nfmt(reqinfo["system_chars"])))
        print()

    # [3] 소모 구조
    tag = "[3]" if reqinfo else "[2]"
    print("%s 소모 구조 (가중 토큰 · 총 %s)" % (tag, kfmt(bd["total"])))
    if bd["total"] <= 0:
        print("  요청 없음 — --hours 를 늘려 보세요")
    else:
        rows = [("캐시 전면 재작성", bd["rewrite"], "%d건" % len(rewrites)),
                ("캐시 읽기(정상)", bd["read"], ""),
                ("델타 캐시 쓰기", bd["delta"], "%d건" % (len(reqs) - len(rewrites))),
                ("출력", bd["out"], "")]
        for name, v, note in rows:
            print("  %-16s %5.1f%% %s %9s %s"
                  % (name, pct(v, bd["total"]), bar(v, bd["total"]), kfmt(v), note))
    print()

    # [4] 컨텍스트
    tag = "[4]" if reqinfo else "[3]"
    print("%s 요청당 컨텍스트" % tag)
    print("  평균 %s · 최대 %s 토큰" % (nfmt(avg_ctx), nfmt(max_ctx)))
    print("  전면 재작성: 세션 첫 요청 %d건 · 세션 중간 %d건" % (first_rew, mid_rew))
    if avg_ctx and mem_tokens:
        print("  고정 프리픽스 비중(메모리만): %.0f%%" % pct(mem_tokens, avg_ctx))
    print()

    # [5] 세션
    tag = "[5]" if reqinfo else "[4]"
    print("%s 낭비 상위 세션" % tag)
    rows = []
    for sess, rs in by.items():
        rows.append((sum(r["w"] for r in rs), sess, len(rs), int(sum(r["ctx"] for r in rs) / len(rs)),
                     max(r["ctx"] for r in rs), rs[0]["proj"]))
    rows.sort(reverse=True)
    print("  %-10s %5s %9s %9s %9s  %s" % ("session", "요청", "평균ctx", "최대ctx", "가중소모", "프로젝트"))
    for w, sess, n, avgc, maxc, proj in rows[:a.top]:
        print("  %-10s %5d %9s %9s %9s  %s"
              % (sess, n, nfmt(avgc), nfmt(maxc), kfmt(w), proj[-34:]))
    print()

    # [6] 손익분기
    tag = "[6]" if reqinfo else "[5]"
    prefix = mem_tokens + tool_tokens
    turns = len(reqs) / max(len(by), 1)
    print("%s 증류 손익분기" % tag)
    budget = a.budget
    if prefix <= 0 or not avg_ctx:
        print("  계산 불가 (프리픽스 또는 요청 0)")
    else:
        if avg_ctx <= budget:
            budget = max(int(avg_ctx * 0.5), 40_000)
            print("  현재 평균 %s 이 예산 %s 이하 — 예산을 %s 로 낮춰 다시 계산"
                  % (nfmt(avg_ctx), nfmt(a.budget), nfmt(budget)))
        restart = prefix * W_W1H
        save = (avg_ctx - budget) * W_READ
        if save <= 0:
            print("  절감 0 — 예산을 더 낮춰야 의미가 생긴다")
        else:
            be = restart / save
            print("  재시작 1회 비용      %s  (프리픽스 %s × %.1f배)"
                  % (kfmt(restart), nfmt(prefix), W_W1H))
            print("  턴당 절감(%s로 증류) %s" % (nfmt(budget), kfmt(save)))
            print("  손익분기 %.1f턴 · 현재 세션당 평균 %.1f턴 → %s"
                  % (be, turns, "더 자주 증류하는 게 이득" if turns > be else "지금 주기 유지 가능"))
    print()

    # [7] 권고
    tag = "[7]" if reqinfo else "[6]"
    print("%s 권고" % tag)
    recos = []
    big_mem = [r for r in mem if r["chars"] > 4000]
    if big_mem:
        recos.append("자동 로드 큰 파일 %d개(%s자) → guides/로 옮기고 rules/엔 1KB 다이제스트만"
                     % (len(big_mem), nfmt(sum(r["chars"] for r in big_mem))))
    if reqinfo:
        fat = [t for t in reqinfo["tools"] if not t["deferred"] and t["chars"] > 3000]
        if fat:
            recos.append("비defer 툴 %d개가 %s자(%s) → defer_loading 또는 기능 off"
                         % (len(fat), nfmt(sum(t["chars"] for t in fat)),
                            ", ".join(t["name"] for t in fat[:4])))
    if rewrites:
        recos.append("전면 재작성 %d건이 소모의 %.0f%% → 세션 동시 시작 분산 + 리줌 컨텍스트 상한"
                     % (len(rewrites), pct(bd["rewrite"], bd["total"])))
    if not recos:
        recos.append("측정된 낭비 없음 — 지금 상태 유지")
    for i, r in enumerate(recos, 1):
        print("  %d. %s" % (i, r))
    print()
    print("가중치 가정: read %.1f · write(1h) %.1f · write(5m) %.2f · output %.0f — 상대 비교용"
          % (W_READ, W_W1H, W_W5M, W_OUT))
    return 0


def tool_tok(chars):
    """툴 정의 JSON(거의 영문) → 토큰 근사."""
    return int(chars / 3.8)


def shorten(p, width=46):
    h = os.path.expanduser("~")
    s = p.replace(h, "~")
    return s if len(s) <= width else "…" + s[-width + 1:]


if __name__ == "__main__":
    sys.exit(main())
