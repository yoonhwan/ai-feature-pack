#!/usr/bin/env python3
"""ctx-waste — local context waste audit for AI coding agents (read-only).

Checks the local environments of claude, codex, pi, hermes, openclaw, opencode and
commandcode: how much of every request is paid before any work happens, which
sessions re-write the prompt cache, and where the distill threshold should sit.

Safety: writes nothing, calls no network. Only reads local session logs and rule
files. Conversation text is never parsed — only token counters.

Weights (approximate, relative comparison only):
  cache read 0.1 · cache write (1h) 2.0 · cache write (5m) 1.25 · output 5.0
"""
import argparse
import calendar
import collections
import glob
import json
import os
import re
import subprocess
import sys
import time

W_READ, W_W1H, W_W5M, W_OUT = 0.1, 2.0, 1.25, 5.0
REWRITE_TOKENS = 150_000
BAR = "█"

HOME = os.path.expanduser("~")

