# FT 구독·용량 고정상수 견본 (0순위) — ft-plan 이 읽는다
# 값은 머신마다 다르므로 여기 비워 둔다. 채워서 설치한다:
#   <루트>/.fable-team/state/capacity/accounts.env   (우선)
#   ~/.claude/fable-team/state/capacity/accounts.env (다음)
# 해석 순서: $FT_CAP_FILE > <루트>/... > ~/.claude/...
# 규칙: 값이 비면 «0순위 문제» 다. 채우기 전 산정 숫자는 신뢰하지 않는다(ft-plan 이 그렇게 출력한다).

# ── 구독 장수
FT_CAP_CLAUDE_5X=
FT_CAP_CLAUDE_ULTRA=
FT_CAP_CODEX_PLUS=
FT_CAP_CODEX_PRO=
FT_CAP_DEEPSEEK_KEYS=

# ── 주간 리밋(가중 M) — 하한과 상한을 «따로» 적는다. «상한 ÷ 3» 같은 대체 계산은 쓰지 않는다.
FT_CAP_WK_5X_LOW=
FT_CAP_WK_ULTRA_LOW=
FT_CAP_WK_5X=
FT_CAP_WK_ULTRA=

# ── 모형
# 한 골 = 팀 FT_GOAL_TEAMS 개 동시 × FT_GOAL_TEAM_HOURS 시간 (남는 팀은 후순위 골)
FT_CAP_SEATS_PER_TEAM=
FT_GOAL_TEAMS=
FT_GOAL_TEAM_HOURS=
FT_CAP_TARGET_UTIL=
