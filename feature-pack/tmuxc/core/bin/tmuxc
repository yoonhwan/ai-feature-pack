#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
tmuxc - tmux session launcher for Claude, Codex, OMX, Pi

Usage:
  tmuxc open <path> [--name NAME] [--agent claude|codex|omx|opencode|cmd|pi] [--role worker|analysis|orchestrator|implementer|planner] [--model ID] [--ctx 1m] [--effort E] [--fast on|off] [--like SESSION] [--prompt TEXT] [--dry-run]
      --effort: claude·cmd·codex(-c model_reasoning_effort)·pi(--thinking) / --fast: codex 전용(-c service_tier=priority)
      --serena: **0.4.9 에서 폐기**(거부 rc 2). Serena 는 2026-10-22 은퇴 — 공유서버 9493 종료·MCP 등록 제거.
        코드 탐색은 code-intel 스킬(`ci search / ci sym / ci outline / ci refs / ci doctor`)을 쓴다. 사전 활성화 없음.
  tmuxc wt <worktree-path> [same options as open]
  tmuxc fork <path> --name NEW_NAME (--from LIVE_SESSION | --source ID --agent claude|codex|opencode|cmd|pi) [--model ID] [--ctx 1m] [--effort E] [--role R] [--prompt TEXT] [--dry-run]
      네이티브 fork — 부모 대화를 건드리지 않고 새 세션ID로 분기한다 (claude --fork-session / codex fork / opencode --fork / cmd --fork-session / pi --fork).
      --from: 라이브 tmux 세션명에서 엔진·모델·effort·conversation id 를 그대로 조회 (--agent 는 교차엔진 검증용, 생략 가능)
      --source: conversation id 를 직접 지정 (이때 --agent 필수 — --last 류의 경쟁적 추론은 하지 않는다)
  tmuxc list
  tmuxc attach <name>
  tmuxc send <name> <message>
  tmuxc send <name> <message>        # 원격: tmuxc send mini/<name> MSG 또는 --host mini (도달 판정 = 원격 ft-reach-check)
  tmuxc submit <name> [--retype]  # 입력줄 판별 후 제출 — real / ghost-delivered(건드리지 말 것) / ghost-lost(유실, --retype 으로 되살림)
  tmuxc boot-enter <name>         # 이어가기: open·fork 가 넣은 부팅 문장이 입력줄에 «전문 그대로» 남았을 때만 Enter 1회 · 제출 판정 = 그 좌석 기록(--session-id) 한 파일
  tmuxc ask <name> [lines]        # 원격: --host mini (또는 mini/<name>)
  tmuxc list [--host H]           # 원격 목록은 HOST 열이 앞에 붙는다
  tmuxc open <path> --host H      # 경로는 «원격 경로» — 원격에 세션을 만든다
  tmuxc kill <name>               # 원격: --host mini / mini/<name> — HIL 그대로(삭제는 사람 확인)
  tmuxc model <name>              # 세션의 라이브 --model/--effort 조회 (증류 모델 승계용)
  tmuxc probe <name>              # 세션의 live agent/model/effort/session-id (KEY=VALUE)
  tmuxc msg <name> <message>
  tmuxc kill <name>
  tmuxc clean
  tmuxc save [--keep N] [--dry-run]   # 종료 전 전역 세션 스냅샷 (argv 기준 — [1m]/effort 보존)
  tmuxc restore [--from latest|PATH] [--scan] [--since HOURS] [--agent claude|codex|all] [--select 1,3,5|all|claude|codex|opencode|cmd|pi] [--baton] [--loose] [--go]

Defaults:
  agent: ${TMUXC_AGENT:-claude}
  role:  worker
  save:  ~/.tmuxc/snapshots/ (최근 ${TMUXC_SNAPSHOT_KEEP:-20}개 롤링 보관)

복원 우선순위: 스냅샷(tmuxc save) > 로그 스캔(--scan). 스냅샷만이 [1m]/effort/
opencode/cmd/pi 를 보존한다 — 트랜스크립트에는 [1m]·effort 가 기록되지 않는다.
pi 좌석은 tmuxc 가 --session-id 를 직접 발급하므로 스냅샷/restore 가 정확하다.
claude 좌석(open·fork)도 --session-id 를 발급한다 — 부팅 문장 제출 판정 = 그 id 의 기록 한 파일(r925).
--scan 은 claude/codex 만 지원한다(pi 는 스냅샷 경로 사용).
EOF
}

die() {
  printf 'tmuxc: %s\n' "$*" >&2
  exit 1
}

# Serena 은퇴(2026-10-22) — --serena 는 어느 명령·에이전트에서도 거부(rc 2 · 세션 열기 0).
die_serena_retired() {
  printf 'tmuxc: --serena 는 Serena 은퇴(10-22)로 없어졌다 — 코드 탐색은 ci(sym·refs·outline·search)\n' >&2
  exit 2
}

# ---------- claude 주입 «한 벌» (r1075 · arch#173 재판단 r2) ----------
# 판독·제출 판정 함수(capture_input_line·input_is_message·claude_jsonl_of·claude_submitted_since·agent_inject …)는
# core/libexec/agent-inject.sh 하나에 있다 — 로컬 open·fork 는 source 해서, 원격 send 는 h_pipe_write 로 «같은 파일을
# 원격 bash 가 실행» 해서 쓴다(복사본 두 벌 금지 · arch 재판단 r2).
AGENT_INJECT_LIB=""
agent_inject_lib() {
  [[ -n "$AGENT_INJECT_LIB" ]] && { printf '%s' "$AGENT_INJECT_LIB"; return 0; }
  local self d c
  self="$(readlink -f "$0" 2>/dev/null || printf '%s' "$0")"
  d="$(dirname "$self")"
  for c in "${TMUXC_AGENT_INJECT_LIB:-}" "$d/../libexec/agent-inject.sh" \
           "$HOME/.tmuxc/current/core/libexec/agent-inject.sh"; do
    if [[ -n "$c" && -f "$c" ]]; then AGENT_INJECT_LIB="$c"; printf '%s' "$c"; return 0; fi
  done
  return 1
}
agent_inject_lib >/dev/null || die 'core/libexec/agent-inject.sh 없음 — claude 주입 판정 불가(설치본 확인)'
# shellcheck source=/dev/null
. "$AGENT_INJECT_LIB"

# ---------- 호스트 라우팅 (r1047 · 설계 multihost DESIGN-tail-remote-and-light-git-20261028.md §1.4 보강 4·5) ----------
# 호스트를 «아는 유일한 자리» 는 tmm 의 host-lib.sh 다 — 여기서는 그 파일을 찾아 «별도 bash» 안에서 부른다.
# ★왜 별도 bash 인가★ — host-lib 는 첫 줄에서 `set +e` 를 한다. 이 파일에서 직접 source 하면 tmuxc 의
#  set -euo pipefail 이 풀려 기존 경로 전부의 실패 처리가 바뀐다(수술적 변경 위반).
HOSTLIB_PATH=""
hostlib_path() {
  [[ -n "$HOSTLIB_PATH" ]] && { printf '%s' "$HOSTLIB_PATH"; return 0; }
  local self d c
  self="$(readlink -f "$0" 2>/dev/null || printf '%s' "$0")"
  d="$(dirname "$self")"
  for c in "${TMUXC_HOSTLIB:-}" "$HOME/.tmm/current/core/libexec/host-lib.sh" \
           "$d/../../../tmm/core/libexec/host-lib.sh" \
           "$d/../../tmm/core/libexec/host-lib.sh"; do
    if [[ -n "$c" && -f "$c" ]]; then HOSTLIB_PATH="$c"; printf '%s' "$c"; return 0; fi
  done
  return 1
}

# hl <host-lib 함수> [인자…] — host-lib 함수를 별도 bash 에서 호출(rc 그대로). 없으면 97 = 판정 불가.
hl() {
  local lib
  lib="$(hostlib_path)" || return 97
  bash -c 'source "$1" >/dev/null 2>&1; shift; "$@"' _ "$lib" "$@"
}

local_host() {
  [[ -n "${_TMUXC_LOCAL_HOST:-}" ]] || _TMUXC_LOCAL_HOST="$(hl h_local_name 2>/dev/null)"
  printf '%s' "${_TMUXC_LOCAL_HOST:-m3}"
}

# 주소 분리 — 첫 '/' 만 구분자(계약 보강 5 ④: 둘째 '/' 는 좌석 이름 문자열로 남겨 lint 가 REJECT 하게 둔다).
addr_split() {
  case "$1" in
    */*) printf '%s %s\n' "${1%%/*}" "${1#*/}" ;;
    *)   printf '%s %s\n' "$(local_host)" "$1" ;;
  esac
}

# ft 도구 경로 — TMUXC_<종류> 환경변수 → 팩 사본 → 홈 사본.
ft_tool_path() {  # <env 값> <이름>
  local envv="$1" n="$2" self d c
  self="$(readlink -f "$0" 2>/dev/null || printf '%s' "$0")"
  d="$(dirname "$self")"
  for c in "$envv" "$d/../../../fable-team/harness/kit/fable-team/bin/$n" \
           "$HOME/.fable-team/bin/$n" "$HOME/.claude/skills/fable-team/bin/$n"; do
    [[ -n "$c" && -f "$c" ]] && { printf '%s' "$c"; return 0; }
  done
  return 1
}

# host_resolve <주소> [--host 값] — 0 = 원격 라우팅(R_HOST/R_SESS 채움) · 1 = 로컬(지금 동작 그대로).
# 순서 고정(계약 보강 5): ①분리 ②--host 와 접두 충돌이면 exit 2 ③좌석 부분만 ft-name-lint ④원격 판정.
host_resolve() {
  local addr="$1" flag="${2:-}" ah as h s lh kind lint out
  # ★빠른 길(R6)★ — --host 도 없고 접두(/) 도 없으면 로컬이다. host-lib 호출 0(기존 경로 속도 그대로).
  if [[ -z "$flag" && "$addr" != */* ]]; then R_HOST=""; R_SESS="$addr"; return 1; fi
  read -r ah as <<<"$(addr_split "$addr")"
  lh="$(local_host)"
  if [[ -n "$flag" ]]; then
    if [[ "$addr" == */* && "$ah" != "$flag" ]]; then
      printf 'tmuxc: 주소 접두(%s)와 --host(%s)가 다르다 — 사용법 오류\n' "$ah" "$flag" >&2
      exit 2
    fi
    h="$flag"
    if [[ "$addr" == */* ]]; then s="${addr#*/}"; else s="$addr"; fi
  else
    h="$ah"; s="$as"
  fi
  R_HOST="$h"; R_SESS="$s"
  kind="$(hl h_field "$h" kind 2>/dev/null)"
  if [[ "$h" == "$lh" && "$kind" != "tail-remote" ]]; then return 1; fi   # 로컬 = 기존 경로(R6)
  if [[ "$s" == */* ]]; then
    printf 'tmuxc: 좌석 이름에 "/" 가 둘 이상 있다 — 이름 규칙 위반(보내지 않는다)\n' >&2
    exit 1
  fi
  lint="$(ft_tool_path "${TMUXC_NAME_LINT:-}" ft-name-lint.sh)" || {
    printf 'tmuxc: ft-name-lint.sh 없음 — 이름 검증 불가(보내지 않는다)\n' >&2; exit 1; }
  out="$("$lint" "$s" 2>&1)" || { printf '%s\n' "$out" >&2; printf 'tmuxc: 이름 규칙 위반 — 보내지 않는다\n' >&2; exit 1; }
  return 0
}

# 송신 락 = <host>/<session> 쌍 하나 (설계 보강 4). /tmp 고정 금지 — HOME 안 ControlPath 폴더를 쓴다.
send_lock_path() { printf '%s/send-lock-%s-%s' "$(hl h_control_dir 2>/dev/null || printf '%s' "$HOME/.ssh/ft-cm")" "$1" "$2"; }

# 원격 송신 = 로컬 agent_inject 와 «같은 절차» 를 원격에서(r1075 · arch 재판단 r2).
#   ① 입력 상자 기다림(상한 TMUXC_READY_MAX 기본 30) ② 입력줄 = 전문일 때만 Enter ③ 그 좌석 --session-id 기록으로 제출 판정
#   ④ 절반 시점 재전송 1회 — 판독 함수는 agent-inject.sh «한 벌» 을 h_pipe_write 로 원격에 흘려 실행한다(복사본 0).
#   rc = 0 제출 확인 · 3 에이전트 없음 · 4 마감까지 기록 없음 · 5 판정 불가(상자 안 뜸·입력줄 불일치·판독 불가) ·
#        6 기록 id 없음(=보냈다 · 제출 판정은 호출자 ft-reach-check 몫) · 97 도구 없음
remote_send_locked() {  # <host> <sess> <text>
  local host="$1" sess="$2" text="$3" lock d lib rmax swait cap runcap
  lib="$(agent_inject_lib)" || { printf 'tmuxc: agent-inject.sh 없음 — 판정 불가\n' >&2; return 97; }
  lock="$(send_lock_path "$host" "$sess")"
  d="$(dirname "$lock")"
  mkdir -p "$d" 2>/dev/null || true; chmod 700 "$d" 2>/dev/null || true
  rmax="${TMUXC_READY_MAX:-30}"; [[ "$rmax" =~ ^[0-9]+$ ]] || rmax=30
  swait="${TMUXC_SUBMIT_WAIT:-7}"; [[ "$swait" =~ ^[0-9]+$ ]] || swait=7
  # 하드 룰 12: 쪼갤 수 없는 기다림 «하나» = min(고정비 + 7×배수, 70). 여기 = 상자 기다림 + 제출 마감 + 왕복.
  cap=$(( rmax + swait + 7 )); (( cap > 70 )) && cap=70
  runcap=$(( cap + 5 )); (( runcap > 70 )) && runcap=70
  ( export H_CALL_TIMEOUT="$cap" H_RUN_CAP="$runcap"
    hl _h_with_lock "$lock" h_pipe_write "$host" "$lib" "$sess" "$text" - "$rmax" "$swait" )
}

# 원격 도달 판정 = 그 호스트에서 돈 ft-reach-check.sh (계약 보강 5 · capture-pane 판정 금지).
# ★baseline 을 «보내기 전»에 잡는다★ — 기본 baseline 은 «호출 시점» 이라 jsonl 이 빨리 쓰이면 방금 쓴 내 기록이
#  baseline 에 섮여 NOT_REACHED 로 오판된다(ft-reach-check 헤더의 FT_REACH_COUNT_ONLY 계약).
remote_reach_baseline() {  # <host> <sess> <marker> → 제출 건수
  local host="$1" sess="$2" marker="$3" reach w rc
  reach="$(ft_tool_path "${TMUXC_REACH_CHECK:-}" ft-reach-check.sh)" || return 97
  w="$(mktemp "${TMPDIR:-/tmp}/tmuxc-reach-count.XXXXXX")" || return 97
  { printf 'export FT_REACH_COUNT_ONLY=1\n'; cat "$reach"; } > "$w"
  hl h_pipe "$host" "$w" "$sess" "$marker"; rc=$?
  rm -f "$w"
  return "$rc"
}
remote_reach_check() {  # <host> <sess> <marker> [baseline]
  local host="$1" sess="$2" marker="$3" base="${4:-}" reach to
  reach="$(ft_tool_path "${TMUXC_REACH_CHECK:-}" ft-reach-check.sh)" || {
    printf 'tmuxc: ft-reach-check.sh 없음 — 도달 판정 불가\n' >&2; return 5; }
  to="${TMUXC_REACH_TIMEOUT:-6}"
  hl h_pipe "$host" "$reach" "$sess" "$marker" "$to" "$base"
}

prepare_color_environment() {
  unset NO_COLOR || true
  tmux set-environment -gu NO_COLOR 2>/dev/null || true
}

create_tmux_session() {
  local name="$1"
  local root="$2"
  shift 2
  # 나머지 인자 = 그 세션에만 심을 추가 env(KEY=VALUE) — r476 opencode 모델(OPENCODE_CONFIG_CONTENT)
  local env_args=() kv
  for kv in "$@"; do env_args+=(-e "$kv"); done
  prepare_color_environment
  # r448: 좌석 표식 FT_SEAT=<세션명> — 생성 «때» 심어야 첫 셸·에이전트·그 자손이 물려받는다(뒤에 set-environment 는 이미 뜬 셸에 안 닿음 · 실측). ft-seat-reap 이 ppid 1 고아의 주인을 이 값으로 찾는다.
  tmux new-session -d -s "$name" -c "$root" -e "FT_SEAT=$name" ${env_args[@]+"${env_args[@]}"} || return 1
  # ★detached 생성은 창 옵션을 window-size=manual(80x24) 로 박는다★ — 나중에 큰 클라이언트가 붙어도 안 커지고
  #   오른쪽·아래가 점으로 채워진다(2026-09-09 실측: 재부팅 후 스폰된 25좌석 전부). 창 옵션을 풀어 서버 기본(latest)을 따른다.
  tmux set -wu -t "=$name:" window-size 2>/dev/null || true
}

sanitize_name() {
  local raw="$1"
  raw="${raw// /-}"
  raw="${raw//:/-}"
  raw="${raw//./-}"
  printf '%s' "$raw" | LC_ALL=C tr -cd 'A-Za-z0-9_#-'
}

repo_root_for() {
  local path="$1"
  local root
  root="$(git -C "$path" rev-parse --show-toplevel 2>/dev/null || true)"
  if [[ -n "$root" ]]; then
    printf '%s\n' "$root"
  else
    cd "$path" && pwd
  fi
}

# (제거 0.4.9) serena_project_for·ensure_serena — Serena 은퇴로 공유서버(9493) 자체가 없다.
#   대체 = code-intel 스킬(`ci`). 좌석 기동 전에 켤 것이 없다.

role_alias() {
  case "${1:-worker}" in
    worker|analysis|analyze|log|logs|doc|docs|review|verify|verifier|check|bts|architect-check|architecture-check) printf 'ccs' ;;
    orchestrator|orch|implementer|implement|implementation|planner|plan|planning|designer|architect|strategy|strategist) printf 'ccd' ;;
    crew|plugin) printf '__crew__' ;;  # zshrc alias 무의존 — resolve_claude_cmd가 직접 합성 (2026-07-13 이슈: 크루가 ccd=opus-4-8[1m] high로 오폴백)
    *) die "unknown role: $1" ;;
  esac
}

# crew/plugin role 고정 스펙 — claude 플러그인 크루(agent-cli·omo·gstack 등) 드라이버 자식 세션.
# fable-team crew-support.md 계약(claude-sonnet-4-6 + medium)과 정합. --model/--effort 명시가 항상 우선.
CREW_MODEL="claude-sonnet-4-6"
CREW_EFFORT="medium"

# --ctx 컨텍스트 창 선택자 — 모델 ID에 "[1m]" 형태로 덧붙인다.
# 1m 을 alias 존재(ccs1m 등)에 의존하지 않는 명시 축으로 올린다: role_alias() 에는
# 1m 경로가 없어 --role worker 는 어떤 방법으로도 1m 을 못 얻던 문제(2026-08 실증)의 대응.
# 멱등 — 이미 [..] 가 붙은 모델에는 덧붙이지 않는다.
apply_ctx_window() {
  local model="$1" ctx="${2:-}"
  [[ -n "$ctx" ]] || { printf '%s' "$model"; return 0; }
  [[ "$model" == *'['*']' ]] && { printf '%s' "$model"; return 0; }
  printf '%s[%s]' "$model" "$ctx"
}

# alias 본문의 `--model X` / `--model "X"` 를 `--model "X[ctx]"` 로 치환한다.
# 치환은 오프셋 슬라이싱으로만 한다 — ${var/pat/rep} 는 모델의 "[1m]" 을 글롭
# 문자클래스로 해석해 조용히 어긋난다.
alias_body_apply_ctx() {
  local body="$1" ctx="${2:-}"
  [[ -n "$ctx" ]] || { printf '%s' "$body"; return 0; }
  [[ "$body" == *"--model "* ]] || die "--ctx: alias 본문에서 --model 을 찾지 못했습니다: $body"
  local pre rest m post
  pre="${body%%--model *}"
  rest="${body#*--model }"
  if [[ "$rest" == '"'* ]]; then
    m="${rest#\"}"; m="${m%%\"*}"
    post="${rest:$(( ${#m} + 2 ))}"
  else
    m="${rest%% *}"
    post="${rest:${#m}}"
  fi
  [[ -n "$m" ]] || die "--ctx: alias 본문의 --model 값이 비어 있습니다: $body"
  printf '%s--model "%s"%s' "$pre" "$(apply_ctx_window "$m" "$ctx")" "$post"
}

zsh_alias_body() {
  local alias_name="$1"
  local out
  out="$(zsh -ic "type $alias_name" 2>/dev/null || true)"
  if [[ "$out" == *" is an alias for "* ]]; then
    printf '%s\n' "${out#* is an alias for }"
  elif command -v "$alias_name" >/dev/null 2>&1; then
    printf '%s\n' "$alias_name"
  else
    return 1
  fi
}

resolve_zsh_alias_chain() {
  local alias_name="$1"
  local body
  local depth=0
  local current="$alias_name"
  while [[ "$depth" -lt 6 ]]; do
    body="$(zsh_alias_body "$current" || true)"
    [[ -n "$body" ]] || return 1
    if [[ "$body" =~ ^[A-Za-z_][A-Za-z0-9_-]*$ ]]; then
      current="$body"
      depth=$((depth + 1))
      continue
    fi
    printf '%s\n' "$body"
    return 0
  done
  die "alias chain too deep: $alias_name"
}

resolve_claude_cmd() {
  local name="$1"
  local role="$2"
  local model="${3:-}"
  local effort="${4:-}"
  local ctx="${5:-}"
  # 명시적 --model 오버라이드: role_alias/zsh alias 체인을 우회하고 headroom 기동
  # 커맨드를 직접 합성한다 (ft-tmux-spawn.sh raw_launch_fallback과 동일 방식 — 방식 분기 금지).
  # 모델 문자열의 [1m] 창 선택자는 큰따옴표로 보존한다(cc/ccs1m alias와 동일 인용 → 글롭 방지).
  if [[ -n "$model" ]]; then
    local cmd
    cmd="$HOME/.headroom/claude-hr.sh --dangerously-skip-permissions --model \"$(apply_ctx_window "$model" "$ctx")\""
    [[ -n "$effort" ]] && cmd="$cmd --effort $effort"
    printf '%s --name %q --remote-control %q' "$cmd" "$name" "$name"
    return 0
  fi
  local alias_name
  alias_name="$(role_alias "$role")"
  # crew/plugin role: alias 체인 대신 고정 스펙 직접 합성 (--model 오버라이드 분기와 동일 방식)
  if [[ "$alias_name" == "__crew__" ]]; then
    local cmd
    cmd="$HOME/.headroom/claude-hr.sh --dangerously-skip-permissions --model \"$(apply_ctx_window "$CREW_MODEL" "$ctx")\" --effort ${effort:-$CREW_EFFORT}"
    printf '%s --name %q --remote-control %q' "$cmd" "$name" "$name"
    return 0
  fi
  local body
  body="$(resolve_zsh_alias_chain "$alias_name" || true)"
  if [[ -z "$body" ]]; then
    die "missing Claude alias for role '$role': $alias_name"
  fi
  # --ctx 는 alias 본문의 모델을 그 자리에서 승격한다 — ccs1m 같은 특정 alias 존재에
  # 의존하지 않으므로 zshrc 를 건드리지 않고 모든 role 에서 1m 이 가능해진다.
  body="$(alias_body_apply_ctx "$body" "$ctx")"
  printf '%s --name %q --remote-control %q' "$body" "$name" "$name"
}

resolve_codex_cmd() {
  local agent="$1"
  local role="$2"
  local model="${3:-}"
  local effort="${4:-}"
  local fast="${5:-}"
  # codex 전용 오버라이드 3축 — 전부 -c key=value 로 «그 프로세스에만» 적용(전역 config.toml 불변):
  #   model  : -c model="ID"
  #   effort : -c model_reasoning_effort="E"  (명시 없으면 role 매핑 worker=medium / orch·verifier·architect=high)
  #   fast   : -c service_tier="priority"|"default"  (codex TUI 의 /fast 가 바꾸는 키 — 세션 로그 실측 2026-09-09.
  #            config.toml 의 fast_default_opt_out=true 면 새 세션은 off 로 뜨므로 좌석마다 손으로 켜야 했다)
  local model_opt="" fast_opt="" role_effort
  [[ -n "$model" ]] && model_opt=" -c model=\"$model\""
  case "$fast" in on|1|true) fast_opt=' -c service_tier="priority"' ;; off|0|false) fast_opt=' -c service_tier="default"' ;; "") ;; *) die "--fast 는 on|off (got: $fast)" ;; esac
  case "$agent" in
    codex)
      case "$role" in
        worker|crew|plugin) role_effort=medium ;;
        orchestrator|orch|verify|verifier|designer|architect|strategy|strategist) role_effort=high ;;
        *) die "unknown role: $role" ;;
      esac
      printf 'codex --dangerously-bypass-approvals-and-sandbox -c model_reasoning_effort="%s"%s%s' "${effort:-$role_effort}" "$model_opt" "$fast_opt"
      ;;
    omx)
      case "$role" in
        worker) printf 'omx --madmax' ;;
        orchestrator|orch|verify|verifier|designer|architect|strategy|strategist) printf 'omx --madmax --high' ;;
        *) die "unknown role: $role" ;;
      esac
      ;;
    *) die "unsupported codex agent: $agent" ;;
  esac
}

# opencode 는 role→effort 매핑이 없다(reasoning effort 개념 부재) — 모델이 유일한 등급 축이다.
# 따라서 role 은 받되 커맨드에 반영하지 않는다.
# --auto: 명시적으로 deny 되지 않은 권한을 자동 승인. claude 의 --dangerously-skip-permissions,
# codex 의 --dangerously-bypass-approvals-and-sandbox 와 같은 자리 — tmuxc 세션은 워커용이라
# 매 승인에 사람이 붙지 않는 것이 전제다.
# r476: opencode 2.0.32 TUI 최상위에는 --model 이 없다(run 서브명령 전용 → «Unrecognized flag: --model» 기동 실패).
#   모델은 플래그가 아니라 세션 생성 때 env OPENCODE_CONFIG_CONTENT 로 심는다(opencode_session_env).
resolve_opencode_cmd() {
  printf '%s' "opencode --auto"
}

# opencode 좌석 모델 → 세션 env 1칸(KEY=VALUE). 모델 미지정이면 출력 0 — opencode 기본값(설정/최근 사용)을 따른다.
# 글로벌 ~/.config/opencode/opencode.json·워크트리 파일은 건드리지 않는다 — env 는 그 tmux 세션에만 닿는다.
opencode_session_env() {
  local model="${1:-}"
  [[ -n "$model" ]] || return 0
  printf 'OPENCODE_CONFIG_CONTENT=%s' \
    "$(python3 -c 'import json,sys;print(json.dumps({"model":sys.argv[1]},separators=(",",":")))' "$model")"
}

# Command Code(commandcode.ai, 바이너리 `cmd`) 는 --model 과 --effort 를 둘 다 받는다.
# 단 --help 가 effort 를 "depends on the model" 로 명시한다 — 오픈모델 다수가 reasoning
# effort 개념이 없으므로 role→effort 를 자동 주입하지 않는다(미지원 모델에서 조용히 깨진다).
# effort 는 명시로 넘어올 때만 붙이고, role 은 받되 커맨드에 반영하지 않는다.
# --yolo: 권한 프롬프트 전량 우회(=--dangerously-skip-permissions). claude 의 같은 자리.
# --trust: 프로젝트 신뢰 프롬프트 스킵. --skip-onboarding: taste 온보딩 스킵(자동화용).
resolve_cmdcode_cmd() {
  local name="$1"
  local model="${2:-}"
  local effort="${3:-}"
  local cc="cmd --yolo --trust --skip-onboarding --name $(printf '%q' "$name")"
  # 모델 미지정이면 Command Code 기본값(deepseek-v4-flash)을 따른다 — 임의 기본값을 박지 않는다.
  [[ -n "$model" ]]  && cc="$cc --model $(printf '%q' "$model")"
  [[ -n "$effort" ]] && cc="$cc --effort $(printf '%q' "$effort")"
  printf '%s' "$cc"
}

# Pi coding agent (pi) — minimal harness. tmuxc passes an explicit session id so
# snapshot/restore and fork can recover the exact conversation.
# Role mapping: worker/implementer gets write tools; planner/orchestrator/reviewer read-only.
resolve_pi_cmd() {
  local name="$1"
  local role="$2"
  local model="${3:-}"
  local effort="${4:-}"
  local tools thinking sid
  case "$role" in
    worker|implementer|crew|plugin) tools="read,bash,edit,write,grep,find,ls" ;;
    orchestrator|orch|planner|analysis|verify|verifier|designer|architect|strategy|strategist) tools="read,grep,find,bash" ;;
    *) tools="read,grep,find,bash" ;;
  esac
  thinking="${effort:-medium}"
  sid="${TMUXC_PI_SESSION_ID:-$(python3 -c 'import uuid;print(uuid.uuid4())' 2>/dev/null)}"
  local cmd="pi --name $(printf '%q' "$name") --session-id $(printf '%q' "$sid") --tools $tools --thinking $(printf '%q' "$thinking")"
  [[ -n "$model" ]] && cmd="$cmd --model $(printf '%q' "$model")"
  printf '%s' "$cmd"
}

# ─ (제거) pi --serena · serena 공유서버 ensure ────────────────────────────────
#   0.4.9: Serena 은퇴(2026-10-22 · 공유서버 9493 종료 · claude/codex MCP 등록 제거 · Phase 4 관측).
#   대체 = 하네스 공통 code-intel 스킬(`ci search/sym/outline/refs/doctor`). 사전 활성화·인덱싱 절차 없음.
#   남겨 둔 것: 아무것도 없다 — 좌석이 스스로 serena 를 스폰하지 않도록 «쓰기·ensure» 를 전부 없앴다.

agent_cmd() {
  local agent="$1"
  local name="$2"
  local role="$3"
  local model="${4:-}"
  local effort="${5:-}"
  local ctx="${6:-}"
  local fast="${7:-}"
  case "$agent" in
    claude) resolve_claude_cmd "$name" "$role" "$model" "$effort" "$ctx" ;;
    codex|omx) resolve_codex_cmd "$agent" "$role" "$model" "$effort" "$fast" ;;
    opencode) resolve_opencode_cmd "$model" ;;
    cmd) resolve_cmdcode_cmd "$name" "$model" "$effort" ;;
    pi) resolve_pi_cmd "$name" "$role" "$model" "$effort" ;;
    *) die "unknown agent: $agent" ;;
  esac
}

# ---------- fork: 네이티브 분기 (부모 대화 불변, 자식은 새 conversation id) ----------
#
# 4엔진 각각의 «네이티브 fork» 플래그 (2026-09-13 --help 실측, --last 류 경쟁 추론 없음):
#   claude    : --resume <ID> --fork-session   (신규 세션ID 발급, 원본 이어쓰기 아님)
#   codex     : codex fork <SESSION_ID> [PROMPT]  (0.154.0 --help; -c model=/-c model_reasoning_effort= 그대로 통함)
#   opencode  : --session <ID> --fork             (1.18.20 --help; --continue --fork 도 가능하나 경쟁 축이라 미사용)
#   cmd       : --resume <ID> --fork-session       (1.41.0 --help; --session 은 fork 계약에 없음)
# omx 는 fork 근거 없음 — 대상에서 제외(TASK 범위: claude/codex/opencode/cmd).

resolve_claude_fork_cmd() {
  local name="$1" source_id="$2" model="${3:-}" effort="${4:-}" ctx="${5:-}"
  local cmd
  cmd="$HOME/.headroom/claude-hr.sh --dangerously-skip-permissions --resume $(printf '%q' "$source_id") --fork-session"
  [[ -n "$model"  ]] && cmd="$cmd --model \"$(apply_ctx_window "$model" "$ctx")\""
  [[ -n "$effort" ]] && cmd="$cmd --effort $effort"
  printf '%s --name %q --remote-control %q' "$cmd" "$name" "$name"
}

resolve_codex_fork_cmd() {
  local role="$1" source_id="$2" model="${3:-}" effort="${4:-}"
  local role_effort model_opt=""
  case "$role" in
    worker|crew|plugin) role_effort=medium ;;
    orchestrator|orch|verify|verifier|designer|architect|strategy|strategist) role_effort=high ;;
    *) die "unknown role: $role" ;;
  esac
  [[ -n "$model" ]] && model_opt=" -c model=\"$model\""
  printf 'codex fork %s --dangerously-bypass-approvals-and-sandbox -c model_reasoning_effort="%s"%s' \
    "$(printf '%q' "$source_id")" "${effort:-$role_effort}" "$model_opt"
}

# 모델은 여기서 붙이지 않는다 — open 과 같이 opencode_session_env 가 세션 env 로 심는다(r476).
resolve_opencode_fork_cmd() {
  local source_id="$1"
  printf '%s' "opencode --auto --session $(printf '%q' "$source_id") --fork"
}

resolve_cmdcode_fork_cmd() {
  local name="$1" source_id="$2" model="${3:-}" effort="${4:-}"
  local cc="cmd --yolo --trust --skip-onboarding --name $(printf '%q' "$name") --resume $(printf '%q' "$source_id") --fork-session"
  [[ -n "$model"  ]] && cc="$cc --model $(printf '%q' "$model")"
  [[ -n "$effort" ]] && cc="$cc --effort $(printf '%q' "$effort")"
  printf '%s' "$cc"
}

# pi --fork <source> creates a new conversation; --session-id pins the child id
# so snapshot/restore and later forks can address it deterministically.
resolve_pi_fork_cmd() {
  local name="$1" source_id="$2" model="${3:-}" effort="${4:-}"
  local sid
  sid="${TMUXC_PI_SESSION_ID:-$(python3 -c 'import uuid;print(uuid.uuid4())' 2>/dev/null)}"
  local cmd="pi --fork $(printf '%q' "$source_id") --session-id $(printf '%q' "$sid") --name $(printf '%q' "$name")"
  [[ -n "$model"  ]] && cmd="$cmd --model $(printf '%q' "$model")"
  [[ -n "$effort" ]] && cmd="$cmd --thinking $(printf '%q' "$effort")"
  printf '%s' "$cmd"
}

agent_fork_cmd() {
  local agent="$1" name="$2" role="$3" source_id="$4" model="${5:-}" effort="${6:-}" ctx="${7:-}"
  case "$agent" in
    claude)   resolve_claude_fork_cmd "$name" "$source_id" "$model" "$effort" "$ctx" ;;
    codex)    resolve_codex_fork_cmd "$role" "$source_id" "$model" "$effort" ;;
    opencode) resolve_opencode_fork_cmd "$source_id" "$model" ;;
    cmd)      resolve_cmdcode_fork_cmd "$name" "$source_id" "$model" "$effort" ;;
    pi)       resolve_pi_fork_cmd "$name" "$source_id" "$model" "$effort" ;;
    *) die "fork not supported for agent: $agent (claude|codex|opencode|cmd|pi only)" ;;
  esac
}

# --source 로 직접 준 conversation id 가 그 엔진의 저장소에 실재하는지 best-effort 확인.
# 헬퍼/저장소가 없으면(구성 안 된 엔진) 판별 불가 = fail-open — «모른다»를 «없다»로 단정하지 않는다.
# --from 경로는 이미 실제 트랜스크립트를 찾아 sid 를 얻은 것이라 이 확인이 불필요하다.
source_id_known_to_engine() {
  local agent="$1" sid="$2"
  local helper
  # pi sessions are JSONL files named <timestamp>_<uuid>.jsonl — no custom helper needed.
  if [[ "$agent" == "pi" ]]; then
    if find "$HOME/.pi/agent/sessions" -type f -name "*${sid}*.jsonl" 2>/dev/null | grep -q .; then
      printf 'found\n'
    else
      printf 'not-found\n'
    fi
    return 0
  fi
  helper="$(snapshot_helper_py)"
  [[ -f "$helper" ]] || return 2
  python3 "$helper" exists "$agent" "$sid" 2>/dev/null
}

# 세션의 라이브 claude 프로세스 argv에서 --model/--effort 를 회수한다.
# 트랜스크립트의 "model" 필드는 [1m] 창 선택자·effort를 담지 않으므로(실측 확인),
# 프로세스 argv가 유일한 authoritative 소스다. 라이브 세션에만 유효.
# 출력: "model=<id>" (+ 있으면 "effort=<e>"), 회수 실패 시 비-0 종료.
session_live_launch() {
  local sess="$1"
  tmux has-session -t "$sess" 2>/dev/null || return 1
  local ppid
  ppid="$(tmux list-panes -t "$sess" -F '#{pane_pid}' 2>/dev/null | head -1)"
  [[ -n "$ppid" ]] || return 1
  local pids pid cmd model="" effort=""
  pids="$ppid $(pgrep -P "$ppid" 2>/dev/null || true) $(pgrep -g "$ppid" 2>/dev/null || true)"
  for pid in $pids; do
    cmd="$(ps -o command= -p "$pid" 2>/dev/null || true)"
    [[ "$cmd" == *--model* ]] || continue
    local -a toks=()
    read -ra toks <<< "$cmd"
    local tok prev=""
    for tok in "${toks[@]}"; do
      [[ "$prev" == "--model" ]] && model="$tok"
      [[ "$prev" == "--effort" ]] && effort="$tok"
      prev="$tok"
    done
    [[ -n "$model" ]] && break
  done
  [[ -n "$model" ]] || return 1
  printf 'model=%s\n' "$model"
  [[ -n "$effort" ]] && printf 'effort=%s\n' "$effort"
  return 0
}

# kind = shell·plain(종전 그대로 — 확인 없음) · agent(Claude TUI — 위 agent_inject · 4번째 인자 = 발급한 --session-id 필수)
#   agent 는 open·fork 가 방금 만든 claude 세션에만 쓴다. send·restore 등 나머지 호출은 종전 그대로(r925 P3).
inject_message() {
  local session="$1"
  local message="$2"
  local kind="${3:-plain}"
  if [[ "$kind" != "agent" ]]; then
    tmux send-keys -t "$session" -l "$message"
    sleep 0.3
    tmux send-keys -t "$session" Enter
    return
  fi
  local sid="${4:-}" pane
  [[ -n "$sid" ]] || { printf 'state=no-session-id session=%s — 세션 기록 id 없음, 주입 0\n' "$session" >&2; return 1; }
  pane="$(pane_id_of "$session")"
  [[ -n "$pane" ]] || pane="$session"
  agent_inject "$session" "$pane" "$message" "$sid"
}

# 세션 env 값 한 개(tmuxc 가 open·fork 때 심은 것) — 없으면 rc1.
session_env_value() {
  local out
  out="$(tmux show-environment -t "=$1" "$2" 2>/dev/null)" || return 1
  [[ "$out" == "$2="* ]] || return 1
  printf '%s\n' "${out#"$2"=}"
}

# 세션 env 에 id 가 없을 때의 좌석 기록 id(r925 r4) — resume 파일(~/.claude/state/seat-resume/<좌석>.json 의 uuid) → 명부(seats*.json 그 좌석 행의 uuid).
#   명부 폴더 = TMUXC_SEATS_DIR 또는 그 좌석 pane 작업 폴더 리포의 .fable-team · 전수 스캔 0 · 없으면 rc1.
seat_uuid_fallback() {
  local name="$1" resume dir="${TMUXC_SEATS_DIR:-}" path root
  resume="${TMUXC_SEAT_RESUME_DIR:-$HOME/.claude/state/seat-resume}/$name.json"
  if [[ -z "$dir" ]]; then
    path="$(tmux display-message -p -t "=$name:" '#{pane_current_path}' 2>/dev/null)" || path=""
    root=""
    [[ -n "$path" ]] && root="$(git -C "$path" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" || root=""
    [[ -n "$root" ]] && dir="${root%/.git}/.fable-team"
  fi
  python3 - "$resume" "$dir" "$name" <<'PY'
import glob, json, os, re, sys
resume, d, name = sys.argv[1:4]
ok = re.compile(r"^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$")
def pick(row):
    if not isinstance(row, dict) or row.get("name", name) != name:
        return None
    u = row.get("uuid")
    return u if isinstance(u, str) and ok.match(u) else None
try:
    with open(resume, encoding="utf-8") as fh:
        u = pick(json.load(fh))
except (OSError, ValueError):
    u = None
if u:
    print(u); sys.exit(0)
if d:
    for f in sorted(glob.glob(os.path.join(glob.escape(d), "seats*.json"))):
        try:
            with open(f, encoding="utf-8") as fh:
                data = json.load(fh)
        except (OSError, ValueError):
            continue
        u = pick(data.get(name)) if isinstance(data, dict) else None
        if u:
            print(u); sys.exit(0)
sys.exit(1)
PY
}

# boot-enter <세션> (r925 r4) — 이어가기(ft-successor-open 재실행): open·fork 가 넣은 부팅 문장이 아직 입력줄에 «전문 그대로» 남았으면 Enter 1회.
#   근거 = 기록 id(세션 env TMUXC_CLAUDE_SESSION_ID → resume 파일 → 명부) + 넣은 전문(세션 env TMUXC_BOOT_TEXT). 없으면 판정 0.
#   제출 판정 = Enter 누르기 «직전» 그 기록의 파일 끝 뒤에 쓰인 user 레코드만(옛 레코드는 앞 30자가 같아도 증거 아님).
#   rc0 = 이번 Enter 로 기록됨 · rc1 = Enter 1회 뒤 마감(TMUXC_SUBMIT_WAIT초 벽시계)까지 기록 없음(재전송 0)
#   rc2 = 판독 불가(입력줄 못 찾음 · capture rc≠0 · 기록 판정 불가) · rc3 = 근거 없음 · rc4 = 입력줄이 전문이 아니다(Enter 0 · 하드 룰 10)
cmd_boot_enter() {
  local name="${1:-}" sid text pane off st sub now t_end wait_s="${TMUXC_SUBMIT_WAIT:-7}"
  [[ -n "$name" ]] || die "boot-enter requires <name>"
  [[ "$wait_s" =~ ^[0-9]+$ ]] || die "TMUXC_SUBMIT_WAIT=$wait_s 정수 아님"
  tmux has-session -t "=$name" 2>/dev/null || die "session not found: $name"
  sid="$(session_env_value "$name" TMUXC_CLAUDE_SESSION_ID)" || sid=""
  [[ -n "$sid" ]] || sid="$(seat_uuid_fallback "$name")" || sid=""
  text="$(session_env_value "$name" TMUXC_BOOT_TEXT)" || text=""
  if [[ -z "$sid" || -z "$text" ]]; then
    printf '[HIL] 세션 기록 못 찾음 — %s 의 기록 id(세션 env·resume 파일·명부) 또는 TMUXC_BOOT_TEXT 가 없다 · Enter 0\n' "$name" >&2
    return 3
  fi
  pane="$(pane_id_of "$name")"
  [[ -n "$pane" ]] || { printf '[HIL] 입력줄 판독 불가 — %s pane 없음 · Enter 0\n' "$name" >&2; return 2; }
  st=0; input_is_message "$pane" "$text" || st=$?
  if [[ "$st" -eq 2 ]]; then
    printf '[HIL] 입력줄 판독 불가 — %s (권한 프롬프트·화면 못 읽음) · Enter 0\n' "$name" >&2
    return 2
  fi
  if [[ "$st" -ne 0 ]]; then
    printf '[HIL] 입력줄이 부팅 문장 전문이 아니다 — %s · Enter 0(남의 글자·자동완성 제안·빈 줄)\n' "$name" >&2
    return 4
  fi
  off="$(claude_jsonl_size "$sid")" || { printf '[HIL] 세션 기록 판정 불가 — %s · Enter 0\n' "$name" >&2; return 2; }
  now="$(now_ms)"; t_end=$(( now + wait_s * 1000 ))
  tmux send-keys -t "$pane" Enter
  while :; do
    sub=0; claude_submitted_since "$sid" "$off" "$text" || sub=$?
    case "$sub" in
      0) printf 'state=submitted session=%s enters=1\n' "$name"; return 0 ;;
      2) printf '[HIL] 세션 기록 판정 불가 — %s · Enter 1회 뒤\n' "$name" >&2; return 2 ;;
    esac
    now="$(now_ms)"
    (( now < t_end )) || break
    sleep 0.2
  done
  printf '[HIL] 부팅 문장 제출 확인 실패 — %s · Enter 1회 · %s초 안에 기록 없음(재전송 0)\n' "$name" "$wait_s" >&2
  return 1
}

# 원격 세션 열기 (r1047 · 설계 「열기」 행) — new-session + 에이전트 명령 주입을 «한 ssh(쓰기)» 로.
# ★로컬 파일 의존 0★: worktree·snapshot 은 원격에서 하지 않는다(카드3·후속).
open_remote() {  # <host> <path> <root> <name> <agent> <role> <model> <effort> <ctx> <fast> <dry_run> <prompt>
  local host="$1" path="$2" root="$3" name="$4" agent="$5" role="$6" model="$7" effort="$8" ctx="$9" fast="${10}" dry_run="${11}" prompt="${12:-}"
  local run_cmd
  run_cmd="$(agent_cmd "$agent" "$name" "$role" "$model" "$effort" "$ctx" "$fast" 0)"
  # r1047 r2: agent_cmd 는 «이 맥» 기준으로 $HOME 을 풀어 놓는다 — 그대로 보내면 원격 pane 이 없는
  # 로컬 경로(/Users/<로컬>/.headroom/…)를 실행한다(h135 실측). 접두를 글자 «$HOME» 으로 바꿔
  # 원격 pane 셸이 풀게 한다. dry-run 출력도 같은 글자를 보인다.
  run_cmd="${run_cmd//"$HOME"/\$HOME}"
  # r1075: claude 도 로컬 open 과 «같게» --session-id 를 발급하고 원격 세션 env 에 심는다 —
  #   원격 송신의 제출 판정(agent-inject.sh ③)과 ft-reach-check 의 좌석 파일 특정이 이 값을 쓴다(반례 R4).
  #   ★dry-run 출력보다 앞★ 에 붙여야 --dry-run 으로도 계약을 볼 수 있다.
  local claude_sid=""
  if [[ "$agent" == "claude" ]]; then
    claude_sid="$(python3 -c 'import uuid;print(uuid.uuid4())')" || die "claude --session-id 발급 실패(python3 uuid)"
    run_cmd="$run_cmd --session-id $claude_sid"
  fi
  local rc=0
  hl h_run "$host" --idempotent test -d "$path" || rc=$?
  case "$rc" in
    0) ;;
    1) die "원격 경로 없음: $host:$path" ;;
    *) die "원격 경로 확인 불가: $host:$path rc=$rc" ;;
  esac
  if [[ "$dry_run" -eq 1 ]]; then
    printf 'host=%s\nsession=%s\nroot=%s\nagent=%s\nrole=%s\ncommand=%s\n' \
      "$host" "$name" "$root" "$agent" "$role" "$run_cmd"
    return 0
  fi
  local envp=()
  [[ "$agent" == "pi" ]] && envp=("TMUXC_PI_MODEL=${model:-}" "TMUXC_PI_THINKING=${effort:-medium}")
  [[ -n "$claude_sid" ]] && envp+=("TMUXC_CLAUDE_SESSION_ID=$claude_sid")
  hl _h_with_lock "$(send_lock_path "$host" "$name")" h_run "$host" --write bash -c '
name=$1; root=$2; run=$3; prompt=$4; shift 4
if tmux has-session -t "$name" 2>/dev/null; then echo "tmuxc: session already exists: $name" >&2; exit 1; fi
tmux new-session -d -s "$name" -c "$root" -e "FT_SEAT=$name" || exit 1
tmux set -wu -t "=$name:" window-size 2>/dev/null
for kv in "$@"; do tmux set-environment -t "$name" "${kv%%=*}" "${kv#*=}" 2>/dev/null; done
tmux send-keys -t "$name" -l "$run" || exit 1
sleep 0.3
tmux send-keys -t "$name" Enter || exit 1
if [ -n "$prompt" ]; then sleep 0.8; tmux send-keys -t "$name" -l "$prompt"; sleep 0.3; tmux send-keys -t "$name" Enter; fi
' _ "$name" "$root" "$run_cmd" "$prompt" ${envp[@]+"${envp[@]}"} || rc=$?
  if [[ "$rc" -ne 0 ]]; then
    printf 'tmuxc: %s open 실패 rc=%s\n' "$host" "$rc" >&2
    return "$rc"
  fi
  printf 'tmuxc open created (host=%s)\nsession=%s\nroot=%s\nagent=%s\nrole=%s\ncommand=%s\nattach=ssh -t %s tmux attach -t %s\n' \
    "$host" "$name" "$root" "$agent" "$role" "$run_cmd" "$(hl h_field "$host" ssh_alias 2>/dev/null)" "$name"
  return 0
}

cmd_open() {
  local path=""
  local name=""
  local agent="${TMUXC_AGENT:-claude}"
  local role="${TMUXC_ROLE:-worker}"
  local prompt=""
  local dry_run=0
  local model=""
  local effort=""
  local like=""
  local ctx=""
  local fast=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --fast) fast="${2:-on}"; case "$fast" in on|off|1|0|true|false) shift 2 ;; *) fast=on; shift ;; esac ;;
      --name) name="${2:-}"; shift 2 ;;
      --agent) agent="${2:-}"; shift 2 ;;
      --role) role="${2:-}"; shift 2 ;;
      --model) model="${2:-}"; shift 2 ;;
      --ctx) ctx="${2:-}"; shift 2 ;;
      --effort) effort="${2:-}"; shift 2 ;;
      --like) like="${2:-}"; shift 2 ;;
      --prompt) prompt="${2:-}"; shift 2 ;;
      --serena) die_serena_retired ;;
      --host) TMUXC_HOST="${2:-}"; shift 2 ;;
      --host=*) TMUXC_HOST="${1#--host=}"; shift ;;
      --dry-run) dry_run=1; shift ;;
      --help|-h) usage; exit 0 ;;
      --*) die "unknown option for open: $1" ;;
      *)
        if [[ -z "$path" ]]; then
          path="$1"; shift
        else
          die "unexpected argument: $1"
        fi
        ;;
    esac
  done

  [[ -n "$path" ]] || die "open requires <path>"
  local remote_open=0
  if [[ -n "${TMUXC_HOST:-}" ]] && [[ "$(local_host)" != "$TMUXC_HOST" ]]; then remote_open=1; fi
  # 원격 좌석의 경로는 «원격 경로» 다 — 이 맥에서 -d 로 볼 수 없다(존재 확인은 원격에서).
  [[ "$remote_open" -eq 1 ]] || [[ -d "$path" ]] || die "path does not exist: $path"

  local root
  if [[ "$remote_open" -eq 1 ]]; then root="$path"; else root="$(repo_root_for "$path")"; fi
  if [[ -z "$name" ]]; then
    name="$(basename "$root")"
  fi
  name="$(sanitize_name "$name")"
  [[ -n "$name" ]] || die "empty session name after sanitize"

  # --model 은 claude/opencode/cmd/codex/pi 에서 쓴다. omx 는 role→effort 고정이라 불가(모델 오버라이드 미지원).
  if [[ -n "$model" ]] && [[ "$agent" != "claude" && "$agent" != "opencode" && "$agent" != "cmd" && "$agent" != "codex" && "$agent" != "pi" ]]; then
    die "--model 은 --agent claude|opencode|cmd|codex|pi 에서만 사용 (agent=$agent)"
  fi
  # --effort 는 claude/cmd/codex/pi. opencode 는 reasoning effort 개념이 없고 omx 는 role 고정.
  if [[ -n "$effort" ]] && [[ "$agent" != "claude" && "$agent" != "cmd" && "$agent" != "codex" && "$agent" != "pi" ]]; then
    die "--effort 는 --agent claude|cmd|codex|pi 에서만 사용 (agent=$agent)"
  fi
  # --fast 는 codex 전용 (service_tier=priority). 다른 agent 에는 그런 축이 없다.
  if [[ -n "$fast" ]] && [[ "$agent" != "codex" ]]; then
    die "--fast 는 --agent codex 에서만 사용 (agent=$agent)"
  fi
  # --ctx 는 claude 전용 — 컨텍스트 창 선택자 "model[1m]" 은 claude CLI 문법이다.
  if [[ -n "$ctx" ]] && [[ "$agent" != "claude" ]]; then
    die "--ctx 는 --agent claude 에서만 사용 (agent=$agent)"
  fi
  if [[ -n "$ctx" && ! "$ctx" =~ ^[0-9]+[mk]$ ]]; then
    die "--ctx 값 형식 오류: '$ctx' (예: 1m)"
  fi
  # --like 는 claude/pi 지원 — 라이브 세션의 모델/effort를 회수해 상속한다.
  if [[ -n "$like" ]] && [[ "$agent" != "claude" && "$agent" != "pi" ]]; then
    die "--like 는 --agent claude|pi 에서만 사용 (agent=$agent)"
  fi
  # --like SESSION: 지정한 라이브 세션의 모델/effort를 상속 (명시 --model/--effort 가 우선)
  if [[ -n "$like" ]]; then
    local like_out
    if [[ "$agent" == "pi" ]]; then
      like_out="$(session_agent_probe "$like" 2>/dev/null || true)"
    else
      like_out="$(session_live_launch "$like" || true)"
    fi
    [[ -n "$like_out" ]] || die "--like: 세션 '$like' 의 라이브 모델 조회 실패 (미기동/엔진 불일치)"
    [[ -n "$model" ]]  || model="$(printf '%s\n' "$like_out" | sed -n 's/^model=//p' | head -1)"
    [[ -n "$effort" ]] || effort="$(printf '%s\n' "$like_out" | sed -n 's/^effort=//p' | head -1)"
  fi

  # 원격 open(카드2 · 계약 보강 4) — --like 라이브 probe 는 로컬 파일을 쓰므로 원격에서는 미지원(카드3).
  if [[ "$remote_open" -eq 1 ]]; then
    [[ -z "$like" ]] || die "--like 는 원격 미지원 (라이브 세션 argv 를 로컬에서 읽는다)"
    open_remote "$TMUXC_HOST" "$path" "$root" "$name" "$agent" "$role" "$model" "$effort" "$ctx" "$fast" "$dry_run" "${prompt:-}"
    return $?
  fi
  local pi_sid=""
  if [[ "$agent" == "pi" ]]; then
    pi_sid="${TMUXC_PI_SESSION_ID:-$(python3 -c 'import uuid;print(uuid.uuid4())' 2>/dev/null)}"
    export TMUXC_PI_SESSION_ID="$pi_sid"
  fi
  local run_cmd
  run_cmd="$(agent_cmd "$agent" "$name" "$role" "$model" "$effort" "$ctx" "$fast")"
  local seat_env=()
  # r925 r3 R1: claude 는 tmuxc 가 --session-id 를 발급한다 — 제출 판정 = 그 id 의 기록 «한 파일»(pi 의 TMUXC_PI_SESSION_ID 와 같은 꼴).
  #   호출자 env 의 같은 이름 값은 쓰지 않는다(호출 좌석 자신의 id 를 물려받으면 두 좌석이 한 기록을 쓴다).
  local claude_sid=""
  if [[ "$agent" == "claude" ]]; then
    claude_sid="$(python3 -c 'import uuid;print(uuid.uuid4())')" || die "claude --session-id 발급 실패(python3 uuid)"
    run_cmd="$run_cmd --session-id $claude_sid"
    seat_env=("TMUXC_CLAUDE_SESSION_ID=$claude_sid")
  fi
  [[ "$agent" == "opencode" && -n "$model" ]] && seat_env=("$(opencode_session_env "$model")")
  # pi: process.title 이 argv를 가리므로 tmux session env에 메타데이터를 심는다.
  # 이후 probe/save/restore/fork가 argv 없이 정확히 복구한다.
  [[ "$agent" == "pi" ]] && seat_env=(
    "TMUXC_PI_SESSION_ID=$pi_sid"
    "TMUXC_PI_MODEL=${model:-}"
    "TMUXC_PI_THINKING=${effort:-medium}"
  )
  # 비 claude 좌석: git 이 화면 없는 편집기(vi)·자격증명 프롬프트를 열고 멈추지 않게 한다
  # (r610 — pi 좌석이 rebase --continue 의 vi 에서 54분 정지 · r599). claude 셸은 이미 넣어 준다.
  [[ "$agent" != "claude" ]] && seat_env+=(
    "GIT_EDITOR=true"
    "GIT_SEQUENCE_EDITOR=true"
    "GIT_TERMINAL_PROMPT=0"
  )

  if [[ "$dry_run" -eq 1 ]]; then
    printf 'session=%s\nroot=%s\nagent=%s\nrole=%s\ncommand=%s\n' "$name" "$root" "$agent" "$role" "$run_cmd"
    [[ ${#seat_env[@]} -eq 0 ]] || printf 'env=%s\n' "${seat_env[@]}"
    return 0
  fi

  tmux has-session -t "$name" 2>/dev/null && die "session already exists: $name"
  create_tmux_session "$name" "$root" ${seat_env[@]+"${seat_env[@]}"}
  inject_message "$name" "$run_cmd" shell
  # r925: claude 경로는 아래 guide 주입이 «입력 상자가 그려졌나» 로 스스로 기다린다(고정 sleep 삭제).
  #        다른 에이전트(codex·cmd·pi) 경로는 종전과 같이 고정 sleep 4 를 둔다(P3 · 회귀 0).
  [[ "$agent" == "claude" ]] || sleep 4

  local guide
  if [[ "$agent" == "claude" ]]; then
    guide="[$(tmux display-message -p '#S' 2>/dev/null || printf 'orch')→$name] 통신 표준: ~/.claude/skills/tmuxc/COMM-GUIDE-BOOT.md(12줄)를 지금 Read하고 그대로 따를 것 — 전문 COMM-GUIDE.md 는 열지 않는다(훅 차단), 필요한 절만 BOOT 매핑표의 줄 범위로 offset/limit Read. 너의 세션명(me)=$name. 세션간 메시지는 검증 송신 프로토콜 준수."
  elif [[ "$agent" == "cmd" ]]; then
    guide="[$(tmux display-message -p '#S' 2>/dev/null || printf 'orch')→$name] tmuxc Command Code 세션. 통신 표준: ~/.claude/skills/tmuxc/COMM-GUIDE-BOOT.md(12줄)를 지금 Read하고 그대로 따를 것 — 전문 COMM-GUIDE.md 는 열지 않는다(훅 차단), 필요한 절만 BOOT 매핑표의 줄 범위로 offset/limit Read — 특히 「Command Code(--agent cmd) 세션 특이사항」 절. --remote-control 이 없으므로 tmux verified-send/capture-pane 방식으로 보고한다. 너의 세션명(me)=$name."
  elif [[ "$agent" == "pi" ]]; then
    guide="[$(tmux display-message -p '#S' 2>/dev/null || printf 'orch')→$name] tmuxc Pi 세션. 통신 표준: ~/.agents/skills/tmuxc/COMM-GUIDE-BOOT.md(12줄)를 지금 read로 읽고 그대로 따를 것 — 전문 COMM-GUIDE.md 는 열지 않는다. Pi에는 --remote-control이 없으므로 tmux verified-send/capture-pane 방식으로 보고한다. Pi 운영 스킬은 /skill:pi-ops. 너의 세션명(me)=$name."
  else
    guide="[$(tmux display-message -p '#S' 2>/dev/null || printf 'orch')→$name] tmuxc Codex 세션. 통신 표준: ~/.claude/skills/tmuxc/COMM-GUIDE-BOOT.md(12줄)를 참고하되(전문 COMM-GUIDE.md 는 열지 말 것), Codex에는 --remote-control이 없으므로 tmux verified-send/capture-pane 방식으로 보고할 것. 너의 세션명(me)=$name."
  fi
  local guide_kind="plain"
  [[ "$agent" == "claude" ]] && guide_kind="agent"
  # r925 r3: 이어가기(tmuxc boot-enter)가 «넣은 전문» 과 완전 일치로만 Enter 하도록 부팅 문장을 세션 env 에 남긴다.
  if [[ "$agent" == "claude" ]]; then
    tmux set-environment -t "=$name" TMUXC_BOOT_TEXT "$guide" 2>/dev/null \
      || printf 'WARN TMUXC_BOOT_TEXT 기록 실패(%s) — 이어가기 boot-enter 는 «근거 없음» 으로 멈춘다\n' "$name" >&2
  fi
  local inj_rc=0
  inject_message "$name" "$guide" "$guide_kind" "$claude_sid" || inj_rc=$?
  if [[ -n "$prompt" && "$inj_rc" -eq 0 ]]; then
    sleep 0.8
    inject_message "$name" "$prompt" "$guide_kind" "$claude_sid" || inj_rc=$?
  fi

  # [2026-07-16] headroom 프록시 경유 검증 (claude 전용 — 토큰낭비·계정리밋 방어).
  # claude-hr.sh는 fail-open이라 프록시가 살아있을 때 직결 프로세스 = 우회 스폰. 경고만(kill 안 함).
  if [[ "$agent" == "claude" ]]; then
    local hr_proxy="${TMUXC_HR_PROXY_URL:-http://localhost:8790}" pane_pid claude_pid
    if curl -sf -m1 "$hr_proxy/health" >/dev/null 2>&1; then
      pane_pid="$(tmux list-panes -t "$name" -F '#{pane_pid}' 2>/dev/null | head -1)"
      claude_pid="$(pgrep -P "${pane_pid:-0}" 2>/dev/null | head -1 || true)"
      if [[ -n "$claude_pid" ]] && ! ps eww "$claude_pid" 2>/dev/null | tr ' ' '\n' | grep -q "^ANTHROPIC_BASE_URL=$hr_proxy"; then
        printf '⚠️  HEADROOM_BYPASS: %s(pid=%s)가 프록시(%s) 미경유 직결 — claude-hr.sh 경유 재기동 권고\n' "$name" "$claude_pid" "$hr_proxy" >&2
      fi
    fi
  fi

  # r925 P2: 주입 rc≠0 이면 «session created» 로 성공 보고하지 않는다 — 반쪽 열림을 성공으로 읽으면 좌석이 빈손이 된다.
  if [[ "$inj_rc" -ne 0 ]]; then
    printf 'tmuxc session created · 부팅 문장 제출 실패 rc=%s\nsession=%s\nroot=%s\nagent=%s\nrole=%s\nattach=tmux attach -t %q\n' \
      "$inj_rc" "$name" "$root" "$agent" "$role" "$name"
    return "$inj_rc"
  fi
  printf 'tmuxc session created\nsession=%s\nroot=%s\nagent=%s\nrole=%s\nattach=tmux attach -t %q\n' "$name" "$root" "$agent" "$role" "$name"
}

# --from <라이브 세션명> 의 conversation id 를 얻는다. argv 에 --resume/--session 이 없으면
# (=처음 열린 세션, 가장 흔한 경우) 트랜스크립트 해석으로 폴백한다 — cmd_save 의 2단계
# (session_agent_probe → tmuxc-snapshot.py resolve) 와 동일 파이프라인을 그대로 재사용한다.
# cwd 매칭 기반이라 «--last 경쟁»이 아니라 «이 세션이 실제로 쓴 그 파일»을 찾는다.
resolve_fork_source_from_live() {
  local from="$1"
  tmux has-session -t "$from" 2>/dev/null || die "source session not found: $from"
  local probe
  probe="$(session_agent_probe "$from" || true)"
  [[ -n "$probe" ]] || die "fork: cannot determine source engine for live session '$from' (no known agent process found)"
  local a m e s
  a="$(printf '%s\n' "$probe" | sed -n 's/^agent=//p'  | head -1)"
  m="$(printf '%s\n' "$probe" | sed -n 's/^model=//p'  | head -1)"
  e="$(printf '%s\n' "$probe" | sed -n 's/^effort=//p' | head -1)"
  s="$(printf '%s\n' "$probe" | sed -n 's/^sid=//p'    | head -1)"
  if [[ -z "$s" ]]; then
    local cwd helper row resolved
    cwd="$(tmux display-message -p -t "$from" '#{session_path}' 2>/dev/null || true)"
    [[ -n "$cwd" ]] || die "fork: cannot resolve cwd of source session '$from'"
    helper="$(snapshot_helper_py)"
    [[ -f "$helper" ]] || die "snapshot engine not found: $helper"
    row="${from}${SEP}${cwd}${SEP}1${SEP}${SEP}${a}${SEP}${m}${SEP}${e}${SEP}"
    resolved="$(printf '%s\n' "$row" | python3 "$helper" resolve)"
    s="$(printf '%s\n' "$resolved" | awk -F"$SEP" '{print $8}')"
    [[ -n "$s" ]] || die "fork: could not resolve conversation id for live session '$from' (no matching transcript found — is it a fresh, unresumed session with no prior turns yet?)"
  fi
  printf 'agent=%s\nmodel=%s\neffort=%s\nsid=%s\n' "$a" "$m" "$e" "$s"
}

cmd_fork() {
  local path="" name="" agent="" role="${TMUXC_ROLE:-worker}"
  local model="" effort="" ctx="" prompt="" dry_run=0
  local from="" source_id=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --name) name="${2:-}"; shift 2 ;;
      --agent) agent="${2:-}"; shift 2 ;;
      --role) role="${2:-}"; shift 2 ;;
      --from) from="${2:-}"; shift 2 ;;
      --source) source_id="${2:-}"; shift 2 ;;
      --model) model="${2:-}"; shift 2 ;;
      --ctx) ctx="${2:-}"; shift 2 ;;
      --effort) effort="${2:-}"; shift 2 ;;
      --prompt) prompt="${2:-}"; shift 2 ;;
      --serena) die_serena_retired ;;
      --dry-run) dry_run=1; shift ;;
      --help|-h) usage; exit 0 ;;
      --*) die "unknown option for fork: $1" ;;
      *)
        if [[ -z "$path" ]]; then
          path="$1"; shift
        else
          die "unexpected argument: $1"
        fi
        ;;
    esac
  done

  [[ -n "$path" ]] || die "fork requires <path>"
  [[ -d "$path" ]] || die "path does not exist: $path"
  [[ -n "$name" ]] || die "fork requires --name"
  name="$(sanitize_name "$name")"
  [[ -n "$name" ]] || die "empty session name after sanitize"

  [[ -n "$from" && -n "$source_id" ]] && die "fork: --from and --source are mutually exclusive"
  [[ -n "$from" || -n "$source_id" ]] || die "fork requires --from <live-session> or --source <conversation-id> --agent <engine>"

  local src_agent="" src_id="" src_model="" src_effort=""
  if [[ -n "$from" ]]; then
    local resolved
    resolved="$(resolve_fork_source_from_live "$from")"
    src_agent="$(printf '%s\n' "$resolved" | sed -n 's/^agent=//p'  | head -1)"
    src_model="$(printf '%s\n' "$resolved" | sed -n 's/^model=//p'  | head -1)"
    src_effort="$(printf '%s\n' "$resolved" | sed -n 's/^effort=//p' | head -1)"
    src_id="$(printf '%s\n' "$resolved" | sed -n 's/^sid=//p'    | head -1)"
    if [[ -n "$agent" && "$agent" != "$src_agent" ]]; then
      die "fork: cross-engine mismatch — source '$from' is $src_agent, requested --agent $agent"
    fi
    agent="$src_agent"
  else
    [[ -n "$agent" ]] || die "fork: --source requires --agent (engine of the given conversation id)"
    src_agent="$agent"
    src_id="$source_id"
  fi

  case "$agent" in
    claude|codex|opencode|cmd|pi) ;;
    *) die "fork: unsupported agent '$agent' (claude|codex|opencode|cmd|pi only — omx has no native fork)" ;;
  esac

  # --source(직접 지정) 경로만 실재 확인 — --from 은 이미 실제 트랜스크립트로 sid 를 얻었다.
  if [[ -n "$source_id" ]]; then
    local exists_check
    exists_check="$(source_id_known_to_engine "$agent" "$source_id" || true)"
    [[ "$exists_check" == "not-found" ]] && \
      die "fork: --source $source_id not found in $agent's session store (wrong id, or cross-engine mismatch) — verify the id or use --from <live-seat> instead"
  fi

  [[ -n "$model"  ]] || model="$src_model"
  [[ -n "$effort" ]] || effort="$src_effort"

  # 옵션 호환성 — cmd_open 의 규칙과 동일(방식 분기 금지)
  if [[ -n "$effort" ]] && [[ "$agent" != "claude" && "$agent" != "cmd" && "$agent" != "codex" && "$agent" != "pi" ]]; then
    die "--effort 는 --agent claude|cmd|codex|pi 에서만 사용 (agent=$agent)"
  fi
  if [[ -n "$ctx" ]] && [[ "$agent" != "claude" ]]; then
    die "--ctx 는 --agent claude 에서만 사용 (agent=$agent)"
  fi
  if [[ -n "$ctx" && ! "$ctx" =~ ^[0-9]+[mk]$ ]]; then
    die "--ctx 값 형식 오류: '$ctx' (예: 1m)"
  fi

  local root
  root="$(repo_root_for "$path")"

  local pi_sid=""
  if [[ "$agent" == "pi" ]]; then
    pi_sid="${TMUXC_PI_SESSION_ID:-$(python3 -c 'import uuid;print(uuid.uuid4())' 2>/dev/null)}"
    export TMUXC_PI_SESSION_ID="$pi_sid"
  fi
  local run_cmd
  run_cmd="$(agent_fork_cmd "$agent" "$name" "$role" "$src_id" "$model" "$effort" "$ctx")"
  local seat_env=()
  # r925 r3 R1: open 과 같다 — 자식 대화 id 를 tmuxc 가 발급한다(claude 는 --fork-session 과 함께일 때 --session-id 를 받는다 · 2.1.310 실측).
  local claude_sid=""
  if [[ "$agent" == "claude" ]]; then
    claude_sid="$(python3 -c 'import uuid;print(uuid.uuid4())')" || die "claude --session-id 발급 실패(python3 uuid)"
    run_cmd="$run_cmd --session-id $claude_sid"
    seat_env=("TMUXC_CLAUDE_SESSION_ID=$claude_sid")
  fi
  [[ "$agent" == "opencode" && -n "$model" ]] && seat_env=("$(opencode_session_env "$model")")
  [[ "$agent" == "pi" ]] && seat_env=(
    "TMUXC_PI_SESSION_ID=$pi_sid"
    "TMUXC_PI_MODEL=${model:-}"
    "TMUXC_PI_THINKING=${effort:-medium}"
  )
  # 비 claude 좌석: git 비대화 3종 — open 과 같은 이유(r610).
  [[ "$agent" != "claude" ]] && seat_env+=(
    "GIT_EDITOR=true"
    "GIT_SEQUENCE_EDITOR=true"
    "GIT_TERMINAL_PROMPT=0"
  )

  if [[ "$dry_run" -eq 1 ]]; then
    printf 'session=%s\nroot=%s\nagent=%s\nrole=%s\nsource_agent=%s\nsource_id=%s\ncommand=%s\n' \
      "$name" "$root" "$agent" "$role" "$src_agent" "$src_id" "$run_cmd"
    [[ ${#seat_env[@]} -eq 0 ]] || printf 'env=%s\n' "${seat_env[@]}"
    return 0
  fi

  tmux has-session -t "$name" 2>/dev/null && die "session already exists: $name"
  create_tmux_session "$name" "$root" ${seat_env[@]+"${seat_env[@]}"}
  inject_message "$name" "$run_cmd" shell
  [[ "$agent" == "claude" ]] || sleep 4   # r925 P3: claude 외 경로는 종전 그대로

  local parent_hint="${from:-source=$source_id}"
  # 뒤이어 --prompt 가 올 수도, 안 올 수도 있다 — "아래 작업만 수행하라"처럼 작업이
  # 반드시 뒤따른다고 단정하면 --prompt 없이 fork 했을 때 자식이 «없는 작업»을
  # 찾는 모순이 생긴다(2026-09-13 실라이브 검증에서 자식이 직접 지적).
  local task_hint="뒤이어 --prompt 로 온 지시가 있으면 그것을 수행하고, 없으면 다음 지시를 대기하라."
  local guide
  if [[ "$agent" == "claude" ]]; then
    guide="[$(tmux display-message -p '#S' 2>/dev/null || printf 'orch')→$name] FORK 세션(부모: $parent_hint) — 네이티브 fork 로 분기된 «새» 대화다. 통신 표준: ~/.claude/skills/tmuxc/COMM-GUIDE-BOOT.md(12줄)를 지금 Read하고 그대로 따를 것 — 전문 COMM-GUIDE.md 는 열지 않는다(훅 차단), 필요한 절만 BOOT 매핑표의 줄 범위로 offset/limit Read. 너의 세션명(me)=$name. 부모의 조율자 역할을 이어받지 않는다 — 독립 좌석으로서 $task_hint"
  elif [[ "$agent" == "cmd" ]]; then
    guide="[$(tmux display-message -p '#S' 2>/dev/null || printf 'orch')→$name] tmuxc Command Code FORK 세션(부모: $parent_hint). 통신 표준: ~/.claude/skills/tmuxc/COMM-GUIDE-BOOT.md(12줄) + COMM-GUIDE.md 의 「Command Code 세션 특이사항」 절(BOOT 매핑표 줄 범위로 offset/limit Read)을 따를 것. 너의 세션명(me)=$name. 부모의 조율자 역할을 이어받지 않는다 — $task_hint"
  elif [[ "$agent" == "pi" ]]; then
    guide="[$(tmux display-message -p '#S' 2>/dev/null || printf 'orch')→$name] tmuxc Pi FORK 세션(부모: $parent_hint). 통신 표준: ~/.agents/skills/tmuxc/COMM-GUIDE-BOOT.md(12줄)를 read로 따를 것. Pi에는 --remote-control이 없으므로 tmux verified-send/capture-pane 방식으로 보고할 것. 너의 세션명(me)=$name. 부모의 조율자 역할을 이어받지 않는다 — $task_hint"
  else
    guide="[$(tmux display-message -p '#S' 2>/dev/null || printf 'orch')→$name] tmuxc ${agent} FORK 세션(부모: $parent_hint). Codex/opencode 에는 --remote-control 이 없으므로 tmux verified-send/capture-pane 방식으로 보고할 것. 너의 세션명(me)=$name. 부모의 조율자 역할을 이어받지 않는다 — $task_hint"
  fi
  local guide_kind="plain"
  [[ "$agent" == "claude" ]] && guide_kind="agent"
  if [[ "$agent" == "claude" ]]; then
    tmux set-environment -t "=$name" TMUXC_BOOT_TEXT "$guide" 2>/dev/null \
      || printf 'WARN TMUXC_BOOT_TEXT 기록 실패(%s) — 이어가기 boot-enter 는 «근거 없음» 으로 멈춘다\n' "$name" >&2
  fi
  local inj_rc=0
  inject_message "$name" "$guide" "$guide_kind" "$claude_sid" || inj_rc=$?
  if [[ -n "$prompt" && "$inj_rc" -eq 0 ]]; then
    sleep 0.8
    inject_message "$name" "$prompt" "$guide_kind" "$claude_sid" || inj_rc=$?
  fi

  if [[ "$inj_rc" -ne 0 ]]; then
    printf 'tmuxc fork created · 부팅 문장 제출 실패 rc=%s\nsession=%s\nroot=%s\nagent=%s\nrole=%s\nsource_agent=%s\nsource_id=%s\nattach=tmux attach -t %q\n' \
      "$inj_rc" "$name" "$root" "$agent" "$role" "$src_agent" "$src_id" "$name"
    return "$inj_rc"
  fi
  printf 'tmuxc fork created\nsession=%s\nroot=%s\nagent=%s\nrole=%s\nsource_agent=%s\nsource_id=%s\nattach=tmux attach -t %q\n' \
    "$name" "$root" "$agent" "$role" "$src_agent" "$src_id" "$name"
}

cmd_list() {
  if [[ -n "${TMUXC_HOST:-}" ]] && [[ "$(local_host)" != "$TMUXC_HOST" ]]; then
    # 원격 목록 — ssh 1회로 받아 HOST 열을 앞에 붙인다(설계 「목록」 행)
    local out rc
    out="$(hl h_run "$TMUXC_HOST" --idempotent tmux list-sessions -F $'#S\t#{session_path}\t#{session_attached}')" || rc=$?
    if [[ "${rc:-0}" -ne 0 ]]; then
      printf 'tmuxc: %s 목록 판정 불가 rc=%s\n' "$TMUXC_HOST" "$rc" >&2
      return "$rc"
    fi
    [[ -n "$out" ]] || return 0
    printf '%s\n' "$out" | awk -v h="$TMUXC_HOST" -F'\t' '{ printf "%s\t%s\t%s\t%s\n", h, $1, $2, $3 }'
    return 0
  fi
  tmux list-sessions -F '#S	#{session_path}	#{session_attached}' 2>/dev/null || return 0
}

cmd_ask() {
  local name="${1:-}"
  local lines="${2:-40}"
  [[ -n "$name" ]] || die "ask requires <name>"
  if host_resolve "$name" "${TMUXC_HOST:-}"; then
    local out rc=0
    out="$(hl h_run "$R_HOST" --idempotent tmux capture-pane -t "=$R_SESS:" -p)" || rc=$?
    [[ "$rc" -eq 0 ]] || die "remote capture failed rc=$rc: $R_HOST/$R_SESS"
    printf '%s\n' "$out" | tail -n "$lines"
    return 0
  fi
  tmux has-session -t "$name" 2>/dev/null || die "session not found: $name"
  tmux capture-pane -t "$name" -p | tail -n "$lines"
}

cmd_send() {
  local name="${1:-}"
  shift || true
  [[ -n "$name" ]] || die "send requires <name>"
  [[ $# -gt 0 ]] || die "send requires <message>"
  if host_resolve "$name" "${TMUXC_HOST:-}"; then
    local rc=0 base="" baserc=0
    # baseline 은 «보내기 전» 에 잡는다 — rc6(기록 id 없음)일 때만 쓰지만, 보낸 뒤에는 잡을 수 없다.
    base="$(remote_reach_baseline "$R_HOST" "$R_SESS" "$*" 2>/dev/null)" || baserc=$?
    remote_send_locked "$R_HOST" "$R_SESS" "$*" || rc=$?
    case "$rc" in
      0) printf 'delivered=%s/%s\n' "$R_HOST" "$R_SESS"; return 0 ;;
      # 4·5 = 주입 절차가 직접 낸 판정(기록 마감·판독 불가). ft-reach-check 로 다시 묻지 않는다.
      4) printf 'sent=%s/%s verification=not-reached\n' "$R_HOST" "$R_SESS"; return 4 ;;
      5) printf 'sent=%s/%s verification=unverifiable\n' "$R_HOST" "$R_SESS"; return 5 ;;
      6) ;;   # 기록 id 없음 = 종전 그대로 ft-reach-check 판정
      *) printf 'tmuxc: %s/%s 송신 실패 rc=%s\n' "$R_HOST" "$R_SESS" "$rc" >&2; return "$rc" ;;
    esac
    # ★baseline 실패를 «빈 값» 으로 삼키지 않는다★(r1047 r3 · 하드 룰 #0) — 빈 값이면 ft-reach-check 가
    #  판정 «직전» 에 자기 baseline 을 잡아 1 > 1 이 거짓이 되고, 도착한 메시지가 NOT_REACHED 로 뒤집힌다.
    #  송신은 그대로 하고 최종 판정만 «판정 불가 rc5» 로 낸다(REACHED·NOT_REACHED 둘 다 아님).
    if [[ "$baserc" -ne 0 ]]; then
      printf 'sent=%s/%s verification=unverifiable (baseline rc=%s)\n' "$R_HOST" "$R_SESS" "$baserc" >&2
      return 5
    fi
    remote_reach_check "$R_HOST" "$R_SESS" "$*" "$base"
    rc=$?
    case "$rc" in
      0) printf 'delivered=%s/%s\n' "$R_HOST" "$R_SESS" ;;
      4) printf 'sent=%s/%s verification=not-reached\n' "$R_HOST" "$R_SESS" ;;
      5) printf 'sent=%s/%s verification=unverifiable\n' "$R_HOST" "$R_SESS" ;;
      *) printf 'tmuxc: %s/%s 도달 판정 불가 rc=%s\n' "$R_HOST" "$R_SESS" "$rc" >&2 ;;
    esac
    return "$rc"
  fi
  tmux has-session -t "$name" 2>/dev/null || die "session not found: $name"
  inject_message "$name" "$*"
  sleep 1
  if tmux capture-pane -t "$name" -p | tail -80 | grep -qF "$*"; then
    printf 'delivered=%s\n' "$name"
  else
    printf 'sent=%s verification=not-visible-yet\n' "$name"
  fi
}

cmd_clean() {
  local session command
  while IFS=$'\t' read -r session command; do
    if [[ "$command" == "zsh" || "$command" == "bash" || "$command" == "fish" ]]; then
      printf '%s\n' "$session"
    fi
  done < <(tmux list-panes -a -F '#S	#{pane_current_command}' 2>/dev/null || true)
}

# ---------- UC13: 종료 전 스냅샷 (save) ----------

SNAP_DIR="${TMUXC_SNAPSHOT_DIR:-$HOME/.tmuxc/snapshots}"
SEP=$'\x1f'

snapshot_helper_py() {
  local self cand
  self="$(readlink -f "$0" 2>/dev/null || printf '%s' "$0")"
  cand="$(dirname "$self")/../libexec/tmuxc-snapshot.py"
  if [[ ! -f "$cand" && -f "$HOME/.tmuxc/current/core/libexec/tmuxc-snapshot.py" ]]; then
    cand="$HOME/.tmuxc/current/core/libexec/tmuxc-snapshot.py"
  fi
  printf '%s' "$cand"
}

# pane 아래 모든 후손 pid (얕은 pgrep -P 는 npm exec → node → 실바이너리 체인을 놓친다)
pane_descendant_pids() {
  # local 은 워드를 «전부 확장한 뒤» 대입한다 — 같은 local 문에서 앞 변수를 참조하면
  # set -u 아래서 unbound 로 죽는다. 반드시 문장을 분리한다.
  local root="$1"
  local queue=("$root")
  local out=() cur kids depth=0
  while [[ "${#queue[@]}" -gt 0 && "$depth" -lt 8 ]]; do
    local next=()
    for cur in "${queue[@]}"; do
      out+=("$cur")
      kids="$(pgrep -P "$cur" 2>/dev/null || true)"
      [[ -n "$kids" ]] && next+=($kids)
    done
    queue=("${next[@]+"${next[@]}"}")
    depth=$((depth + 1))
  done
  printf '%s\n' "${out[@]+"${out[@]}"}"
}

# 세션의 라이브 에이전트를 argv 에서 판별한다.
# argv 가 [1m] 창 선택자·effort 의 유일한 authoritative 소스다 — 트랜스크립트에는
# 둘 다 기록되지 않는다(2026-08-25 실측: jsonl 전량 grep 결과 [1m] 히트 0).
# 출력: agent/model/effort/sid 를 KEY=VALUE 줄로. 에이전트 미검출 시 비-0.
session_agent_probe() {
  local sess="$1"
  local env_sid env_model env_effort
  # pi: tmuxc 가 세션 env에 심은 메타데이터 — process.title이 argv를 숨겨도 복구된다.
  env_sid="$(tmux show-environment -t "$sess" TMUXC_PI_SESSION_ID 2>/dev/null | sed -n 's/^TMUXC_PI_SESSION_ID=//p' | head -1)"
  if [[ -n "$env_sid" ]]; then
    env_model="$(tmux show-environment -t "$sess" TMUXC_PI_MODEL 2>/dev/null | sed -n 's/^TMUXC_PI_MODEL=//p' | head -1)"
    env_effort="$(tmux show-environment -t "$sess" TMUXC_PI_THINKING 2>/dev/null | sed -n 's/^TMUXC_PI_THINKING=//p' | head -1)"
    printf 'agent=pi\n'
    [[ -n "$env_model"  ]] && printf 'model=%s\n' "$env_model"
    [[ -n "$env_effort" ]] && printf 'effort=%s\n' "$env_effort"
    printf 'sid=%s\n' "$env_sid"
    return 0
  fi
  local ppid
  ppid="$(tmux list-panes -t "$sess" -F '#{pane_pid}' 2>/dev/null | head -1)"
  [[ -n "$ppid" ]] || return 1
  local pid cmd agent="" model="" effort="" sid=""
  for pid in $(pane_descendant_pids "$ppid"); do
    cmd="$(ps -o command= -p "$pid" 2>/dev/null || true)"
    [[ -n "$cmd" ]] || continue
    local -a toks=()
    read -ra toks <<< "$cmd"
    local t prev="" base kind="" i=0 want_resume=0
    kind=""
    for t in "${toks[@]}"; do
      base="${t##*/}"
      case "$base" in
        claude) kind="claude" ;;
        codex)  kind="codex" ;;
        opencode|opencode.exe) kind="opencode" ;;
        pi|pi.js) kind="pi" ;;
        cmd|cmdc) kind="cmd" ;;
        # cmd(Command Code, Node/Ink)는 부팅 직후 process.title 을 자기 이름으로
        # 덮어쓴다 — ps 에는 원래 argv("cmd ...")가 아니라 "command-code"(idle,
        # 첫 턴 전)나 "⌘ <세션명>"(첫 턴 처리 후)만 보인다(2026-09-13 실측, 크레딧
        # 미소비 상태로 재현: 부팅만 하고 질의는 안 보냄). 그래서 원래 판정은
        # cmd 세션을 «에이전트 미검출»로 놓쳐 tmuxc fork --from 이 항상 실패했다.
        command-code) kind="cmd" ;;
        '⌘') kind="cmd" ;;
      esac
      # 실경로로 띄운 claude: argv0 이 `~/.local/share/claude/versions/2.1.308` 꼴이면
      # basename 이 «버전 번호» 라 위 case 에 안 걸린다 → 저장이 agent=shell 로 적혀
      # restore 가 그 좌석을 건너뛴다(BYZ 2597 · 2026-10-22). 경로 꼴로 판정한다.
      if [[ -z "$kind" && "$t" == */claude/versions/* ]]; then
        kind="claude"
      fi
      [[ -n "$kind" ]] && break
    done
    # Node bundle: argv may be `node .../@earendil-works/pi-coding-agent/.../cli.js`
    if [[ -z "$kind" && ( "$cmd" == *"pi-coding-agent"* || "$cmd" == *"/bin/pi "* ) ]]; then
      kind="pi"
    fi
    [[ -n "$kind" ]] || continue
    # npm exec 래퍼는 인자를 *** 로 가린다 — sid 를 못 주는 프로세스는 후보로만 두고 계속 찾는다
    local p_model="" p_effort="" p_sid=""
    prev=""
    for t in "${toks[@]}"; do
      case "$prev" in
        --model|-m) p_model="$t" ;;
        --effort|--thinking) p_effort="$t" ;;
        --resume|--session|--session-id|-s) [[ "$t" != -* ]] && p_sid="$t" ;;
      esac
      case "$t" in
        -c) : ;;
        model=*)                   p_model="${t#model=}";   p_model="${p_model%\"}"; p_model="${p_model#\"}" ;;
        model_reasoning_effort=*)  p_effort="${t#model_reasoning_effort=}"; p_effort="${p_effort%\"}"; p_effort="${p_effort#\"}" ;;
      esac
      # `codex resume <uuid>` 위치 인자
      if [[ "$kind" == "codex" && "$prev" == "resume" && "$t" != -* && "$t" != "***" ]]; then
        p_sid="$t"
      fi
      prev="$t"
    done
    # 더 구체적인 프로세스(sid/model 을 실제로 가진 쪽)를 우선 채택 — 단 «종류»는
    # 처음 찾은 것(pane 에 가까운 BFS 앞)을 지킨다. 뒤 후손(도구 하위 프로세스)이
    # 덮어쓰면 claude 좌석이 agent=pi 로 저장된다(BYZ 2597 · 2026-10-22).
    if [[ -z "$agent" ]]; then agent="$kind"; fi
    # sid/model/effort 는 «정한 종류와 같은 종류의 후손» 에서만 채운다 — 다른 엔진(예: claude 좌석의
    # 도구 하위 pi 프로세스)의 --model/--session 이 섞이면 restore 가 엉뚱한 대화를 claude --resume 으로
    # 되살린다(r736 반송1 · 2026-10-22). 같은 종류의 더 구체적인 후손(sid/model 보유)은 그대로 채택.
    if [[ "$kind" == "$agent" ]]; then
      if [[ -n "$p_model"  ]]; then model="$p_model";   fi
      if [[ -n "$p_effort" ]]; then effort="$p_effort"; fi
      if [[ -n "$p_sid"    ]]; then sid="$p_sid";     fi
    fi
    [[ -n "$sid" && -n "$model" ]] && break
  done
  [[ -n "$agent" ]] || return 1
  printf 'agent=%s\n' "$agent"
  [[ -n "$model"  ]] && printf 'model=%s\n' "$model"
  [[ -n "$effort" ]] && printf 'effort=%s\n' "$effort"
  [[ -n "$sid"    ]] && printf 'sid=%s\n' "$sid"
  return 0
}

# 스냅샷 행 → 복구 커맨드 합성. open 경로와 같은 합성기를 쓴다(방식 분기 금지).
snapshot_resume_cmd() {
  local agent="$1" name="$2" model="$3" effort="$4" sid="$5"
  case "$agent" in
    claude)
      local cmd="$HOME/.headroom/claude-hr.sh --dangerously-skip-permissions"
      [[ -n "$model"  ]] && cmd="$cmd --model \"$model\""
      [[ -n "$effort" ]] && cmd="$cmd --effort $effort"
      [[ -n "$sid"    ]] && cmd="$cmd --resume $sid"
      printf '%s --name %q --remote-control %q' "$cmd" "$name" "$name"
      ;;
    codex)
      local cmd="codex"
      [[ -n "$sid" ]] && cmd="$cmd resume $sid"
      cmd="$cmd --dangerously-bypass-approvals-and-sandbox -c model_reasoning_effort=\"${effort:-high}\""
      [[ -n "$model" ]] && cmd="$cmd -c model=\"$model\""
      printf '%s' "$cmd"
      ;;
    opencode)
      local cmd="opencode --auto"
      [[ -n "$sid"   ]] && cmd="$cmd -s $(printf '%q' "$sid")"
      [[ -n "$model" ]] && cmd="$cmd --model $(printf '%q' "$model")"
      printf '%s' "$cmd"
      ;;
    cmd)
      local cmd="cmd --yolo --trust --skip-onboarding --name $(printf '%q' "$name")"
      [[ -n "$sid"    ]] && cmd="$cmd --session $(printf '%q' "$sid")"
      [[ -n "$model"  ]] && cmd="$cmd --model $(printf '%q' "$model")"
      [[ -n "$effort" ]] && cmd="$cmd --effort $(printf '%q' "$effort")"
      printf '%s' "$cmd"
      ;;
    pi)
      local cmd="pi --name $(printf '%q' "$name")"
      [[ -n "$sid"    ]] && cmd="$cmd --session $(printf '%q' "$sid")"
      [[ -n "$model"  ]] && cmd="$cmd --model $(printf '%q' "$model")"
      [[ -n "$effort" ]] && cmd="$cmd --thinking $(printf '%q' "$effort")"
      printf '%s' "$cmd"
      ;;
    *) printf '' ;;   # shell 전용 pane — 복구 커맨드 없음
  esac
}

snapshot_prune() {
  local keep="$1" f n=0
  [[ -d "$SNAP_DIR" ]] || return 0
  while IFS= read -r f; do
    n=$((n + 1))
    if [[ "$n" -gt "$keep" ]]; then
      rm -f "$f"
      printf '  🗑  롤링 삭제: %s\n' "$(basename "$f")"
    fi
  done < <(ls -1t "$SNAP_DIR"/snapshot-*.json 2>/dev/null || true)
}

cmd_save() {
  local dry_run=0 keep="${TMUXC_SNAPSHOT_KEEP:-20}"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --keep) keep="${2:-}"; shift 2 ;;
      --serena) die_serena_retired ;;
      --dry-run) dry_run=1; shift ;;
      --help|-h) usage; exit 0 ;;
      *) die "unknown option for save: $1" ;;
    esac
  done
  [[ "$keep" =~ ^[0-9]+$ && "$keep" -ge 1 ]] || die "--keep 는 1 이상의 정수 (받음: $keep)"

  local helper
  helper="$(snapshot_helper_py)"
  [[ -f "$helper" ]] || die "snapshot engine not found: $helper"
  tmux list-sessions >/dev/null 2>&1 || die "tmux 서버가 없습니다 — 저장할 세션 없음"

  # 1단계: tmux 열거 + argv 수집
  local raw="" name cwd attached pane_cmd probe agent model effort sid
  while IFS=$'\t' read -r name cwd attached pane_cmd; do
    [[ -n "$name" ]] || continue
    agent="" model="" effort="" sid=""
    probe="$(session_agent_probe "$name" 2>/dev/null || true)"
    if [[ -n "$probe" ]]; then
      agent="$(printf '%s\n' "$probe" | sed -n 's/^agent=//p'  | head -1)"
      model="$(printf '%s\n' "$probe" | sed -n 's/^model=//p'  | head -1)"
      effort="$(printf '%s\n' "$probe" | sed -n 's/^effort=//p' | head -1)"
      sid="$(printf '%s\n' "$probe" | sed -n 's/^sid=//p'    | head -1)"
    fi
    [[ -n "$agent" ]] || agent="shell"
    raw+="${name}${SEP}${cwd}${SEP}${attached}${SEP}${pane_cmd}${SEP}${agent}${SEP}${model}${SEP}${effort}${SEP}${sid}"$'\n'
  done < <(tmux list-sessions -F '#S	#{session_path}	#{session_attached}	#{pane_current_command}' 2>/dev/null)

  [[ -n "$raw" ]] || die "열거된 세션이 없습니다"

  # 2단계: sid 미상 행을 세션 로그에서 해석 (agent별 경로 — python)
  local resolved
  resolved="$(printf '%s' "$raw" | python3 "$helper" resolve)"

  # 3단계: 복구 커맨드 합성 (bash — open 경로와 단일 합성기 유지)
  local final="" sid_src title rcmd
  while IFS=$'\x1f' read -r name cwd attached pane_cmd agent model effort sid sid_src title; do
    [[ -n "$name" ]] || continue
    rcmd="$(snapshot_resume_cmd "$agent" "$name" "$model" "$effort" "$sid")"
    final+="${name}${SEP}${cwd}${SEP}${attached}${SEP}${pane_cmd}${SEP}${agent}${SEP}${model}${SEP}${effort}${SEP}${sid}${SEP}${sid_src}${SEP}${title}${SEP}${rcmd}"$'\n'
    # $(...) 는 후행 개행을 전부 제거한다 — '%s' 로 흘리면 마지막 행이 미종단이라
    # read 가 EOF 에서 false 를 반환해 «마지막 세션 1개»가 조용히 빠진다. '%s\n' 필수.
  done < <(printf '%s\n' "$resolved")

  if [[ "$dry_run" -eq 1 ]]; then
    printf '%s' "$final" | python3 "$helper" emit --stdout
    return 0
  fi

  mkdir -p "$SNAP_DIR"
  local stamp out
  stamp="$(date -u +%Y%m%dT%H%M%SZ)"
  out="$SNAP_DIR/snapshot-$stamp.json"
  printf '%s' "$final" | python3 "$helper" emit --out "$out"
  ln -sfn "$out" "$SNAP_DIR/latest.json"

  local n
  n="$(printf '%s' "$final" | grep -c . || true)"
  printf '📸 스냅샷 저장 완료\n'
  printf '   파일: %s\n' "$out"
  printf '   세션: %s개\n' "$n"
  printf '   미해석 sid: %s개\n' "$(printf '%s' "$final" | awk -F"\x1f" '$9=="none" && $5!="shell"' | grep -c . || true)"
  snapshot_prune "$keep"
  printf '   보관: 최근 %s개 (--keep 로 조정)\n' "$keep"
  printf '   복원: tmuxc restore --from latest\n'
}

# ---------- UC11: tmux 서버 사망 복원 (restore) ----------

restore_scan_py() {
  local self cand
  self="$(readlink -f "$0" 2>/dev/null || printf '%s' "$0")"
  # 정상 설치(심링크)에서는 bin 옆 ../libexec 로 해석된다.
  cand="$(dirname "$self")/../libexec/tmuxc-restore-scan.py"
  # bin 이 심링크가 아닌 파일 복사본으로 놓인 경우(로컬 수동 sync — cp),
  # ../libexec 가 존재하지 않는다. 전역 설치본으로 폴백해 restore 가 깨지지 않게 한다.
  if [[ ! -f "$cand" && -f "$HOME/.tmuxc/current/core/libexec/tmuxc-restore-scan.py" ]]; then
    cand="$HOME/.tmuxc/current/core/libexec/tmuxc-restore-scan.py"
  fi
  printf '%s' "$cand"
}

# 행 배열 (스캐너 TSV와 1:1). R_RESUME 은 스냅샷 경로에서만 채워진다 —
# 채워져 있으면 alias 추론을 통째로 건너뛴다(스냅샷이 이미 완제품 커맨드를 갖고 있다).
R_AGENT=() R_NAME=() R_CWD=() R_MODEL=() R_ROUTE=() R_SID=() R_TS=() R_STATUS=() R_SUMMARY=() R_RESUME=()

# 스냅샷 JSON → 스캐너와 동일한 행 배열. 파싱은 python 이 하고 bash 는 채우기만 한다.
restore_load_snapshot() {
  local snap="$1"
  local a n c m r s t st sum rc
  while IFS=$'\x1f' read -r a n c m r s t st sum rc; do
    [[ -n "$a" ]] || continue
    R_AGENT+=("$a"); R_NAME+=("$n"); R_CWD+=("$c"); R_MODEL+=("$m")
    R_ROUTE+=("$r"); R_SID+=("$s"); R_TS+=("$t"); R_STATUS+=("$st")
    R_SUMMARY+=("$sum"); R_RESUME+=("$rc")
  done < <(python3 - "$snap" <<'PY'
import json, os, sys
SEP = "\x1f"
with open(sys.argv[1], encoding="utf-8") as f:
    doc = json.load(f)
created = doc.get("created_at", "")
for s in doc.get("sessions", []):
    rc = s.get("resume_cmd") or ""
    cwd = s.get("cwd") or ""
    if not rc:
        status = "skip"          # shell 전용 pane — 복구 대상 아님
    elif not cwd or not os.path.isdir(cwd):
        status = "no-cwd"
    else:
        status = "ok"
    print(SEP.join([
        s.get("agent") or "?",
        s.get("name") or "?",
        cwd,
        s.get("model") or "?",
        s.get("effort") or (s.get("sid_source") or "snap"),
        s.get("session_id") or "",
        created,
        status,
        s.get("title") or "",
        rc,
    ]))
PY
  )
}

# 스냅샷 나이를 사람이 읽는 문자열로 (분/시간/일)
snapshot_age_human() {
  local iso="$1"
  python3 - "$iso" <<'PY'
import sys
from datetime import datetime, timezone
try:
    t = datetime.strptime(sys.argv[1], "%Y-%m-%dT%H:%M:%SZ").replace(tzinfo=timezone.utc)
except ValueError:
    print("?"); raise SystemExit
sec = (datetime.now(timezone.utc) - t).total_seconds()
if sec < 90:
    print("방금 전")
elif sec < 5400:
    print(f"{int(sec // 60)}분 전")
elif sec < 172800:
    print(f"{int(sec // 3600)}시간 전")
else:
    print(f"{int(sec // 86400)}일 전")
PY
}

restore_load_rows() {
  local since="$1" agent_filter="$2" loose="$3"
  local scan_py extra=()
  scan_py="$(restore_scan_py)"
  [[ -f "$scan_py" ]] || die "scan engine not found: $scan_py"
  [[ "$loose" -eq 1 ]] && extra+=(--loose)
  # 구분자 0x1f: 탭은 IFS whitespace라 빈 중간 필드(cwd="")가 collapse되어 필드가 밀림
  local a n c m r s t st sum
  while IFS=$'\x1f' read -r a n c m r s t st sum; do
    [[ -n "$a" ]] || continue
    R_AGENT+=("$a"); R_NAME+=("$n"); R_CWD+=("$c"); R_MODEL+=("$m")
    R_ROUTE+=("$r"); R_SID+=("$s"); R_TS+=("$t"); R_STATUS+=("$st"); R_SUMMARY+=("$sum")
    R_RESUME+=("")   # 로그 스캔 경로엔 완제품 커맨드가 없다 — 인덱스 정렬만 유지
  done < <(python3 "$scan_py" --since "$since" --agent "$agent_filter" "${extra[@]+"${extra[@]}"}")
}

restore_cmd_for() {
  local i="$1" baton="$2"
  local agent="${R_AGENT[$i]}" name="${R_NAME[$i]}" route="${R_ROUTE[$i]}" sid="${R_SID[$i]}"
  # 스냅샷 경로: save 시점의 라이브 argv 로 이미 완제품이 만들어져 있다.
  # alias 추론을 타지 않으므로 [1m]/effort/opencode/cmd 가 그대로 살아온다.
  local snap_cmd="${R_RESUME[$i]:-}"
  if [[ -n "$snap_cmd" ]]; then
    if [[ "$baton" -eq 1 && "$agent" == "claude" ]]; then
      # --baton 은 대화 복원 없이 가볍게 — --resume <sid> 만 떼어낸다.
      printf '%s' "$snap_cmd" | sed -E 's/ --resume [^ ]+//'
    else
      printf '%s' "$snap_cmd"
    fi
    return 0
  fi
  if [[ "$agent" == "codex" ]]; then
    # R_MODEL 은 restore_load_rows 에서 이미 스캔돼 있다 — "?"(미상)면 기존과 동일하게 생략.
    local rmodel="${R_MODEL[$i]}" model_opt=""
    [[ -n "$rmodel" && "$rmodel" != "?" ]] && model_opt=" -c model=\"$rmodel\""
    printf 'codex resume %s --dangerously-bypass-approvals-and-sandbox -c model_reasoning_effort="high"%s' "$sid" "$model_opt"
    return 0
  fi
  local body
  body="$(resolve_zsh_alias_chain "$route" || true)"
  # alias 미해석 폴백: 모델을 알면 headroom 기동을 직접 합성한다.
  # zshrc에 alias 없는 모델(claude-opus-5 등)이 전부 no-alias=복구불가로 떨어지던 문제.
  # 모델 문자열은 [1m] suffix를 포함한 원본이므로 창 크기도 승계된다.
  if [[ -z "$body" ]]; then
    local model="${R_MODEL[$i]}"
    [[ -n "$model" && "$model" != "?" ]] || return 1
    body="$HOME/.headroom/claude-hr.sh --dangerously-skip-permissions --model \"$model\" --effort ${TMUXC_SYNTH_EFFORT:-high}"
  fi
  if [[ "$baton" -eq 1 ]]; then
    printf '%s --name %q --remote-control %q' "$body" "$name" "$name"
  else
    printf '%s --resume %s --name %q --remote-control %q' "$body" "$sid" "$name" "$name"
  fi
}

restore_cwd_short() {
  # worktree면 REPO/WT명, 아니면 basename — 한눈에 프로젝트 식별
  local cwd="$1" name parent grand
  [[ -n "$cwd" ]] || { printf '?'; return; }
  name="$(basename "$cwd")"
  parent="$(basename "$(dirname "$cwd")")"
  grand="$(basename "$(dirname "$(dirname "$cwd")")")"
  if [[ "$parent" == ".worktrees" || "$parent" == "worktrees" ]]; then
    printf '%s/%s' "$grand" "$name"   # .../BYZ-Agents/.worktrees/v6-realtime-live
  else
    printf '%s' "$name"
  fi
}

restore_work_hint() {
  # 요약의 ⇢ 뒤(최근 작업)를 우선 — AGENTS.md 노이즈 회피
  local s="$1" hint
  if [[ "$s" == *"⇢"* ]]; then
    hint="${s##*⇢ }"
  else
    hint="$s"
  fi
  hint="${hint#"${hint%%[![:space:]]*}"}"
  if ((${#hint} > 64)); then
    hint="${hint:0:63}…"
  fi
  printf '%s' "$hint"
}

restore_print_table() {
  # baton 을 그대로 넘긴다 — 표는 «실제로 실행될 커맨드»를 보여야 한다.
  # (사용자가 이 표를 보고 --go 를 결정하므로 표와 실행이 갈리면 안 된다.)
  local baton="${1:-0}" i
  printf '\n복구 후보 (%d개 — 최신순)\n' "${#R_NAME[@]}"
  printf '%-3s %-7s %-28s %-18s %-5s %-7s %s\n' '#' agent 세션명 프로젝트 route 상태 작업
  for i in "${!R_NAME[@]}"; do
    printf '%-3s %-7s %-28s %-18s %-5s %-7s %s\n' \
      "$((i + 1))" "${R_AGENT[$i]}" "${R_NAME[$i]}" "$(restore_cwd_short "${R_CWD[$i]}")" \
      "${R_ROUTE[$i]}" "${R_STATUS[$i]}" "$(restore_work_hint "${R_SUMMARY[$i]}")"
    printf '    cwd=%s\n' "${R_CWD[$i]}"
    printf '    cmd=%s\n' "$(restore_cmd_for "$i" "$baton" || printf '(alias %s 미해석 — 복구 불가)' "${R_ROUTE[$i]}")"
  done
}

restore_expand_select() {
  local spec="$1" i
  case "$spec" in
    all)    for i in "${!R_NAME[@]}"; do printf '%s\n' "$i"; done ;;
    claude|codex|opencode|cmd|pi)
      for i in "${!R_NAME[@]}"; do [[ "${R_AGENT[$i]}" == "$spec" ]] && printf '%s\n' "$i"; done ;;
    *)
      local tok
      IFS=',' read -ra toks <<< "$spec"
      for tok in "${toks[@]}"; do
        tok="${tok// /}"
        [[ "$tok" =~ ^[0-9]+$ ]] || die "잘못된 선택: '$tok' (숫자, all, claude, codex, opencode, cmd, pi만 허용)"
        [[ "$tok" -ge 1 && "$tok" -le "${#R_NAME[@]}" ]] || die "선택 범위 밖: $tok (1-${#R_NAME[@]})"
        printf '%s\n' "$((tok - 1))"
      done
      ;;
  esac
}

restore_agent_live() {
  # pane 아래 해당 에이전트 자식이 있으면 기동된 것으로 본다
  local name="$1" agent="$2" ppid pat
  ppid="$(tmux list-panes -t "$name" -F '#{pane_pid}' 2>/dev/null | head -1)"
  [[ -n "$ppid" ]] || return 1
  case "$agent" in
    claude)   pat='claude|claude-hr|headroom' ;;
    codex)    pat='codex' ;;
    opencode) pat='opencode' ;;
    cmd)      pat='cmd|cmdc' ;;
    pi)       pat='pi-coding-agent|/bin/pi' ;;
    *)        pat='' ;;
  esac
  if [[ "$agent" == "claude" ]]; then
    pgrep -P "$ppid" -f "$pat" >/dev/null 2>&1
  else
    { [[ -n "$pat" ]] && pgrep -P "$ppid" -f "$pat" >/dev/null 2>&1; } || {
      # 래퍼(npm exec/node)가 중간에 끼면 이름 매칭이 실패한다 — 자식 존재로 폴백
      local child
      child="$(pgrep -P "$ppid" 2>/dev/null | head -1 || true)"
      [[ -n "$child" ]]
    }
  fi
}

restore_pane_ready() {
  local name="$1" agent="$2" pane
  pane="$(tmux capture-pane -t "$name" -p 2>/dev/null || true)"
  if [[ "$agent" == "claude" ]]; then
    # statusline 포맷이 버전마다 다름:
    #   구형 ctx:12% / 신형 "100% context used" / "bypass permissions" / Model:
    if [[ -n "$pane" ]] && printf '%s' "$pane" | grep -Eiq \
      'ctx:|[0-9]+%[[:space:]]*context[[:space:]]*used|bypass permissions|^[[:space:]]*❯|Model:'; then
      return 0
    fi
    restore_agent_live "$name" "$agent"
    return $?
  fi
  restore_agent_live "$name" "$agent"
}

restore_wait_ready() {
  local name="$1" agent="$2" try
  # resume는 컨텍스트 로드로 24초를 넘기기 쉬움 — 기본 60초(20×3)
  local max="${TMUXC_RESTORE_READY_TRIES:-20}"
  for ((try = 1; try <= max; try++)); do
    sleep 3
    if [[ "$agent" == "claude" ]]; then
      restore_pane_ready "$name" "$agent" && return 0
    else
      # codex: 자식이 뜬 뒤 한 박자 더 기다림
      if restore_agent_live "$name" "$agent" && [[ "$try" -ge 3 ]]; then
        return 0
      fi
    fi
  done
  return 1
}

# 복원 결과 리포트용 (restore_one이 채움)
RESTORE_REP_IDX=() RESTORE_REP_NAME=() RESTORE_REP_AGENT=()
RESTORE_REP_PROJ=() RESTORE_REP_OUTCOME=() RESTORE_REP_SUMMARY=()

restore_record() {
  # $1=idx $2=name $3=agent $4=proj $5=outcome $6=summary
  RESTORE_REP_IDX+=("$1")
  RESTORE_REP_NAME+=("$2")
  RESTORE_REP_AGENT+=("$3")
  RESTORE_REP_PROJ+=("$4")
  RESTORE_REP_OUTCOME+=("$5")
  RESTORE_REP_SUMMARY+=("$6")
}

restore_summary_clip() {
  # 이전 대화 요약 — 전체 summary를 표에 맞게 자름 (⇢ 앞뒤 유지)
  local s="$1" limit="${2:-72}"
  s="$(printf '%s' "$s" | tr '\n' ' ')"
  s="${s#"${s%%[![:space:]]*}"}"
  if ((${#s} > limit)); then
    s="${s:0:limit-1}…"
  fi
  printf '%s' "$s"
}

restore_print_final_report() {
  local n="${#RESTORE_REP_IDX[@]}" j outcome mark
  [[ "$n" -gt 0 ]] || return 0
  printf '\n════════════════════════════════════════════════════════════\n'
  printf '복원 결과 %d개 — 세션명 / 번호 / 이전 대화 요약\n' "$n"
  printf '════════════════════════════════════════════════════════════\n'
  printf '%-4s %-7s %-28s %-8s %-22s %s\n' '#' agent 세션명 결과 프로젝트 '이전 대화 요약'
  for j in "${!RESTORE_REP_IDX[@]}"; do
    outcome="${RESTORE_REP_OUTCOME[$j]}"
    case "$outcome" in
      ok|soft) mark='✅' ;;
      exists|skip) mark='⏭' ;;
      fail) mark='⚠️' ;;
      error) mark='❌' ;;
      *) mark='·' ;;
    esac
    printf '%-4s %-7s %-28s %-8s %-22s %s\n' \
      "#${RESTORE_REP_IDX[$j]}" "${RESTORE_REP_AGENT[$j]}" "${RESTORE_REP_NAME[$j]}" \
      "$mark$outcome" "${RESTORE_REP_PROJ[$j]}" \
      "$(restore_summary_clip "${RESTORE_REP_SUMMARY[$j]}" 72)"
  done
  printf '\n'
  local first_ok=""
  for j in "${!RESTORE_REP_OUTCOME[@]}"; do
    case "${RESTORE_REP_OUTCOME[$j]}" in ok|soft)
      first_ok="${RESTORE_REP_NAME[$j]}"; break ;;
    esac
  done
  if [[ -n "$first_ok" ]]; then
    printf 'attach 예: tmux attach -t %q\n' "$first_ok"
  fi
  printf '전체 목록: tmuxc list\n'
}

restore_one() {
  local i="$1" baton="$2"
  local agent="${R_AGENT[$i]}" name="${R_NAME[$i]}" cwd="${R_CWD[$i]}" sid="${R_SID[$i]}"
  local proj work idx summary
  idx="$((i + 1))"
  proj="$(restore_cwd_short "$cwd")"
  work="$(restore_work_hint "${R_SUMMARY[$i]}")"
  summary="$(restore_summary_clip "${R_SUMMARY[$i]}" 96)"
  # ok=정상, synth=alias 없이 모델로 기동 합성 가능 — 둘 다 복구 대상
  if [[ "${R_STATUS[$i]}" != "ok" && "${R_STATUS[$i]}" != "synth" ]]; then
    printf '  ⏭  [#%s] %s (%s) · %s — 상태=%s 스킵\n' "$idx" "$name" "$agent" "$proj" "${R_STATUS[$i]}"
    restore_record "$idx" "$name" "$agent" "$proj" "skip" "$summary"
    return 0
  fi
  if tmux has-session -t "$name" 2>/dev/null; then
    printf '  ⏭  [#%s] %s (%s) · %s — 동명 세션 이미 존재\n' "$idx" "$name" "$agent" "$proj"
    restore_record "$idx" "$name" "$agent" "$proj" "exists" "$summary"
    return 0
  fi
  local run_cmd
  run_cmd="$(restore_cmd_for "$i" "$baton" || true)"
  if [[ -z "$run_cmd" ]]; then
    printf '  ❌ [#%s] %s: alias %s 해석 실패 + 모델 미상 — 스킵\n' "$idx" "$name" "${R_ROUTE[$i]}"
    restore_record "$idx" "$name" "$agent" "$proj" "error" "$summary"
    return 0
  fi
  create_tmux_session "$name" "$cwd"
  inject_message "$name" "$run_cmd"
  local ready=0 soft=0
  if restore_wait_ready "$name" "$agent"; then
    ready=1
  elif restore_agent_live "$name" "$agent"; then
    # UI 마커는 못 봤지만 에이전트 프로세스는 살아 있음 — soft success
    ready=1
    soft=1
  fi
  if [[ "$ready" -eq 1 ]]; then
    if [[ "$agent" == "claude" ]]; then
      if [[ "$baton" -eq 1 ]]; then
        inject_message "$name" "/baton:resume"
        sleep 1
      fi
      inject_message "$name" "[restore→$name] tmux 서버 사망 후 tmuxc restore로 복원된 세션이다. 통신 표준: ~/.claude/skills/tmuxc/COMM-GUIDE-BOOT.md(12줄)를 Read하고 준수 — 전문 COMM-GUIDE.md 는 열지 않는다. 너의 세션명(me)=$name. 직전 작업 컨텍스트를 확인하고 이어가라."
    fi
    if [[ "$soft" -eq 1 ]]; then
      printf '  ✅ [#%s] %s (%s) 복원 완료 (프로세스 확인, UI 마커 지연)\n' "$idx" "$name" "$agent"
      restore_record "$idx" "$name" "$agent" "$proj" "soft" "$summary"
    else
      printf '  ✅ [#%s] %s (%s) 복원 완료\n' "$idx" "$name" "$agent"
      restore_record "$idx" "$name" "$agent" "$proj" "ok" "$summary"
    fi
    printf '     프로젝트: %s\n' "$proj"
    [[ -n "$work" ]] && printf '     작업: %s\n' "$work"
    [[ -n "$summary" ]] && printf '     이전 대화: %s\n' "$summary"
    [[ "${R_STATUS[$i]}" == "synth" ]] && printf '     모드: synth (alias 없이 model=%s 직접 기동)\n' "${R_MODEL[$i]}"
    printf '     attach: tmux attach -t %q\n' "$name"
  else
    printf '  ⚠️  [#%s] %s (%s) · %s — 기동 확인 실패(%ss)\n' \
      "$idx" "$name" "$agent" "$proj" "$(( ${TMUXC_RESTORE_READY_TRIES:-20} * 3 ))"
    [[ -n "$work" ]] && printf '     작업: %s\n' "$work"
    [[ -n "$summary" ]] && printf '     이전 대화: %s\n' "$summary"
    printf '     수동 확인: tmux attach -t %q\n' "$name"
    restore_record "$idx" "$name" "$agent" "$proj" "fail" "$summary"
  fi
}

cmd_restore() {
  local since=24 agent_filter="all" select_spec="" baton=0 go=0 loose=0
  local from="" force_scan=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --from) from="${2:-}"; shift 2 ;;
      --scan) force_scan=1; shift ;;
      --since) since="${2:-}"; shift 2 ;;
      --agent) agent_filter="${2:-}"; shift 2 ;;
      --select) select_spec="${2:-}"; shift 2 ;;
      --baton) baton=1; shift ;;
      --loose) loose=1; shift ;;
      --go) go=1; shift ;;
      --help|-h) usage; exit 0 ;;
      *) die "unknown option for restore: $1" ;;
    esac
  done
  case "$agent_filter" in claude|codex|all) ;; *) die "--agent must be claude|codex|all" ;; esac
  [[ -n "$from" && "$force_scan" -eq 1 ]] && die "--from 과 --scan 은 함께 쓸 수 없습니다"
  # r641: 계획 모드 안내를 출력 «끝» 이 아니라 맨 위에 — 표가 길면 끝 줄을 못 보고 실행된 줄 안다.
  if [[ "$go" -ne 1 ]] && ! [[ -z "$select_spec" && -t 0 ]]; then
    printf '(계획 모드 — 실행은 `tmuxc restore --select all --go` · 많으면 `ft-reboot-restore.sh`)\n'
  fi

  # 소스 결정: 명시 --from > (스냅샷 존재 && --scan 아님) > 로그 스캔
  local snap=""
  if [[ -n "$from" ]]; then
    if [[ "$from" == "latest" ]]; then
      snap="$SNAP_DIR/latest.json"
    else
      snap="$from"
    fi
    [[ -f "$snap" ]] || die "스냅샷을 찾을 수 없습니다: $snap"
  elif [[ "$force_scan" -eq 0 && -f "$SNAP_DIR/latest.json" ]]; then
    snap="$SNAP_DIR/latest.json"
  fi

  if tmux list-sessions >/dev/null 2>&1; then
    printf '⚠️  tmux 서버가 살아있습니다 (세션 %s개). 서버 사망(UC11)이 아니라 디스커넥트(UC8)일 수 있음 — cmux면 tmuxc recover 검토.\n' \
      "$(tmux list-sessions 2>/dev/null | wc -l | tr -d ' ')"
  fi

  if [[ -n "$snap" ]]; then
    restore_load_snapshot "$snap"
    if [[ "${#R_NAME[@]}" -eq 0 ]]; then
      printf '스냅샷에 세션이 없습니다: %s\n' "$snap"
      printf '  로그 스캔으로 전환: tmuxc restore --scan\n'
      return 0
    fi
    local created age
    created="${R_TS[0]}"
    age="$(snapshot_age_human "$created")"
    printf '📸 스냅샷 사용: %s (%s, %s개 세션)\n' "$(basename "$(readlink "$snap" 2>/dev/null || printf '%s' "$snap")")" "$age" "${#R_NAME[@]}"
    printf '   생성: %s   로그 스캔으로 전환: tmuxc restore --scan\n' "$created"
    case "$age" in
      *일\ 전) printf '⚠️  스냅샷이 오래됐습니다(%s) — 이후 생긴 세션은 빠집니다. `tmuxc restore --scan` 병행 검토.\n' "$age" ;;
    esac
  else
    restore_load_rows "$since" "$agent_filter" "$loose"
    if [[ "${#R_NAME[@]}" -eq 0 ]]; then
      printf '복구 후보 없음 (최근 %s시간, agent=%s). --since 를 늘려보세요.\n' "$since" "$agent_filter"
      case "$agent_filter" in
        codex|all)
          printf '  힌트: codex 대화형(cli) 세션은 thread_name 없이 익명으로 기록되는 경우가 있어, 최근 세션이 없으면 --since 168 처럼 늘려서 다시 시도해보세요.\n'
          ;;
      esac
      printf '  스냅샷이 있으면 더 정확합니다 — 평소 종료 전 `tmuxc save` 를 실행하세요.\n'
      return 0
    fi
    # 로그 스캔은 트랜스크립트에 없는 것을 복구할 수 없다 — 조용히 200K 로 되살리지 않도록 명시.
    printf '🔎 로그 스캔 경로 — 트랜스크립트에 [1m]·effort 가 기록되지 않아 %s\n' \
      '창 크기/effort 는 복원되지 않습니다.'
    printf '   다음부터는 종료 전 `tmuxc save` 로 스냅샷을 남기세요.\n'
  fi
  restore_print_table "$baton"

  if [[ -z "$select_spec" ]]; then
    if [[ "$go" -eq 1 ]]; then
      die "--go 는 --select 와 함께 사용하세요 (예: --select all --go)"
    fi
    if [[ -t 0 ]]; then
      printf '\n복구할 세션 선택 (예: 1,3,5 / all / claude / codex / q=종료): '
      read -r select_spec
      [[ -n "$select_spec" && "$select_spec" != "q" ]] || { printf '취소됨.\n'; return 0; }
      go=1
    else
      printf '\n(plan 모드 — 실행하려면: tmuxc restore --select all --go)\n'
      return 0
    fi
  fi

  local indices=()
  while IFS= read -r i; do indices+=("$i"); done < <(restore_expand_select "$select_spec")
  [[ "${#indices[@]}" -gt 0 ]] || { printf '선택된 세션 없음.\n'; return 0; }

  if [[ "$go" -ne 1 ]]; then
    printf '\n(plan 모드 — 선택 %d개. 실행하려면 --go 추가)\n' "${#indices[@]}"
    return 0
  fi

  printf '\n▶ %d개 세션 복원 시작\n' "${#indices[@]}"
  RESTORE_REP_IDX=() RESTORE_REP_NAME=() RESTORE_REP_AGENT=()
  RESTORE_REP_PROJ=() RESTORE_REP_OUTCOME=() RESTORE_REP_SUMMARY=()
  local i
  for i in "${indices[@]}"; do
    restore_one "$i" "$baton"
  done
  restore_print_final_report
}

# ---------- 입력줄 제출 (submit) ----------
#
# ★「미제출로 보이는 것」은 세 가지다★ (2026-09-01 실측 — ft-v65-tester-cc#12 / ft-v65-impl-cc#8).
#   ⑴ real           — 버퍼에 텍스트가 있는데 Enter 가 안 들어갔다. Enter 한 번이면 나간다.
#   ⑵ ghost-delivered — 이미 처리된 메시지의 낡은 행. 버퍼는 비었다. 건드리면 중복 발송이 된다.
#   ⑶ ghost-lost     — 타이핑이 앱에 도달하지 못했고 화면 행만 남았다. ★유실★.
#      Enter 를 눌러도 아무 일도 안 일어나 「Enter 가 또 씹혔다」로 오독되고, 그래서 증상이 안 바뀐다.
#
# 화면만으로는 셋이 구분되지 않는다. 판별은 두 축이다.
#   축1 «버퍼가 비었나» — ★문자 한 개를 넣어본다★. 잔상이면 옛 텍스트가 사라지고 그 문자만 남고,
#     진짜면 옛 텍스트 뒤에 그 문자가 붙는다. 되돌림이 어느 쪽이든 BSpace 정확히 한 번이라
#     원문을 재구성할 필요가 없다. BSpace 로 판별하면(지우고 그대로면 잔상) 진짜인 경우
#     마지막 글자를 복원해야 하는데, 한글 같은 멀티바이트가 캡처에서 잘리면 조용히 다른 글자가 된다.
#   축2 «전달됐나» — transcript(박스 위)에 그 문장이 있으면 처리된 것이고, 없으면 유실이다.
#     (실측: 유실 케이스는 60초를 기다려도 큐로 처리되지 않았다 — 큐잉이 아니라 소실이다.)
PROBE_CHAR="${TMUXC_PROBE_CHAR:-X}"

# 세션명 → pane_id 정확 매칭. `-t 세션명` 은 `#`-suffix 세션명에서 파싱 함정이 있다.
pane_id_of() {
  tmux list-panes -a -F '#{session_name}|#{pane_id}' 2>/dev/null \
    | awk -F'|' -v s="$1" '$1==s{print $2; exit}'
}

# 박스 «위»(=처리 이력)에 그 문장이 있는지. 잔상의 「전달됨 vs 유실」을 가르는 유일한 축.
transcript_has() {
  local pane="$1" text="$2"
  tmux capture-pane -t "$pane" -p 2>/dev/null | awk '
    { l[NR] = $0 }
    END {
      for (i = NR; i >= 1; i--)
        if (l[i] ~ /^─────/) { if (!b) { b = i } else { a = i; break } }
      if (!a) a = NR
      for (i = 1; i < a; i++) print l[i]
    }' | LC_ALL=C grep -aqF "$text"
}

# Enter 로 제출하고 «입력줄이 그 문장에서 벗어났는지»로 확인한다. 최대 3회.
submit_enter_loop() {
  local pane="$1" name="$2" text="$3" kind="$4" try after
  for try in 1 2 3; do
    tmux send-keys -t "$pane" Enter
    # ★3초 미만은 이르다★ — 제출됐는데 화면이 아직 옛 행이라 「실패」로 읽힌다(같은 날 오판 1회).
    sleep 3
    after="$(capture_input_line "$pane")" || after=""
    if [[ "$after" != "$text" ]]; then
      printf 'state=submitted kind=%s session=%s try=%s text=%q\n' "$kind" "$name" "$try" "$text"
      return 0
    fi
  done
  printf 'state=stuck kind=%s session=%s text=%q — Enter 3회 실패, 수동 확인\n' "$kind" "$name" "$text" >&2
  return 1
}

cmd_submit() {
  local name="" retype=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --retype) retype=1; shift ;;
      --*) die "unknown option for submit: $1" ;;
      *) [[ -z "$name" ]] || die "unexpected argument: $1"; name="$1"; shift ;;
    esac
  done
  [[ -n "$name" ]] || die "submit requires <name>"
  local pane
  pane="$(pane_id_of "$name")"
  [[ -n "$pane" ]] || die "session not found: $name"

  local before
  before="$(capture_input_line "$pane")" || die "입력 박스를 못 읽음(미지원 UI일 수 있음): $name"
  if [[ -z "$before" ]]; then
    printf 'state=empty session=%s — 제출할 내용 없음\n' "$name"
    return 0
  fi

  # 축1: 문자 한 개 주입 → 재도색된 «실제 버퍼»를 읽는다 → BSpace 로 즉시 되돌린다.
  local probed
  tmux send-keys -t "$pane" -l "$PROBE_CHAR"
  sleep 0.5
  probed="$(capture_input_line "$pane")" || probed=""
  tmux send-keys -t "$pane" BSpace
  sleep 0.3

  if [[ "$probed" == "$before$PROBE_CHAR" ]]; then
    submit_enter_loop "$pane" "$name" "$before" "real"
    return $?
  fi
  if [[ "$probed" != "$PROBE_CHAR" ]]; then
    printf 'state=unknown session=%s before=%q probed=%q — 판별 실패, 수동 확인\n' "$name" "$before" "$probed" >&2
    return 1
  fi

  # 축2: 버퍼는 비었다. transcript 로 「전달됨」과 「유실」을 가른다.
  if transcript_has "$pane" "$before"; then
    printf 'state=ghost-delivered session=%s text=%q — 전달됨. 낡은 행일 뿐이니 건드리지 마라.\n' "$name" "$before"
    return 0
  fi
  if [[ "$retype" -ne 1 ]]; then
    printf 'state=ghost-lost session=%s text=%q — ★유실★. Enter 를 눌러도 안 나간다. 되살리려면 --retype\n' "$name" "$before"
    return 0
  fi
  # --retype: 화면에 남은 그 문장이 곧 유실된 원문이다. 입력줄을 비우고 다시 쳐서 넣는다.
  tmux send-keys -t "$pane" C-u
  sleep 0.4
  tmux send-keys -t "$pane" -l "$before"
  sleep 0.4
  submit_enter_loop "$pane" "$name" "$before" "retyped"
}

main() {
  local cmd="${1:-}"
  [[ -n "$cmd" ]] || { usage; exit 1; }
  shift || true
  # 전 명령 공통 --host (r1047) — 없으면 지금 동작 그대로(R6). 인자 자리에서는 빠진다.
  local -a argv=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --host) TMUXC_HOST="${2:-}"; shift 2 || shift ;;
      --host=*) TMUXC_HOST="${1#--host=}"; shift ;;
      *) argv+=("$1"); shift ;;
    esac
  done
  set -- ${argv[@]+"${argv[@]}"}
  case "$cmd" in
    open|wt) cmd_open "$@" ;;
    fork) cmd_fork "$@" ;;
    list) cmd_list ;;
    attach)
      [[ -n "${1:-}" ]] || die "attach requires <name>"
      tmux attach -t "$1"
      ;;
    send) cmd_send "$@" ;;
    submit) cmd_submit "$@" ;;
    boot-enter) cmd_boot_enter "$@" ;;
    ask) cmd_ask "$@" ;;
    model)
      [[ -n "${1:-}" ]] || die "model requires <name>"
      # pi 등 신형 엔진은 probe가 --model/--thinking/session-id를 모두 안다.
      if _probe="$(session_agent_probe "$1" 2>/dev/null)" && [[ -n "$_probe" ]]; then
        printf '%s\n' "$_probe"
      else
        session_live_launch "$1" || die "session not live or model not found: $1"
      fi
      ;;
    probe)
      [[ -n "${1:-}" ]] || die "probe requires <name>"
      session_agent_probe "$1" || die "no known agent process found: $1"
      ;;
    msg)
      [[ -n "${1:-}" ]] || die "msg requires <name> <message>"
      local name="$1"
      shift
      cmd_send "$name" "$@"
      sleep 2
      cmd_ask "$name" 30
      ;;
    kill)
      [[ -n "${1:-}" ]] || die "kill requires <name>"
      if host_resolve "$1" "${TMUXC_HOST:-}"; then
        local krc=0
        hl h_run "$R_HOST" --write tmux kill-session -t "$R_SESS" || krc=$?
        [[ "$krc" -eq 0 ]] || die "remote kill 실패 rc=$krc: $R_HOST/$R_SESS"
        printf 'killed=%s/%s\n' "$R_HOST" "$R_SESS"
        return 0
      fi
      tmux kill-session -t "$1"
      ;;
    clean) cmd_clean ;;
    save|snapshot) cmd_save "$@" ;;
    restore) cmd_restore "$@" ;;
    help|--help|-h) usage ;;
    *) die "unknown command: $cmd" ;;
  esac
}

main "$@"
