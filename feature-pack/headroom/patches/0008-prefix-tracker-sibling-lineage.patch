+    @staticmethod
+    def _clone_tracker(tracker: PrefixCacheTracker) -> PrefixCacheTracker:
+        """Clone cache-relevant state before a lineage advances."""
+        clone = PrefixCacheTracker(tracker.provider, tracker.config)
+        clone._cached_token_count = tracker._cached_token_count
+        clone._cached_message_count = tracker._cached_message_count
+        clone._turn_number = tracker._turn_number
+        clone._last_activity = tracker._last_activity
+        # These lists are replaced, not mutated, by update_from_response();
+        # sharing them keeps bounded checkpoints from copying large histories.
+        clone._last_original_messages = tracker._last_original_messages
+        clone._last_forwarded_messages = tracker._last_forwarded_messages
+        clone._idle_seconds_at_fetch = tracker._idle_seconds_at_fetch
+        clone.read_maturation_manager = SessionTrackerStore._clone_read_maturation_manager(
+            tracker.read_maturation_manager
+        )
+        clone._busts_avoided = tracker._busts_avoided
+        clone._tokens_preserved = tracker._tokens_preserved
+        clone._compression_foregone_tokens = tracker._compression_foregone_tokens
+        return clone
+
+    @staticmethod
+    def _clone_read_maturation_manager(manager: Any) -> Any:
+        """Copy branch-local maturation markers without copying its store."""
+        if manager is None:
+            return None
+        clone = copy.copy(manager)
+        matured = getattr(manager, "_matured", None)
+        if isinstance(matured, dict):
+            clone._matured = dict(matured)
+        return clone
+
+    def _remember_lineage_checkpoint(
+        self,
+        session_id: str,
+        messages: list[Any],
+        tracker: PrefixCacheTracker,
+    ) -> None:
+        """Keep the prior prefix state while its active lineage grows."""
+        checkpoints = self._lineage_checkpoints.setdefault(session_id, OrderedDict())
+        key = f"{session_id}\x00checkpoint-{next(self._lineage_counter)}"
+        checkpoints[key] = _LineageCheckpoint(
+            messages=messages,
+            tracker=self._clone_tracker(tracker),
+        )
+        limit = max(1, self._default_config.max_lineages_per_session)
+        while len(checkpoints) > limit:
+            checkpoints.popitem(last=False)
+
+    def _find_lineage_checkpoint(
+        self,
+        session_id: str,
+        messages: list[Any],
+    ) -> _LineageCheckpoint | None:
+        """Find the newest longest saved prefix that contains this history."""
+        best: _LineageCheckpoint | None = None
+        best_len = -1
+        for checkpoint in reversed(self._lineage_checkpoints.get(session_id, {}).values()):
+            if checkpoint.tracker.is_expired:
+                continue
+            chain = checkpoint.messages
+            if len(chain) > len(messages) or len(chain) <= best_len:
+                continue
+            if messages[: len(chain)] == chain:
+                best = checkpoint
+                best_len = len(chain)
+        return best

