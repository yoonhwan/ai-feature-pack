#!/usr/bin/env bash
# ci — code-intel 단일 진입점 (하네스 불문: claude / codex / opencode / pi / hermes)
# probe(의미검색·AST·LSP) + tilth(심볼·호출자·토큰) 래퍼.
# 설계 원칙: 도구가 없으면 "안내 후 exit 0" — 에이전트를 블로킹하지 않는다.
set -uo pipefail

PROBE="${PROBE_BIN:-}"
TILTH="${TILTH_BIN:-}"

_resolve() { # $1=name  → echo path or empty
  local n="$1" p
  if command -v "$n" >/dev/null 2>&1; then command -v "$n"; return 0; fi
  for p in "$HOME/.local/bin/$n" "/opt/homebrew/bin/$n" "/usr/local/bin/$n"; do
    [ -x "$p" ] && { echo "$p"; return 0; }
  done
  return 1
}

PROBE="${PROBE:-$(_resolve probe || true)}"

# ── 부하 가드 (2026-10-23 tilth 585% 폭주 사고 후 추가) ────────────────────
#   · 모든 심볼/구조 검색은 CI_TIMEOUT(기본 60s) 안에서만 돈다
#   · scope 가 리포 루트(.git 존재)면 경고 — 하위 경로 지정을 유도
#   · 정말 필요하면 CI_ALLOW_HEAVY=1 CI_TIMEOUT=600 으로 예외
_guard_run() { # $@ = 실행할 명령
  local to="${CI_TIMEOUT:-60}"
  if [ "${CI_ALLOW_HEAVY:-0}" = "1" ]; then
    ( "$@" ) ; return $?
  fi
  timeout "$to" "$@"
  local rc=$?
  if [ "$rc" -eq 124 ]; then
    echo "[timeout] ${to}s 초과 — scope 를 좁히세요 (예: ci sym <sym> --scope <subdir>)." >&2
    echo "          전체 스캔이 필요하면 CI_ALLOW_HEAVY=1 CI_TIMEOUT=600 으로 실행." >&2
  fi
  return $rc
}
_scope_warn() { # $1 = scope path
  if [ -e "$1/.git" ]; then
    echo "[warn] scope 가 리포 루트입니다($1) — 하위 디렉터리를 지정하면 수십 배 빠릅니다." >&2
  fi
}

TILTH="${TILTH:-$(_resolve tilth || true)}"

die_missing() { # $1=tool  $2=install hint
  cat >&2 <<EOF
[warn] $1 미설치 — code-intel 계층 비활성 (블로킹하지 않음, rg/Read 로 계속 진행 가능)

  설치(레퍼런스: ~/.claude/skills/code-intel/references/*.md):
$2
EOF
  exit 0
}

need_probe() { [ -n "$PROBE" ] || die_missing probe "  curl -sL -o /tmp/p.tar.gz https://github.com/probelabs/probe/releases/download/v0.6.0-rc342/probe-v0.6.0-rc342-aarch64-apple-darwin.tar.gz
  tar xzf /tmp/p.tar.gz -C /tmp && cp /tmp/probe-v0.6.0-rc342-aarch64-apple-darwin/probe ~/.local/bin/"; }
need_tilth() { [ -n "$TILTH" ] || die_missing tilth "  npx -y tilth --version   # 캐시된 네이티브 바이너리를 ~/.local/bin/tilth 로 복사
  또는 cargo install tilth"; }

# ── LSP crash-loop 판정 (r1636) ───────────────────────────────────────────
#  probe 0.6.0 은 워크스페이스 캐시의 MVCC logical log 끝이 잘리면 기동 중 panic 한다("couldn't read
#  enough data") → 데몬 즉사 → 호출은 25초를 기다린다(하드 룰 12). 창(기본 120초) 안 DB crash 2회 이상 = crash-loop.
#  crash-log 에는 클라이언트 panic(예: md char-boundary f344d642)도 쌓인다 → 데몬 DB 열기 형태만 세고, 창 «안» 시각인 항목만 센다(보정 #282277).
#  $1=slow 이면 crash-log 없이도 Uptime 0s 2회 연속을 본다(doctor·refs 공통 판정). rc0=crash-loop · rc1=정상
_lsp_uptime() { "$PROBE" lsp status 2>/dev/null | sed -n 's/^ *Uptime: *//p' | head -1; }
_ep() { date -j -u -f '%Y-%m-%dT%H:%M:%S' "${1%%.*}" +%s 2>/dev/null || echo 0; }
_lsp_crash_state() {
  local f ents ts msg cnt last e now stamp
  f="${PROBE_LSP_CRASH_LOG:-$HOME/Library/Caches/probe/lsp-daemon-crashes.log}"; now="$(date +%s)"
  if [ -f "$f" ]; then
    ents="$(tail -c 8000 "$f" 2>/dev/null | awk '/^timestamp: /{ts=$2} /^message: /{if ($0 ~ /read enough data|core database|logical_log/) print ts "\t" substr($0,10)}')"
    cnt=0; last=""
    while IFS=$'\t' read -r ts msg; do
      e="$(_ep "$ts")"; [ "$e" -gt 0 ] && [ $((now - e)) -le "${CI_LSP_CRASH_LOOP_SEC:-120}" ] && { cnt=$((cnt+1)); last="$msg ($((now - e))s 전)"; }
    done <<< "$ents"
    [ "$cnt" -ge 2 ] && { echo "$last · 창 안 $cnt 회"; return 0; }
  fi
  [ "${1:-}" = "slow" ] || return 1
  stamp="${TMPDIR:-/tmp}/ci-lsp-uptime0.$(id -u)"
  case "$(_lsp_uptime)" in 0s|0sec|0secs) ;; *) rm -f "$stamp"; return 1 ;; esac
  [ -f "$stamp" ] && [ $((now - $(cat "$stamp" 2>/dev/null || echo 0))) -lt 120 ] && { echo "Uptime 0s 2회 연속"; return 0; }
  date +%s > "$stamp"; return 1
}

# LSP 계층은 온디맨드. CI_LSP_AUTO_INIT=1 이면 자동 init, 아니면 안내만.
_lsp_ensure() {
  command -v "${PROBE:-probe}" >/dev/null 2>&1 || return 0
  local cs st
  if cs="$(_lsp_crash_state slow)"; then echo "판정 불가 LSP 데몬 crash-loop — ci lsp repair ($cs)" >&2; exit 3; fi
  st="$("$PROBE" lsp status 2>/dev/null)"
  case "$st" in
    *"No language servers initialized"*|*"Status: Not"*|*"not connected"*|*"unavailable"*)
      if [ "${CI_LSP_AUTO_INIT:-0}" = "1" ]; then
        "$PROBE" lsp init -w "${CI_LSP_SCOPE:-$PWD}" >/dev/null 2>&1 || true
      else
        echo "[hint] LSP 미초기화 — 'ci lsp up --scope .' 1회 실행 (또는 CI_LSP_AUTO_INIT=1)" >&2
      fi
      ;;
  esac
}

usage() {
  cat <<'EOF'
ci — code-intel (probe + tilth)

  ci search "<query>" [path] [--max N]      의미/키워드 검색 (BM25 + AST 블록)
  ci sym <name> [--scope P] [--callers|--deps]
                                            심볼 정의/호출자/의존성 (정의 우선 정렬)
  ci outline <file> [--section S]           파일 아웃라인 (+토큰 수)
  ci refs "<file>#<sym>" [--json]           LSP 정밀 참조 (온디맨드)
  ci def "file#sym" | ci impl "file#sym"    LSP 정의 / 구현체
  ci ast '<pattern>' [path] [-l lang]       ast-grep 구조 패턴
  ci lsp up [--scope P] | down | status     LSP 데몬 수명주기
  ci lsp repair [--ws <이름>]               crash-loop 수리 — 캐시를 지우지 않고 .corrupt-<ts> 로 옮긴다 (lsp init 실패 = 1회 재시도)
  ci doctor                                 설치·버전·데몬·smoke 진단
  ci bench [--queries FILE]                 성능 회귀 (p50/p95)

  env: PROBE_BIN, TILTH_BIN 로 바이너리 강제 지정
EOF
}

# ── 실행 상한·search 단계 실행기 (r1850 · 카드 ci-search-nonascii-panic · ci-search-ascii-md-panic) ──
# 로컬 하네스 단계 상한(하드 룰 12) — GNU timeout 이 있을 때만 감싼다(없으면 그대로 실행).
#   $1=초 · $2..=명령 → 명령의 rc 를 그대로 돌려준다(timeout 이 걸리면 124).
_cap() {
  local to="$1"; shift
  if command -v timeout >/dev/null 2>&1; then timeout "$to" "$@"; else "$@"; fi
}

#  probe 0.6.0 은 결과 «출력» 단계에서 바이트로 자른다(src/search/search_output.rs:2566). 결과 줄에
#  다중 바이트 글자가 잘림 자리에 걸리면 파일 종류(.py)·질의 문자(ASCII)와 무관하게 panic 한다.
#  이 함수는 stdout 에 아무것도 쓰지 않는다 — 단계 출력은 $_SE_DIR 안 파일로만 받고(출력 보류 C8),
#  판정만 전역 SE_RC · SE_PANIC · SE_TIMEOUT 에 남긴다. 함수 rc 는 늘 0(판정은 세 전역으로만 본다).
_probe_search() { # $1=<q> $2=<path> $3=<max> $4=<단계 이름> [probe 추가 인자…]
  local q="$1" p="$2" mx="$3" st="$4"; shift 4
  SE_OUT="$_SE_DIR/out.$st"; SE_ERR="$_SE_DIR/err.$st"
  SE_TIMEOUT=0
  # K6(E6): probe 단계 상한 = min(CI_TIMEOUT, 25) · 정수 아니면 25 · probe --timeout 도 같은 값.
  local pt="${CI_TIMEOUT:-25}"
  case "$pt" in ''|*[!0-9]*) pt=25 ;; esac
  [ "$pt" -ge 1 ] || pt=25
  [ "$pt" -gt 25 ] && pt=25
  _cap "$pt" "$PROBE" search "$q" "$p" --max-results "$mx" --timeout "$pt" "$@" >"$SE_OUT" 2>"$SE_ERR" &
  wait $! 2>/dev/null   # 백그라운드+wait = 셸의 «Abort trap: 6» 통지를 삼킨다(경고 1줄 규칙 · 부분 출력 금지)
  SE_RC=$?
  SE_PANIC=0
  case "$SE_RC" in 101|133|134) SE_PANIC=1 ;; esac           # rc 만으로도 panic (stderr 가 빌 수 있다)
  grep -q "panicked at" "$SE_ERR" 2>/dev/null && SE_PANIC=1   # rc 0 이어도 panic (stderr 표지)
  [ "$SE_RC" -eq 124 ] && SE_TIMEOUT=1                        # timeout 이 걸렸다(E6 · panic 판정과 별개)
  return 0
}

# 결과 본문 자르기 = 문자 단위(바이트로 자르면 UTF-8 이 깨진다 — panic 의 원인과 같은 실수).
#   locale 무관(DA 4202 R2): cut -c 는 LC_ALL=C 에서 바이트를 자른다 → python3 로 UTF-8 디코드 뒤 문자로 자르고,
#   python3 가 없으면 바이트 160 으로 자른 뒤 iconv -c 로 불완전 꼬리를 떨어낸다(문자 수 ≤ 바이트 수 = 유효).
_cut160() {
  if [ -z "${_CUT_PY+x}" ]; then _CUT_PY="$(command -v python3 2>/dev/null || true)"; fi
  if [ -n "$_CUT_PY" ] && printf '%s' "$1" | "$_CUT_PY" -c 'import sys; sys.stdout.write(sys.stdin.buffer.read().decode("utf-8", "ignore")[:160])' 2>/dev/null; then
    return 0
  fi
  printf '%s' "$1" | LC_ALL=C cut -b1-160 | LC_ALL=C iconv -c -f UTF-8 -t UTF-8 2>/dev/null
}

# ---- 서브커맨드 파싱 -------------------------------------------------------
cmd="${1:-}"; shift || true

case "$cmd" in
  search)
    need_probe
    q="${1:?query required}"; shift || true
    path="."; max="5"
    while [ $# -gt 0 ]; do
      case "$1" in
        --max) max="$2"; shift 2 ;;
        *) path="$1"; shift ;;
      esac
    done
    # K1·K2·K5 (E1·E2·E5): probe 0.6.0 은 markdown 청커(src/language/markdown.rs:240)가 다중 바이트
    #   md 를 바이트로 잘라 panic(SIGABRT=134) 한다. 자리가 앞 카드(출력 단계)와 달라 폴백으로도 경고가
    #   남고, md 를 다 읽느라 7초 근처가 된다(timeout 7 이면 rc 124). 그래서 질의 문자와 상관없이
    #   probe 에는 md 를 늘 빼고(-i '*.md' = 제외) md 는 rg 절로 따로 찾는다(실측 2.89초 · panic 0).
    echo "[info] markdown 은 rg 로 분리 검색(probe panic 회피)" >&2
    md_excl=1

    # 출력 보류(D1a·C8): 어느 단계든 panic 이면 첫 단계 «No results found» 까지 버려야 하므로
    #   모든 단계의 stdout·stderr 를 임시 폴더에 받고, 판정(OR 재시도 여부)이 끝난 뒤 한 번에 낸다.
    _SE_DIR="$(mktemp -d "${TMPDIR:-/tmp}/ci-search.XXXXXX")" || { echo "판정 불가 ci search: 임시 폴더를 만들지 못했다" >&2; exit 3; }
    trap 'rm -rf "$_SE_DIR"' EXIT

    # 1단계 — 질의 종류와 상관없이 md 는 빼고 부른다(K1).
    _probe_search "$q" "$path" "$max" 1 -i '*.md'
    if [ "$SE_TIMEOUT" = 1 ]; then
      echo "판정 불가 ci search: probe 시간 초과 rc=124 — scope 를 좁히세요" >&2
      exit 124
    fi
    rc=$SE_RC; panic=$SE_PANIC; out1=$SE_OUT; err1=$SE_ERR
    panic_rc=$SE_RC; panic_err=$SE_ERR; orq=""

    # md 결과를 OR 재시도 «앞» 에 확보한다(DA 4202 R1) — 기준판은 md hit 이 있으면 rc1→0 보정을 먼저 해
    #   OR 를 부르지 않는다. 출력은 지금처럼 probe 출력 뒤에 낸다(순서 보존).
    # K3·K4 (E3·E4): 글자 그대로(-F · 낱말마다 -e · glob 확장 0) · RG_BIN → _resolve rg
    #   · 상한 min(CI_RG_TIMEOUT, 25) · 실패(rc ≥ 2 · 124)면 md 절 0 + 경고 1줄(probe 결과·rc 그대로).
    md_hits=""; md_bad=0; md_rg_rc=""
    read -ra md_words <<< "$q"
    set --; for w in "${md_words[@]}"; do set -- "$@" -e "$w"; done
    md_rg="${RG_BIN:-$(_resolve rg || true)}"
    md_rgt="${CI_RG_TIMEOUT:-25}"; case "$md_rgt" in ''|*[!0-9]*) md_rgt=25 ;; esac
    [ "$md_rgt" -ge 1 ] || md_rgt=25; [ "$md_rgt" -gt 25 ] && md_rgt=25
    if [ -z "$md_rg" ] || ! command -v "$md_rg" >/dev/null 2>&1; then
      md_bad=1; md_rg_rc="-"
    else
      _cap "$md_rgt" "$md_rg" -F -H -n --no-heading --color never -m 1 "$@" -g '*.md' -g '!**/.git/**' -- "$path" >"$_SE_DIR/md.out" 2>/dev/null
      md_rg_rc=$?
      if [ "$md_rg_rc" -eq 124 ] || [ "$md_rg_rc" -ge 2 ]; then md_bad=1; fi
    fi
    if [ "$md_bad" = 1 ]; then
      echo "[warn] markdown rg 실패 rc=$md_rg_rc" >&2
    else
      md_hits="$(head -n "$max" "$_SE_DIR/md.out" 2>/dev/null)"
    fi
    [ -n "$md_hits" ] && [ "$panic" -eq 0 ] && [ "$rc" -eq 1 ] && rc=0

    # D5: panic 이면 md 뺀 재시도 0(panic 자리가 md 청커가 아니라 출력 단계다).
    # D6: OR 재시도는 «첫 단계가 panic 아님 + rc1 + 질의에 공백» 일 때만.
    if [ "$panic" -eq 0 ] && [ "$rc" -eq 1 ] && printf '%s' "$q" | grep -q '[[:space:]]'; then
      orq="$(printf '%s' "$q" | tr -s '[:space:]' '\n' | grep -v '^$' | paste -sd '|' - | sed 's/|/ OR /g')"
      _probe_search "$orq" "$path" "$max" 2 -i '*.md'
      if [ "$SE_TIMEOUT" = 1 ]; then
        echo "판정 불가 ci search: probe 시간 초과 rc=124 — scope 를 좁히세요" >&2
        exit 124
      fi
      rc=$SE_RC; out2=$SE_OUT; err2=$SE_ERR
      if [ "$SE_PANIC" -eq 1 ]; then panic=1; panic_rc=$SE_RC; panic_err=$SE_ERR; md_excl=1; fi
    fi

    if [ "$panic" -eq 1 ]; then
      # ── D3 폴백: 부분 stdout 전부 버리고 rg 결과만 낸다 · stdout 첫 줄 = 표지 ──
      loc="$(sed -n 's/.*panicked at *//p' "$panic_err" 2>/dev/null | head -n 1)"
      [ -n "$loc" ] || loc="stderr 없음"
      dl="$(wc -l < "$out1" 2>/dev/null | tr -d ' ')"; [ -n "$dl" ] || dl=0
      if [ -n "${orq}" ] && [ -f "${out2:-}" ]; then dl=$((dl + $(wc -l < "$out2" | tr -d ' '))); fi
      echo "[warn] probe panic rc=$panic_rc ($loc) → rg 폴백 · 부분 출력 ${dl}줄 버림" >&2

      # 낱말 OR(-F 글자 그대로) · 파일당 1줄(-m 1) · 파일명 강제(-H · 단일 파일 갈래도 파일:줄)
      # 낱말 분리 = read -a (glob 확장 0 · DA 4202 R3) · rg 원래 rc 를 이 자리에서 바로 받는다(R2 · 파이프 0)
      read -ra words <<< "$q"
      set --; for w in "${words[@]}"; do set -- "$@" -e "$w"; done
      RG="${RG_BIN:-$(_resolve rg || true)}"
      rgt="${CI_RG_TIMEOUT:-25}"; case "$rgt" in ''|*[!0-9]*) rgt=25 ;; esac
      [ "$rgt" -ge 1 ] || rgt=25; [ "$rgt" -gt 25 ] && rgt=25     # 로컬 하네스 상한 25초(하드 룰 12)
      rgrc=""; failwhy=""
      if [ -z "$RG" ] || ! command -v "$RG" >/dev/null 2>&1; then
        failwhy="rg 없음 rc=-"
      else
        gopts=(-g '!**/.git/**'); [ "$md_excl" = 1 ] && gopts+=(-g "!*.md")   # panic 난 probe 가 md 를 뺐으면 rg 도 뺐다(C4)
        timeout "$rgt" "$RG" -H -n --no-heading --color never -F -m 1 "$@" "${gopts[@]}" -- "$path" >"$_SE_DIR/rg.out" 2>"$_SE_DIR/rg.err"
        rgrc=$?
        if [ "$rgrc" -eq 124 ]; then failwhy="시간 초과 rc=124"
        elif [ "$rgrc" -ge 2 ]; then failwhy="rg 실패 rc=$rgrc"
        fi
      fi
      # C3 실패 먼저 — stdout 전체 0줄(rg 가 낸 줄·md 절도 내지 않는다) · 134/133/101 그대로 내보냄 0
      if [ -n "$failwhy" ]; then
        echo "판정 불가 ci search: probe panic rc=$panic_rc · rg 폴백 실패($failwhy)" >&2
        exit 3
      fi
      echo "== rg 폴백 (probe panic rc=$panic_rc) =="
      if [ "$rgrc" -eq 1 ]; then
        echo "(0건)"; rc=1
      else
        head -n "$max" "$_SE_DIR/rg.out" | while IFS= read -r line; do
          f="${line%%:*}"; rest="${line#*:}"; ln="${rest%%:*}"; txt="${rest#*:}"
          printf '%s:%s\n  %s\n' "$f" "$ln" "$(_cut160 "$txt")"
        done
        rc=0
      fi
    else
      # ── panic 아님 = 지금과 같은 stdout·stderr·순서(C6) ──
      [ -s "$err1" ] && cat "$err1" >&2
      cat "$out1"
      if [ -n "$orq" ]; then
        echo "[hint] 0건 — AND 해석이었을 가능성. OR 재시도: $orq" >&2
        [ -s "${err2:-}" ] && cat "$err2" >&2
        cat "${out2:-}"
      fi
    fi

    # md 절 — 지금과 같은 자리(D8) · 결과는 위에서 이미 확보(R1)
    if [ -n "$md_hits" ]; then
      echo
      echo "== markdown (rg 폴백 · probe panic 회피) =="
      printf '%s\n' "$md_hits" | while IFS= read -r line; do
        f="${line%%:*}"; rest="${line#*:}"; ln="${rest%%:*}"; txt="${rest#*:}"
        printf '%s:%s\n  %s\n' "$f" "$ln" "$(_cut160 "$txt")"
      done
      [ "$rc" -eq 1 ] && rc=0
    fi
    exit "$rc"
    ;;

  sym)
    need_tilth
    name="${1:?symbol required}"; shift || true
    scope="."; mode=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --scope) scope="$2"; shift 2 ;;
        --callers) mode="--callers"; shift ;;
        --deps) mode="--deps"; shift ;;
        *) shift ;;
      esac
    done
    _scope_warn "$scope"
    _guard_run "$TILTH" "$name" $mode --scope "$scope"
    exit $?
    ;;

  outline)
    need_tilth
    f="${1:?file required}"; shift || true
    # r1832: 없는 파일 = tilth 0 · rc2(tilth 는 없는 경로를 검색어로 보고 리포 전체를 훑는다) · 상한 CI_OUTLINE_TIMEOUT(7초)
    [ -f "$f" ] || { echo "[ci] 파일 없음: $f" >&2; exit 2; }
    a=("$f"); [ "${1:-}" = "--section" ] && a+=(--section "$2")
    [ "${CI_ALLOW_HEAVY:-0}" = "1" ] && exec "$TILTH" "${a[@]}"
    to="${CI_OUTLINE_TIMEOUT:-7}"
    # exec = 신호 주인 GNU timeout 1개(바깥 TERM·INT·HUP 가 곧바로 닿음 · 그룹째 전달) · 안 bash 는 안내 1줄만
    exec timeout -s USR1 -k 1 "$to" bash -c 'trap "echo \"[timeout] ${0}s 초과 — ci outline <파일> --section <범위> 로 좁히세요.\" >&2; exit 124" USR1; "$@"; exit $?' "$to" "$TILTH" "${a[@]}"
    ;;

  refs)
    need_probe
    loc="${1:?location 'file#symbol' or 'file:line:col' required}"; shift || true
    fmt="terminal"; [ "${1:-}" = "--json" ] && fmt="json"
    _lsp_ensure
    exec "$PROBE" lsp call references "$loc" --format "$fmt"
    ;;

  def|impl|type|hover)
    need_probe
    loc="${1:?location required}"; shift || true
    case "$cmd" in
      def) m="definition" ;; impl) m="implementations" ;;
      type) m="type-definition" ;; hover) m="hover" ;;
    esac
    _lsp_ensure
    exec "$PROBE" lsp call "$m" "$loc"
    ;;

  ast)
    need_probe
    pat="${1:?pattern required}"; shift || true
    path="."; lang=""; rawlang=""
    while [ $# -gt 0 ]; do
      case "$1" in
        -l|--language) rawlang="$2"; lang="-l $2"; shift 2 ;;
        *) path="$1"; shift ;;
      esac
    done
    out="$("$PROBE" query "$pat" "$path" $lang 2>&1)"; prc=$?
    # 폴백 사유 2종 → ast-grep: ① r1706 probe 이상 종료(panic·signal · rc≠0 — 그 출력은 stderr 로만) ② probe 0.6.0-rc342 가 python 등에서 0건으로 샘
    why=""
    if [ "$prc" -ne 0 ]; then
      why="probe rc=$prc"; printf '%s\n' "$out" >&2
    else
      printf '%s\n' "$out"
      case "$out" in *"No results found"*) why="probe query 0건" ;; esac
    fi
    if [ -n "$why" ]; then
      SG="${ASTGREP_BIN:-$(command -v ast-grep || command -v sg || true)}"
      if [ -n "$SG" ] && command -v "$SG" >/dev/null 2>&1; then
        case "$rawlang" in
          py) sl=python ;; rs) sl=rust ;; ts) sl=typescript ;; js) sl=javascript ;;
          tsx) sl=tsx ;; go) sl=go ;; *) sl="${rawlang:-python}" ;;
        esac
        echo "[fallback] ast-grep 사용 ($why) — lang=$sl" >&2
        _guard_run "$SG" run -p "$pat" -l "$sl" "$path"
        exit $?
      fi
      [ "$prc" -eq 0 ] || { echo "판정 불가 ci ast: probe rc=$prc · ast-grep 없음" >&2; exit 3; }
      echo "[hint] probe query 가 0건입니다. ast-grep 설치를 권장: brew install ast-grep" >&2
    fi
    ;;

  lsp)
    need_probe
    sub="${1:-status}"; shift || true
    case "$sub" in
      up)
        scope="."
        [ "${1:-}" = "--scope" ] && { scope="$2"; shift 2; }
        exec "$PROBE" lsp init -w "$scope"
        ;;
      down)   exec "$PROBE" lsp shutdown ;;
      status) exec "$PROBE" lsp status ;;
      repair)
        wsroot="${PROBE_LSP_WORKSPACE_CACHE_DIR:-$HOME/Library/Caches/probe/lsp/workspaces}"; only=""
        [ "${1:-}" = "--ws" ] && { only="$2"; shift 2; }
        "$PROBE" lsp shutdown >/dev/null 2>&1 || { echo "판정 불가 repair — lsp shutdown rc≠0 · 아무것도 옮기지 않았다" >&2; exit 3; }
        ts="$(date +%Y%m%d%H%M%S)"; moved=0
        for d in "$wsroot"/*; do
          [ -d "$d" ] && [ -f "$d/cache.db-log" ] || continue; case "$d" in *.corrupt-*) continue;; esac
          [ -n "$only" ] && [ "$(basename "$d")" != "$only" ] && continue
          mv "$d" "$d.corrupt-$ts" 2>/dev/null || { echo "판정 불가 repair — 옮기기 실패(지우지 않았다): $d" >&2; exit 3; }
          echo "옮김: $d → $d.corrupt-$ts"; moved=$((moved+1))
        done
        for n in 1 2; do "$PROBE" lsp init -w "${CI_LSP_SCOPE:-$PWD}" >/dev/null 2>&1 && break; [ "$n" = 2 ] && { echo "판정 불가 repair — lsp init rc≠0 2회 (옮긴 캐시 $moved 개 · 되돌림 = 이름 되돌리기)" >&2; exit 3; }; done
        up="$("$PROBE" lsp status 2>/dev/null | sed -n 's/^ *Uptime: *//p' | head -1)"
        case "$up" in ""|0s|0sec|0secs) echo "판정 불가 repair — 데몬이 Uptime>0 으로 서지 않았다 (status: ${up:-none})" >&2; exit 3 ;; esac
        echo "repair OK — 데몬 Uptime $up · 옮긴 워크스페이스 $moved 개"; exit 0
        ;;
      *)      exec "$PROBE" lsp "$sub" ;;
    esac
    ;;

  doctor)
    echo "== code-intel doctor =="
    printf "probe : %s\n" "${PROBE:-MISSING}"
    [ -n "$PROBE" ] && printf "        %s\n" "$("$PROBE" --version 2>/dev/null | head -1)"
    printf "tilth : %s\n" "${TILTH:-MISSING}"
    [ -n "$TILTH" ] && printf "        %s\n" "$("$TILTH" --version 2>/dev/null | head -1)"
    printf "pylsp : %s\n" "$(_resolve pylsp || echo 'MISSING (probe lsp python 불가)')"
    if [ -n "$PROBE" ]; then
      cs="$(_lsp_crash_state slow)" && { printf "lsp   : CRASH-LOOP %s · 다음: ci lsp repair\nsmoke : (생략 — 데몬 crash-loop)\n" "$cs"; exit 3; }
      # doctor 는 진단만 — status 가 데몬을 자동 기동시키면 즉시 내려 상주를 남기지 않는다
      pre_lsp="$(pgrep -f "probe lsp start" | wc -l | tr -d ' ')"
      printf "lsp   : %s\n" "$("$PROBE" lsp status 2>/dev/null | tr '\n' ' ' | cut -c1-90)"
      [ "$pre_lsp" = "0" ] && "$PROBE" lsp shutdown >/dev/null 2>&1
      printf "smoke : "
      out="$("$PROBE" search "function OR def" . --max-results 1 2>/dev/null | head -3 | tr '\n' ' ')"
      [ -n "$out" ] && echo "OK" || echo "EMPTY(정상: 빈 디렉터리일 수 있음)"
    fi
    exit 0
    ;;

  bench)
    need_probe; need_tilth
    qf="$HOME/.claude/skills/code-intel/references/queries.txt"
    [ "${1:-}" = "--queries" ] && qf="$2"
    echo "bench: $qf  ($( [ -f "$qf" ] && wc -l <"$qf" || echo 0) queries)"
    [ -f "$qf" ] || { echo "  (queries 파일 없음 — references/queries.txt 참조)"; exit 0; }
    n=0
    while IFS= read -r q; do
      [ -z "$q" ] && continue
      n=$((n+1))
      s=$( { /usr/bin/time -p "$PROBE" search "$q" . --max-results 3 >/dev/null; } 2>&1 | awk '/^real/{print $2}')
      printf "  %-46s probe %ss\n" "$(echo "$q" | cut -c1-46)" "$s"
    done < "$qf"
    exit 0
    ;;

  ""|-h|--help|help) usage; exit 0 ;;
  *) echo "unknown: $cmd" >&2; usage; exit 2 ;;
esac
