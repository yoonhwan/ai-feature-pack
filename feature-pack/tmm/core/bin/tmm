#!/usr/bin/env bash
# tmm — 모바일(Termius/SSH) 전용 tmux 좌석 TUI. 폰 60~80열 기준. fzf 기반 커서 이동·필터·미리보기.
#   tmm              TUI 피커 (↑↓ 커서 · 타이핑=필터 · Enter=attach · 아래 키 참조)
#   tmm ls [PAT]     텍스트 목록 (비대화용)
#   tmm a NAME [-i]  attach (기본 폰 크기 추종 · -i 면 데스크탑 크기 고정+점 채움)
#   tmm p NAME [N]   pane 최근 N줄 (기본 30)
#   tmm s NAME MSG   메시지 (에이전트 없는 좌석 차단 + 도달확인)
#   tmm ss           전 좌석 상태 스캔 (seat-scan)
#   tmm h            HUMAN/BLOCK/STUCK 좌석만
#   tmm save         tmuxc save
#   tmm menu         숫자 메뉴 (fzf 없을 때 폴백)
#   tmm doctor       의존성·환경 점검
#   tmm dead [PAT] [--since H] [--all]   종료된 세션 목록 (재부팅·kill 로 사라진 좌석 — tmuxc 미관리 포함)
#   tmm dp NAME|SID [N]                  종료 세션의 마지막 대화 N줄
#   tmm restore NAME [--dry-run]         종료 세션 1건 복구 (resume) → attach
#   tmm restore-all [--since H] [--dry-run] [--yes]   창 안 종료 세션 «전부» 복구 — 5개씩 배치 병렬(TMM_RESTORE_BATCH), 결과 $RUN/restore-<ts>.log(ok|fail) — tmuxc restore --scan --loose 의 폰판
#
# TUI 키:  Enter/^E attach · ^S 메시지 · ^H 대기좌석만 · ^A 전체 · ^T 최근순 · ^W 대기우선 · ^G 카테고리순
#          ^R 새로고침 · ^U 미리보기 자동갱신 5/10/15초 · ^P 미리보기 토글 · ^O 크게/작게 · ^X 종료 · ^/ 도움말(? 는 필터 문자)
# 뷰 전환: ^D = 종료된 세션 뷰(«종료>») ↔ ^A = 살아있는 좌석 뷰(«좌석>»). 완전 전환 — 목록·미리보기·Enter 의미가 바뀐다.
#          종료 뷰: 진입 12h 창, ^] +12h / ^\ -12h, ^L 계보 전체↔최신만. Enter = resume 복구 후 attach.
#          ^B = 창 안 «전부» 일괄 복구(확인 y 후, attach 없음). 창을 ^] 로 넓히고 ^B 를 다시 누르면 새로 드러난 것만 이어서.
#          상태 열 = 출처 배지 SNAP(스냅샷 argv 완제품)/CC/CDX/CMD/OC. ^W 는 SNAP 우선. 마커 ◌ = 종료.
# 복구 모델: 스냅샷이면 그 argv, 아니면 트랜스크립트 model + effort high. ★fable 계열 제외 전부 [1m]★ (작은 창 금지)
# 정렬:   기본 = 마지막 응답 시각 역순(진입 시 최신 대화가 맨 위). ^W = 대기(HUMAN/BLOCK/STUCK) 상단 고정 후 최근순.
#          ^G = 카테고리 묶음 안 최근순. ^H = 대기 좌석만 필터.
# 시각:   claude "done 오후 H:MM" 마커 1순위(`12:34`), 없으면 tmux window_activity(`12~34`)
# 자동갱신: 2단 — 커서 좌석 미리보기는 ^U 로 5/10/15초 순환(기본 5), 전좌석 목록(상태·시각)은 20초 고정.
#          attach 중엔 멈추고 떼면 재개. 새로 HUMAN/BLOCK/STUCK 이 된 좌석이 생기면 터미널 벨.
#
# 환경변수:
#   TMM_CATEGORIES   카테고리 규칙 파일 (기본 ~/.tmm/categories) — "glob<TAB>라벨" 한 줄씩, 위에서부터 첫 매치
#   TMM_SCAN         seat-scan 스크립트 경로 (기본: 설치본 libexec → ~/.claude/skills/tmuxc/scripts)
#   TMM_CACHE_TTL    상태 스캔 캐시 초 (기본 20). 폰에서 ^R/필터 반복 시 재스캔 부하 방지. 0=항상 재스캔
#   TMM_PREVIEW_LINES 미리보기 줄 수 (기본 40). 색 유지·입력박스/statusline 제거·최신(바닥)부터 표시
#   TMM_AUTO_PREVIEW 커서 좌석 미리보기 자동 갱신 초 (기본 5, 0=off). `tmm --auto N` 과 같음. TUI 안에서 ^U 로 5/10/15 순환
#   TMM_AUTO         전좌석 목록 자동 갱신 초 (기본 20 고정, 0=off). ^U 로는 안 바뀐다 — seat-scan 부하 상한
#   TMM_BELL         새 대기 좌석 벨 (기본 1, 0=끔)
set -uo pipefail
export PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"

# ★SELF/HERE 는 «지금 실행 중인 파일» 기준★ — command -v tmm 을 쓰면 소스 트리에서 돌려도 설치본(~/.tmm)의
#   libexec 를 찾아가 verify·개발이 설치본과 섞인다(0.4.0 실측: dead-scan 미발견 → 0건). $0 을 심링 해석해 푼다.
#   BASH_SOURCE 를 쓴다 — `source tmm __lib`(병렬 워커) 에서는 $0 이 "bash" 다.
#   심링은 2단(~/.local/bin/tmm → ~/.tmm/current → versions/N)이라 readlink -f 로 끝까지 푼다 (macOS 12.3+/GNU 둘 다).
SELF="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || printf '%s' "${BASH_SOURCE[0]}")"
HERE="$(cd "$(dirname "$SELF")" && pwd)"; SELF="$HERE/$(basename "$SELF")"
SCAN="${TMM_SCAN:-}"
[ -n "$SCAN" ] || for c in "$HERE/../libexec/seat-scan.sh" "$HOME/.claude/skills/tmuxc/scripts/seat-scan.sh"; do
  [ -f "$c" ] && { SCAN="$c"; break; }
done
CAT_FILE="${TMM_CATEGORIES:-$HOME/.tmm/categories}"
CACHE_TTL="${TMM_CACHE_TTL:-20}"
CACHE="${TMPDIR:-/tmp}/tmm-scan-$(id -u).cache"
PREVIEW_LINES="${TMM_PREVIEW_LINES:-40}"
AUTO="${TMM_AUTO:-20}"; AUTO_PREVIEW="${TMM_AUTO_PREVIEW:-5}"; BELL="${TMM_BELL:-1}"
AUTO_PRESETS="5 10 15"
DEAD_SCAN="$HERE/../libexec/tmm-dead-scan.py"
DEAD_SINCE0="${TMM_DEAD_SINCE:-12}"
# TUI 상태(정렬 모드·자동 갱신 초·직전 대기 좌석 집합·벨 플래그) — fzf 바인딩과 백그라운드 핑거가 파일로 공유.
# ★인스턴스별★ — 폰·데스크탑에서 tmm 을 여럿 띄우면 한쪽 ^U/^W 가 다른 쪽 자동 갱신을 바꾸므로 TUI 마다 run-<pid>/.
# fzf 가 띄우는 바인딩 자식은 env 를 물려받으니 TMM_RUN 으로 자기 디렉터리를 안다. 캐시는 공유(그냥 캐시).
STATE="${TMPDIR:-/tmp}/tmm-$(id -u)"; RUN="${TMM_RUN:-$STATE}"; mkdir -p "$RUN"
[ "${1:-}" = --auto ] && { AUTO_PREVIEW="${2:-5}"; shift 2; }

# ---------- 카테고리 ----------
# 규칙 파일이 있으면 그것을, 없으면 세션명 접두(문자·숫자·_·- 중 첫 토큰)를 카테고리로.
cat_of() {
  local n="${1%%#*}" glob label
  if [ -f "$CAT_FILE" ]; then
    while IFS=$'\t' read -r glob label; do
      [ -z "$glob" ] || [ "${glob#\#}" != "$glob" ] && continue
      # shellcheck disable=SC2254
      case "$n" in $glob) printf '%s' "$label"; return;; esac
    done < "$CAT_FILE"
  fi
  n="${n%%[-_]*}"; printf '%s' "${n:0:5}"
}

# ---------- 상태 스캔 (캐시) ----------
# seat-scan 은 좌석당 capture 2회라 65좌석에 ~2초. 폰에서 필터/^R 을 연타해도 TTL 안에서는 재사용.
scan_cached() {
  [ -n "$SCAN" ] || { return 0; }
  if [ "$CACHE_TTL" -gt 0 ] && [ -f "$CACHE" ]; then
    local age=$(( $(date +%s) - $(stat -f %m "$CACHE" 2>/dev/null || stat -c %Y "$CACHE") ))
    [ "$age" -lt "$CACHE_TTL" ] && { cat "$CACHE"; return; }
  fi
  # 캐시는 인스턴스 간 공유 — 폰·PC 가 동시에 갱신하면 같은 .tmp 를 놓고 경합해 «mv: No such file» 이 튄다(실측).
  # 프로세스별 임시 파일로 쓰고 mv 는 조용히 — 진 쪽은 이긴 쪽의 결과를 읽으면 되니 실패해도 무해.
  local tmp="$CACHE.$$.tmp"
  bash "$SCAN" 2>/dev/null > "$tmp"; mv -f "$tmp" "$CACHE" 2>/dev/null || rm -f "$tmp"; cat "$CACHE" 2>/dev/null
}
scan_fresh() { rm -f "$CACHE"; scan_cached; }

# 대기(사람이 봐야 할) 상태 = 항상 최상단 고정
wait_rank() { case "$1" in HUMAN) echo 0;; BLOCK) echo 1;; STUCK) echo 2;; *) echo 5;; esac; }

# ---------- 마지막 메시지 시각 ----------
# 1순위 claude 완료 마커 "done 오후 12:56"(줄바꿈 분리 대비 공백 병합),
# 2순위 tmux window_activity(pane 마지막 출력 — idle 좌석은 안 움직이므로 유효, BUSY 좌석은 ≈now).
last_epoch() {  # $1 session  $2 window_activity  $3 midnight_epoch  $4 now  →  "epoch <:|~>"
  local txt ampm h m t
  txt="$(tmux capture-pane -t "=$1:" -p -S -300 2>/dev/null | tr -s '\n ' '  ')"
  # 한국어 로케일 "done 오후 12:56" / 영어 로케일 "done 12:56 PM" 둘 다
  if [[ "$txt" =~ done\ +(오전|오후)\ +([0-9]{1,2}):([0-9]{2}) ]]; then
    ampm="${BASH_REMATCH[1]}"; h=$((10#${BASH_REMATCH[2]})); m=$((10#${BASH_REMATCH[3]}))
  elif [[ "$txt" =~ done\ +([0-9]{1,2}):([0-9]{2})\ +(AM|PM) ]]; then
    h=$((10#${BASH_REMATCH[1]})); m=$((10#${BASH_REMATCH[2]})); ampm="${BASH_REMATCH[3]}"
  else
    echo "${2:-0} ~"; return
  fi
  { case "$ampm" in 오후|PM) [ $h -lt 12 ] && h=$((h+12));; 오전|AM) [ $h -eq 12 ] && h=0;; esac; } || true
  if true; then
    t=$(( $3 + h*3600 + m*60 )); [ $t -gt $(( $4 + 120 )) ] && t=$((t-86400))
    echo "$t :"
  fi
}
age_of() {  # 상대 나이 3자: 3m / 2h / 1d
  local d=$(( $2 - $1 ))
  [ "$1" -le 0 ] && { echo "  -"; return; }
  if [ $d -lt 3600 ]; then printf '%2dm' $((d/60)); elif [ $d -lt 86400 ]; then printf '%2dh' $((d/3600)); else printf '%2dd' $((d/86400)); fi
}
midnight() { date -v0H -v0M -v0S +%s 2>/dev/null || date -d 'today 00:00' +%s; }
fmt_hm()   { date -r "$1" "+%H$2%M" 2>/dev/null || date -d "@$1" "+%H$2%M" 2>/dev/null || echo '--:--'; }

# ---------- 모델 표기 ----------
# 폰 60열에 맞춰 8자 안으로: claude-opus-5[1m]→opus5·1m · claude-sonnet-5→sonn5 · claude-fable-5-1→fabl51 · gpt-5.6-luna→luna
# gpt-6-astra→astra · gpt-5.6-terra→terra. 알 수 없으면 뒤 7자.
model_short() {
  local m="$1" ctx=""
  case "$m" in *\[1m\]*) ctx="·1m"; m="${m%%\[*}";; esac
  case "$m" in
    claude-opus-*)   m="opus${m#claude-opus-}";;
    claude-sonnet-*) m="sonn${m#claude-sonnet-}";;
    claude-haiku-*)  m="haik${m#claude-haiku-}";;
    claude-fable-*)  m="fabl${m#claude-fable-}";;
    gpt-*-*)         m="${m##*-}";;          # gpt-5.6-luna → luna, gpt-6-astra → astra
    "")              m="?";;
  esac
  m="${m//-/}"; printf '%s%s' "${m:0:6}" "$ctx"
}
# 라이브 좌석의 모델: pane 자식 프로세스 argv 의 --model / -c model= (tmuxc model 과 같은 정본). codex 에 -c model 이 없으면 config 기본.
live_model_of() {  # pane_pid [session]
  local c m; c="$(pgrep -P "$1" 2>/dev/null | head -1)"; [ -n "$c" ] || { printf ''; return; }
  m="$(ps -o args= -p "$c" 2>/dev/null | sed -nE 's/.*(--model[ =]|-c model=)"?([^" ]+)"?.*/\2/p' | head -1)"
  # codex 가 config 기본 모델로 떴으면 argv 에 없다 → pane 하단 «gpt-6-astra medium fast» 에서 읽는다
  [ -z "$m" ] && [ -n "${2:-}" ] && m="$(tmux capture-pane -t "=$2:" -p 2>/dev/null | grep -oE '\bgpt-[0-9.]+-[a-z]+\b' | tail -1)"
  printf '%s' "$m"
}

# ---------- rows ----------
# rows [time|wait|cat] [h] [fresh]  →  "표시줄\t세션명\t카테고리"
# tmux 호출 2회(list-panes -a + seat-scan) + 좌석당 capture 1회(시각). 좌석별 display/list-panes 루프 금지.
cmd_rows() {
  local mode="${1:-time}" only="${2:-}" fresh="${3:-}" s st cwd cat pcmd live act ep src now mid
  declare -A ST
  if [ "$fresh" = fresh ]; then
    while read -r name state _; do ST["$name"]="$state"; done < <(scan_fresh)
  else
    while read -r name state _; do ST["$name"]="$state"; done < <(scan_cached)
  fi
  wait_delta
  now=$(date +%s); mid=$(midnight)
  # 시각 추출은 좌석당 capture 1회 — 직렬이면 부하 시 1~2초라 8병렬로 (순서 무관, 뒤에서 sort)
  declare -A EP MD
  while IFS=$'\t' read -r s ep src md; do EP["$s"]="$ep $src"; MD["$s"]="$md"; done < <(
    tmux list-panes -a -F $'#{session_name}\t#{window_activity}\t#{pane_pid}' 2>/dev/null | awk -F'\t' '!seen[$1]++' \
    | xargs -P 8 -L 1 bash -c 'source "$0" __lib; e="$(last_epoch "$3" "$4" "$1" "$2")"; printf "%s\t%s\t%s\t%s\n" "$3" "${e%% *}" "${e##* }" "$(live_model_of "$5" "$3")"' "$SELF" "$mid" "$now" 2>/dev/null
  )
  while IFS=$'\t' read -r s pcmd act cwd; do
    st="${ST[$s]:-?}"
    [ "$only" = "h" ] && ! [[ "$st" =~ ^(HUMAN|BLOCK|STUCK)$ ]] && continue
    case "$pcmd" in zsh|bash|sh|fish|-zsh|-bash) live="○";; *) live="●";; esac
    cwd="${cwd##*/}"; cat="$(cat_of "$s")"; read -r ep src <<<"${EP[$s]:-$act ~}"
    printf '%s\t%s\t%s\t%-5s %s %-20s %-5s %-8s %s %s %s\t%s\t%s\n' \
      "$(wait_rank "$st")" "$ep" "$cat" \
      "$cat" "$live" "${s:0:20}" "$st" "$(model_short "${MD[$s]:-}")" "$(fmt_hm "$ep" "$src")" "$(age_of "$ep" "$now")" "${cwd:0:6}" \
      "$s" "$cat"
  done < <(tmux list-panes -a -F $'#{session_name}\t#{pane_current_command}\t#{window_activity}\t#{pane_current_path}' 2>/dev/null | awk -F'\t' '!seen[$1]++') \
  | { case "$mode" in
        cat)  sort -t$'\t' -k3,3 -k2,2nr;;            # 카테고리 → 최근순
        wait) sort -t$'\t' -k1,1n -k2,2nr;;           # 대기(HUMAN/BLOCK/STUCK) 상단 고정 → 최근순
        *)    sort -t$'\t' -k2,2nr;;                  # time(기본): 마지막 응답 역순 — 진입 시 최신 대화가 맨 위
      esac; } | cut -f4-
}

# 직전 스캔 대비 «새로» 대기(HUMAN/BLOCK/STUCK)가 된 좌석이 있으면 벨 플래그. 호출자(cmd_rows)의 ST 를 읽는다.
# 첫 스캔(비교 대상 없음)은 기록만 — 진입하자마자 기존 대기 좌석으로 울리지 않게.
wait_delta() {
  local k cur
  cur="$(for k in "${!ST[@]}"; do [[ "${ST[$k]}" =~ ^(HUMAN|BLOCK|STUCK)$ ]] && echo "$k"; done | sort)"
  if [ -f "$RUN/waitset" ]; then
    comm -23 <(printf '%s\n' "$cur") "$RUN/waitset" | grep -q . && : > "$RUN/bell"
  fi
  printf '%s\n' "$cur" > "$RUN/waitset"
}

# 정렬 모드는 파일에 남긴다 — ^R·자동 갱신이 «현재 모드»로 다시 그리게 (전엔 ^R 이 늘 time 으로 되돌렸다)
cmd_mode()     { printf '%s %s\n' "$1" "${2:-}" > "$RUN/mode"; }
cmd_rows_cur() {  # ★뷰를 따라간다★ — ^R·20초 자동 갱신이 여기만 부르므로, dead 뷰인데 live 목록으로 되돌아가면 안 된다
  local m o; { read -r m o < "$RUN/mode"; } 2>/dev/null
  if [ "$(view_now)" = dead ]; then cmd_dead_rows "${m:-time}" "${1:-}"; else cmd_rows "${m:-time}" "${o:-}" "${1:-}"; fi
}
view_now()  { cat "$RUN/view" 2>/dev/null || echo live; }
since_now() { cat "$RUN/since" 2>/dev/null || echo "$DEAD_SINCE0"; }
gen_now()   { cat "$RUN/gen" 2>/dev/null || echo latest; }
cmd_view()  { printf '%s\n' "$1" > "$RUN/view"; }
cmd_since() { local c; c="$(since_now)"; case "$1" in +) c=$((c+12));; -) c=$((c-12)); [ $c -lt 12 ] && c=12;; *) c="$1";; esac; printf '%s\n' "$c" | tee "$RUN/since"; }
cmd_gen()   { [ "$(gen_now)" = latest ] && echo all > "$RUN/gen" || echo latest > "$RUN/gen"; cat "$RUN/gen"; }

# ---------- 종료된 세션 (dead 뷰) ----------
# 스캐너(python, 읽기 전용)가 tsv 를 만들고 $RUN/dead.tsv 에 캐시 — 미리보기·복구가 같은 파일을 읽는다(재스캔 없음).
dead_tsv() {  # [fresh]
  local f="$RUN/dead.tsv" live
  if [ "${1:-}" != fresh ] && [ -f "$f" ] && [ $(( $(date +%s) - $(stat -f %m "$f" 2>/dev/null || stat -c %Y "$f") )) -lt "$CACHE_TTL" ]; then cat "$f"; return; fi
  live="$(tmux ls -F '#S' 2>/dev/null | tr '\n' ' ')"
  # shellcheck disable=SC2086
  python3 "$DEAD_SCAN" scan --since "$(since_now)" $([ "$(gen_now)" = all ] && echo --all-gen) --live $live > "$f.tmp" 2>/dev/null && mv -f "$f.tmp" "$f"
  cat "$f" 2>/dev/null
}
# 표시줄: 카테고리 ◌ 이름(22) 배지(5) 시각 나이 cwd(14)  — live 와 같은 폭. 키 필드(2)=세션명, 3=카테고리
cmd_dead_rows() {  # [time|wait|cat] [fresh]
  local mode="${1:-time}" now line src name cwd lm la cat md
  now=$(date +%s)
  while IFS= read -r line; do
    src="$(printf '%s' "$line" | cut -f1)"; name="$(printf '%s' "$line" | cut -f3)"; cwd="$(printf '%s' "$line" | cut -f4)"
    lm="$(printf '%s' "$line" | cut -f7)"; la="$(printf '%s' "$line" | cut -f8)"; md="$(printf '%s' "$line" | cut -f6)"
    [ -n "$name" ] || continue
    cat="$(cat_of "$name")"
    printf '%s\t%s\t%s\t%-5s ◌ %-20s %-5s %-8s %s %s %s\t%s\t%s\n' \
      "$([ "$src" = SNAP ] && echo 0 || echo 5)" "$la" "$cat" \
      "$cat" "${name:0:20}" "$src" "$(model_short "$(with_1m_if_claude "$md")")" "$(fmt_hm "${lm:-0}" :)" "$(age_of "${la:-0}" "$now")" "$(basename "$cwd" | cut -c1-6)" \
      "$name" "$cat"
  done < <(dead_tsv "${2:-}") \
  | { case "$mode" in
        cat)  sort -t$'\t' -k3,3 -k2,2nr;;
        wait) sort -t$'\t' -k1,1n -k2,2nr;;   # SNAP(정확 복구) 우선 → 최근순
        *)    sort -t$'\t' -k2,2nr;;
      esac; } | cut -f4-
}
dead_row() { dead_tsv | awk -F'\t' -v n="$1" '$3==n || $5==n {print; exit}'; }
cmd_dead_ls() {  # tmm dead [PAT] [--since H] [--all]
  local pat="" a
  while [ $# -gt 0 ]; do case "$1" in --since) cmd_since "$2" >/dev/null; shift;; --all) echo all > "$RUN/gen";; *) pat="$1";; esac; shift; done
  cmd_dead_rows time fresh | cut -f1 | { [ -n "$pat" ] && grep -i -- "$pat" || cat; }
}
cmd_dead_preview() {  # NAME|SID [N]
  local row sid; row="$(dead_row "$1")"
  [ -n "$row" ] || { echo "(목록에 없음: $1 — ^R 로 갱신)"; return 1; }
  sid="$(printf '%s' "$row" | cut -f5)"
  printf '\033[36m[%s] %s · %s · 마지막 %s · %s\033[0m\n' "$(printf '%s' "$row" | cut -f1)" "$(printf '%s' "$row" | cut -f3)" \
    "$(basename "$(printf '%s' "$row" | cut -f4)")" "$(fmt_hm "$(printf '%s' "$row" | cut -f7)" :)" "$(printf '%s' "$row" | cut -f6)"
  python3 "$DEAD_SCAN" tail --sid "$sid" --n "${2:-$PREVIEW_LINES}" --width "${COLUMNS:-80}" 2>/dev/null | render_pane
}

# 복구 커맨드 합성 — ★fable 계열 제외 전부 [1m]★ (오빠 확정 2026-09-09: 작은 창으로 절대 열지 않는다)
with_1m_if_claude() { case "$1" in claude-*) with_1m "$1";; *) printf '%s' "$1";; esac; }
with_1m() { case "$1" in *fable*|*\[*\]*) printf '%s' "$1";; "") printf '%s' "$1";; *) printf '%s[1m]' "$1";; esac; }
restore_cmd_for() {  # agent model sid name resume
  local agent="$1" model="$2" sid="$3" name="$4" resume="$5" bin
  [ -n "$resume" ] && { printf '%s' "$resume"; return; }
  case "$agent" in
    claude) bin="$HOME/.headroom/claude-hr.sh"; [ -x "$bin" ] || bin=claude
            printf '%s --dangerously-skip-permissions --model "%s" --effort high --resume %s --name %s --remote-control %s' "$bin" "$(with_1m "${model:-claude-opus-5}")" "$sid" "$name" "$name";;
    codex)  printf 'codex --dangerously-bypass-approvals-and-sandbox -c model_reasoning_effort="high" resume %s' "$sid";;
    cmd)    printf 'cmd --yolo --trust --skip-onboarding --name %s --resume %s' "$name" "$sid";;
    opencode) printf 'opencode --session %s' "$sid";;
    *) return 1;;
  esac
}
# tmuxc restore_one 과 같은 순서: 세션 생성 → resume 커맨드 주입 → 부팅 대기 → (claude) 복원 안내 주입 → attach
cmd_restore_one() {  # NAME [--dry-run|--no-attach]
  local n="$1" dry="${2:-}" row src agent name cwd sid model lm la base gen resume cmd try
  if tmux has-session -t "=$n" 2>/dev/null; then
    [ "$dry" = --no-attach ] && { echo "⏭ $n 이미 살아있음"; return 0; }
    echo "이미 살아있음 → attach"; cmd_attach "$n"; return
  fi
  row="$(dead_row "$n")"; [ -n "$row" ] || { echo "❌ 종료 목록에 없음: $n"; sleep 1; return 1; }
  src="$(printf '%s' "$row" | cut -f1)"; agent="$(printf '%s' "$row" | cut -f2)"; name="$(printf '%s' "$row" | cut -f3)"
  cwd="$(printf '%s' "$row" | cut -f4)"; sid="$(printf '%s' "$row" | cut -f5)"; model="$(printf '%s' "$row" | cut -f6)"
  resume="$(printf '%s' "$row" | cut -f11-)"
  cmd="$(restore_cmd_for "$agent" "$model" "$sid" "$name" "$resume")" || { echo "❌ 복구 커맨드 합성 불가 ($agent)"; sleep 1; return 1; }
  [ -d "$cwd" ] || { echo "⚠ cwd 없음 ($cwd) → \$HOME 에서 기동"; cwd="$HOME"; }
  if [ "$dry" = --dry-run ]; then printf 'session=%s\ncwd=%s\nsrc=%s\ncmd=%s\n' "$name" "$cwd" "$src" "$cmd"; return 0; fi
  echo "▶ 복구 $name ($src, $agent) · $(basename "$cwd")"
  tmux new-session -d -s "$name" -c "$cwd" || { echo "❌ tmux new-session 실패"; sleep 1; return 1; }
  # ★detached 로 만든 세션은 tmux 가 창을 80x24 «manual» 로 고정한다★ — 나중에 데스크탑이 붙어도 안 커진다(실측 2026-09-09:
  #   복구 좌석 10개 전부 manual, 화면 오른쪽·아래가 점으로 채워짐). 창 옵션을 풀어 서버 기본(latest)을 따르게 한다.
  tmux set -wu -t "=$name:" window-size 2>/dev/null
  tmux send-keys -t "=$name:" -l "$cmd"; sleep 0.3; tmux send-keys -t "=$name:" Enter
  for try in $(seq 1 "${TMM_RESTORE_TRIES:-20}"); do
    sleep 3
    # 부팅 판정: claude(❯/ctx:/bypass) · codex(› Ask Codex / Pursuing goal) · cmd/opencode 는 pane 이 셸이 아니면 살아있는 것
    tmux capture-pane -t "=$name:" -p 2>/dev/null | grep -qE 'ctx:|❯|bypass permissions|Model:|context used|› Ask Codex|Pursuing goal|Ask Codex to' && break
    [ "$try" -ge 3 ] && ! is_shell_cmd "$(tmux display -p -t "=$name:" '#{pane_current_command}' 2>/dev/null)" && [ "$agent" != claude ] && break
    [ "$try" -eq "${TMM_RESTORE_TRIES:-20}" ] && echo "⚠ 부팅 확인 못 함 (세션은 남김)"
  done
  if [ "$agent" = claude ] && [ "$try" -lt "${TMM_RESTORE_TRIES:-20}" ]; then
    sleep 1; tmux send-keys -t "=$name:" -l "[restore→$name] tmm 에서 복원된 세션이다. 통신 표준: ~/.claude/skills/tmuxc/COMM-GUIDE.md 를 Read하고 준수. 너의 세션명(me)=$name. 직전 작업 컨텍스트를 확인하고 이어가라."; sleep 0.3; tmux send-keys -t "=$name:" Enter
  fi
  [ "$dry" = --no-attach ] && { [ "$try" -lt "${TMM_RESTORE_TRIES:-20}" ] && echo "  ✅ $name"; return 0; }
  rm -f "$RUN/dead.tsv"   # 다음 목록에서 이 행이 사라지게
  cmd_attach "$name"
}
# 현재 창(since)·계보(gen)에 보이는 종료 세션을 «전부» 순서대로 복구 — tmuxc restore --scan --loose --select all --go 의 폰판.
# 창을 ^] 로 넓힌 뒤 다시 실행하면 새로 드러난 것만 이어서 복구된다(이미 살아있는 것은 ⏭). attach 는 하지 않는다.
cmd_restore_all() {  # [--dry-run] [--yes] [--since H]  — ★5개씩 배치 병렬★ (TMM_RESTORE_BATCH, 기본 5). 한 배치가 다 끝나야 다음 배치.
  local dry="" yes="" names n total=0 ok=0 fail=0 t0 a batch="${TMM_RESTORE_BATCH:-5}" res i=0 bno=0 chunk
  while [ $# -gt 0 ]; do case "$1" in --dry-run) dry=--dry-run;; --yes|-y) yes=1;; --since) cmd_since "$2" >/dev/null; shift;; esac; shift; done
  names="$(cmd_dead_rows time fresh | cut -f2 | grep .)"; total="$(printf '%s\n' "$names" | grep -c .)"
  [ "$total" -gt 0 ] || { echo "(창 ${DEAD_SINCE0}h 안에 종료 세션 없음 — ^] 로 창을 넓히세요)"; sleep 1.5; return 0; }
  echo "▶ 일괄 복구: 창 $(since_now)h · 계보 $(gen_now) · ${total}건 · ${batch}개씩 배치 (attach 없음, 배치당 ≤$(( ${TMM_RESTORE_TRIES:-20}*3 ))s)"
  if [ -z "$yes" ] && [ -z "$dry" ]; then
    printf '%s\n' "$names" | sed 's/^/   ◌ /' | head -40; [ "$total" -gt 40 ] && echo "   … (+$((total-40)))"
    read -r -p "전부 복구? [y/N] " a; [ "$a" = y ] || [ "$a" = Y ] || { echo "(취소)"; sleep 1; return 0; }
  fi
  if [ -n "$dry" ]; then
    while IFS= read -r n; do cmd_restore_one "$n" --dry-run | grep -E '^(session|cmd)=' | tr '\n' ' '; echo; done <<<"$names"; return 0
  fi
  # 결과 파일 $RUN/restore-<epoch>.log — «ok|fail<TAB>세션명<TAB>사유» 한 줄씩. 워커는 화면에 안 쓰고 파일로만 보고.
  t0=$(date +%s); res="$RUN/restore-$t0.log"; : > "$res"
  # 배치 루프: 5개를 백그라운드로 띄우고 wait — 한 배치의 부팅이 전부 끝나야 다음 5개 (헤드룸·API 동시 부하 상한)
  while :; do
    chunk="$(printf '%s\n' "$names" | sed -n "$((i+1)),$((i+batch))p")"; [ -n "$chunk" ] || break
    bno=$((bno+1)); echo "── 배치 $bno: $(printf '%s' "$chunk" | tr '\n' ' ')"
    while IFS= read -r n; do
      [ -n "$n" ] || continue
      ( out="$("$SELF" restore "$n" --no-attach </dev/null 2>&1)"; rc=$?
        if [ $rc -eq 0 ] && tmux has-session -t "=$n" 2>/dev/null && ! printf '%s' "$out" | grep -q '부팅 확인 못 함'; then
          printf 'ok\t%s\t\n' "$n" >> "$res"; printf '  ✅ %s\n' "$n"
        else
          printf 'fail\t%s\t%s\n' "$n" "$(printf '%s' "$out" | grep -E '❌|⚠' | tail -1 | cut -c1-80)" >> "$res"; printf '  ❌ %s\n' "$n"
        fi ) &
    done <<<"$chunk"
    wait
    i=$((i+batch))
  done
  ok="$(grep -c '^ok' "$res")"; fail="$(grep -c '^fail' "$res")"
  rm -f "$RUN/dead.tsv"
  echo "── 완료: ✅ $ok  ❌ $fail  / $total  ($(( $(date +%s)-t0 ))s) — 결과: $res"
  [ "$fail" -gt 0 ] && { echo "── 실패:"; grep '^fail' "$res" | cut -f2,3 | sed $'s/\t/ — /;s/^/   ❌ /'; }
  echo "살아난 좌석은 ^A 좌석뷰에서 확인"; read -r -n1 -p "[아무 키] " _
}

# ---------- 자동 갱신 ----------
# ^U 가 돌리는 것은 «미리보기» 주기다. 전좌석 주기(AUTO)는 seat-scan 부하 상한이라 키로 못 줄인다.
auto_now() { cat "$RUN/auto" 2>/dev/null || echo "$AUTO_PREVIEW"; }
cmd_auto_cycle() {  # 5 → 10 → 15 → 5. off 는 없다 — 폰에서 실수로 꺼져 «갱신이 안 된다»가 되지 않게. 끄려면 TMM_AUTO_PREVIEW=0
  local cur p next="${AUTO_PRESETS%% *}"; cur="$(auto_now)"
  for p in $AUTO_PRESETS; do [ "$p" -gt "$cur" ] && { next=$p; break; }; done
  echo "$next" | tee "$RUN/auto"
}
# 헤더: 키 2줄 + 상태 1줄. 전체 폭 ≥240(초광폭)일 때만 키 2줄을 한 줄로. 기준은 tput cols(전체 폭) — FZF_COLUMNS 는 목록 폭이라
# 오른쪽 미리보기가 켜지면 절반이 돼 흔들린다. resize 이벤트로 재계산.
# 전체 폭: fzf 자식에서 tput cols 는 80 으로 고정(실측) — FZF_COLUMNS(목록 폭) + FZF_PREVIEW_COLUMNS(미리보기 폭, 켜져 있을 때).
# 미리보기가 오른쪽이면 둘의 합이 전체, 아래면 FZF_COLUMNS 가 곧 전체. 상태 파일 $RUN/cols 에 마지막 값을 남겨 폭이 안 잡히는 호출도 따른다.
term_cols() {
  local c="${FZF_COLUMNS:-}" p="${FZF_PREVIEW_COLUMNS:-0}" pw
  if [ -n "$c" ]; then
    pw="$(cat "$RUN/pw" 2>/dev/null)"; case "$pw" in right*) c=$((c + p + 1));; esac
    printf '%s\n' "$c" > "$RUN/cols"; printf '%s' "$c"; return
  fi
  cat "$RUN/cols" 2>/dev/null || tput cols 2>/dev/null || echo "${COLUMNS:-60}"
}
TMM_VERSION="$(cat "$HERE/../VERSION" 2>/dev/null || echo dev)"
cmd_header() {
  local a w; a="$(auto_now)"; w="$(term_cols)"
  if [ "$(view_now)" = dead ]; then
    hdr_dead
    printf '\033[33m상태\033[0m 창 %sh · %s건 · 계보 %s · SNAP/CC/CDX/CMD/OC\n' "$(since_now)" "$(dead_tsv | wc -l | tr -d ' ')" "$( [ "$(gen_now)" = all ] && echo 전체 || echo 최신)"
    return
  fi
  hdr_live
  printf '\033[33m상태\033[0m '
  [ "$a" -gt 0 ] && printf 'pane %ss' "$a" || printf 'pane off'
  [ "$AUTO" -gt 0 ] && printf ' 전체 %ss' "$AUTO" || printf ' 전체 off'
  printf ' · 12:34 완료 12~34 출력 · 1m=1M창\n'
}
cmd_post() { curl -s -o /dev/null --unix-socket "$1" -X POST http://localhost/ -d "$2"; }
# 백그라운드 핑거: 1초 틱마다 상태 파일을 다시 읽어 ^U 변경이 즉시 반영. fzf 가 끝나면 cmd_tui 가 죽인다 —
# attach 중엔 fzf 가 없으므로 자연히 멈추고, 떼고 돌아오면 새 fzf 와 함께 다시 뜬다.
auto_loop() {
  local sock="$1" i=0 gap
  while :; do
    sleep 1; i=$((i+1))
    [ -S "$sock" ] || continue
    gap="$(auto_now)"
    [ "$gap" -gt 0 ] && [ $((i % gap)) -eq 0 ] && cmd_post "$sock" 'refresh-preview'
    [ "$AUTO" -gt 0 ] && [ $((i % AUTO)) -eq 0 ] && cmd_post "$sock" "reload($SELF rows-cur fresh)"
    [ "$BELL" != 0 ] && [ -f "$RUN/bell" ] && { rm -f "$RUN/bell"; cmd_post "$sock" 'bell'; }
  done
}

cmd_ls() { local pat="${1:-}"; cmd_rows time | cut -f1 | { [ -n "$pat" ] && grep -i -- "$pat" || cat; }; }

# ---------- 동작 ----------
cmd_attach() {
  local n="${1:-}" flags=""
  [ -n "$n" ] || { echo "(목록 로딩 중 — 잠시 후 다시 Enter)"; sleep 1; return 0; }
  tmux has-session -t "=$n" 2>/dev/null || { echo "❌ 세션 없음: $n"; sleep 1; return 1; }
  [ "${2:-}" = "-i" ] && flags="-f ignore-size"
  if [ -n "${TMUX:-}" ]; then tmux switch-client -t "=$n"; else tmux attach -t "=$n" $flags; fi
}

cmd_peek() {  # 비대화용(tmm p): 색 없음·빈 줄 제거·폭 자름
  local n="$1" k="${2:-30}"
  tmux capture-pane -t "=$n:" -p 2>/dev/null | grep -vE '^\s*$' | tail -n "$k" | cut -c1-"${COLUMNS:-80}"
}

# TUI 미리보기 전용 렌더러 — 폰 가독성 3축을 여기서 푼다:
#  ① -e 로 SGR 색을 살린다 — Claude TUI 는 응답=굵게·도구출력=회색·완료=초록이라 색이 곧 구조다.
#  ② 바닥 입력박스(── ❯ ──)와 statusline 을 잘라 12행 미리보기에서 대화만 보이게. 연속 빈 줄은 1줄로.
#  ③ fzf follow 로 바닥(최신)부터. -J 는 tmux 소프트랩만 되돌린다 — Claude TUI 의 하드 줄바꿈(216열 문단이
#     폰 60열에서 다시 접혀 ↳ 조각이 나는 것)은 여기서 못 고친다(실측: -J 유무 표시행 동일).
cmd_preview() {
  local n="$1" k="${2:-$PREVIEW_LINES}"
  [ "$(view_now)" = dead ] && { cmd_dead_preview "$n" "$k"; return; }
  tmux capture-pane -t "=$n:" -p -e -J -S -200 2>/dev/null | render_pane | tail -n "$k"
}
render_pane() {  # stdin: capture-pane -e -J 원문 → 입력박스 이하 제거·연속 빈 줄 압축 (verify 가 골든으로 잰다)
  awk '
    { s=$0; gsub(/\033\[[0-9;?]*[a-zA-Z]/, "", s); sub(/[ \t]+$/, "", s) }
    # 구분선 판정은 «바이트 안전»하게 — macOS awk 는 멀티바이트 문자에 (─)+ 를 못 건다
    # 첫 구분선엔 세션명이 박힌다(«──── NAME ────») — ─ 를 지운 나머지가 원문의 1/4 미만이면 구분선
    { t = s; gsub(/─/, "", t); sep[NR] = (length(s) >= 30 && length(t) * 4 < length(s)) }
    # 입력박스: Claude = «구분선 → ❯ 로 시작하는 줄» 쌍(본문 속 표 구분선은 뒤에 ❯ 가 없어 안 잘림),
    #           Codex  = «› Ask Codex …» 프롬프트 줄. 그 아래 statusline·모델 줄은 통째로 버린다.
    NR > 1 && sep[NR-1] && s ~ /^❯/ && !cut { cut = NR - 1 }
    s ~ /^› Ask Codex/ && !cut { cut = NR }
    { lines[NR] = $0; blank[NR] = (s == "") }
    END {
      last = cut ? cut - 1 : NR
      for (i = 1; i <= last; i++) {
        if (blank[i] && (i == 1 || blank[i-1])) continue
        print lines[i]
      }
    }'
}

is_shell_cmd() { case "$1" in zsh|bash|sh|fish|-zsh|-bash|"") return 0;; *) return 1;; esac; }
live_mark() {  # ● 에이전트 실행 중 / ○ shell only  (send 가드용 단건 조회)
  # pane_current_command 기준 — pgrep -P 는 zsh 플러그인 자식(gitstatusd 등)을 에이전트로 오판한다(verify 실측)
  local cmd; cmd="$(tmux display -p -t "=$1:" '#{pane_current_command}' 2>/dev/null)"
  is_shell_cmd "$cmd" && echo "○" || echo "●"
}

cmd_send() {
  local n="$1"; shift
  # HARD GATE: pane 자식(에이전트) 없으면 셸에 타이핑되므로 차단 (tmuxc send 자체엔 가드 없음)
  [ "$(live_mark "$n")" = "●" ] || { echo "❌ $n 에 에이전트가 실행 중이 아님 — 셸 오타이핑 방지로 차단"; return 1; }
  if command -v tmuxc >/dev/null; then
    tmuxc send "$n" "[mobile→$n] $*"
  else
    tmux send-keys -t "=$n:" -l "[mobile→$n] $*"; sleep 0.3; tmux send-keys -t "=$n:" Enter
  fi && { sleep 2; echo "── 도달 확인 ──"; cmd_peek "$n" 6; }
}

# TUI 안 ^S: fzf 밖(정상 tty)에서 프롬프트
cmd_sendp() {
  local n="$1" m
  echo "→ $n  (빈 입력 = 취소)"
  read -r -p "메시지: " m
  [ -n "$m" ] && cmd_send "$n" "$m"
  read -r -n1 -p "[아무 키] " _
}

cmd_scan()  { [ -n "$SCAN" ] && bash "$SCAN" || echo "seat-scan 없음 (TMM_SCAN 지정)"; }
cmd_human() { cmd_scan | grep -E '^\S+\s+(HUMAN|BLOCK|STUCK)\b' || echo "(사람 입력 대기·차단 좌석 없음)"; }

cmd_doctor() {
  local ok=0
  for c in tmux fzf; do command -v "$c" >/dev/null && echo "  [✓] $c $(command -v $c)" || { echo "  [✗] $c 없음"; ok=1; }; done
  command -v tmuxc >/dev/null && echo "  [✓] tmuxc $(cat "$HOME/.tmuxc/current/core/VERSION" 2>/dev/null) (세트 — send 도달확인·save·restore 규약)" || { echo "  [✗] tmuxc 없음 — tmm 은 tmuxc 와 세트. feature-pack/tmuxc 먼저 설치"; ok=1; }
  [ -n "$SCAN" ] && echo "  [✓] seat-scan: $SCAN" || { echo "  [✗] seat-scan 없음 (상태 열이 ? 로 나옴)"; ok=1; }
  [ -f "$CAT_FILE" ] && echo "  [✓] categories: $CAT_FILE" || echo "  [!] categories 없음 → 세션명 첫 토큰으로 자동 분류 ($CAT_FILE 에 규칙 작성 가능)"
  tmux ls >/dev/null 2>&1 && echo "  [✓] tmux 서버 ($(tmux ls | wc -l | tr -d ' ') 세션)" || echo "  [!] tmux 서버 없음"
  local fv; fv="$(fzf --version 2>/dev/null | cut -d' ' -f1)"
  if [ -n "$fv" ]; then
    [ "$(printf '%s\n0.54.0\n' "$fv" | sort -V | head -1)" = "0.54.0" ] && echo "  [✓] fzf $fv (--listen/--track/bell)" \
      || { echo "  [✗] fzf $fv < 0.54.0 — 자동 갱신·벨 불가 (brew upgrade fzf)"; ok=1; }
  fi
  command -v curl >/dev/null || { echo "  [✗] curl 없음 — 자동 갱신 불가"; ok=1; }
  [ -f "$DEAD_SCAN" ] && python3 -c 'import sys' 2>/dev/null && echo "  [✓] dead-scan: $DEAD_SCAN (종료 세션 $(python3 "$DEAD_SCAN" scan --since "$DEAD_SINCE0" 2>/dev/null | wc -l | tr -d ' ')건/${DEAD_SINCE0}h)" || { echo "  [✗] dead-scan 없음 또는 python3 없음 — 종료 뷰 불가"; ok=1; }
  [ -f "$HOME/.tmuxc/snapshots/latest.json" ] && echo "  [✓] tmuxc 스냅샷: $(readlink "$HOME/.tmuxc/snapshots/latest.json" | sed 's/.*snapshot-//;s/.json//')" || echo "  [!] tmuxc 스냅샷 없음 — SNAP 배지 없이 트랜스크립트만으로 복구"
  [ -x "$HOME/.headroom/claude-hr.sh" ] && echo "  [✓] headroom 래퍼 (복구 커맨드 경유)" || echo "  [!] headroom 래퍼 없음 — 복구는 bare claude"

  echo "  cache: $CACHE (ttl ${CACHE_TTL}s) · state: $STATE/run-<pid> · pane:${AUTO_PREVIEW}s all:${AUTO}s bell:$BELL"
  return $ok
}

# ★폰 60열 기준 — fzf 는 헤더를 줄바꿈하지 않고 «자른다». 각 줄 표시폭(한글=2) 60 이내 (verify 가 잰다)
# 미리보기 창 배치: 전체 폭 <120 (폰) 아래 50% / ≥120 (PC) 오른쪽 55%. big = 같은 방향에서 크게↔기본 토글(상태 파일).
cmd_pw() {
  local w big=""; w="$(term_cols)"
  if [ "${1:-}" = big ]; then [ -f "$RUN/pwbig" ] && rm -f "$RUN/pwbig" || : > "$RUN/pwbig"; fi
  [ -f "$RUN/pwbig" ] && big=1
  local out
  if [ "$w" -ge 120 ]; then out="right,$([ -n "$big" ] && echo 75% || echo 55%),wrap,follow,noinfo,border-left"
  else out="down,$([ -n "$big" ] && echo 80% || echo 50%),wrap,follow,noinfo,border-top"; fi
  printf '%s' "$out" > "$RUN/pw"; printf '%s' "$out"
}

# 헤더 — 섹션별로 «키(청록 굵게) 설명(회색)» 쌍. 폰 60열 기준 한 줄 ≤60 표시폭(ANSI 제외, verify 가 잰다). 3~4줄.
K() { printf '\033[1;36m%s\033[0m\033[2m %s\033[0m' "$1" "$2"; }   # key + label
S() { printf '\033[33m%s\033[0m' "$1"; }                               # 섹션 표시
hdr_live() {
  printf '%s %s  %s  %s  %s\n' "$(S 이동)" "$(K ⏎ attach)" "$(K ^S 메시지)" "$(K ^D 종료뷰)" "$(K ^X 끝)"
  printf '%s %s  %s  %s  %s  %s\n' "$(S 정렬)" "$(K ^T 최근)" "$(K ^W 대기)" "$(K ^G 분류)" "$(K ^H 대기만)" "$(K ^A 전체)"
  printf '%s %s  %s  %s  %s\n' "$(S 화면)" "$(K ^P/^O 미리보기)" "$(K ^U 자동)" "$(K ^R 갱신)" "$(K ^/ 도움)"
}
hdr_dead() {
  printf '%s %s  %s  %s  %s\n' "$(S 복구)" "$(K ⏎ 1건)" "$(K ^B 창전체)" "$(K ^A 좌석뷰)" "$(K ^X 끝)"
  printf '%s %s  %s  %s  %s\n' "$(S 창)" "$(K ^] +12h)" "$(K ^\\ -12h)" "$(K ^L 계보)" "$(K ^R 갱신)"
  printf '%s %s  %s  %s  %s\n' "$(S 정렬)" "$(K ^T 최근)" "$(K ^W SNAP)" "$(K ^G 분류)" "$(K ^P/^O 미리보기)"
}

cmd_tui() {
  command -v fzf >/dev/null || { echo "fzf 없음 → 숫자 메뉴 (brew install fzf 권장)"; menu; return; }
  local R="$SELF rows" M="$SELF mode" out key sel rc pinger sock
  export TMM_RUN="$STATE/run-$$"; RUN="$TMM_RUN"; mkdir -p "$RUN"; sock="$RUN/fzf.sock"
  printf '%s\n' "$AUTO_PREVIEW" > "$RUN/auto"; cmd_mode time; cmd_view live   # waitset 없음 = 첫 스캔은 기록만(진입 즉시 벨 방지)
  trap 'kill "${pinger:-}" 2>/dev/null; rm -rf "$RUN"' EXIT
  # ★attach/메시지는 fzf 밖에서 실행★ — execute() 안에서는 /dev/tty 를 못 잡아
  #   "open terminal failed: can't use /dev/tty". fzf 는 --expect 로 (키, 선택줄)만 돌려주고,
  #   이 루프가 attach → detach 후 다시 피커를 띄운다.
  # ★핑거도 fzf 한 번의 수명에 묶는다★ — attach 중(fzf 없음)엔 갱신이 없어야 하므로.
  while :; do
    rm -f "$sock"; auto_loop "$sock" & pinger=$!
    out="$(fzf --ansi --delimiter=$'\t' --with-nth=1 --nth=1,3 --tiebreak=index --track \
      --layout=reverse --cycle --no-mouse --info=inline-right --sync --listen="$sock" \
      --prompt="$( [ "$(view_now)" = dead ] && echo '종료> ' || echo '좌석> ')" --pointer='▶' \
      --header="$(cmd_header)" --header-first \
      --preview="$SELF preview {2} $PREVIEW_LINES" --preview-window="$(cmd_pw)" \
      --bind "resize:transform-header($SELF header)+transform($SELF pw-action)" \
      --bind "start:transform($SELF pw-action)" \
      --preview-label=' pane ' \
      --border=top --border-label=" tmm $TMM_VERSION " --border-label-pos=-3:top \
      --expect=enter,ctrl-e,ctrl-s,ctrl-b,double-click \
      --bind "ctrl-h:execute-silent($M wait h)+reload($R wait h)+change-prompt(대기> )" \
      --bind "ctrl-a:execute-silent($SELF view live)+execute-silent($M time)+reload($R time)+change-prompt(좌석> )+transform-header($SELF header)" \
      --bind "ctrl-d:execute-silent($SELF view dead)+execute-silent($M time)+reload($SELF dead-rows time fresh)+change-prompt(종료> )+transform-header($SELF header)" \
      --bind "ctrl-]:execute-silent($SELF since +)+reload($SELF rows-cur fresh)+transform-header($SELF header)" \
      --bind "ctrl-\\:execute-silent($SELF since -)+reload($SELF rows-cur fresh)+transform-header($SELF header)" \
      --bind "ctrl-l:execute-silent($SELF gen)+reload($SELF rows-cur fresh)+transform-header($SELF header)" \
      --bind "ctrl-t:execute-silent($M time)+reload($SELF rows-cur)+change-prompt(최근순> )" \
      --bind "ctrl-w:execute-silent($M wait)+reload($SELF rows-cur)+change-prompt(대기우선> )" \
      --bind "ctrl-g:execute-silent($M cat)+reload($SELF rows-cur)+change-prompt(카테고리> )" \
      --bind "ctrl-r:reload($SELF rows-cur fresh)+refresh-preview" \
      --bind "ctrl-u:execute-silent($SELF auto-cycle)+transform-header($SELF header)" \
      --bind "ctrl-p:toggle-preview" \
      --bind "ctrl-o:transform($SELF pw-action big)" \
      --bind "ctrl-x:abort" \
      --bind "ctrl-/:transform-header($SELF header)" \
      < <(cmd_rows_cur))"; rc=$?
    kill "$pinger" 2>/dev/null; wait "$pinger" 2>/dev/null; rm -f "$sock"
    [ $rc -eq 0 ] || return 0                   # ^X / Esc → 종료
    key="${out%%$'\n'*}"; sel="${out#*$'\n'}"; sel="$(printf '%s' "$sel" | cut -f2)"
    if [ "$(view_now)" = dead ] && [ "$key" = ctrl-b ]; then cmd_restore_all; continue; fi   # 창 전체 일괄 복구 (선택 무관)
    [ -n "$sel" ] || continue
    if [ "$(view_now)" = dead ]; then
      case "$key" in
        ctrl-b) cmd_restore_all;;
        ctrl-s) echo "(종료된 세션에는 메시지를 보낼 수 없음 — Enter 로 먼저 복구)"; sleep 1.5;;
        *)      cmd_restore_one "$sel";;          # enter / ctrl-e / double-click → resume 복구 → attach, 떼면 dead 뷰로 복귀
      esac
    else
      case "$key" in
        ctrl-s) cmd_sendp "$sel";;
        *)      cmd_attach "$sel";;                 # enter / ctrl-e / double-click → attach, detach 후 루프 재진입
      esac
    fi
  done
}

menu() {
  while :; do
    cat <<'EOF'

 ┌─ tmm ──────────────────────────────┐
 │ 1 세션 목록      5 전 좌석 스캔      │
 │ 2 attach         6 HUMAN 대기만     │
 │ 3 pane 읽기      7 tmuxc save       │
 │ 4 메시지 보내기  q 종료             │
 └────────────────────────────────────┘
EOF
    read -r -p " 선택: " c
    case "$c" in
      1) read -r -p " 필터(엔터=전체): " p; cmd_ls "$p";;
      2) read -r -p " 세션명: " n; cmd_attach "$n";;
      3) read -r -p " 세션명: " n; cmd_peek "$n";;
      4) read -r -p " 세션명: " n; read -r -p " 메시지: " m; cmd_send "$n" "$m";;
      5) cmd_scan;;
      6) cmd_human;;
      7) tmuxc save;;
      q|Q|"") exit 0;;
    esac
  done
}

case "${1:-}" in
  __lib)     return 0 2>/dev/null || exit 0;;   # source 용 — 함수만 정의하고 끝 (병렬 워커)
  "")        cmd_tui;;
  rows)      cmd_rows "${2:-time}" "${3:-}" "${4:-}";;
  rows-cur)  cmd_rows_cur "${2:-}";;            # 상태 파일의 현재 정렬 모드·뷰로 (^R·자동 갱신용)
  dead-rows) cmd_dead_rows "${2:-time}" "${3:-}";;
  view)      cmd_view "${2:-live}";;
  since)     cmd_since "${2:-+}";;
  gen)       cmd_gen;;
  dead)      shift; cmd_dead_ls "$@";;
  dp)        cmd_dead_preview "$2" "${3:-40}";;
  restore)   cmd_restore_one "$2" "${3:-}";;
  restore-all) shift; cmd_restore_all "$@";;      # 현재 창(--since 로 조정) 전부 — tmm dead --since 24 >/dev/null; tmm restore-all
  mode)      cmd_mode "${2:-time}" "${3:-}";;
  auto-cycle) cmd_auto_cycle;;
  header)    cmd_header;;
  pw)        cmd_pw "${2:-}";;                   # 미리보기 창 배치 (폭 기준)
  pw-action) printf 'change-preview-window(%s)' "$(cmd_pw "${2:-}")";;   # fzf transform() 용 액션 문자열
  __post)    cmd_post "$2" "$3";;                # 핑거 → fzf --listen 소켓 액션 전송
  ls|l)      cmd_ls "${2:-}";;
  a|attach)  cmd_attach "${2:-}" "${3:-}";;
  p|peek)    cmd_peek "$2" "${3:-30}";;
  preview)   cmd_preview "$2" "${3:-}";;         # TUI 미리보기 (색·문단 재접기·바닥 상태줄 제거)
  __render)  render_pane;;                       # stdin 렌더 (verify 골든용)
  s|send)    n="$2"; shift 2; cmd_send "$n" "$@";;
  sendp)     cmd_sendp "$2";;
  ss|scan)   cmd_scan;;
  h|human)   cmd_human;;
  save)      tmuxc save;;
  menu)      menu;;
  doctor)    cmd_doctor;;
  -h|--help|help) sed -n '2,32p' "$0";;
  *)         sed -n '2,32p' "$0"; exit 1;;
esac
