#!/usr/bin/env bash
# tmm — 모바일(Termius/SSH) 전용 tmux 좌석 TUI. 폰 60~80열 기준. fzf 기반 커서 이동·필터·미리보기.
#   tmm              TUI 피커 (↑↓ 커서 · 타이핑=필터 · Enter=attach · 아래 키 참조)
#   tmm ls [PAT] [--host H|all]   텍스트 목록 (비대화용) — --host 면 HOST 열이 앞에 붙는다(원격 좌석 포함)
#   tmm a NAME [-i]  attach (기본 폰 크기 추종 · -i 면 데스크탑 크기 고정+점 채움)
#   tmm p [HOST/]NAME [N]   pane 최근 N줄 (기본 30) — mini/좌석 처럼 호스트 접두를 받는다
#   tmm s NAME MSG   메시지 (에이전트 없는 좌석 차단 + 도달확인)
#   tmm ss [--host H|all]   전 좌석 상태 스캔 (seat-scan) — 호스트 접두를 붙여 보여준다
#   tmm h            HUMAN/BLOCK/STUCK 좌석만
#   tmm save         tmuxc save
#   tmm menu         숫자 메뉴 (fzf 없을 때 폴백)
#   tmm doctor       의존성·환경 점검
#   tmm kill NAME [--yes]                좌석 종료 (tmux 세션 + 그 안의 에이전트)
#   ※ TUI 는 tmux 세션 «tmm» 안에서 뜬다(터미널이 창 리사이즈 중 pty 를 회수해도 안 죽게). 좌석에 붙었다가
#     좌석에 붙었다가 C-a d 를 누르면 피커로 돌아온다(조건부 바인딩 — 피커 세션에서는 원래대로 detach).
#     TMM_NO_WRAP=1 로 래핑을, TMM_NO_DBIND=1 로 그 바인딩을 끄고, TMM_SESSION 으로 세션명을 바꾼다.
#   tmm dead [PAT] [--since H] [--all]   종료된 세션 목록 (재부팅·kill 로 사라진 좌석 — tmuxc 미관리 포함)
#   tmm dp NAME|SID [N]                  종료 세션의 마지막 대화 N줄
#   tmm restore NAME [--dry-run]         종료 세션 1건 복구 (resume) → attach
#   tmm restore-all [--since H] [--dry-run] [--yes]   창 안 종료 세션 «전부» 복구 — 5개씩 배치 병렬(TMM_RESTORE_BATCH), 결과 $RUN/restore-<ts>.log(ok|fail) — tmuxc restore --scan --loose 의 폰판
#   tmm idx NAME|SID [--json|--path]     세션의 대화 기록(트랜스크립트) 인덱스 경로 — 라이브·종료 공통. 에이전트가 이전 대화를 바로 찾게
#   tmm fork SRC --agent AG --model M [--name N] [--cwd C] [--effort E] [--ctx 1m] [--prompt P] [--dry-run] [--attach]
#                                        AG = claude|codex|opencode|cmd|pi. 소스 대화를 «새 에이전트 세션»으로 이어받기. 동일 엔진=네이티브 tmuxc fork(전체 히스토리·부모 불변),
#                                        크로스 엔진=tmuxc open 새 세션 + 트랜스크립트 경로·발췌 주입(~/.tmm/forks). 이름 기본=소스 #N+1
#   tmm models [AG] | refresh [AG...] | find QUERY   fork 모델 별칭 — refresh 는 라이브 목록(opencode 프로바이더 접두사)에서 생성
#                                        opencode 의 --model 접두사가 곧 프로바이더다: opencode/=zen, openrouter/=OpenRouter (TMM_MODELS_PROVIDER)
#                                        ^F 는 어느 단계에서든 ^C(또는 이름/에이전트/모델에서 q)로 취소, 생성 중 아무 키=취소 → 피커 복귀
#
# TUI 키:  Enter/^E attach · ^S 메시지 · ^K 좌석닫기 · ^F fork · ^Y 대화기록 경로 · ^H 대기좌석만 · ^A 전체
#          ^T 최근순 · ^W 대기우선 · ^G 카테고리순 · ^R 새로고침 · ^U 미리보기 자동갱신 1/5/10/15초
#          ^P 미리보기 토글 · ^O 크게/작게 · ^X 종료 · ^/ 도움말(? 는 필터 문자)
#          분할 화면(0.8.0, tmux 안 기본): 왼쪽 분류 칸 ↑↓ 로 고르면 목록이 바뀜 · ⏎=목록으로 · Esc/⌫(빈 질의)=분류 칸으로(←/→ 별칭) · ^V 분류 칸 숨김/보임
#          숨기면(또는 TMM_SPLIT=0 · tmux 밖) 0.7.x 탭 줄: Tab·→ / S-Tab·← 다음/이전 탭. 키워드는 뷰(^A/^D)별로 기억
# 뷰 전환: ^D = 종료된 세션 뷰(«종료>») ↔ ^A = 살아있는 좌석 뷰(«좌석>»). 완전 전환 — 목록·미리보기·Enter 의미가 바뀐다.
#          종료 뷰: 진입 12h 창, ^] +12h / ^\ -12h, ^L 계보 전체↔최신만. Enter = resume 복구 후 attach.
#          ^B = «지금 화면에 보이는 행 전부» 일괄 복구(필터·카테고리 적용분만, 확인 y 후, attach 없음).
#               필터 없이 누르면 창 전체. 창을 ^] 로 넓히고 다시 누르면 새로 드러난 것만 이어서.
#          상태 열 = 출처 배지 SNAP(스냅샷 argv 완제품)/CC/CDX/CMD/OC. ^W 는 SNAP 우선. 마커 ◌ = 종료.
# 복구 모델: 스냅샷이면 그 argv, 아니면 트랜스크립트 model + effort high. ★fable 계열 제외 전부 [1m]★ (작은 창 금지)
# 정렬:   기본 = 마지막 응답 시각 역순(진입 시 최신 대화가 맨 위). ^W = 대기(HUMAN/BLOCK/STUCK) 상단 고정 후 최근순.
#          ^G = 카테고리 묶음 안 최근순. ^H = 대기 좌석만 필터.
# 시각:   claude "done 오후 H:MM" 마커 1순위(`12:34`), 없으면 tmux window_activity(`12~34`)
# 자동갱신: 2단 — 커서 좌석 미리보기는 ^U 로 5/10/15초 순환(기본 5), 전좌석 목록(상태·시각)은 20초 고정.
#          attach 중엔 멈추고 떼면 재개. 새로 HUMAN/BLOCK/STUCK 이 된 좌석이 생기면 터미널 벨.
#
# 환경변수:
#   TMM_CATEGORIES   카테고리 규칙 파일 (기본 ~/.tmm/categories) — "glob<TAB>라벨" 한 줄씩, 위에서부터 첫 매치
#   TMM_SCAN         seat-scan 스크립트 경로 (기본: 설치본 libexec → ~/.claude/skills/tmuxc/scripts)
#   TMM_CACHE_TTL    상태 스캔 캐시 초 (기본 20). 폰에서 ^R/필터 반복 시 재스캔 부하 방지. 0=항상 재스캔
#   TMM_PREVIEW_LINES 미리보기 줄 수 (기본 40). 색 유지·입력박스/statusline 제거·최신(바닥)부터 표시
#   TMM_AUTO_PREVIEW 커서 좌석 미리보기 자동 갱신 초 (기본 1, 0=off). `tmm --auto N` 과 같음. TUI 안에서 ^U 로 1/5/10/15 순환
#   TMM_AUTO         전좌석 목록 자동 갱신 초 (기본 20 고정, 0=off). ^U 로는 안 바뀐다 — seat-scan 부하 상한
#   TMM_BELL         새 대기 좌석 벨 (기본 1, 0=끔)
#   TMM_TAB          탭 뷰로 진입 (기본 1=탭, 0=목록으로 시작 — ^V 로 언제든 전환)
#   TMM_MODELS       fork 모델 별칭 파일 (기본 ~/.tmm/models) — "agent<TAB>alias<TAB>id<TAB>extra"
#   TMM_FORKS        fork 발췌 파일 디렉터리 (기본 ~/.tmm/forks) — 피커 종료 후에도 새 에이전트가 읽음
#   TMM_FORK_EXCERPT_N  fork 발췌에 담을 최근 메시지 수 (기본 40)
#   TMM_BASH4_CANDIDATES  bash 4+ 후보 경로(공백 구분, 기본 homebrew) — 아래 가드가 bash 3.2 에서 재실행할 때 쓴다

# ★bash 4+ 전용★ — 연관 배열(declare -A)·`${x,,}` 를 쓴다. macOS 기본 /bin/bash 3.2 에선 본 경로가 못 돈다.
#   3.2 로 불리면 bash 4+ 후보로 다시 실행하고, 없으면 «조용히 진행하지 않고» 멈춘다. (source tmm __lib 는 재실행하지 않는다)
if [ "${BASH_VERSINFO[0]}" -lt 4 ]; then
  if [ "${1:-}" != __lib ]; then
    for b in ${TMM_BASH4_CANDIDATES:-/opt/homebrew/bin/bash /usr/local/bin/bash}; do
      [ -x "$b" ] && "$b" -c '[ "${BASH_VERSINFO[0]}" -ge 4 ]' 2>/dev/null && exec "$b" "$0" "$@"
    done
  fi
  echo "tmm: bash 4 이상 필요 (지금 $BASH_VERSION) — brew install bash" >&2
  return 1 2>/dev/null || exit 1
fi
set -uo pipefail
export PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"

# ★SELF/HERE 는 «지금 실행 중인 파일» 기준★ — command -v tmm 을 쓰면 소스 트리에서 돌려도 설치본(~/.tmm)의
#   libexec 를 찾아가 verify·개발이 설치본과 섞인다(0.4.0 실측: dead-scan 미발견 → 0건). $0 을 심링 해석해 푼다.
#   BASH_SOURCE 를 쓴다 — `source tmm __lib`(병렬 워커) 에서는 $0 이 "bash" 다.
#   심링은 2단(~/.local/bin/tmm → ~/.tmm/current → versions/N)이라 readlink -f 로 끝까지 푼다 (macOS 12.3+/GNU 둘 다).
SELF="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || printf '%s' "${BASH_SOURCE[0]}")"
HERE="$(cd "$(dirname "$SELF")" && pwd)"; SELF="$HERE/$(basename "$SELF")"
SCAN="${TMM_SCAN:-}"
[ -n "$SCAN" ] || for c in "$HERE/../libexec/seat-scan.sh" "$HOME/.claude/skills/tmuxc/scripts/seat-scan.sh"; do
  [ -f "$c" ] && { SCAN="$c"; break; }
done
# 호스트 명부·ssh 래퍼 (tail-remote). 파일이 없거나 source 가 안 되면 로컬(m3) 전용 — 지금 동작 그대로
HOSTLIB="$HERE/../libexec/host-lib.sh"
# shellcheck source=/dev/null
if [ -f "$HOSTLIB" ]; then . "$HOSTLIB"; fi
type -t h_run >/dev/null 2>&1 || {
  h_local_name() { printf '%s\n' "${TMM_LOCAL_HOST:-m3}"; }
  h_split() { case "$1" in */*) printf '%s %s\n' "${1%%/*}" "${1#*/}" ;; *) printf '%s %s\n' "$(h_local_name)" "$1" ;; esac; }
  h_field() { printf ''; }
  h_targets() { [ "$1" = all ] && h_local_name || printf '%s\n' "$1"; }
  h_run()  { printf 'tmm: host-lib 없음 — 원격 불가\n' >&2; return 97; }
  h_tmux() { printf 'tmm: host-lib 없음 — 원격 불가\n' >&2; return 97; }
  h_pipe() { printf 'tmm: host-lib 없음 — 원격 불가\n' >&2; return 97; }
}
CAT_FILE="${TMM_CATEGORIES:-$HOME/.tmm/categories}"
MODELS_FILE="${TMM_MODELS:-$HOME/.tmm/models}"          # fork 모델 별칭 (agent<TAB>alias<TAB>id<TAB>extra) — 사용자
MODELS_GEN="${TMM_MODELS_GEN:-$HOME/.tmm/models.generated}"  # `tmm models refresh` 생성본 — 사용자 파일이 우선
MODELS_SYNC="$HERE/../libexec/tmm-models-sync.py"       # 라이브 목록 → 생성본
MODELS_PROVIDER="${TMM_MODELS_PROVIDER:-openrouter}"    # opencode 프로바이더 접두사 (opencode/=zen, openrouter/=OpenRouter)
FORKS_DIR="${TMM_FORKS:-$HOME/.tmm/forks}"              # fork 발췌 파일 (영속 — 피커 종료 후에도 새 에이전트가 읽음)
FORK_EXCERPT_N="${TMM_FORK_EXCERPT_N:-40}"              # 발췌에 담을 최근 메시지 수
CACHE_TTL="${TMM_CACHE_TTL:-20}"
# ★캐시는 tmux 서버별로 가른다★ — 격리 소켓(TMUX_TMPDIR)에서 돌린 tmm 이 실사용 캐시를 덮어써
#   전 좌석 상태가 «?» 로 죽는 사고가 났다(2026-09-14 실측: 캐시에 격리 세션 1줄만 남음).
#   소켓 경로를 섞어 파일명을 만든다 — 같은 서버를 보는 인스턴스끼리만 공유.
CACHE=""   # ★지연 계산(cache_init)★ — 시작할 때 tmux 를 부르면 tmux 가 필요 없는 경로(탭 전환 tabgo 등)도 매번 1회 fork 한다
cache_init() { [ -n "$CACHE" ] || CACHE="${TMPDIR:-/tmp}/tmm-scan-$(id -u)-$(tmux display -p '#{socket_path}' 2>/dev/null | cksum | cut -d' ' -f1 || echo 0).cache"; }
PREVIEW_LINES="${TMM_PREVIEW_LINES:-40}"
AUTO="${TMM_AUTO:-20}"; AUTO_PREVIEW="${TMM_AUTO_PREVIEW:-1}"; BELL="${TMM_BELL:-1}"
AUTO_PRESETS="1 5 10 15"
DEAD_SCAN="$HERE/../libexec/tmm-dead-scan.py"
DEAD_SINCE0="${TMM_DEAD_SINCE:-12}"
# TUI 상태(정렬 모드·자동 갱신 초·직전 대기 좌석 집합·벨 플래그) — fzf 바인딩과 백그라운드 핑거가 파일로 공유.
# ★인스턴스별★ — 폰·데스크탑에서 tmm 을 여럿 띄우면 한쪽 ^U/^W 가 다른 쪽 자동 갱신을 바꾸므로 TUI 마다 run-<pid>/.
# fzf 가 띄우는 바인딩 자식은 env 를 물려받으니 TMM_RUN 으로 자기 디렉터리를 안다. 캐시는 공유(그냥 캐시).
STATE="${TMPDIR:-/tmp}/tmm-$(id -u)"; RUN="${TMM_RUN:-$STATE}"; mkdir -p "$RUN"
[ "${1:-}" = --auto ] && { AUTO_PREVIEW="${2:-1}"; TMM_WRAP_AUTO="$AUTO_PREVIEW"; shift 2; }

# ---------- TUI 는 tmux 안에서 (pty 회수 방어) ----------
# Ghostty 가 창 드래그·리사이즈 중 pty 를 회수하면 거기 직접 붙은 프로세스는 SIGHUP 으로 죽는다
# (실측 2026-09-14: 고아 fzf fd2=revoked, 고아 8개, run-* 49개 = EXIT trap 미실행 = 즉사).
# tmux 가 pty 를 소유하면 클라이언트만 떨어지고 tmm 은 살아남는다 — 좌석에 attach 중일 때 안 죽던 이유.
# 인자 없는 TUI 실행일 때만 래핑한다(ls/dead/restore 등 비대화 경로는 그대로).
tui_wrap() {
  [ -z "${TMUX:-}" ] || return 0                       # 이미 tmux 안
  [ "${TMM_NO_WRAP:-0}" != 1 ] || return 0             # 명시적 비래핑
  command -v tmux >/dev/null 2>&1 || return 0
  # ★창마다 독립 피커★ — 0.5.0~0.5.4 는 `new-session -A` 가 «같은 이름 세션에 붙는» 탓에 창을 몇 개 열든
  #   전부 한 화면을 공유했다(한쪽에서 커서를 옮기면 다른 쪽도 같이 움직임 — 2026-09-16 사용자 지적).
  #   붙어 있는 클라이언트가 «없는» 세션만 재사용하고(= 떼고 돌아온 경우 이어받기), 이미 누가 보고 있으면
  #   tmm-2, tmm-3 … 으로 새로 만든다.
  #   ★0.8.0: «붙은 클라이언트 0» 만으로는 부족했다★ — 폰이 Enter 로 좌석에 가 있는 동안 피커의 클라이언트는 0 이 되고, 그때 데스크탑에서
  #   tmm 을 치면 같은 피커에 붙어 한 fzf 를 둘이 봤다(커서가 저절로 움직이던 원인 · 2026-10-12 사용자 지적). 그래서 «살아 있는 클라이언트가
  #   출발 피커(@tmm_home_<tty>)·직전 세션으로 가리키는 피커» 도 사용 중으로 본다(picker_free). SSH 가 끊겨 클라이언트가 사라진 피커는 그대로 이어받는다.
  local sess; sess="$(pick_picker_name)"
  # ★좌석에서 C-a d 를 누르면 피커로 돌아온다★ — 기본 detach 는 tmux 밖(셸)으로 떨어져 «tmm 이 끝난» 것처럼 보인다.
  #   피커가 여럿이라 세션명을 바인딩에 박을 수 없다(서버 전역 바인딩이라 마지막 tmm 이 덮어쓴다).
  #   대신 «그 클라이언트가 직전에 있던 세션»으로 돌아간다 — 각 창이 자기 피커로 복귀한다. TMM_NO_DBIND=1 로 끈다.
  local dbind=()
  if [ "${TMM_NO_DBIND:-0}" != 1 ]; then
    dbind=(';' bind-key d run-shell "'$SELF' dkey '#{client_tty}' '#{session_name}'")
  fi
  # ★피커 세션만 tmux 프리픽스를 끈다★ — 전역 프리픽스가 C-a 라서 피커 안의 ^A(좌석뷰)가 fzf 에 닿지 않고 프리픽스로 먹혔다.
  #   그 뒤 ^D(종료뷰)가 «프리픽스+d» = dkey 가 되어 피커를 detach → tmm 이 통째로 끝났다(2026-09-30 사용자 지적:
  #   「^a ^d 로 뒤로갈때 tmm 으로 안 돌아가고 종료로 넘어간다」). 좌석 세션의 C-a d 는 그대로다. 피커 종료는 ^X.
  exec tmux new-session -A -s "$sess" "TMM_NO_WRAP=1 TMM_SESSION='$sess' '$SELF'${TMM_WRAP_AUTO:+ --auto $TMM_WRAP_AUTO}" \
       ';' set -t "=$sess:" @tmm_picker 1 ';' set -t "=$sess:" @tmm_ver "$TMM_VERSION" ';' set -t "=$sess:" prefix None "${dbind[@]}"
}

# 피커를 «이어받아도 되는가» — 붙은 클라이언트가 없고, 살아 있는 어떤 클라이언트도 이 피커를 출발 피커(@tmm_home_<tty>)·직전 세션으로 가리키지 않을 때만.
#   낡은 @tmm_home(클라이언트가 이미 떨어진 것)은 «살아 있는 클라이언트» 만 돌므로 자연히 무시된다. verify (pk).
picker_free() {  # <세션명> → 0 = 이어받기 가능
  [ -z "$(tmux list-clients -t "=$1" -F x 2>/dev/null)" ] || return 1
  local tty last
  while IFS=$'\t' read -r tty last; do
    [ -n "$tty" ] || continue
    [ "$last" = "$1" ] && return 1
    [ "$(tmux show -gqv "@tmm_home_$(tty_key "$tty")" 2>/dev/null)" = "$1" ] && return 1
  done < <(tmux list-clients -F $'#{client_tty}\t#{client_last_session}' 2>/dev/null)
  return 0
}
# ★업그레이드 뒤 살아남은 «다른 버전» 피커(좀비)★ — 0.8.5
#   0.8.4 이하 피커는 재사용 규칙(picker_free)에 «버전»이 없어서, tmm 을 새로 설치해도 21:29 설치 전에 뜬 0.8.3 피커를
#   폰이 계속 물었습니다(2026-10-18 실사고). 그 피커는 자기 RUN 디렉터리(옛 $TMPDIR)의 fzf.sock 에 POST 하는데,
#   세션이 갈리며 소켓이 죽으면 화면은 마지막 상태로 남고 키·탭 전환·갱신이 전부 조용히 사라집니다(«아무 키도 안 먹는다»).
#   버전이 다르면(=@tmm_ver 없음 포함) 이어받지 않는다. 클라이언트가 없으면 죽이고 그 이름을 다시 쓴다.
picker_stale() {  # <세션명> → 0 = 지금 버전이 아님
  local v; v="$(tmux show -t "=$1:" -qv @tmm_ver 2>/dev/null)"
  [ "$v" != "$TMM_VERSION" ]
}
pick_picker_name() {  # → tmm | tmm-2 | … (TMM_SESSION 이 베이스) — 없거나 이어받을 수 있는 첫 이름
  local base sess i=2                                  # ★한 local 문 안에서 앞 변수를 참조하면 set -u 에 걸린다★
  base="${TMM_SESSION:-tmm}"; sess="$base"
  while tmux has-session -t "=$sess" 2>/dev/null; do
    if picker_free "$sess"; then
      # 좀비(다른 버전)는 죽이고 이름을 다시 쓴다 — 붙은 클라이언트가 있으면 남의 화면이라 건드리지 않고 다음 이름으로(0.8.5)
      picker_stale "$sess" && tmux kill-session -t "=$sess" 2>/dev/null
      break
    fi
    sess="$base-$i"; i=$((i+1)); [ "$i" -gt 32 ] && break
  done
  printf '%s' "$sess"
}

# 미리보기 라벨 — 커서가 놓인 좌석의 «온전한» 이름을 보여준다. 목록의 이름 열은 폭에 맞춰 잘리므로
# (60열 폰에서는 20칸) 어느 좌석을 보고 있는지 라벨이 정본이다. focus 이벤트로 커서를 옮길 때마다 갱신.
cmd_plabel() {  # <세션명|SID>
  local n="${1:-}"
  [ -n "$n" ] || { printf ' pane '; return; }
  printf ' %s ' "$n"
}

# 상단 테두리 라벨 — 버전 + 매치수. --info=hidden 으로 비운 «한 줄»을 여기로 옮겼다(폰에서 목록 한 줄이 귀하다).
cmd_blabel() {  # fzf 가 result/load 에서 부른다. 매치수는 환경변수로 온다.
  local m="${FZF_MATCH_COUNT:-}" t="${FZF_TOTAL_COUNT:-}" tr=""
  tab_on && tr=" 탭"
  if [ -n "$m" ] && [ -n "$t" ]; then printf ' tmm %s%s · %s/%s ' "$TMM_VERSION" "$tr" "$m" "$t"
  else printf ' tmm %s%s ' "$TMM_VERSION" "$tr"; fi
}

# ^B = 선택복구 모드 토글 (종료 뷰 전용). fzf 바인딩은 정적이라 «몇 번째 누름인지»를 파일로 들고,
# transform 이 그때그때 다른 액션을 뱉는다. 스페이스는 평소엔 «필터 문자»라서 모드일 때만 rebind 한다.
#   1회: 전체 선택 + 스페이스=체크/해제
#   2회: 모드 종료 — 선택이 있으면 그것만 복구, 없으면 그냥 빠져나온다 (2026-09-16 사용자 스펙)
cmd_bkey() {
  [ "$(view_now)" = dead ] || { printf 'change-prompt(^B 는 종료 뷰 전용 — ^D> )'; return; }
  if [ -f "$RUN/selmode" ]; then
    rm -f "$RUN/selmode"
    if [ "${FZF_SELECT_COUNT:-0}" -gt 0 ]; then
      : > "$RUN/bulk"; printf 'unbind(space)+accept'
    else
      printf 'unbind(space)+deselect-all+change-prompt(종료> )'
    fi
  else
    : > "$RUN/selmode"; printf 'select-all+rebind(space)+change-prompt(선택복구 space=체크 ^B=실행> )'
  fi
}

# C-a d 처리 — 좌석이면 «그 클라이언트가 직전에 있던» 피커로 복귀, 피커면 원래대로 detach.
# 피커 판별은 세션 옵션 @tmm_picker 로 한다(이름은 tmm-2 … 로 늘어나므로 이름 비교는 못 쓴다).
is_picker() { [ "$(tmux show -t "=$1:" -qv @tmm_picker 2>/dev/null)" = 1 ]; }
tty_key()   { printf '%s' "${1//[^A-Za-z0-9]/_}"; }      # /dev/ttys004 → _dev_ttys004 (tmux 사용자 옵션명용)
# ★복귀 대상 3단★ — 예전엔 «직전 세션이 피커일 때만» 돌아가고 아니면 detach(=tmm 종료)였다. 좌석 A → (choose-tree 로) 좌석 B 에서
#   C-a d 를 누르면 직전이 좌석 A 라 피커로 못 돌아가고 밖으로 떨어졌다(2026-09-30).
#   ①cmd_attach 가 남긴 «이 클라이언트의 출발 피커» → ②직전 세션이 피커면 그것 → ③붙은 클라이언트가 없는 피커 → ④그래도 없으면 detach.
cmd_dkey() {  # <client_tty> <현재 세션명>
  local tty="${1:-}" cur="${2:-}" home last p
  [ -n "$tty" ] || return 0
  if is_picker "$cur"; then tmux detach-client -t "$tty" 2>/dev/null; return 0; fi
  home="$(tmux show -gqv "@tmm_home_$(tty_key "$tty")" 2>/dev/null)"
  last="$(tmux display -p -c "$tty" '#{client_last_session}' 2>/dev/null)"
  for p in "$home" "$last"; do
    [ -n "$p" ] && tmux has-session -t "=$p" 2>/dev/null && is_picker "$p" \
      && { tmux switch-client -c "$tty" -t "=$p" 2>/dev/null; return 0; }
  done
  p="$(tmux list-sessions -F $'#{session_attached}\t#{session_name}' -f '#{@tmm_picker}' 2>/dev/null | awk -F'\t' '$1==0{print $2; exit}')"
  if [ -n "$p" ]; then tmux switch-client -c "$tty" -t "=$p" 2>/dev/null; else tmux detach-client -t "$tty" 2>/dev/null; fi
}

# ---------- 카테고리 ----------
# 규칙 파일이 있으면 그것을, 없으면 세션명 접두(문자·숫자·_·- 중 첫 토큰)를 카테고리로.
cat_of() {
  local n="${1%%#*}" glob label
  if [ -f "$CAT_FILE" ]; then
    while IFS=$'\t' read -r glob label; do
      [ -z "$glob" ] || [ "${glob#\#}" != "$glob" ] && continue
      # shellcheck disable=SC2254
      case "$n" in $glob) printf '%s' "${label,,}"; return;; esac
    done < "$CAT_FILE"
  fi
  # ★P6 일반 규칙★ — `<프로젝트>-<팀>-<역할>…`(소문자·숫자·`-` 뿐이고 3번째 토큰이 역할 예약어)면 라벨 = 팀(둘째 토큰).
  #   byz-v65-master-claude → v65 · byz-cfo-master-claude → cfo · ft-v65-master-claude → v65(구 이름도 같은 규칙) · 프로젝트별 규칙 0.
  #   역할 예약어 = scripts/fable-team-bin/ft-name-lint.sh 의 ROLES 와 같은 값(시험이 일치를 잰다).
  #   같은 팀 글자를 «다른 프로젝트»가 쓰는 라이브 세션이 있을 때만 `<프로젝트 첫 글자>-<팀>`(SPEC Q6). 구 접두(ft- FB_)는 프로젝트가 아니다.
  #   TMM_CAT_SESSIONS = 시험용 세션명 목록(줄바꿈 구분) — 미설정이면 tmux list-sessions.
  local roles=" master arch da tester checker analyst pm nano repro tool desk " t1 t2 t3 pfx lower="${n,,}" pl
  if [[ "$n" != *[!a-z0-9-]* ]]; then
    IFS=- read -r t1 t2 t3 _ <<<"$n"
    if [ -n "$t1" ] && [ -n "$t2" ] && [[ "$roles" == *" $t3 "* ]]; then
      local legacy=0 s b p1 p2 p3 list x
      for pfx in ${TMM_CAT_STRIP:-FB_ ft-}; do pl="${pfx,,}"; { [ "$pl" = "$t1-" ] || [ "$pl" = "${t1}_" ]; } && legacy=1; done
      # ★key 모드(0.9.0)★ — `cat_of <세션> key` 는 «프로젝트/팀»을 낸다(분류 칸이 프로젝트(1depth) 아래에 팀(2depth)을 들여써 보인다). 프로젝트가 아닌 구 접두(ft- FB_)·규칙 파일 라벨·
      #   일반화 폴백은 «/ 없는 한 단계(leaf)» 그대로. 같은 팀 글자를 다른 프로젝트가 써도 프로젝트로 갈리므로 key 모드엔 충돌 접두(`b-`)가 필요 없다.
      if [ "$legacy" = 0 ] && [ "${2:-}" = key ]; then printf '%s/%s' "${t1:0:8}" "${t2:0:8}"; return; fi
      if [ "$legacy" = 0 ]; then
        # ★세션 목록은 «프로세스당 한 번» 받아 `팀:프로젝트` 표(CAT_TEAMS)로 만든다★ — 세션마다 list-sessions 를 다시 받고 목록을 다시 돌던 것(113 fork · O(N²) · 2.5초)을 없앤다.
        #   cmd_rows/cmd_dead_rows 는 시작할 때 cat_prep 으로 CAT_LIST 를 정해 부모 셸에서 표를 만들어 둔다($(cat_of …) 서브셸이 표를 물려받는다). 목록 글자가 바뀌면 다시 만든다.
        list="${TMM_CAT_SESSIONS-${CAT_LIST-$(tmux list-sessions -F '#{session_name}' 2>/dev/null)}}"
        if [ "${CAT_SRC+set}" != set ] || [ "$CAT_SRC" != "$list" ]; then
          CAT_SRC="$list"; CAT_TEAMS=" "
          while IFS= read -r s; do
            b="${s%%#*}"; [[ "$b" != *[!a-z0-9-]* ]] || continue
            IFS=- read -r p1 p2 p3 _ <<<"$b"
            [ -n "$p2" ] && [[ "$roles" == *" $p3 "* ]] || continue
            for pfx in ${TMM_CAT_STRIP:-FB_ ft-}; do pl="${pfx,,}"; { [ "$pl" = "$p1-" ] || [ "$pl" = "${p1}_" ]; } && continue 2; done
            [[ "$CAT_TEAMS" == *" $p2:$p1 "* ]] || CAT_TEAMS+="$p2:$p1 "
          done <<<"$list"
        fi
        # 같은 팀 글자를 «다른 프로젝트(p1≠t1)»가 쓰는 세션이 하나라도 있으면 접두를 붙인다
        x="${CAT_TEAMS// $t2:$t1 / }"
        [[ "$x" == *" $t2:"* ]] && t2="${t1:0:1}-$t2"
      fi
      printf '%s' "${t2:0:8}"; return
    fi
  fi
  # ★일반화 폴백★ — 규칙에 안 걸리면 «역할 접두»(기본 `FB_ ft-`, TMM_CAT_STRIP 로 변경)를 떼고 첫 토큰(-/_ 앞 8자)을 라벨로(전부 소문자).
  #   FB_CCU#0 → CCU(=CCU_ARCH 와 한 탭) · FB_CFO#33 → CFO · ft-v65-master → v65 · ft-airag-arch → airag.
  #   접두가 «프로젝트»를 가리던 것(FB_*→FB, ft-*→ft)이 프로젝트별 규칙을 하나씩 늘려야 했던 원인이다.
  for pfx in ${TMM_CAT_STRIP:-FB_ ft-}; do
    pl="${pfx,,}"; [ "${lower#"$pl"}" != "$lower" ] && [ "${#n}" -gt "${#pfx}" ] && { n="${n:${#pfx}}"; break; }
  done
  # ★라벨은 전부 소문자★ — KK / kk, CCU / ccu 가 다른 탭으로 갈라지던 것(2026-10-02). 그룹 키는 8자(ARCHDOC 이 ARCHD 로 잘리지 않게),
  #   목록의 카테고리 «열»만 5자로 자른다(cmd_rows / cmd_dead_rows).
  n="${n%%[-_]*}"; n="${n,,}"; printf '%s' "${n:0:8}"
}

# 목록을 그리는 함수(cmd_rows·cmd_dead_rows)가 시작할 때 부른다 — 세션 목록을 1회 받아 CAT_LIST 에 두고 cat_of 의 표를 «부모 셸»에서 만든다.
cat_prep() { CAT_LIST="${TMM_CAT_SESSIONS-$(tmux list-sessions -F '#{session_name}' 2>/dev/null)}"; cat_of zz-zz-master > /dev/null; }

# ---------- 상태 스캔 (캐시) ----------
# seat-scan 은 좌석당 capture 2회라 65좌석에 ~2초. 폰에서 필터/^R 을 연타해도 TTL 안에서는 재사용.
scan_cached() {
  [ -n "$SCAN" ] || { return 0; }
  cache_init
  if [ "$CACHE_TTL" -gt 0 ] && [ -f "$CACHE" ]; then
    local age=$(( $(date +%s) - $(stat -f %m "$CACHE" 2>/dev/null || stat -c %Y "$CACHE") ))
    [ "$age" -lt "$CACHE_TTL" ] && { cat "$CACHE"; return; }
  fi
  # ★낡았을 때 다시 스캔하는 인스턴스는 «하나»★ — 피커가 여럿(폰·데스크탑·tmm-2…)이면 20초마다 전원이 같은 seat-scan(7초)을 동시에 돌렸다.
  #   mkdir 락을 잡은 쪽만 스캔하고, 진 쪽은 기존(낡은) 캐시를 바로 읽는다(다음 틱에 새 것). 캐시가 아예 없으면 락이 풀릴 때까지 기다렸다 읽는다.
  #   스캔 중 죽어 남은 락은 1분이 지나면 치운다. TTL 0(시험·항상 재스캔)은 락을 쓰지 않는다.
  local lock="$CACHE.lock" w=0
  if [ "$CACHE_TTL" -gt 0 ] && ! mkdir "$lock" 2>/dev/null; then
    if [ -n "$(find "$lock" -maxdepth 0 -mmin +1 2>/dev/null)" ]; then
      rmdir "$lock" 2>/dev/null; mkdir "$lock" 2>/dev/null || { cat "$CACHE" 2>/dev/null; return; }
    else
      [ -f "$CACHE" ] || while [ -d "$lock" ] && [ "$w" -lt 120 ]; do sleep 0.25; w=$((w+1)); done
      cat "$CACHE" 2>/dev/null; return
    fi
  fi
  # 캐시는 인스턴스 간 공유 — 폰·PC 가 동시에 갱신하면 같은 .tmp 를 놓고 경합해 «mv: No such file» 이 튄다(실측).
  # 프로세스별 임시 파일로 쓰고 mv 는 조용히 — 진 쪽은 이긴 쪽의 결과를 읽으면 되니 실패해도 무해.
  local tmp="$CACHE.$$.tmp"
  bash "$SCAN" 2>/dev/null > "$tmp"; mv -f "$tmp" "$CACHE" 2>/dev/null || rm -f "$tmp"
  rmdir "$lock" 2>/dev/null; cat "$CACHE" 2>/dev/null
}
scan_fresh() { cache_init; rm -f "$CACHE"; scan_cached; }

# 대기(사람이 봐야 할) 상태 = 항상 최상단 고정
wait_rank() { case "$1" in HUMAN) echo 0;; BLOCK) echo 1;; STUCK) echo 2;; *) echo 5;; esac; }

# ---------- 마지막 메시지 시각 ----------
# 1순위 claude 완료 마커 "done 오후 12:56"(줄바꿈 분리 대비 공백 병합),
# 2순위 tmux window_activity(pane 마지막 출력 — idle 좌석은 안 움직이므로 유효, BUSY 좌석은 ≈now).
last_epoch() {  # $1 session  $2 window_activity  $3 midnight_epoch  $4 now  →  "epoch <:|~>"
  local txt ampm h m t
  txt="$(tmux capture-pane -t "=$1:" -p -S -300 2>/dev/null | tr -s '\n ' '  ')"
  # 한국어 로케일 "done 오후 12:56" / 영어 로케일 "done 12:56 PM" 둘 다
  if [[ "$txt" =~ done\ +(오전|오후)\ +([0-9]{1,2}):([0-9]{2}) ]]; then
    ampm="${BASH_REMATCH[1]}"; h=$((10#${BASH_REMATCH[2]})); m=$((10#${BASH_REMATCH[3]}))
  elif [[ "$txt" =~ done\ +([0-9]{1,2}):([0-9]{2})\ +(AM|PM) ]]; then
    h=$((10#${BASH_REMATCH[1]})); m=$((10#${BASH_REMATCH[2]})); ampm="${BASH_REMATCH[3]}"
  else
    echo "${2:-0} ~"; return
  fi
  { case "$ampm" in 오후|PM) [ $h -lt 12 ] && h=$((h+12));; 오전|AM) [ $h -eq 12 ] && h=0;; esac; } || true
  if true; then
    t=$(( $3 + h*3600 + m*60 )); [ $t -gt $(( $4 + 120 )) ] && t=$((t-86400))
    echo "$t :"
  fi
}
age_of() {  # 상대 나이 3자: 3m / 2h / 1d
  local d=$(( $2 - $1 ))
  [ "$1" -le 0 ] && { echo "  -"; return; }
  if [ $d -lt 3600 ]; then printf '%2dm' $((d/60)); elif [ $d -lt 86400 ]; then printf '%2dh' $((d/3600)); else printf '%2dd' $((d/86400)); fi
}
midnight() { date -v0H -v0M -v0S +%s 2>/dev/null || date -d 'today 00:00' +%s; }
fmt_hm()   { date -r "$1" "+%H$2%M" 2>/dev/null || date -d "@$1" "+%H$2%M" 2>/dev/null || echo '--:--'; }

# ---------- 모델 표기 ----------
# 폰 60열에 맞춰 8자 안으로: claude-opus-5[1m]→opus5·1m · claude-opus-5-5[1m]→op55·1m · claude-sonnet-5→sonn5 · claude-sonnet-5-5[1m]→sn55·1m · claude-fable-5-1→fabl51 · gpt-5.6-luna→luna
# gpt-6-astra→astra · gpt-5.6-terra→terra. 알 수 없으면 뒤 7자.
model_short() {  # <model> [effort] — effort 를 주면 모델 5칸 + `·` + 2칸 약어(총 8칸)
  local m="$1" ef="${2:-}" ctx="" rest ver fl t ini
  case "$m" in *\[1m\]*) ctx="·1m"; m="${m%%\[*}";; esac
  case "$m" in */*) m="${m##*/}";; esac   # 프로바이더 경로(opengateway/deepseek/…·openrouter/…)는 뗀다(0.9.2)
  case "$m" in
    deepseek-v*)     rest="${m#deepseek-v}"; ver="${rest%%-*}"; fl="${rest#"$ver"}"; ini=""   # deepseek-v4.1-flash-ultrafast → ds41fu · v4-pro → ds4p
                     for t in ${fl//-/ }; do ini+="${t:0:1}"; done; m="ds${ver//./}${ini}";;
    claude-opus-*-*) m="op${m#claude-opus-}";;   # 5-5 처럼 두 마디면 op55 — opus55·1m 은 5칸 절단에 opus5·1m 이 되어 opus-5 와 겹친다
    claude-opus-*)   m="opus${m#claude-opus-}";;
    claude-sonnet-*-*) m="sn${m#claude-sonnet-}";;   # 5-5 처럼 두 마디면 sn55 — sonn55·1m 은 5칸 절단에 sonn5·1m 이 되어 sonnet-5 와 겹친다
    claude-sonnet-*) m="sonn${m#claude-sonnet-}";;
    claude-haiku-*)  m="haik${m#claude-haiku-}";;
    claude-fable-*)  m="fabl${m#claude-fable-}";;
    gpt-*-*)         m="${m##*-}";;          # gpt-5.6-luna → luna, gpt-6-astra → astra
    "")              m="?";;
  esac
  # 열 폭 8 을 넘지 않게 — ctx(·1m, 3칸) 가 붙으면 본체는 5칸까지 (fabl51·1m 이 9칸이 되어 행이 밀렸다)
  m="${m//-/}"
  if [ -n "$ctx" ]; then printf '%s%s' "${m:0:5}" "$ctx"; return; fi
  # effort 표시(0.9.4): 모델만 보면 «같은 모델인데 왜 느리지» 를 알 수 없다(실측 off 1.25s vs high 2.08s).
  #   2칸 약어로 8칸 안에 넣는다 — off=of minimal=mi low=lo medium=md high=hi xhigh=xh max=mx.
  if [ -n "$ef" ]; then
    case "$ef" in
      off|of) ef=of;; minimal|mi) ef=mi;; low|lo) ef=lo;; medium|md) ef=md;;
      high|hi) ef=hi;; xhigh|xh) ef=xh;; max|mx) ef=mx;; *) ef="${ef:0:2}";;
    esac
    printf '%s·%s' "${m:0:5}" "$ef"; return
  fi
  printf '%s' "${m:0:8}"
}
# 라이브 좌석의 모델: pane 자식 프로세스 argv 의 --model / -c model= (tmuxc model 과 같은 정본). codex 에 -c model 이 없으면 config 기본.
pi_footer_model() {  # stdin = pane 화면 → pi 하단 줄 `… 3.6%/1.0M (auto)  deepseek/deepseek-v4.1-flash-ultrafast • high` 의 모델 토큰(없으면 빈 출력)
  sed -nE 's/.*[0-9.]+%\/[0-9.]+[MK] \(auto\) +([A-Za-z0-9._\/:-]+).*/\1/p' | tail -1
}
live_effort_of() {  # pane_pid [session] → thinking/effort 약어 원값(없으면 빈 출력)
  local c a
  c="$(pgrep -P "$1" 2>/dev/null | head -1)"; [ -n "$c" ] || return 0
  a="$(ps -o args= -p "$c" 2>/dev/null)" || return 0
  case "$a" in
    pi|pi\ *|*/pi|*/pi\ *)   # pi 는 argv 에 --thinking 이 있지만 process.title 이 가린다 → tmuxc 가 심은 세션 env(정확)
      [ -n "${2:-}" ] && tmux show-environment -t "=$2" TMUXC_PI_THINKING 2>/dev/null | sed -n 's/^TMUXC_PI_THINKING=//p'
      return 0;;
  esac
  printf '%s' "$a" | grep -oE -- '--effort[ =][a-z]+' | head -1 | sed 's/.*[ =]//'
  [ -n "$(printf '%s' "$a" | grep -oE 'model_reasoning_effort="[a-z]+"')" ] && printf '%s' "$a" | sed -nE 's/.*model_reasoning_effort="([a-z]+)".*/\1/p' | head -1
  return 0
}
live_model_of() {  # pane_pid [session]
  local c m; c="$(pgrep -P "$1" 2>/dev/null | head -1)"; [ -n "$c" ] || { printf ''; return; }
  m="$(ps -o args= -p "$c" 2>/dev/null | sed -nE 's/.*(--model[ =]|-c model=)"?([^" ]+)"?.*/\2/p' | head -1)"
  # pi 는 프로세스 이름이 `pi` 로 바뀌어 argv 에 --model 이 없다(0.9.2) → tmuxc 가 심은 세션 환경 TMUXC_PI_MODEL(정확) → 없으면 하단 줄(폭에 잘릴 수 있음)
  if [ -z "$m" ] && [ -n "${2:-}" ]; then
    case "$(ps -o args= -p "$c" 2>/dev/null)" in
      pi|pi\ *|*/pi|*/pi\ *)
        m="$(tmux show-environment -t "=$2" TMUXC_PI_MODEL 2>/dev/null | sed -n 's/^TMUXC_PI_MODEL=//p')"
        [ -n "$m" ] || m="$(tmux capture-pane -t "=$2:" -p 2>/dev/null | pi_footer_model)";;
    esac
  fi
  # codex 가 config 기본 모델로 떴으면 argv 에 없다 → pane 하단 «gpt-6-astra medium fast» 에서 읽는다
  [ -z "$m" ] && [ -n "${2:-}" ] && m="$(tmux capture-pane -t "=$2:" -p 2>/dev/null | grep -oE '\bgpt-[0-9.]+-[a-z]+\b' | tail -1)"
  printf '%s' "$m"
}

# ---------- 열 너비 (목록 폭에 맞춘다) ----------
# 폰 60열 기준 고정폭이던 것을 «남는 만큼» 세션명·cwd 에 준다 — 넓은 창에서 이름 뒤 #N 과 경로 뒷부분이 보이게.
# 기준 폭은 FZF_COLUMNS(=목록 영역). 미리보기가 오른쪽이면 그만큼 이미 빠져 있다.
col_widths() {  # → "이름폭 cwd폭"
  local w extra n=20 c=6
  w="${FZF_COLUMNS:-${COLUMNS:-60}}"
  extra=$(( w - 59 ))                      # 59 = 60열에서 쓰던 합계
  if [ "$extra" -gt 0 ]; then
    n=$(( 20 + extra * 6 / 10 )); [ "$n" -gt 44 ] && n=44
    c=$(( 6  + extra * 4 / 10 )); [ "$c" -gt 28 ] && c=28
  fi
  printf '%s %s' "$n" "$c"
}
# 이름이 폭을 넘으면 «가운데»를 접고 끝의 #N 을 남긴다 — ft-v65-master-sonnet#5 / #6 이 20자에서 잘려
# 똑같이 보이던 문제(2026-09-14 사용자 지적). 인덱스가 곧 좌석의 구분자다.
clip_name() {  # <이름> <폭>
  local s="$1" w="$2" idx="" base keep
  [ "${#s}" -le "$w" ] && { printf '%s' "$s"; return; }
  case "$s" in *\#*) idx="#${s##*#}" ;; esac
  keep=$(( w - ${#idx} - 1 ))
  [ "$keep" -lt 4 ] && { printf '%s' "${s:0:$w}"; return; }
  base="${s%"$idx"}"
  printf '%s…%s' "${base:0:$keep}" "$idx"
}

# ---------- rows ----------
# rows [time|wait|cat] [h] [fresh]  →  "표시줄\t세션명\t카테고리"
# tmux 호출 2회(list-panes -a + seat-scan) + 좌석당 capture 1회(시각). 좌석별 display/list-panes 루프 금지.
cmd_rows() {
  local mode="${1:-time}" only="${2:-}" fresh="${3:-}" s st cwd cat tl pcmd live act ep src now mid nw cw
  read -r nw cw <<<"$(col_widths)"
  cat_prep
  declare -A ST
  if [ "$fresh" = fresh ]; then
    while read -r name state _; do ST["$name"]="$state"; done < <(scan_fresh)
  else
    while read -r name state _; do ST["$name"]="$state"; done < <(scan_cached)
  fi
  wait_delta
  now=$(date +%s); mid=$(midnight)
  # 시각 추출은 좌석당 capture 1회 — 직렬이면 부하 시 1~2초라 8병렬로 (순서 무관, 뒤에서 sort)
  # ★좌석별 결과 캐시★ — (window_activity, pane_pid) 가 직전과 같으면 그 좌석의 «완료 시각·모델»은 그대로다(출력이 없었으니 done 마커도,
  #   프로세스 argv 도 안 바뀜). 64좌석 중 움직인 것만 다시 캡처한다: 병렬 구간 1.3초 → 활동 좌석 수에 비례. 캐시는 $STATE/ep-<버전>.cache(원자적 교체 · 버전이 바뀌면 새로 — 0.9.2: 표시 규칙이 바뀐 뒤에도 옛 «?» 가 안 남게).
  declare -A EP MD EF CA CE CM KEY
  local ecache="$STATE/ep-${TMM_VERSION:-dev}.cache" todo="" a2 p2
  if [ -f "$ecache" ]; then
    while IFS=$'\t' read -r s a2 p2 ep src md ef; do CA["$s"]="$a2:$p2"; CE["$s"]="$ep $src"; CM["$s"]="$md"; CM["$s.effort"]="$ef"; done < "$ecache"
  fi
  while IFS=$'\t' read -r s a2 p2; do
    KEY["$s"]="$a2:$p2"
    if [ "${CA[$s]:-}" = "$a2:$p2" ]; then EP["$s"]="${CE[$s]}"; MD["$s"]="${CM[$s]}"; EF["$s"]="${CM[$s.effort]:-}"
    else todo+="$s"$'\t'"$a2"$'\t'"$p2"$'\n'; fi
  done < <(tmux list-panes -a -F $'#{session_name}\t#{window_activity}\t#{pane_pid}' 2>/dev/null | awk -F'\t' '!seen[$1]++')
  if [ -n "$todo" ]; then
    while IFS=$'\t' read -r s ep src md ef; do EP["$s"]="$ep $src"; MD["$s"]="$md"; EF["$s"]="$ef"; done < <(
      printf '%s' "$todo" | xargs -P 8 -L 1 bash -c 'source "$0" __lib; e="$(last_epoch "$3" "$4" "$1" "$2")"; printf "%s\t%s\t%s\t%s\t%s\n" "$3" "${e%% *}" "${e##* }" "$(live_model_of "$5" "$3")" "$(live_effort_of "$5" "$3")"' "$SELF" "$mid" "$now" 2>/dev/null
    )
  fi
  { for s in "${!KEY[@]}"; do
      [ -n "${EP[$s]:-}" ] || continue
      read -r ep src <<<"${EP[$s]}"; a2="${KEY[$s]%%:*}"; p2="${KEY[$s]##*:}"
      printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$s" "$a2" "$p2" "$ep" "$src" "${MD[$s]:-}" "${EF[$s]:-}"
    done; } > "$ecache.$$.tmp" 2>/dev/null && mv -f "$ecache.$$.tmp" "$ecache" 2>/dev/null || rm -f "$ecache.$$.tmp" 2>/dev/null
  # 피커 세션은 «자신이든 다른 창의 것이든» 좌석이 아니다. list-sessions 한 번으로 받는다(좌석당 루프 금지).
  local picks=" $(tmux list-sessions -F '#{session_name}' -f '#{@tmm_picker}' 2>/dev/null | tr '\n' ' ')"
  while IFS=$'\t' read -r s pcmd act cwd; do
    case "$picks" in *" $s "*) continue ;; esac
    [ -n "${TMM_SESSION:-}" ] && [ "$s" = "$TMM_SESSION" ] && continue   # 래핑 안 쓴 경우의 폴백
    st="${ST[$s]:-?}"
    [ "$only" = "h" ] && ! [[ "$st" =~ ^(HUMAN|BLOCK|STUCK)$ ]] && continue
    case "$pcmd" in zsh|bash|sh|fish|-zsh|-bash) live="○";; *) live="●";; esac
    cwd="${cwd##*/}"; cat="$(cat_of "$s" key)"; tl="${cat#*/}"; read -r ep src <<<"${EP[$s]:-$act ~}"   # cat = «프로젝트/팀»(key 모드) · 열에는 팀(tl)만
    printf '%s\t%s\t%s\t%-5s %s %-*s %-5s %-8s %s %s %s\t%s\t%s\n' \
      "$(wait_rank "$st")" "$ep" "$cat" \
      "${tl:0:5}" "$live" "$nw" "$(clip_name "$s" "$nw")" "$st" "$(model_short "${MD[$s]:-}" "${EF[$s]:-}")" "$(fmt_hm "$ep" "$src")" "$(age_of "$ep" "$now")" "${cwd:0:$cw}" \
      "$s" "$cat"
  done < <(tmux list-panes -a -F $'#{session_name}\t#{pane_current_command}\t#{window_activity}\t#{pane_current_path}' 2>/dev/null | awk -F'\t' '!seen[$1]++') \
  | { case "$mode" in
        cat)  sort -t$'\t' -k3,3 -k2,2nr;;            # 카테고리 → 최근순
        wait) sort -t$'\t' -k1,1n -k2,2nr;;           # 대기(HUMAN/BLOCK/STUCK) 상단 고정 → 최근순
        *)    sort -t$'\t' -k2,2nr;;                  # time(기본): 마지막 응답 역순 — 진입 시 최신 대화가 맨 위
      esac; } | cut -f4-
}

# 직전 스캔 대비 «새로» 대기(HUMAN/BLOCK/STUCK)가 된 좌석이 있으면 벨 플래그. 호출자(cmd_rows)의 ST 를 읽는다.
# 첫 스캔(비교 대상 없음)은 기록만 — 진입하자마자 기존 대기 좌석으로 울리지 않게.
wait_delta() {
  local k cur
  cur="$(for k in "${!ST[@]}"; do [[ "${ST[$k]}" =~ ^(HUMAN|BLOCK|STUCK)$ ]] && echo "$k"; done | sort)"
  if [ -f "$RUN/waitset" ]; then
    comm -23 <(printf '%s\n' "$cur") "$RUN/waitset" | grep -q . && : > "$RUN/bell"
  fi
  printf '%s\n' "$cur" > "$RUN/waitset"
}

# 정렬 모드는 파일에 남긴다 — ^R·자동 갱신이 «현재 모드»로 다시 그리게 (전엔 ^R 이 늘 time 으로 되돌렸다)
cmd_mode()     { printf '%s %s\n' "$1" "${2:-}" > "$RUN/mode"; }
# ★커서 고정은 tmm 이 한다(0.8.2)★ — fzf `--id-nth` 는 reload 가 끝날 때까지 «키 입력을 버리고» reload 뒤에 이은 액션(프롬프트·헤더)도 버린다
#   (fzf 0.74.3 최소 예제 실측 2026-10-15: ^D 뒤 헤더·프롬프트 안 바뀜 · 종료 스캔 중 누른 ^] 증발 · 20초 갱신 reload 마다 입력 막힘 = «느리다»).
#   그래서 --track 만 두고, reload 가 커서 세션(TMM_CUR={2})·질의(TMM_Q={q})를 넘기면 새 목록에서 그 세션이 «화면에 보일 순서»를 $RUN/wantpos 에 적는다
#   → reload 직후 load 이벤트(cmd_onload)가 pos(N). 질의가 있으면 목록 fzf 와 같은 옵션의 `fzf --filter` 로 매치 순서를 그대로 재현한다.
cmd_rows_cur() {
  [ -n "${TMM_CUR:-}" ] || { rows_cur_emit "$@"; return; }
  local f="$RUN/rowscur.$$" p
  rows_cur_emit "$@" > "$f"
  p="$(screen_pos "$f" "$TMM_CUR" "${TMM_Q:-}")"
  [ -n "$p" ] && [ ! -s "$RUN/wantpos" ] && printf '%s\n' "$p" > "$RUN/wantpos"
  cat "$f"; rm -f "$f"
}
screen_pos() {  # <목록 파일> <세션명> <질의> — 그 세션이 화면에 보일 순서(1부터). 없으면 빈 출력
  if [ -n "${3:-}" ]; then fzf --filter "$3" --ansi --delimiter=$'\t' --with-nth=1 --nth=1,3 --tiebreak=index --scheme=path < "$1" 2>/dev/null; else cat "$1"; fi \
    | awk -F'\t' -v n="$2" '$2==n{print NR; exit}'
}
rows_cur_emit() {  # ★뷰를 따라간다★ — ^R·20초 자동 갱신이 여기만 부르므로, dead 뷰인데 live 목록으로 되돌아가면 안 된다
  local m o; { read -r m o < "$RUN/mode"; } 2>/dev/null
  if [ "$(view_now)" = dead ]; then cmd_dead_rows "${m:-time}" "${1:-}"
  else
    local tmp="$STATE/rows.snap.$$"
    cmd_rows "${m:-time}" "${o:-}" "${1:-}" > "$tmp"
    # ★탭 전환용 «전체 목록» 스냅샷★ — tab_switch_to 가 tmux·scan 없이 이 파일을 카테고리로 거른다. 원자적 교체.
    cp -f "$tmp" "$RUN/rowsfull.$$" 2>/dev/null && mv -f "$RUN/rowsfull.$$" "$RUN/rowsfull" 2>/dev/null
    if [ -f "$RUN/tab" ]; then tab_rows < "$tmp"; else cat "$tmp"; fi | tee "$RUN/shown.$$" 
    mv -f "$RUN/shown.$$" "$RUN/shown" 2>/dev/null
    # 부팅 즉시 그릴 «직전 화면» — 시간순·전체 필터일 때만(부팅 모드와 같아야 그대로 쓴다). 원자적 교체.
    if [ "${m:-time}" = time ] && [ -z "${o:-}" ] && [ -s "$tmp" ]; then mv -f "$tmp" "$STATE/rows.snap" 2>/dev/null; else rm -f "$tmp"; fi
  fi
}
# ★부팅 = 직전 화면 먼저, 갱신은 뒤에서★ — 첫 화면이 전체 스캔(seat-scan 2.5초 + 좌석별 캡처, 부하 시 10초)을 기다리던 것을 없앤다.
#   스냅샷(최대 30분)이 있고 지금 부팅 모드와 같으면 그것을 즉시 내고, fzf start 이벤트가 boot-reload 로 진짜 목록을 바꿔 끼운다.
#   낡은 행에서 Enter 를 눌러도 cmd_attach 가 has-session 으로 막는다. 스냅샷이 없으면(첫 실행) 예전처럼 rows-cur.
cmd_rows_boot() {
  local snap="$STATE/rows.snap" m o
  { read -r m o < "$RUN/mode"; } 2>/dev/null
  if [ "$(view_now)" = live ] && [ "${m:-time}" = time ] && [ -z "${o:-}" ] && [ -s "$snap" ] \
     && [ $(( $(date +%s) - $(stat -f %m "$snap" 2>/dev/null || stat -c %Y "$snap") )) -lt 1800 ]; then
    : > "$RUN/bootstale"
    cp -f "$snap" "$RUN/rowsfull.$$" 2>/dev/null && mv -f "$RUN/rowsfull.$$" "$RUN/rowsfull" 2>/dev/null
    if [ -f "$RUN/tab" ]; then tab_rows < "$snap"; else cat "$snap"; fi | tee "$RUN/shown.$$"
    mv -f "$RUN/shown.$$" "$RUN/shown" 2>/dev/null
  else
    cmd_rows_cur
  fi
}
# ---------- 탭별 커서 기억 (0.7.3) ----------
# 탭마다 «마지막으로 커서가 있던 세션»을 $RUN/tabcur(`탭\t세션명`) 에 둔다. 탭을 옮길 때·좌석에 붙을 때 저장하고, 돌아오면 그 세션에 커서를 놓는다.
#   (전엔 탭 전환이 늘 `first` 라 커서가 매번 맨 위로 갔고, --track 은 --id-nth 없이 «줄 전체» 가 같아야 추적해 시각·상태가 바뀌는 20초 갱신마다 커서가 튀었다.)
tab_cur_id() {  # 지금 탭 id — 선택이 없거나 사라졌으면 첫 카테고리(tab_rows 와 같은 규칙)
  local sel; sel="$(cat "$RUN/tabsel" 2>/dev/null)"
  if [ -s "$RUN/tabs" ] && cut -f1 "$RUN/tabs" | grep -qxF -- "$sel"; then printf '%s' "$sel"; else sed -n 1p "$RUN/tabs" 2>/dev/null | cut -f1; fi
}
cur_tab_key() { if tab_on; then tab_cur_id; else printf 'list'; fi; }
tabcur_set() {  # <탭> <세션명>
  [ -n "${1:-}" ] && [ -n "${2:-}" ] || return 0
  { awk -F'\t' -v t="$1" '$1!=t' "$RUN/tabcur" 2>/dev/null; printf '%s\t%s\n' "$1" "$2"; } > "$RUN/tabcur.$$" && mv -f "$RUN/tabcur.$$" "$RUN/tabcur"
}
tabcur_get() { awk -F'\t' -v t="${1:-}" '$1==t{print $2; exit}' "$RUN/tabcur" 2>/dev/null; }
row_pos() {  # <목록파일> <세션명...> — 먼저 찾아지는 세션의 줄 번호(1부터). 없으면 빈 출력
  local f="$1" n p; shift
  for n in "$@"; do
    [ -n "$n" ] || continue
    p="$(awk -F'\t' -v n="$n" '$2==n{print NR; exit}' "$f" 2>/dev/null)"; [ -n "$p" ] && { printf '%s' "$p"; return; }
  done
}
cmd_boot_reload() {  # fzf start — ①기억한 커서 복원 ②스냅샷 부팅이면 진짜 목록으로 갱신(--track 이 커서를 지켜 준다)
  local acts="" p
  p="$(row_pos "$RUN/shown" "$(tabcur_get "$(cur_tab_key)")")"; [ -n "$p" ] && acts="pos($p)"
  if [ -f "$RUN/bootstale" ]; then rm -f "$RUN/bootstale"; acts+="${acts:++}reload(TMM_CUR={2} TMM_Q={q} $SELF rows-cur)"; fi
  printf '%s' "$acts"; return 0
}

# ---------- 분할 화면 (0.8.0) ----------
# 왼쪽 = 카테고리 칸(별도 fzf · tmux pane) · 오른쪽 = 세션 목록(+pane 미리보기). 사용자 원문 「상하만 사용 · 반을 나눠서 좌측에 카테고리」(2026-10-12).
#   fzf 는 목록이 하나뿐이라 한 fzf 에 두 커서를 못 둔다 → 피커 세션(tui_wrap) 안에서 pane 을 하나 더 가른다.
#   키: ↑↓ 는 지금 칸 안에서 · ⏎(분류 칸)=목록으로 · Esc·⌫(빈 질의)(목록)=분류 칸으로 · ←/→ 는 같은 동작의 별칭 · Tab/S-Tab 탭 회전은 없다.
#   상태: $RUN/mainpane(목록 pane id) · catpane(분류 pane id — 있으면 분할 켜짐) · catw(칸 폭) · cat.sock(분류 fzf --listen) · catseen(핑거가 분류 칸을 마지막으로 갱신한 표식)
#   분류 칸 → 목록: 분류 fzf 의 focus 가 목록 fzf 소켓에 `transform($SELF tabgo <분류> {2})` 를 쏜다({2} 는 목록 fzf 가 «자기» 커서 세션으로 푼다).
#   목록 → 분류 칸: 핑거(auto_loop)가 $RUN/tabs 가 새로 쓰일 때마다 cat.sock 에 reload 를 쏜다(첫 목록이 늦게 와도 자연히 채워진다).
#   분류 칸에서 누른 다른 키(^X ^D ^A …)는 목록 칸으로 넘긴다(catfwd — 우리 피커 pane 에만 send-keys · 좌석 아님).
#   tmux 없이(TMM_NO_WRAP=1) 돌면 분할 불가 → 0.7.x 탭 줄(Tab/S-Tab) 그대로. TMM_SPLIT=0 도 같다. verify (sp).
split_catw()   { [ "${1:-60}" -ge 120 ] && printf 16 || printf 11; }   # 폰(<120)은 이름 7자+⚠N, 데스크탑은 이름 8자+수 (포인터 2칸 포함)
split_active() { [ -s "$RUN/catpane" ]; }
to_cat_action() { printf 'execute-silent(tmux select-pane -t %s)' "$(cat "$RUN/catpane")"; }
split_open() {  # [목록 pane id] — 왼쪽에 분류 칸 pane 을 열고 그 안에서 `$SELF catpane` 을 돌린다
  local main w catw cp; main="${1:-$(cat "$RUN/mainpane" 2>/dev/null)}"
  [ -n "$main" ] || return 0
  split_active && return 0
  w="$(tmux display -p -t "$main" '#{window_width}' 2>/dev/null)"; catw="$(split_catw "${w:-60}")"
  printf '%s' "$main" > "$RUN/mainpane"; printf '%s' "$catw" > "$RUN/catw"; rm -f "$RUN/catseen"
  cp="$(tmux split-window -h -b -d -l "$catw" -P -F '#{pane_id}' -t "$main" "TMM_RUN='$RUN' TMM_NO_WRAP=1 '$SELF' catpane" 2>/dev/null)" || return 0
  [ -n "$cp" ] || return 0
  printf '%s' "$cp" > "$RUN/catpane"
  tmux set -w -t "$main" pane-active-border-style 'fg=cyan' 2>/dev/null; tmux set -w -t "$main" pane-border-style 'fg=brightblack' 2>/dev/null
  return 0
}
split_close() {  # 분류 칸 pane(우리 피커 세션의 것)을 닫는다 — 좌석이 아니다
  local cp; cp="$(cat "$RUN/catpane" 2>/dev/null)"
  rm -f "$RUN/catpane" "$RUN/cat.sock" "$RUN/catseen"
  [ -n "$cp" ] && tmux kill-pane -t "$cp" 2>/dev/null
  return 0
}
cmd_catrows() {  # $RUN/tabs(카테고리\t수\t대기수) → «키\t라벨» — 분류 fzf 의 행. 폭은 $RUN/catw(포인터 2칸 제외)
  local catw cat cnt wt lab; catw="$(cat "$RUN/catw" 2>/dev/null || echo 11)"
  [ -s "$RUN/tabs" ] || return 0
  while IFS=$'\t' read -r cat cnt wt; do
    # 좁은 칸(폰 60열 = catw 11 → 보이는 폭 9)도 수를 뺀다 — 이름 5자 + 수 2자(회색) + ⚠N. 수는 «폭이 모자라서» 숨기지 않는다(0.8.6 · 사용자 2026-10-20)
    # ★트리(0.9.0)★ — 키가 `프로젝트/팀` 이면 팀 줄: 한 칸 들여쓰고(넓은 칸 2칸) 이름을 줄인다(좁은 칸 4자 · 넓은 칸 6자). 프로젝트 줄은 굵게.
    if [ "$cat" = '*' ]; then lab='전체'
      if [ "$catw" -ge 16 ]; then lab="$(printf '%-6s %2s' "$lab" "$cnt")"; else lab+="$(printf '\033[90m %2s\033[0m' "$cnt")"; fi
    elif [ "${cat#*/}" != "$cat" ]; then
      if [ "$catw" -ge 16 ]; then lab="$(printf '  %-6.6s\033[90m %2s\033[0m' "${cat#*/}" "$cnt")"
      else lab="$(printf ' %-4.4s\033[90m%2s\033[0m' "${cat#*/}" "$cnt")"; fi
    elif [ "$catw" -ge 16 ]; then lab="$(printf '\033[1m%-8.8s\033[0m\033[90m %2s\033[0m' "$cat" "$cnt")"
    else lab="$(printf '\033[1m%-5.5s\033[0m\033[90m%2s\033[0m' "$cat" "$cnt")"; fi
    [ "${wt:-0}" -gt 0 ] && lab+=$'\033[31m⚠'"$wt"$'\033[0m'
    printf '%s\t%s\n' "$cat" "$lab"
  done < "$RUN/tabs"
}
cat_sync() {  # 분류 칸 행을 다시 만들어 «바뀐 때만» $RUN/catrows 로 바꾼다 — 바뀜=0, 안 바뀜=1. 핑거가 reload 를 쏠지 여기서 가른다(스폰 0: cmd_catrows 는 같은 프로세스 함수 호출)
  cmd_catrows > "$RUN/catrows.new" 2>/dev/null
  if [ -f "$RUN/catrows" ] && cmp -s "$RUN/catrows.new" "$RUN/catrows"; then rm -f "$RUN/catrows.new"; return 1; fi
  mv -f "$RUN/catrows.new" "$RUN/catrows"; return 0
}
cmd_catpane() {  # 분류 칸 pane 안에서 돈다 — ↑↓ 로 고르면 목록이 바뀌고(focus), ⏎/→/Tab 은 목록 칸으로. 나머지 키는 목록 칸에 넘긴다.
  local sock="$RUN/cat.sock" rc n k
  local -a fwd=()
  for k in ctrl-x ctrl-v ctrl-d ctrl-a ctrl-r ctrl-t ctrl-w ctrl-g ctrl-h ctrl-p ctrl-o ctrl-u ctrl-y ctrl-s ctrl-k ctrl-f ctrl-e ctrl-b; do
    fwd+=(--bind "$k:execute-silent($SELF catfwd C-${k#ctrl-})")
  done
  # 종료 뷰 창 넓히기·좁히기·계보(^] ^\ ^L)도 넘긴다 — 빠져 있어서 커서가 분류 칸에 있으면 «안 먹었다»(2026-10-15). ] \ 는 tmux 키 이름 대신 바이트로 보낸다.
  fwd+=(--bind "ctrl-]:execute-silent($SELF catfwd hex:1d)" --bind "ctrl-\\:execute-silent($SELF catfwd hex:1c)" --bind "ctrl-l:execute-silent($SELF catfwd C-l)")
  # ★키 에코 차단★ — fzf 기동 전·재시작 틈(아래 sleep 0.3)에 누른 ↑↓ 가 cooked tty 에 `^[[A` 로 찍히는 걸 막는다(2026-10-17). fzf 는 자기 raw 모드로 바꾸고 종료 때 «들어올 때 상태(-echo)» 로 되돌리므로 루프 재진입에도 유지된다. pane 은 fzf 130 종료 때 함께 닫혀 원복 불필요.
  stty -echo -icanon min 1 time 0 </dev/tty 2>/dev/null || true
  while [ -d "$RUN" ]; do
    rm -f "$sock"
    n="$(awk -F'\t' -v s="$(tab_cur_id)" '$1==s{print NR; exit}' "$RUN/tabs" 2>/dev/null)"
    fzf --ansi --delimiter=$'\t' --with-nth=2 --track --id-nth=1 --layout=reverse --cycle --no-mouse --info=hidden --sync --no-input \
      --listen="$sock" --pointer='▶' --border=top --border-label=' 분류 ' --border-label-pos=2:top --no-scrollbar \
      --bind "start:pos(${n:-1})" \
      --bind "focus:execute-silent(req=\$\$.\$(date +%s); printf '%s' \"\$req\" > $RUN/tabreq; ( sleep 0.12; [ \"\$(cat $RUN/tabreq 2>/dev/null)\" = \"\$req\" ] && [ -S $RUN/fzf.sock ] && curl -s -o /dev/null --unix-socket $RUN/fzf.sock -X POST http://localhost/ -d \"transform($SELF tabgo {1} \\{2} '\$req')\" ) >/dev/null 2>&1 </dev/null &)" \
      --bind "enter,right,tab:execute-silent($SELF catgo)" \
      --bind "left,esc,btab,space,double-click:ignore" \
      "${fwd[@]}" \
      < <(cmd_catrows) >/dev/null 2>>"$STATE/fzf-stderr.log"; rc=$?
    [ "$rc" = 130 ] && return 0
    sleep 0.3
  done
}
cmd_catfocus() {  # <카테고리> — 분류 칸 커서가 옮겨지면 목록 fzf 에 tabgo 를 쏜다(같은 탭이어도 쏜다 — 아래)
  # ★라이브 focus 는 cmd_catpane 의 바인드에 «인라인»(tmm 스폰 0·디바운스 0.12s·배경)으로 옮겼다(2026-10-17) — 부하 20 에서 포커스마다 tmm 전체를 새로 띄우면 40~120ms 가 직렬로 밀렸다.
  #   이 함수는 perf.sh((d)·(d3))가 직접 부르는 경로로 남긴다(동기·디바운스 없음 — req 필터로 마지막 요청만 반영하는 계약을 시험이 그대로 검증).
  local c="${1:-}" req; [ -n "$c" ] || return 0
  # ★마지막 요청만 반영★ — 요청 번호를 $RUN/tabreq 에 «먼저» 쓴다. 목록 fzf 는 쏜 순서대로 하나씩 처리하므로, 연타하면 앞선 요청이 늦게 끝나 뒤 요청을 덮을 수 있다.
  #   tabgo 는 자기 번호가 tabreq 와 다르면 버린다.
  #   ★«지금 탭과 같아도» 쏜다★ — 같은 탭이라 안 쏘면, 이미 검사를 통과해 적용 중인 낡은 요청(b)이 tabsel 을 쓴 뒤에 최신 focus(a)를 바로잡을 요청이 없어
  #   커서 a·목록 b 로 어긋났다(DA⑥ H1). 목록 fzf 가 요청을 순서대로 처리하므로 뒤 요청이 앞 요청의 결과를 바로잡는다. 같은 탭이면 tabgo 가 ignore 라 비용은 작다.
  req="$$.$RANDOM$RANDOM"; printf '%s' "$req" > "$RUN/tabreq"
  [ -S "$RUN/fzf.sock" ] && cmd_post "$RUN/fzf.sock" "transform($SELF tabgo '$c' {2} '$req')"
  return 0
}
cmd_catgo()  { local main; main="$(cat "$RUN/mainpane" 2>/dev/null)"; [ -n "$main" ] && tmux select-pane -t "$main" 2>/dev/null; return 0; }
cmd_catfwd() {  # <tmux 키> — 분류 칸에서 누른 키를 목록 칸(우리 피커 pane)으로 넘긴다(^X 끝·^D 종료뷰 … 가 분류 칸에서도 먹게)
  local main; main="$(cat "$RUN/mainpane" 2>/dev/null)"; [ -n "$main" ] || return 0
  tmux select-pane -t "$main" 2>/dev/null
  case "$1" in hex:*) tmux send-keys -t "$main" -H "${1#hex:}" 2>/dev/null;; *) tmux send-keys -t "$main" "$1" 2>/dev/null;; esac
  return 0
}
cmd_esckey() { if split_active && tab_on; then to_cat_action; else printf 'abort'; fi; }                 # Esc: 분할이면 분류 칸으로, 아니면 원래대로 끝
cmd_bskey()  { if [ -z "${1:-}" ] && split_active && tab_on; then to_cat_action; else printf 'backward-delete-char'; fi; }   # ⌫: 질의가 비었을 때만 분류 칸으로
tab_switch_to() {  # <탭> [커서 세션명] — 탭을 바꾸고 커서 복원 액션(reload(cat …)+헤더)을 낸다. tabkey(회전)·tabgo(직접 지정)가 같이 쓴다
  local nxt="$1" here="${2:-}" cur p
  cur="$(tab_cur_id)"; tabcur_set "$cur" "$here"      # 떠나는 탭의 커서 저장
  printf '%s\n' "$nxt" > "$RUN/tabsel"
  # 새 탭 목록을 «여기서» 만들어 위치를 계산한 뒤 reload 로 바꿔 끼운다. 후보 순서: 이 탭에서 기억한 세션 → 지금 세션(전체 탭 등에 있으면) → 맨 위.
  #   ★tmux·scan 0★ — 직전 갱신이 남긴 전체 목록($RUN/rowsfull)을 카테고리로 거를 뿐이다(예전엔 여기서 cmd_rows_cur 를 동기로 돌려 3초+ 걸렸고, 연타하면
  #   줄 선 요청이 왼쪽 분류 칸 커서와 오른쪽 목록을 어긋나게 했다). 새로 그리는 건 20초 자동 갱신·^R 뿐. 스냅샷이 없으면(부팅 직후 등) 옛 경로.
  if [ -s "$RUN/rowsfull" ]; then tab_rows < "$RUN/rowsfull" > "$RUN/tabrows"; else cmd_rows_cur > "$RUN/tabrows"; fi
  p="$(row_pos "$RUN/tabrows" "$(tabcur_get "$(tab_cur_id)")" "$here")"
  # ★`reload-sync(...)+pos/first` 는 안 먹는다★ — --track 이 reload 가 끝난 뒤 커서를 «이전 줄 번호»로 되돌려 pos/first 를 덮는다(최소 예제 실측 2026-10-02).
  #   그래서 원하는 줄 번호를 $RUN/wantpos 에 적고 reload 를 걸면, fzf `load` 이벤트(cmd_onload)가 reload 직후 pos 를 준다.
  printf '%s\n' "${p:-1}" > "$RUN/wantpos"
  # ★header 는 reload 의 load 이벤트가 그린다★ — 여기 `+transform-header` 를 붙이면 header(160ms)가 2중으로 돈다(2026-10-17).
  #   호출 경로(tabgo 630·tabkey 710)가 모두 tab_on 가드 뒤라 reload 후에도 tab_on 이 참 → cmd_onload 가 `transform-header($SELF header)` 로 탭 줄을 다시 그린다.
  printf 'reload(cat %s)' "$RUN/tabrows"
}
cmd_tabgo() {  # <탭> [커서 세션명] [요청 번호] — 분류 칸이 고른 카테고리로 목록을 바로 바꾼다(회전 없음). 요청 번호가 최신(tabreq)이 아니면 버린다
  local to="${1:-}" req="${3:-}"
  tab_on && [ -n "$to" ] || { printf 'ignore'; return; }
  [ -z "$req" ] || [ "$req" = "$(cat "$RUN/tabreq" 2>/dev/null)" ] || { printf 'ignore'; return; }
  [ "$to" = "$(tab_cur_id)" ] && { printf 'ignore'; return; }
  tab_switch_to "$to" "${2:-}"
}

# ---------- 탭 뷰 (좌석뷰의 «추가 모드», 0.7.0) ----------
# 목록 = 정렬된 평면 행. 탭 = 상단에 «카테고리 탭 줄»(전체 · ft · v65 …)을 두고 Tab/S-Tab 으로 회전, 목록은 그 카테고리만 보인다.
#   카테고리 = cat_of(^G 와 같은 규칙). 탭 순서 = 정렬 모드가 정한 «맨 위 좌석이 나오는 순서»(^T 최근순이면 최근 활동 카테고리가 앞).
#   ★`전체`(`*`)는 «마지막» 탭이다★ — 전체는 행이 제일 많아 가장 무겁다(2026-09-30 사용자 지정). 그래서 시작 탭도 전체가 아니라
#   «첫 카테고리»다. 선택이 비었거나 고른 카테고리가 사라져도 첫 카테고리로 간다(전체로 튀지 않는다).
#   상태 파일: $RUN/tab(있으면 탭 뷰) · $RUN/tabsel(현재 탭, `*`=전체, 없음=첫 카테고리) · $RUN/tabs(마지막으로 센 «카테고리\t수\t대기수», 마지막 줄이 `*` — 탭 줄·회전이 읽음).
#   특정 탭에서는 카테고리 열(5칸)을 뗀다 — 어차피 전부 같은 값이라 폰 60열의 5칸이 아깝다. ●○ 앞을 자르는 byte 기반 index() 라 한글 카테고리도 안전.
tab_on() { [ "$(view_now)" = live ] && [ -f "$RUN/tab" ]; }
tab_rows() {
  local sel; sel="$(cat "$RUN/tabsel" 2>/dev/null)"
  # ★프로젝트(1depth) → 팀(2depth) 트리(0.9.0)★ — 행의 3열 = `프로젝트/팀`(cat_of key 모드) 또는 «/ 없는 한 단계»(leaf: 구 접두·규칙 라벨·폴백).
  #   tabs 행의 키: 팀이 2개 이상인 프로젝트 = 프로젝트 줄 `byz`(그 프로젝트 전체) + 팀 줄 `byz/harness` · 팀이 1개뿐이거나 leaf 는 «한 줄»(`aifp`·`kakao`).
  #   고르는 규칙: 키가 3열과 같거나, 3열이 `키/` 로 시작하면 그 행. 옛 평면 키(`harness`)는 그대로 leaf 로 통한다(호환).
  awk -F'\t' -v sel="$sel" -v out="$RUN/tabs" '
    { n++; c[n] = $3; L[n] = $0; w = ($1 ~ / (HUMAN|BLOCK|STUCK) /)
      s = index($3, "/"); p = (s > 0) ? substr($3, 1, s - 1) : $3
      if (!(p in pc)) { ord[++G] = p; nt[p] = 0 }
      pc[p]++; if (w) { pw[p]++; tw++ }
      if (s > 0) { if (!($3 in tc)) { tord[p, ++nt[p]] = $3 }; tc[$3]++; if (w) tw2[$3]++ } }
    END {
      printf "" > out
      for (g = 1; g <= G; g++) {
        p = ord[g]; known[p] = 1
        printf "%s\t%d\t%d\n", p, pc[p], pw[p] >> out
        if (nt[p] >= 2) for (t = 1; t <= nt[p]; t++) { k = tord[p, t]; known[k] = 1; printf "%s\t%d\t%d\n", k, tc[k], tw2[k] >> out }
      }
      printf "*\t%d\t%d\n", n, tw >> out                                # 전체는 마지막
      if (sel != "*" && !(sel in known)) sel = (G > 0) ? ord[1] : "*"   # 선택 없음·사라진 카테고리 → 첫 카테고리(전체는 가장 무겁다)
      multi = (index(sel, "/") == 0 && nt[sel] >= 2)                   # 팀이 여럿인 «프로젝트 줄» 이면 카테고리 열(팀)을 남긴다 — 어느 팀인지 보여야 한다
      for (i = 1; i <= n; i++) {
        if (sel == "*") { print L[i]; continue }
        if (c[i] != sel && index(c[i], sel "/") != 1) continue
        if (multi) { print L[i]; continue }
        split(L[i], f, "\t"); s = f[1]; a = index(s, "●"); b = index(s, "○")
        p = (a > 0 && (b == 0 || a < b)) ? a : b
        if (p > 0) s = substr(s, p)
        print s "\t" f[2] "\t" f[3]
      }
    }'
}
dwidth() {  # 표시폭 — 한글 2칸. 로케일이 바이트 모드면 과대추정(안전한 쪽)
  local s="$1" ch b; ch="${#s}"; b="$(printf '%s' "$s" | LC_ALL=C wc -c | tr -d ' ')"
  echo $(( ch + (b - ch) / 2 ))
}
# 헤더 맨 아랫줄(프롬프트 바로 위) — 현재 탭은 청록 반전, 대기(HUMAN/BLOCK/STUCK)가 있는 탭은 빨강 ⚠N. 폭이 모자라면 현재 탭이 보이게 창을 밀고 ‹ › 로 표시.
tab_bar() {
  [ -s "$RUN/tabs" ] || return 0
  local sel avail n=0 act=1 start i cur=0 out="" cat cnt wt lab
  local -a cats=() labs=() wids=() wts=()
  sel="$(cat "$RUN/tabsel" 2>/dev/null)"        # 비었거나 목록에 없으면 act=1 = 첫 카테고리(tab_rows 와 같은 규칙)
  avail=$(( $(term_cols) - 4 ))
  while IFS=$'\t' read -r cat cnt wt; do
    n=$((n+1)); cats[n]="$cat"; wts[n]="${wt:-0}"
    if [ "$cat" = '*' ]; then lab="전체 $cnt"; elif [ "${cat#*/}" != "$cat" ]; then lab="·${cat#*/} $cnt"; else lab="$cat $cnt"; fi   # 팀 줄은 «·팀» (0.9.0)
    [ "${wt:-0}" -gt 0 ] && lab+="⚠$wt"
    labs[n]="$lab"; wids[n]=$(dwidth " $lab ")
    [ "$cat" = "$sel" ] && act=$n
  done < "$RUN/tabs"
  start=1; cur=0
  for ((i=1;i<=act;i++)); do cur=$((cur + wids[i])); done
  while [ "$cur" -gt "$avail" ] && [ "$start" -lt "$act" ]; do cur=$((cur - wids[start])); start=$((start+1)); done
  [ "$start" -gt 1 ] && { out+=$'\033[2m‹\033[0m'; cur=$((cur+1)); }
  cur=0
  for ((i=start;i<=n;i++)); do
    if [ $((cur + wids[i] + 1)) -gt "$avail" ] && [ "$i" -gt "$act" ]; then out+=$'\033[2m›\033[0m'; break; fi
    cur=$((cur + wids[i]))
    if [ "$i" = "$act" ]; then out+=$'\033[1;30;46m '"${labs[i]}"$' \033[0m'
    elif [ "${wts[i]}" -gt 0 ]; then out+=$'\033[31m '"${labs[i]}"$' \033[0m'
    else out+=$'\033[2m '"${labs[i]}"$' \033[0m'; fi
  done
  printf '%s\n' "$out"
}
# ^V — 목록 ↔ 탭. 종료 뷰에는 탭이 없다.
cmd_vtab() {
  if [ "$(view_now)" = dead ]; then printf 'change-prompt(탭은 좌석뷰 전용 — ^A 로 먼저> )'; return; fi
  # 분할(0.8.0)이 가능한 세션(mainpane 있음)에서는 ^V = 분류 칸 숨김/보임. 숨기면 0.7.x 탭 줄(Tab/S-Tab 회전)로 돌아간다.
  if split_active; then split_close; printf 'transform-header(%s header)+change-prompt(탭> )' "$SELF"; return; fi
  if [ -f "$RUN/tab" ] && [ -s "$RUN/mainpane" ] && [ "${TMM_SPLIT:-1}" = 1 ]; then
    split_open; printf 'transform-header(%s header)+change-prompt(탭> )' "$SELF"; return
  fi
  if [ -f "$RUN/tab" ]; then rm -f "$RUN/tab"; else : > "$RUN/tab"; fi
  printf 'reload(TMM_CUR={2} TMM_Q={q} %s rows-cur)+transform-header(%s header)+change-prompt(%s)' "$SELF" "$SELF" "$([ -f "$RUN/tab" ] && echo '탭> ' || echo '좌석> ')"
}
# Tab / S-Tab — 탭 뷰: 다음/이전 탭(전체 → 카테고리들 → 전체 …). 목록·종료 뷰는 원래 동작(선택 토글 + 아래/위).
cmd_tabkey() {  # next|prev [커서 세션명]
  local dir="${1:-next}" here="${2:-}" cur nxt
  tab_on || { [ "$dir" = next ] && printf 'toggle+down' || printf 'toggle+up'; return; }
  split_active && { printf 'ignore'; return; }        # 분할(0.8.0)이면 탭 회전은 없다 — 분류 칸에서 ↑↓
  [ -s "$RUN/tabs" ] || { printf 'ignore'; return; }
  cur="$(tab_cur_id)"
  nxt="$(awk -F'\t' -v cur="$cur" -v dir="$dir" '{ t[NR] = $1 }
    END { idx = 1; for (i = 1; i <= NR; i++) if (t[i] == cur) idx = i
          if (dir == "next") idx = idx % NR + 1; else idx = (idx - 2 + NR) % NR + 1
          print t[idx] }' "$RUN/tabs")"
  tab_switch_to "$nxt" "$here"
}
# → / ← — 탭 뷰: Tab / S-Tab 과 같다(다음/이전 탭). 목록·종료 뷰는 원래 동작(입력창 커서 이동).
#   탭 뷰에서는 입력창 안 커서 이동에 방향키를 못 쓴다(Backspace·^W 로 고친다) — 사용자 지정 2026-10-01.
cmd_arrowkey() {  # next|prev [커서 세션명]
  if split_active && tab_on; then { [ "${1:-next}" = prev ] && to_cat_action || printf 'ignore'; }   # 분할(0.8.0): ← = Esc 와 같은 별칭, → 는 없음
  elif tab_on; then cmd_tabkey "${1:-next}" "${2:-}"
  elif [ "${1:-next}" = next ]; then printf 'forward-char'; else printf 'backward-char'; fi
}
# load 이벤트 — 상단 라벨(매치수) 갱신. 탭 뷰면 방금 다시 센 탭 줄(수·⚠)도 같이.
cmd_onload() {
  local w
  printf 'transform-border-label(%s blabel)' "$SELF"
  { tab_on || [ "$(view_now)" = dead ]; } && printf '+transform-header(%s header)' "$SELF"   # 종료 뷰: 창을 넓힌 뒤 새 개수
  if [ -f "$RUN/wantpos" ]; then w="$(cat "$RUN/wantpos")"; rm -f "$RUN/wantpos"; [ -n "$w" ] && printf '+pos(%s)' "$w"; fi
  return 0
}
# ^A / ^D — 뷰 전환. 뷰마다 «자기 키워드»를 기억한다(2026-09-30 사용자 확정): 나가는 뷰의 질의를 저장하고 들어가는 뷰의 질의를 복원.
#   change-query 는 «콜론 형식»이어야 질의 속 `)`·`+` 가 액션 구문을 깨지 않는다 → 반드시 액션 체인의 마지막.
cmd_vswitch() {  # <live|dead> <현재 질의>
  local to="$1" q="${2:-}" from acts saved; from="$(view_now)"
  printf '%s' "$q" > "$RUN/query.$from"
  rm -f "$RUN/selmode"; cmd_view "$to"; cmd_mode time
  saved="$(cat "$RUN/query.$to" 2>/dev/null)"
  if [ "$to" = dead ]; then acts="unbind(space)+deselect-all+reload(TMM_CUR={2} TMM_Q={q} $SELF rows-cur fresh)+change-prompt(종료> )"
  else acts="unbind(space)+deselect-all+reload(TMM_CUR={2} TMM_Q={q} $SELF rows-cur)+change-prompt($([ -f "$RUN/tab" ] && echo '탭> ' || echo '좌석> '))"; fi
  acts+="+transform-header($SELF header)"
  if [ -n "$saved" ]; then printf '%s+change-query:%s' "$acts" "$saved"; else printf '%s+change-query()' "$acts"; fi
}
view_now()  { cat "$RUN/view" 2>/dev/null || echo live; }
since_now() { cat "$RUN/since" 2>/dev/null || echo "$DEAD_SINCE0"; }
gen_now()   { cat "$RUN/gen" 2>/dev/null || echo latest; }
cmd_view()  { printf '%s\n' "$1" > "$RUN/view"; }
# 창·계보를 바꾸면 직전 목록 캐시(dead.tsv)를 지운다 — 헤더가 «창 36h · (24h 의) 78건» 처럼 새 창에 옛 개수를 붙이지 않고 «…건» 을 보이다가 load 때 새 개수로.
cmd_since() { local c; c="$(since_now)"; case "$1" in +) c=$((c+12));; -) c=$((c-12)); [ $c -lt 12 ] && c=12;; *) c="$1";; esac; rm -f "$RUN/dead.tsv"; printf '%s\n' "$c" | tee "$RUN/since"; }
cmd_gen()   { [ "$(gen_now)" = latest ] && echo all > "$RUN/gen" || echo latest > "$RUN/gen"; rm -f "$RUN/dead.tsv"; cat "$RUN/gen"; }

# ---------- 종료된 세션 (dead 뷰) ----------
# 스캐너(python, 읽기 전용)가 tsv 를 만들고 $RUN/dead.tsv 에 캐시 — 미리보기·복구가 같은 파일을 읽는다(재스캔 없음).
dead_tsv() {  # [fresh]
  local f="$RUN/dead.tsv" live
  if [ "${1:-}" != fresh ] && [ -f "$f" ] && [ $(( $(date +%s) - $(stat -f %m "$f" 2>/dev/null || stat -c %Y "$f") )) -lt "$CACHE_TTL" ]; then cat "$f"; return; fi
  live="$(tmux ls -F '#S' 2>/dev/null | tr '\n' ' ')"
  # shellcheck disable=SC2086
  python3 "$DEAD_SCAN" scan --since "$(since_now)" $([ "$(gen_now)" = all ] && echo --all-gen) --live $live > "$f.tmp" 2>/dev/null && mv -f "$f.tmp" "$f"
  cat "$f" 2>/dev/null
}
# 표시줄: 카테고리 ◌ 이름(22) 배지(5) 시각 나이 cwd(14)  — live 와 같은 폭. 키 필드(2)=세션명, 3=카테고리
cmd_dead_rows() {  # [time|wait|cat] [fresh]
  local mode="${1:-time}" now src agent name cwd sid md lm la _rest cat pri hm b nw cw
  local -A CATC MSC
  read -r nw cw <<<"$(col_widths)"
  cat_prep
  now=$(date +%s)
  # ★행마다 외부 프로세스를 띄우지 않는다(0.8.2)★ — 예전엔 행마다 cut 6번·date·basename… ~14 fork 라 부하 시 132행에 5.7초였다(창을 넓힐수록 느려진 주원인, 2026-10-15 실측).
  #   필드는 탭→US(\037)로 바꿔 read 한 번에 자른다(탭은 IFS 공백이라 빈 칸이 접힌다 — 모델이 빈 CDX·OC 행). 카테고리·모델 표기는 값별로 한 번만, 시각은 printf %()T.
  while IFS=$'\037' read -r src agent name cwd sid md ef lm la _rest; do
    [ -n "$name" ] || continue
    [ -n "${CATC[$name]+x}" ] || CATC[$name]="$(cat_of "$name")"; cat="${CATC[$name]}"
    [ -n "${MSC[x$md:$ef]+x}" ] || MSC[x$md:$ef]="$(model_short "$(with_1m_if_claude "$md")" "$ef")"
    [ "$src" = SNAP ] && pri=0 || pri=5
    printf -v hm '%(%H:%M)T' "${lm:-0}"
    b="${cwd##*/}"
    printf '%s\t%s\t%s\t%-5s ◌ %-*s %-5s %-8s %s %s %s\t%s\t%s\n' \
      "$pri" "$la" "$cat" \
      "${cat:0:5}" "$nw" "$(clip_name "$name" "$nw")" "$src" "${MSC[x$md:$ef]}" "$hm" "$(age_of "${la:-0}" "$now")" "${b:0:$cw}" \
      "$name" "$cat"
  done < <(dead_tsv "${2:-}" | tr '\t' '\037') \
  | { case "$mode" in
        cat)  sort -t$'\t' -k3,3 -k2,2nr;;
        wait) sort -t$'\t' -k1,1n -k2,2nr;;   # SNAP(정확 복구) 우선 → 최근순
        *)    sort -t$'\t' -k2,2nr;;
      esac; } | cut -f4-
}
dead_row() { dead_tsv | awk -F'\t' -v n="$1" '$3==n || $5==n {print; exit}'; }
cmd_dead_ls() {  # tmm dead [PAT] [--since H] [--all]
  local pat="" a
  while [ $# -gt 0 ]; do case "$1" in --since) cmd_since "$2" >/dev/null; shift;; --all) echo all > "$RUN/gen";; *) pat="$1";; esac; shift; done
  cmd_dead_rows time fresh | cut -f1 | { [ -n "$pat" ] && grep -i -- "$pat" || cat; }
}
cmd_dead_preview() {  # NAME|SID [N]
  local row sid; row="$(dead_row "$1")"
  [ -n "$row" ] || { echo "(목록에 없음: $1 — ^R 로 갱신)"; return 1; }
  sid="$(printf '%s' "$row" | cut -f5)"
  printf '\033[36m[%s] %s · %s · 마지막 %s · %s\033[0m\n' "$(printf '%s' "$row" | cut -f1)" "$(printf '%s' "$row" | cut -f3)" \
    "$(basename "$(printf '%s' "$row" | cut -f4)")" "$(fmt_hm "$(printf '%s' "$row" | cut -f7)" :)" "$(printf '%s' "$row" | cut -f6)"
  python3 "$DEAD_SCAN" tail --sid "$sid" --n "${2:-$PREVIEW_LINES}" --width "${COLUMNS:-80}" 2>/dev/null | render_pane
}

# 라이브 좌석의 엔진 판별 — pane 자식 프로세스 argv(+cmd 는 pane title). resolve 가 이 힌트로 해당 엔진만 훑게 한다
# (힌트 없이 4엔진을 다 훑으면 codex/cmd 글롭 전수 head-read 로 opencode 좌석이 7~11초 걸렸다 — 2026-09-19 실측).
live_agent_of() {  # session → claude|codex|opencode|cmd|pi|""
  local ppid pid args title
  ppid="$(tmux display -p -t "=$1:" '#{pane_pid}' 2>/dev/null)"
  [ -n "$ppid" ] || return 0
  for pid in "$ppid" $(pgrep -P "$ppid" 2>/dev/null); do
    args="$(ps -o args= -p "$pid" 2>/dev/null)"
    case "$args" in
      *claude*)   echo claude; return 0;;
      *codex*)    echo codex; return 0;;
      *opencode*) echo opencode; return 0;;
      pi|*/pi|pi\ *|*pi-coding-agent*) echo pi; return 0;;
      *command-code*|*"cmd "*) echo cmd; return 0;;
    esac
  done
  title="$(tmux display -p -t "=$1:" '#{pane_title}' 2>/dev/null)"
  case "$title" in command-code|"⌘"*) echo cmd;; esac
}

# ---------- 대화 기록 인덱스 (기능1) ----------
# 리스트에 보이는 세션(라이브·종료 공통)의 트랜스크립트 파일 경로를 해석한다.
# 라이브는 (이름,cwd) 로, 종료는 sid 로 찾는다. 결과: "agent<TAB>sid<TAB>path<TAB>cwd<TAB>match"
idx_row() {  # NAME|SID
  local n="${1:-}" cwd row sid ag
  [ -n "$n" ] || return 1
  if tmux has-session -t "=$n" 2>/dev/null; then
    cwd="$(tmux display -p -t "=$n:" '#{pane_current_path}' 2>/dev/null)"
    ag="$(live_agent_of "$n")"
    # pi 는 tmuxc 가 --session-id 를 발급한다 — probe 로 sid/path 를 바로 만들 수 있다.
    if [ "$ag" = pi ]; then
      local probe psid ppath
      probe="$(tmuxc probe "$n" 2>/dev/null || true)"
      psid="$(printf '%s\n' "$probe" | sed -n 's/^sid=//p' | head -1)"
      [ -n "$psid" ] || return 1
      ppath="$(find "$HOME/.pi/agent/sessions" -type f -name "*${psid}*.jsonl" 2>/dev/null | head -1)"
      printf 'pi\t%s\t%s\t%s\tprobe\n' "$psid" "$ppath" "$cwd"
      return 0
    fi
    local -a rargs=(--name "$n" --cwd "$cwd"); [ -n "$ag" ] && rargs+=(--agent "$ag")
    python3 "$DEAD_SCAN" resolve "${rargs[@]}" 2>/dev/null
    return
  fi
  row="$(dead_row "$n")"; [ -n "$row" ] || return 1
  sid="$(printf '%s' "$row" | cut -f5)"; cwd="$(printf '%s' "$row" | cut -f4)"; ag="$(printf '%s' "$row" | cut -f2)"
  local -a dargs=(--sid "$sid" --cwd "$cwd"); [ -n "$ag" ] && dargs+=(--agent "$ag")
  python3 "$DEAD_SCAN" resolve "${dargs[@]}" 2>/dev/null
}
cmd_idx() {  # NAME|SID [--json|--path]
  local n="${1:-}" mode="${2:-}"
  [ -n "$n" ] || { echo "usage: tmm idx NAME|SID [--json|--path]"; return 1; }
  local out agent sid path cwd match
  out="$(idx_row "$n")"
  if [ -z "$out" ]; then
    [ "$mode" = --json ] && printf '{"name":"%s","found":false}\n' "$n" \
      || echo "❌ 대화 기록 인덱스 없음: $n (라이브/종료 목록에 없거나 트랜스크립트 미발견)"
    return 1
  fi
  IFS=$'\t' read -r agent sid path cwd match <<<"$out"
  case "$mode" in
    --path) printf '%s\n' "$path";;
    --json) printf '{"name":"%s","agent":"%s","session_id":"%s","cwd":"%s","transcript":"%s","match":"%s"}\n' "$n" "$agent" "$sid" "$cwd" "$path" "$match";;
    *) printf 'agent:      %s\nsession_id: %s\ncwd:        %s\ntranscript: %s\nmatch:      %s\n' "$agent" "$sid" "$cwd" "$path" "$match";;
  esac
}
# TUI ^Y — fzf execute() 정보화면(커서 유지). 정상 tty 에서 돈다(attach 아님).
cmd_idxp() {  # NAME
  local n="${1:-}" out
  out="$(idx_row "$n")"
  printf '\033[1;36m── 대화 기록 인덱스 ──\033[0m \033[2m%s\033[0m\n\n' "$n"
  if [ -z "$out" ]; then
    printf '  ❌ 인덱스 없음 — 트랜스크립트를 못 찾음\n'
  else
    printf '%s\n' "$out" | awk -F'\t' '{printf "  agent:      %s\n  session_id: %s\n  cwd:        %s\n  transcript: %s\n  match:      %s\n",$1,$2,$4,$3,$5}'
  fi
  printf '\n\033[2m[아무 키] 복귀\033[0m'
  read -r -n1 -s _ </dev/tty 2>/dev/null || true
}

# ---------- fork (기능2) — 소스 대화를 «다른 에이전트 세션»으로 이어받기 ----------
# 동일 엔진: tmuxc fork 네이티브(전체 히스토리·부모 불변·새 conversation id).
# 크로스 엔진: tmuxc open 새 세션 + 트랜스크립트 경로·발췌 주입.
# 스폰·창옵션·COMM-GUIDE 주입은 전부 tmuxc 에 위임한다(중복 구현 금지).
sanitize_name() { printf '%s' "$1" | tr ' :./' '----' | tr -cd 'A-Za-z0-9_#-'; }
bump_name() {  # NAME → #N+1 (카운터 없으면 #1)
  local n="$1"
  if [[ "$n" =~ ^(.*)#([0-9]+)$ ]]; then printf '%s#%s' "${BASH_REMATCH[1]}" "$(( ${BASH_REMATCH[2]} + 1 ))"
  else printf '%s#1' "$n"; fi
}
free_name() {  # NAME → tmux 에 없는 이름까지 증가
  local n="$1" i=0
  while tmux has-session -t "=$n" 2>/dev/null && [ "$i" -lt 50 ]; do n="$(bump_name "$n")"; i=$((i+1)); done
  printf '%s' "$n"
}
models_of() {  # agent → "alias<TAB>id<TAB>extra" (사용자 파일 먼저 → 생성본; 별칭 중복은 사용자 우선)
  { [ -f "$MODELS_FILE" ] && cat "$MODELS_FILE"; [ -f "$MODELS_GEN" ] && cat "$MODELS_GEN"; } 2>/dev/null \
    | awk -F'\t' -v a="$1" '!/^[[:space:]]*#/ && $1==a && $2!="" && !seen[$2]++ {print $2"\t"$3"\t"$4}'
}
model_id_of()    { models_of "$1" | awk -F'\t' -v al="$2" '$1==al {print $2; exit}'; }
model_extra_of() { models_of "$1" | awk -F'\t' -v al="$2" '$1==al {print $3; exit}'; }
src_model_effort() {  # NAME|SID → "model<TAB>effort"
  local n="$1" m="" e="" row out
  if tmux has-session -t "=$n" 2>/dev/null && command -v tmuxc >/dev/null; then
    out="$(tmuxc model "$n" 2>/dev/null || true)"
    m="$(printf '%s\n' "$out" | sed -n 's/^model=//p' | head -1)"
    e="$(printf '%s\n' "$out" | sed -n 's/^effort=//p' | head -1)"
  else
    row="$(dead_row "$n" 2>/dev/null)"
    m="$(printf '%s' "$row" | cut -f6)"
    e="$(printf '%s' "$row" | cut -f7)"
  fi
  printf '%s\t%s' "$m" "$e"
}
# 크로스 엔진 주입 프롬프트 — 발췌 파일(영속)을 만들어 경로와 함께 준다. dry-run 이면 파일을 안 쓴다.
fork_prompt() {  # src sagent tagent spath scwd ssid user dry
  local src="$1" sagent="$2" tagent="$3" spath="$4" scwd="$5" ssid="$6" user="${7:-}" dry="${8:-}"
  local ex="" slug
  if [ -z "$dry" ] && [ -n "$ssid" ]; then
    mkdir -p "$FORKS_DIR"
    slug="$(sanitize_name "$src")"
    ex="$FORKS_DIR/$(date +%Y%m%d-%H%M%S)-$slug.md"
    python3 "$DEAD_SCAN" excerpt --sid "$ssid" --agent "$sagent" --cwd "$scwd" --n "$FORK_EXCERPT_N" > "$ex" 2>/dev/null || { rm -f "$ex"; ex=""; }
  fi
  printf '[fork←%s] 다른 엔진(%s→%s)으로 컨텍스트를 이어받는다. 이전 세션 대화 원문: %s' "$src" "$sagent" "$tagent" "$spath"
  [ -n "$ex" ] && printf '\n발췌(먼저 읽어라): %s' "$ex"
  printf '\n발췌를 읽고 필요하면 원문을 참조해 직전 작업을 파악한 뒤 이어서 진행하라. (컨텍스트 승계 포크)'
  [ -n "$user" ] && printf '\n\n%s' "$user"
}
cmd_fork() {  # SRC [--agent AG] [--model M] [--name N] [--cwd C] [--effort E] [--ctx 1m] [--prompt P] [--dry-run] [--attach]
  local src="" agent="" model="" name="" cwd="" effort="" ctx="" prompt="" dry="" attach=0
  while [ $# -gt 0 ]; do case "$1" in
    --agent)  agent="${2:-}"; shift 2;;
    --model)  model="${2:-}"; shift 2;;
    --name)   name="${2:-}"; shift 2;;
    --cwd)    cwd="${2:-}"; shift 2;;
    --effort) effort="${2:-}"; shift 2;;
    --ctx)    ctx="${2:-}"; shift 2;;
    --prompt) prompt="${2:-}"; shift 2;;
    --dry-run) dry=--dry-run; shift;;
    --attach) attach=1; shift;;
    --no-attach) attach=0; shift;;
    --help|-h) sed -n '2,32p' "$0"; return 0;;
    *) [ -z "$src" ] && src="$1" || { echo "❌ 알 수 없는 인자: $1"; return 1; }; shift;;
  esac; done
  [ -n "$src" ] || { echo "usage: tmm fork SRC --agent AG --model M [--name N] [--cwd C] [--effort E] [--ctx 1m] [--prompt P] [--dry-run] [--attach]"; return 1; }
  command -v tmuxc >/dev/null || { echo "❌ tmuxc 필요 (fork 스폰 위임)"; return 1; }
  local idxline; idxline="$(idx_row "$src")"
  [ -n "$idxline" ] || { echo "❌ 소스 인덱스 없음: $src (라이브/종료 목록에 없거나 트랜스크립트 미발견)"; return 1; }
  local sagent ssid spath scwd smatch
  IFS=$'\t' read -r sagent ssid spath scwd smatch <<<"$idxline"
  [ -n "$cwd" ] || cwd="$scwd"
  [ -d "$cwd" ] || { echo "⚠ cwd 없음 ($cwd) → \$HOME"; cwd="$HOME"; }
  [ -n "$agent" ] || agent="$sagent"
  case "$agent" in claude|codex|opencode|cmd|pi) ;; *) echo "❌ 미지원 에이전트: $agent (claude|codex|opencode|cmd|pi)"; return 1;; esac
  local same=0; [ "$agent" = "$sagent" ] && same=1
  # 모델: 별칭→id 매핑(별칭일 때만). 미지정이면 동일 엔진일 때만 소스 모델 승계.
  local alias="$model" mid extra=""
  [ -n "$alias" ] && mid="$(model_id_of "$agent" "$alias")" && [ -n "$mid" ] && model="$mid"
  extra="$(model_extra_of "$agent" "$alias")"
  local me smodel seffort; me="$(src_model_effort "$src")"; smodel="${me%%$'\t'*}"; seffort="${me##*$'\t'}"
  if [ -z "$model" ] && [ "$same" = 1 ]; then model="$smodel"; fi
  # claude ctx 기본 1m (fable 제외) — 작은 창 금지 규칙
  if [ "$agent" = claude ] && [ -z "$ctx" ]; then case "$model" in *fable*) ;; *) ctx=1m;; esac; fi
  if [ -z "$effort" ] && [ "$same" = 1 ]; then effort="$seffort"; fi
  # 이름
  if [ -n "$name" ]; then name="$(sanitize_name "$name")"; else name="$(bump_name "$src")"; fi
  [ -n "$name" ] || { echo "❌ 이름이 비었음"; return 1; }
  name="$(free_name "$name")"

  local -a argv ex
  if [ "$same" = 1 ]; then
    argv=(tmuxc fork "$cwd" --name "$name")
    if tmux has-session -t "=$src" 2>/dev/null; then argv+=(--from "$src")
    else argv+=(--source "$ssid" --agent "$sagent"); fi
    [ -n "$model" ]  && argv+=(--model "$model")
    [ -n "$effort" ] && argv+=(--effort "$effort")
    [ -n "$ctx" ]    && argv+=(--ctx "$ctx")
    [ -n "$prompt" ] && argv+=(--prompt "$prompt")
  else
    local fp; fp="$(fork_prompt "$src" "$sagent" "$agent" "$spath" "$scwd" "$ssid" "$prompt" "$dry")"
    argv=(tmuxc open "$cwd" --name "$name" --agent "$agent")
    [ -n "$model" ]  && argv+=(--model "$model")
    [ -n "$effort" ] && argv+=(--effort "$effort")
    [ -n "$ctx" ]    && argv+=(--ctx "$ctx")
    argv+=(--prompt "$fp")
  fi
  if [ -n "$extra" ]; then read -r -a ex <<<"$extra"; argv+=("${ex[@]}"); fi
  [ -n "$dry" ] && argv+=(--dry-run)
  if [ -n "$dry" ]; then
    printf 'src=%s (%s)\nagent=%s same_engine=%s\nname=%s\ncwd=%s\nmodel=%s effort=%s ctx=%s\n' \
      "$src" "$sagent" "$agent" "$same" "$name" "$cwd" "${model:-<engine default>}" "${effort:-<engine default>}" "${ctx:-<none>}"
  fi
  "${argv[@]}"
  local rc=$?
  [ "$rc" -eq 0 ] || return "$rc"
  [ -n "$dry" ] && return 0
  if [ "$attach" = 1 ]; then cmd_attach "$name"; else echo "attach: tmm a '$name'"; fi
}
# TUI ^F — fzf 밖(정상 tty)에서 이름·에이전트·모델을 프롬프트하고 백그라운드 생성 → 피커 복귀.
# ★어느 단계에서든 ^C(또는 이름/에이전트/모델에서 q) 로 취소 → 피커로 복귀★. 생성 중 아무 키=취소.
cmd_forkp() {  # SRC
  local src="${1:-}"
  [ -n "$src" ] || { echo "(선택된 좌석 없음)"; sleep 1; return 0; }
  command -v tmuxc >/dev/null || { echo "❌ tmuxc 필요 (fork 스폰 위임)"; sleep 1.5; return 1; }
  local idxline; idxline="$(idx_row "$src")"
  [ -n "$idxline" ] || { echo "❌ 소스 인덱스 없음: $src"; sleep 1.5; return 1; }
  local sagent ssid spath scwd smatch
  IFS=$'\t' read -r sagent ssid spath scwd smatch <<<"$idxline"

  local cancelled=0 def name agent ag list ms model="" p
  trap 'cancelled=1' INT
  _fcancel() { trap - INT; echo "(취소)"; sleep 0.8; }

  def="$(free_name "$(bump_name "$src")")"
  printf '\033[1;36m── fork\033[0m %s (%s) → 새 세션  \033[2m(^C 취소)\033[0m\n' "$src" "$sagent"
  read -r -p "이름 [$def]: " name || cancelled=1
  [ "$cancelled" = 1 ] && { _fcancel; return 0; }
  case "$name" in q|Q|취소) { _fcancel; return 0; };; esac
  [ -n "$name" ] || name="$def"

  printf '에이전트: 1 claude  2 codex  3 opencode  4 cmd  5 pi\n'
  read -r -p "선택 [1]: " ag || cancelled=1
  [ "$cancelled" = 1 ] && { _fcancel; return 0; }
  case "$ag" in q|Q|취소) { _fcancel; return 0; };; 2) agent=codex;; 3) agent=opencode;; 4) agent=cmd;; 5) agent=pi;; *) agent=claude;; esac

  list="$(models_of "$agent")"
  if [ -n "$list" ] && command -v fzf >/dev/null; then
    ms="$(printf '%s\n' "$list" | awk -F'\t' '{print $1"\t"$2}' \
      | fzf --delimiter=$'\t' --with-nth=1,2 --nth=1,2 --reverse --height=70% \
            --prompt="모델($agent)> " --header='엔터=선택 · 타이핑=검색 · Esc=취소(소스모델)' 2>/dev/null)"
    [ -z "$ms" ] && { _fcancel; return 0; }
    model="$(printf '%s' "$ms" | cut -f1)"
  elif [ -n "$list" ]; then
    printf '모델(%s) — 번호/별칭, 엔터=소스모델, q=취소:\n' "$agent"
    printf '%s\n' "$list" | awk -F'\t' '{printf "  %2d %-14s %s\n", NR, $1, $2}'
    read -r -p "선택: " ms || cancelled=1
    [ "$cancelled" = 1 ] && { _fcancel; return 0; }
    case "$ms" in q|Q|취소) { _fcancel; return 0; };; esac
    if [ -n "$ms" ]; then
      if [[ "$ms" =~ ^[0-9]+$ ]]; then model="$(printf '%s\n' "$list" | sed -n "${ms}p" | cut -f1)"; else model="$ms"; fi
    fi
  else
    read -r -p "모델 id (엔터=소스모델, q=취소): " model || cancelled=1
    case "$model" in q|Q|취소) { _fcancel; return 0; };; esac
  fi
  [ "$cancelled" = 1 ] && { _fcancel; return 0; }

  read -r -p "추가 프롬프트(엔터=없음, ^C 취소): " p || cancelled=1
  [ "$cancelled" = 1 ] && { _fcancel; return 0; }

  local -a args=(fork "$src" --agent "$agent" --name "$name")
  [ -n "$model" ] && args+=(--model "$model")
  [ -n "$p" ] && args+=(--prompt "$p")
  mkdir -p "$FORKS_DIR"
  printf '▶ 생성 중… %s %s  \033[2m(아무 키=취소 · 기다리면 완료)\033[0m\n' "$agent" "$name"
  "$SELF" "${args[@]}" >"$FORKS_DIR/.last-fork.log" 2>&1 &
  local fpid=$! waited=0
  while kill -0 "$fpid" 2>/dev/null; do
    [ "$cancelled" = 1 ] && break
    read -r -t 1 -n1 _ && { cancelled=1; break; }
    waited=$((waited+1)); [ "$waited" -ge 90 ] && break
  done
  if [ "$cancelled" = 1 ]; then
    kill "$fpid" 2>/dev/null; pkill -P "$fpid" 2>/dev/null
    tmux kill-session -t "=$name" 2>/dev/null   # 이미 만들어진 «우리» 세션 정리(free_name 으로 비어있던 이름)
    trap - INT; printf '(취소됨 — %s)\n' "$name"; sleep 1.2; return 0
  fi
  wait "$fpid" 2>/dev/null
  trap - INT
  if grep -qE 'created|command=|^session=' "$FORKS_DIR/.last-fork.log" 2>/dev/null; then
    echo "✅ 생성 완료: $name (좌석 목록은 ^R 로 갱신)"
  else
    echo "⚠ 확인 필요 — 로그: $FORKS_DIR/.last-fork.log"; tail -3 "$FORKS_DIR/.last-fork.log" 2>/dev/null
  fi
  sleep 1.2
}
cmd_models() {  # [agent] | refresh [agent...] | find QUERY
  local sub="${1:-}"
  case "$sub" in
    refresh)
      shift
      command -v python3 >/dev/null || { echo "❌ python3 필요"; return 1; }
      local args=(--out "$MODELS_GEN" --provider "$MODELS_PROVIDER")
      [ $# -gt 0 ] && args+=(--agents "$(printf '%s,' "$@")")
      python3 "$MODELS_SYNC" "${args[@]}" || return 1
      echo "  생성본: $MODELS_GEN (프로바이더 $MODELS_PROVIDER) — 사용자 별칭 $MODELS_FILE 이 우선"
      ;;
    find)
      shift; local q="${1:-}"
      [ -n "$q" ] || { echo "usage: tmm models find QUERY"; return 1; }
      { [ -f "$MODELS_FILE" ] && cat "$MODELS_FILE"; [ -f "$MODELS_GEN" ] && cat "$MODELS_GEN"; } 2>/dev/null \
        | awk -F'\t' -v q="$q" '!/^#/ && $2!="" && (index(tolower($2),tolower(q)) || index(tolower($3),tolower(q))) {print $1"\t"$2"\t"$3}' | sort -u
      ;;
    "")
      local a; for a in claude codex opencode cmd pi; do printf '# %s\n' "$a"; models_of "$a"; done;;
    *) models_of "$sub";;
  esac
}

# 복구 커맨드 합성 — ★fable 계열 제외 전부 [1m]★ (오빠 확정 2026-09-09: 작은 창으로 절대 열지 않는다)
with_1m_if_claude() { case "$1" in claude-*) with_1m "$1";; *) printf '%s' "$1";; esac; }
with_1m() { case "$1" in *fable*|*\[*\]*) printf '%s' "$1";; "") printf '%s' "$1";; *) printf '%s[1m]' "$1";; esac; }
restore_cmd_for() {  # agent model sid name resume [effort]
  local agent="$1" model="$2" sid="$3" name="$4" resume="$5" effort="${6:-}" bin
  [ -n "$resume" ] && { printf '%s' "$resume"; return; }
  case "$agent" in
    claude) bin="$HOME/.headroom/claude-hr.sh"; [ -x "$bin" ] || bin=claude
            printf '%s --dangerously-skip-permissions --model "%s" --effort high --resume %s --name %s --remote-control %s' "$bin" "$(with_1m "${model:-claude-opus-5-5}")" "$sid" "$name" "$name";;
    codex)  printf 'codex --dangerously-bypass-approvals-and-sandbox -c model_reasoning_effort="high" resume %s' "$sid";;
    cmd)    printf 'cmd --yolo --trust --skip-onboarding --name %s --resume %s' "$name" "$sid";;
    opencode) printf 'opencode --session %s' "$sid";;
    # pi(0.9.4): thinking 레벨을 «복구 커맨드에 남긴다» — 없으면 settings 기본(medium)으로 조용히 떨어진다
    #   (실측 off 1.25s vs high 2.08s — 레벨이 바뀌면 좌석 성격이 바뀐다). 스냅샷의 effort 를 우선 쓰고, 없으면 medium.
    pi)    printf 'pi --name %s --session %s --thinking %s' "$name" "$sid" "${effort:-medium}";;
    *) return 1;;
  esac
}
# tmuxc restore_one 과 같은 순서: 세션 생성 → resume 커맨드 주입 → 부팅 대기 → (claude) 복원 안내 주입 → attach
cmd_restore_one() {  # NAME [--dry-run|--no-attach]
  local n="$1" dry="${2:-}" row src agent name cwd sid model effort lm la base gen resume cmd try
  if tmux has-session -t "=$n" 2>/dev/null; then
    [ "$dry" = --no-attach ] && { echo "⏭ $n 이미 살아있음"; return 0; }
    echo "이미 살아있음 → attach"; cmd_attach "$n"; return
  fi
  row="$(dead_row "$n")"; [ -n "$row" ] || { echo "❌ 종료 목록에 없음: $n"; sleep 1; return 1; }
  src="$(printf '%s' "$row" | cut -f1)"; agent="$(printf '%s' "$row" | cut -f2)"; name="$(printf '%s' "$row" | cut -f3)"
  cwd="$(printf '%s' "$row" | cut -f4)"; sid="$(printf '%s' "$row" | cut -f5)"; model="$(printf '%s' "$row" | cut -f6)"
  effort="$(printf '%s' "$row" | cut -f7)"   # 0.9.4 · 스냅샷의 thinking/effort(없으면 빈 값 → pi 는 medium)
  resume="$(printf '%s' "$row" | cut -f12-)"
  cmd="$(restore_cmd_for "$agent" "$model" "$sid" "$name" "$resume" "$effort")" || { echo "❌ 복구 커맨드 합성 불가 ($agent)"; sleep 1; return 1; }
  [ -d "$cwd" ] || { echo "⚠ cwd 없음 ($cwd) → \$HOME 에서 기동"; cwd="$HOME"; }
  if [ "$dry" = --dry-run ]; then printf 'session=%s\ncwd=%s\nsrc=%s\ncmd=%s\n' "$name" "$cwd" "$src" "$cmd"; return 0; fi
  echo "▶ 복구 $name ($src, $agent) · $(basename "$cwd")"
  tmux new-session -d -s "$name" -c "$cwd" || { echo "❌ tmux new-session 실패"; sleep 1; return 1; }
  # 창 옵션 window-size 를 서버 기본(latest)으로. ★정정 2026-09-09★: new-session -d 자체는 manual 을 박지 않는다
  #   (격리 실측: 생성 직후 opt='' 상속). 좌석들이 `resize-window -x 200`(ctx 읽기) 뒤 원복할 때 manual 이 남는 것이
  #   원인이라, 근본 방어는 cmd_attach 의 set -wu 다. 여기 것은 무해한 보험으로 남긴다.
  tmux set -wu -t "=$name:" window-size 2>/dev/null
  tmux send-keys -t "=$name:" -l "$cmd"; sleep 0.3; tmux send-keys -t "=$name:" Enter
  for try in $(seq 1 "${TMM_RESTORE_TRIES:-20}"); do
    sleep 3
    # 부팅 판정: claude(❯/ctx:/bypass) · codex(› Ask Codex / Pursuing goal) · cmd/opencode 는 pane 이 셸이 아니면 살아있는 것
    tmux capture-pane -t "=$name:" -p 2>/dev/null | grep -qE 'ctx:|❯|bypass permissions|Model:|context used|› Ask Codex|Pursuing goal|Ask Codex to' && break
    [ "$try" -ge 3 ] && ! is_shell_cmd "$(tmux display -p -t "=$name:" '#{pane_current_command}' 2>/dev/null)" && [ "$agent" != claude ] && break
    [ "$try" -eq "${TMM_RESTORE_TRIES:-20}" ] && echo "⚠ 부팅 확인 못 함 (세션은 남김)"
  done
  if [ "$agent" = claude ] && [ "$try" -lt "${TMM_RESTORE_TRIES:-20}" ]; then
    sleep 1; tmux send-keys -t "=$name:" -l "[restore→$name] tmm 에서 복원된 세션이다. 통신 표준: ~/.claude/skills/tmuxc/COMM-GUIDE-BOOT.md(12줄)를 Read하고 준수 — 전문 COMM-GUIDE.md 는 열지 않는다. 너의 세션명(me)=$name. 직전 작업 컨텍스트를 확인하고 이어가라."; sleep 0.3; tmux send-keys -t "=$name:" Enter
  fi
  [ "$dry" = --no-attach ] && { [ "$try" -lt "${TMM_RESTORE_TRIES:-20}" ] && echo "  ✅ $name"; return 0; }
  rm -f "$RUN/dead.tsv"   # 다음 목록에서 이 행이 사라지게
  cmd_attach "$name"
}
# 현재 창(since)·계보(gen)에 보이는 종료 세션을 «전부» 순서대로 복구 — tmuxc restore --scan --loose --select all --go 의 폰판.
# 창을 ^] 로 넓힌 뒤 다시 실행하면 새로 드러난 것만 이어서 복구된다(이미 살아있는 것은 ⏭). attach 는 하지 않는다.
cmd_restore_all() {  # [--dry-run] [--yes] [--since H]  — ★5개씩 배치 병렬★ (TMM_RESTORE_BATCH, 기본 5). 한 배치가 다 끝나야 다음 배치.
  local dry="" yes="" names n total=0 ok=0 fail=0 t0 a batch="${TMM_RESTORE_BATCH:-5}" res i=0 bno=0 chunk nf="" scope=""
  while [ $# -gt 0 ]; do case "$1" in --dry-run) dry=--dry-run;; --yes|-y) yes=1;; --names-file) nf="$2"; shift;; --since) cmd_since "$2" >/dev/null; shift;; esac; shift; done
  # --names-file: fzf 가 «지금 화면에 보이는(필터된)» 행만 넘긴 목록. 없으면 창 전체(CLI 경로).
  if [ -n "$nf" ] && [ -s "$nf" ]; then names="$(cut -f2 < "$nf" | grep .)"; scope="화면 $(printf '%s\n' "$names" | grep -c .)건"
  else names="$(cmd_dead_rows time fresh | cut -f2 | grep .)"; scope="창 $(since_now)h 전체"; fi
  total="$(printf '%s\n' "$names" | grep -c .)"
  [ "$total" -gt 0 ] || { echo "(창 ${DEAD_SINCE0}h 안에 종료 세션 없음 — ^] 로 창을 넓히세요)"; sleep 1.5; return 0; }
  echo "▶ 일괄 복구: ${scope} · 계보 $(gen_now) · ${total}건 · ${batch}개씩 배치 (attach 없음, 배치당 ≤$(( ${TMM_RESTORE_TRIES:-20}*3 ))s)"
  if [ -z "$yes" ] && [ -z "$dry" ]; then
    printf '%s\n' "$names" | sed 's/^/   ◌ /' | head -40; [ "$total" -gt 40 ] && echo "   … (+$((total-40)))"
    read -r -p "전부 복구? [y/N] " a; [ "$a" = y ] || [ "$a" = Y ] || { echo "(취소)"; sleep 1; return 0; }
  fi
  if [ -n "$dry" ]; then
    while IFS= read -r n; do cmd_restore_one "$n" --dry-run | grep -E '^(session|cmd)=' | tr '\n' ' '; echo; done <<<"$names"; return 0
  fi
  # 결과 파일 $RUN/restore-<epoch>.log — «ok|fail<TAB>세션명<TAB>사유» 한 줄씩. 워커는 화면에 안 쓰고 파일로만 보고.
  t0=$(date +%s); res="$RUN/restore-$t0.log"; : > "$res"
  # 배치 루프: 5개를 백그라운드로 띄우고 wait — 한 배치의 부팅이 전부 끝나야 다음 5개 (헤드룸·API 동시 부하 상한)
  while :; do
    chunk="$(printf '%s\n' "$names" | sed -n "$((i+1)),$((i+batch))p")"; [ -n "$chunk" ] || break
    bno=$((bno+1)); echo "── 배치 $bno: $(printf '%s' "$chunk" | tr '\n' ' ')"
    while IFS= read -r n; do
      [ -n "$n" ] || continue
      ( out="$("$SELF" restore "$n" --no-attach </dev/null 2>&1)"; rc=$?
        if [ $rc -eq 0 ] && tmux has-session -t "=$n" 2>/dev/null && ! printf '%s' "$out" | grep -q '부팅 확인 못 함'; then
          printf 'ok\t%s\t\n' "$n" >> "$res"; printf '  ✅ %s\n' "$n"
        else
          printf 'fail\t%s\t%s\n' "$n" "$(printf '%s' "$out" | grep -E '❌|⚠' | tail -1 | cut -c1-80)" >> "$res"; printf '  ❌ %s\n' "$n"
        fi ) &
    done <<<"$chunk"
    wait
    i=$((i+batch))
  done
  ok="$(grep -c '^ok' "$res")"; fail="$(grep -c '^fail' "$res")"
  rm -f "$RUN/dead.tsv"
  echo "── 완료: ✅ $ok  ❌ $fail  / $total  ($(( $(date +%s)-t0 ))s) — 결과: $res"
  [ "$fail" -gt 0 ] && { echo "── 실패:"; grep '^fail' "$res" | cut -f2,3 | sed $'s/\t/ — /;s/^/   ❌ /'; }
  echo "살아난 좌석은 ^A 좌석뷰에서 확인"; read -r -n1 -p "[아무 키] " _
}

# ---------- 자동 갱신 ----------
# ^U 가 돌리는 것은 «미리보기» 주기다. 전좌석 주기(AUTO)는 seat-scan 부하 상한이라 키로 못 줄인다.
auto_now() { cat "$RUN/auto" 2>/dev/null || echo "$AUTO_PREVIEW"; }
cmd_auto_cycle() {  # 1 → 5 → 10 → 15 → 1. off 는 없다 — 폰에서 실수로 꺼져 «갱신이 안 된다»가 되지 않게. 끄려면 TMM_AUTO_PREVIEW=0
  local cur p next="${AUTO_PRESETS%% *}"; cur="$(auto_now)"
  for p in $AUTO_PRESETS; do [ "$p" -gt "$cur" ] && { next=$p; break; }; done
  echo "$next" | tee "$RUN/auto"
}
# 헤더: 키 2줄 + 상태 1줄. 전체 폭 ≥240(초광폭)일 때만 키 2줄을 한 줄로. 기준은 tput cols(전체 폭) — FZF_COLUMNS 는 목록 폭이라
# 오른쪽 미리보기가 켜지면 절반이 돼 흔들린다. resize 이벤트로 재계산.
# 전체 폭: fzf 자식에서 tput cols 는 80 으로 고정(실측) — FZF_COLUMNS(목록 폭) + FZF_PREVIEW_COLUMNS(미리보기 폭, 켜져 있을 때).
# 미리보기가 오른쪽이면 둘의 합이 전체, 아래면 FZF_COLUMNS 가 곧 전체. 상태 파일 $RUN/cols 에 마지막 값을 남겨 폭이 안 잡히는 호출도 따른다.
term_cols() {
  local c="${FZF_COLUMNS:-}" p="${FZF_PREVIEW_COLUMNS:-0}" pw
  if [ -n "$c" ]; then
    pw="$(cat "$RUN/pw" 2>/dev/null)"; case "$pw" in right*) c=$((c + p + 1));; esac
    split_active && c=$((c + $(cat "$RUN/catw" 2>/dev/null || echo 11) + 1))   # 분할(0.8.0): 분류 칸 + 경계선도 전체 폭
    printf '%s\n' "$c" > "$RUN/cols"; printf '%s' "$c"; return
  fi
  cat "$RUN/cols" 2>/dev/null || tput cols 2>/dev/null || echo "${COLUMNS:-60}"
}
TMM_VERSION="$(cat "$HERE/../VERSION" 2>/dev/null || echo dev)"
cmd_header() {
  local a w lw narrow=""; a="$(auto_now)"; w="$(term_cols)"
  # 목록 칸 폭(lw) — 분할(0.8.0)이면 전체에서 분류 칸을 뺀 폭. 60 미만(60~70열 폰 + 분할)이면 섹션 라벨·두 칸 띄움을 줄인 «좁은» 헤더.
  if split_active; then lw="${FZF_COLUMNS:-$(( w - $(cat "$RUN/catw" 2>/dev/null || echo 11) - 1 ))}"; else lw="${FZF_COLUMNS:-$w}"; fi
  [ "$lw" -lt 60 ] && narrow=1          # fzf 가 헤더를 2칸 들여쓰므로 쓸 수 있는 폭 = lw-2. 보통 헤더(≤58)는 lw≥60 에서만 다 보인다(70열 폰 실측 2026-10-12)
  if [ "$(view_now)" = dead ]; then
    hdr_dead
    # ★헤더는 스캔하지 않는다★ — 예전엔 dead_tsv 를 불러, 캐시가 없으면 transform-header(동기) 안에서 종료 스캔(부하 시 3~9초)을 «한 번 더» 돌려 화면이 멈췄다.
    #   개수는 직전 목록 캐시로만 세고, 목록이 다 오면(load) cmd_onload 가 헤더를 다시 그린다.
    printf '\033[33m상태\033[0m 창 %sh · %s건 · 계보 %s · SNAP/CC/CDX/CMD/OC\n' "$(since_now)" "$( [ -f "$RUN/dead.tsv" ] && wc -l < "$RUN/dead.tsv" | tr -d ' ' || echo '…')" "$( [ "$(gen_now)" = all ] && echo 전체 || echo 최신)"
    return
  fi
  hdr_live "$narrow"
  [ -n "$narrow" ] || printf '\033[33m상태\033[0m '
  [ "$a" -gt 0 ] && printf 'pane %ss' "$a" || printf 'pane off'
  [ "$AUTO" -gt 0 ] && printf ' 전체 %ss' "$AUTO" || printf ' 전체 off'
  if [ -n "$narrow" ]; then printf ' · 1m=1M창\n'; else printf ' · 12:34 완료 12~34 출력 · 1m=1M창\n'; fi
  # ★탭 줄은 헤더의 «마지막» 줄 — 검색 프롬프트 바로 위(0.7.1, 사용자 지정). `&&` 로 끝내면 탭 꺼짐일 때 종료코드 1 이 된다(pipefail 에서 헤더 호출이 실패로 잡힘)
  #   분할(0.8.0)이면 탭 줄 대신 «칸 이동 안내»(↑↓ ⏎ Esc) — 카테고리는 왼쪽 칸에 있다.
  if split_active && tab_on; then
    if [ -n "$narrow" ]; then hdr_line "" " " "$(K ↑↓ 고르기)" "$(K ⏎ 목록)" "$(K Esc/⌫ 분류)" "$(K ^V 숨김)"
    else hdr_line 칸 "  " "$(K ↑↓ 고르기)" "$(K ⏎ 목록으로)" "$(K Esc/⌫ 분류칸으로)" "$(K ^V 칸숨김)"; fi
  elif tab_on; then tab_bar; fi
}
cmd_post() { curl -s -o /dev/null --unix-socket "$1" -X POST http://localhost/ -d "$2"; }
# 백그라운드 핑거: 1초 틱마다 상태 파일을 다시 읽어 ^U 변경이 즉시 반영. fzf 가 끝나면 cmd_tui 가 죽인다 —
# attach 중엔 fzf 가 없으므로 자연히 멈추고, 떼고 돌아오면 새 fzf 와 함께 다시 뜬다.
auto_loop() {
  local sock="$1" i=0 gap
  while :; do
    sleep 1; i=$((i+1))
    [ -S "$sock" ] || continue
    gap="$(auto_now)"
    [ "$gap" -gt 0 ] && [ $((i % gap)) -eq 0 ] && cmd_post "$sock" 'refresh-preview'
    # ★선택복구 모드(^B)에서는 전좌석 갱신을 멈춘다★ — fzf 의 reload 는 «선택을 전부 지운다».
    #   20초마다 체크가 통째로 풀려서 «시간이 지나면 선택이 해제된다» 로 보였다(2026-09-16 사용자 지적).
    #   미리보기 갱신(refresh-preview)은 선택을 건드리지 않으므로 그대로 둔다.
    # ★자동 갱신은 `fresh` 를 쓰지 않는다★ — fresh 는 «인스턴스 공용» 캐시를 지우고 seat-scan(7초)을 다시 돌려, 피커가 여럿이면 서로의 캐시를 계속 지워
    #   TTL 이 무력해졌다. 캐시가 20초 안이면 재사용하고, 지났으면 한 인스턴스만 다시 스캔한다(scan_cached 의 락). 수동 ^R 만 fresh.
    [ "$AUTO" -gt 0 ] && [ $((i % AUTO)) -eq 0 ] && [ ! -f "$RUN/selmode" ] \
      && cmd_post "$sock" "reload(TMM_CUR={2} TMM_Q={q} $SELF rows-cur)"
    [ "$BELL" != 0 ] && [ -f "$RUN/bell" ] && { rm -f "$RUN/bell"; cmd_post "$sock" 'bell'; }
    # 분할(0.8.0): 목록이 탭 수를 새로 셀 때마다($RUN/tabs 갱신) 분류 칸 행을 다시 만들되, «내용이 바뀐 때만» reload 를 쏜다(2026-10-17)
    #   — tabs 는 rows-cur 가 돌 때마다 같은 내용으로 다시 쓰여 catseen 보다 새로워진다. 그때마다 reload 하면 분류 fzf 가 키 입력을 버려 «밀림» 이 됐다.
    #   cat_sync 가 cmd_catrows(스폰 0 함수 호출)로 $RUN/catrows 를 갱신하고 바뀐 때만 0 → 그때만 reload(cat 파일). 안 바뀌면 catseen 만 찍어 다음 tabs 변화까지 쉰다.
    if [ -S "$RUN/cat.sock" ] && { [ ! -f "$RUN/catseen" ] || [ "$RUN/tabs" -nt "$RUN/catseen" ]; }; then
      cat_sync && cmd_post "$RUN/cat.sock" "reload(cat $RUN/catrows)"; : > "$RUN/catseen"
    fi
  done
}

cmd_ls() {  # [PAT] [--host H|all]
  local pat="" host="" h
  while [ $# -gt 0 ]; do
    case "$1" in
      --host)   host="${2:-}"; shift; [ $# -gt 0 ] && shift ;;
      --host=*) host="${1#--host=}"; shift ;;
      *)        pat="${pat:+$pat }$1"; shift ;;
    esac
  done
  if [ -z "$host" ]; then cmd_rows time | cut -f1 | { [ -n "$pat" ] && grep -i -- "$pat" || cat; }; return; fi
  # ★HOST 열★ — --host 를 준 경우에만 앞에 붙는다(접두 없는 지금 출력은 그대로 — R6)
  for h in $(h_targets "$host"); do
    if [ "$h" = "$(h_local_name)" ] || [ "$(h_field "$h" kind)" = local ]; then
      cmd_rows time | cut -f1 | sed "s/^/$h /"
    else
      cmd_rows_remote "$h" | cut -f1 | sed "s/^/$h /"
    fi
  done | { [ -n "$pat" ] && grep -i -- "$pat" || cat; }
}

# 원격 좌석 행 — ssh 한 번(h_pipe)으로 상태·활동·cwd 를 받아 로컬 cmd_rows 와 «같은 모양» 으로 편다.
# 모델·완료 마커는 원격 트랜스크립트를 읽어야 하므로 «-» 로 둔다(정본 확장은 카드3 후속).
cmd_rows_remote() {  # <host>
  local h="$1" s st act pcmd cwd tl live cat nw cw now scr
  read -r nw cw <<<"$(col_widths)"
  now=$(date +%s)
  scr="$(mktemp "${TMPDIR:-/tmp}/tmm-rrows.XXXXXX")" || return 1
  rows_remote_script > "$scr"
  h_pipe "$h" "$scr" 2>/dev/null | while IFS=$'\t' read -r s st act pcmd cwd; do
    [ -n "$s" ] || continue
    case "$pcmd" in zsh|bash|sh|fish|-zsh|-bash) live="○" ;; *) live="●" ;; esac
    cat="$(cat_of "$s" key)"; tl="${cat#*/}"
    printf '%s\t%s\t%s\t%-5s %s %-*s %-5s %-8s %s %s %s\t%s\t%s\n' \
      "$(wait_rank "$st")" "${act:-0}" "$cat" \
      "${tl:0:5}" "$live" "$nw" "$(clip_name "$s" "$nw")" "$st" "-" "$(fmt_hm "${act:-0}" "~") " "$(age_of "${act:-0}" "$now")" "${cwd##*/}" \
      "$s" "$cat"
  done | sort -t$'\t' -k2,2nr | cut -f4-
  rm -f "$scr"
}

# 원격에서 돌 스크립트 본문 — seat-scan 을 «설치 없이» 그대로 싣고 tmux 목록과 이름으로 잇는다.
rows_remote_script() {
  printf '#!/bin/bash\n'
  printf 'SEAT_STATE="$(\n'
  [ -n "$SCAN" ] && [ -f "$SCAN" ] && sed -e '1{/^#!/d;}' "$SCAN"
  printf ')"\n'
  cat <<'EOS'
tmux list-panes -a -F $'#{session_name}\t#{window_activity}\t#{pane_current_command}\t#{pane_current_path}' 2>/dev/null |
awk -F'\t' '!seen[$1]++' |
awk -F'\t' -v st="$SEAT_STATE" 'BEGIN { n = split(st, L, "\n"); for (i = 1; i <= n; i++) { split(L[i], P, " "); if (P[1] != "") S[P[1]] = P[2] } }
{ print $1 "\t" (S[$1] != "" ? S[$1] : "?") "\t" $2 "\t" $3 "\t" $4 }'
EOS
}

# ---------- 동작 ----------
cmd_attach() {
  local n="${1:-}" flags=""
  [ -n "$n" ] || { echo "(목록 로딩 중 — 잠시 후 다시 Enter)"; sleep 1; return 0; }
  tmux has-session -t "=$n" 2>/dev/null || { echo "❌ 세션 없음: $n"; sleep 1; return 1; }
  [ "${2:-}" = "-i" ] && flags="-f ignore-size"
  # ★attach 직전에 창 옵션 window-size 를 푼다★ — 좌석들이 ctx 게이지를 읽으려고 `resize-window -x 200` → 원복을
  #   반복하는데, resize-window 는 창 옵션을 manual 로 박아 이후 어떤 클라이언트가 붙어도 그 크기(80x24 등)에 갇힌다
  #   (격리 재현 2026-09-09: 200→80 원복 뒤 64x66 attach → 80x24 그대로 · set -wu 뒤 → 64x65). 스폰 경로 탓이 아니다.
  #   -i(ignore-size) 는 사용자가 «고정» 을 원한 것이므로 건드리지 않는다.
  [ -z "$flags" ] && tmux set -wu -t "=$n:" window-size 2>/dev/null
  if [ -n "${TMUX:-}" ]; then
    # 출발 피커를 이 클라이언트에 적어 둔다 — 좌석에서 C-a d 가 «직전 세션» 추정 없이 정확히 돌아오게(cmd_dkey)
    local me tty
    me="$(tmux display -p -t "${TMUX_PANE:-}" '#{session_name}' 2>/dev/null)"
    if [ -n "$me" ] && is_picker "$me"; then
      while read -r tty; do [ -n "$tty" ] && tmux set -g "@tmm_home_$(tty_key "$tty")" "$me" 2>/dev/null; done \
        < <(tmux list-clients -t "=$me" -F '#{client_tty}' 2>/dev/null)
    fi
    tmux switch-client -t "=$n"
  else tmux attach -t "=$n" $flags; fi
}

cmd_peek() {  # 비대화용(tmm p): 색 없음·빈 줄 제거·폭 자름 — 주소는 «호스트/좌석»
  local addr="${1:-}" k="${2:-30}" host sess out rc
  read -r host sess <<<"$(h_split "$addr")"
  if [ "$host" != "$(h_local_name)" ]; then
    out="$(h_tmux "$host" --idempotent capture-pane -t "=$sess:" -p 2>/dev/null)"; rc=$?
    [ "$rc" -eq 0 ] || echo "tmm: $host/$sess 읽기 실패 (rc=$rc)" >&2
    printf '%s\n' "$out" | grep -vE '^\s*$' | tail -n "$k" | cut -c1-"${COLUMNS:-80}"
    return "$rc"
  fi
  tmux capture-pane -t "=$sess:" -p 2>/dev/null | grep -vE '^\s*$' | tail -n "$k" | cut -c1-"${COLUMNS:-80}"
}

# TUI 미리보기 전용 렌더러 — 폰 가독성 3축을 여기서 푼다:
#  ① -e 로 SGR 색을 살린다 — Claude TUI 는 응답=굵게·도구출력=회색·완료=초록이라 색이 곧 구조다.
#  ② 바닥 입력박스(── ❯ ──)와 statusline 을 잘라 12행 미리보기에서 대화만 보이게. 연속 빈 줄은 1줄로.
#  ③ fzf follow 로 바닥(최신)부터. -J 는 tmux 소프트랩만 되돌린다 — Claude TUI 의 하드 줄바꿈(216열 문단이
#     폰 60열에서 다시 접혀 ↳ 조각이 나는 것)은 여기서 못 고친다(실측: -J 유무 표시행 동일).
cmd_preview() {
  local n="$1" k="${2:-$PREVIEW_LINES}"
  [ "$(view_now)" = dead ] && { cmd_dead_preview "$n" "$k"; return; }
  tmux capture-pane -t "=$n:" -p -e -J -S -200 2>/dev/null | render_pane | tail -n "$k"
}
render_pane() {  # stdin: capture-pane -e -J 원문 → 입력박스 이하 제거·연속 빈 줄 압축 (verify 가 골든으로 잰다)
  awk '
    # 줄 끝 공백만 제거하고 끝에 붙은 SGR 은 되돌려 붙인다 (색 유지 + 불필요 wrap 제거)
    function rstrip(l,   tail, changed) {
      tail = ""
      do {
        changed = 0
        if (match(l, /[ \t]+$/))                    { l = substr(l, 1, RSTART-1); changed = 1 }
        if (match(l, /\033\[[0-9;?]*[a-zA-Z]$/))    { tail = substr(l, RSTART) tail; l = substr(l, 1, RSTART-1); changed = 1 }
      } while (changed)
      return l tail
    }
    { s=$0; gsub(/\033\[[0-9;?]*[a-zA-Z]/, "", s); sub(/[ \t]+$/, "", s) }
    # 구분선 판정은 «바이트 안전»하게 — macOS awk 는 멀티바이트 문자에 (─)+ 를 못 건다
    # 첫 구분선엔 세션명이 박힌다(«──── NAME ────») — ─ 를 지운 나머지가 원문의 1/4 미만이면 구분선
    { t = s; gsub(/─/, "", t); sep[NR] = (length(s) >= 30 && length(t) * 4 < length(s)) }
    # 입력박스: Claude = «구분선 → ❯ 로 시작하는 줄» 쌍(본문 속 표 구분선은 뒤에 ❯ 가 없어 안 잘림),
    #           Codex  = «› Ask Codex …» 프롬프트 줄. 그 아래 statusline·모델 줄은 통째로 버린다.
    NR > 1 && sep[NR-1] && s ~ /^❯/ && !cut { cut = NR - 1 }
    s ~ /^› Ask Codex/ && !cut { cut = NR }
    { lines[NR] = $0; blank[NR] = (s == "") }
    END {
      last = cut ? cut - 1 : NR
      for (i = 1; i <= last; i++) {
        if (blank[i] && (i == 1 || blank[i-1])) continue
        print rstrip(lines[i])
      }
    }'
}

is_shell_cmd() { case "$1" in zsh|bash|sh|fish|-zsh|-bash|"") return 0;; *) return 1;; esac; }
live_mark() {  # ● 에이전트 실행 중 / ○ shell only  (send 가드용 단건 조회)
  # pane_current_command 기준 — pgrep -P 는 zsh 플러그인 자식(gitstatusd 등)을 에이전트로 오판한다(verify 실측)
  local cmd; cmd="$(tmux display -p -t "=$1:" '#{pane_current_command}' 2>/dev/null)"
  is_shell_cmd "$cmd" && echo "○" || echo "●"
}

cmd_send() {
  local n="$1"; shift
  # HARD GATE: pane 자식(에이전트) 없으면 셸에 타이핑되므로 차단 (tmuxc send 자체엔 가드 없음)
  [ "$(live_mark "$n")" = "●" ] || { echo "❌ $n 에 에이전트가 실행 중이 아님 — 셸 오타이핑 방지로 차단"; return 1; }
  if command -v tmuxc >/dev/null; then
    tmuxc send "$n" "[mobile→$n] $*"
  else
    tmux send-keys -t "=$n:" -l "[mobile→$n] $*"; sleep 0.3; tmux send-keys -t "=$n:" Enter
  fi && { sleep 2; echo "── 도달 확인 ──"; cmd_peek "$n" 6; }
}

# TUI 안 ^S: fzf 밖(정상 tty)에서 프롬프트
cmd_sendp() {
  local n="$1" m
  echo "→ $n  (빈 입력 = 취소)"
  read -r -p "메시지: " m
  [ -n "$m" ] && cmd_send "$n" "$m"
  read -r -n1 -p "[아무 키] " _
}


# 좌석 종료 — 그 안의 에이전트도 함께 끝난다. 확인 프롬프트는 fzf 밖(정상 tty)에서 받는다.
# tmuxc 가 있으면 graceful 경로(/exit 전송 → kill)를 쓴다.
cmd_kill() {  # NAME [--yes]
  local n="${1:-}" yes="${2:-}" a
  [ -n "$n" ] || { echo "(선택된 좌석 없음)"; sleep 1; return 0; }
  [ -n "${TMM_SESSION:-}" ] && [ "$n" = "$TMM_SESSION" ] && { echo "❌ 피커 자신($n)은 여기서 못 닫는다 — ^X 로 끝내세요"; sleep 1.5; return 1; }
  tmux has-session -t "=$n" 2>/dev/null || { echo "❌ 세션 없음: $n"; sleep 1; return 1; }
  if [ "$yes" != --yes ]; then
    printf '좌석 «%s» 를 종료합니다 — tmux 세션과 그 안의 에이전트가 끝납니다.\n' "$n"
    cmd_peek "$n" 4
    read -r -p "종료? [y/N] " a
    case "$a" in y|Y) ;; *) echo "(취소)"; sleep 0.8; return 0 ;; esac
  fi
  if command -v tmuxc >/dev/null; then tmuxc kill "$n" >/dev/null 2>&1; else tmux kill-session -t "=$n" 2>/dev/null; fi
  sleep 0.5
  if tmux has-session -t "=$n" 2>/dev/null; then echo "⚠ 아직 살아있음: $n"; else echo "✅ 종료됨: $n"; fi
  [ "$yes" = --yes ] || read -r -n1 -p "[아무 키] " _
}

cmd_scan() {  # [--host H|all]
  local host="" h
  while [ $# -gt 0 ]; do
    case "$1" in
      --host)   host="${2:-}"; shift; [ $# -gt 0 ] && shift ;;
      --host=*) host="${1#--host=}"; shift ;;
      *)        shift ;;
    esac
  done
  [ -n "$SCAN" ] || { echo "seat-scan 없음 (TMM_SCAN 지정)"; return 0; }
  if [ -z "$host" ]; then bash "$SCAN"; return; fi
  for h in $(h_targets "$host"); do
    if [ "$h" = "$(h_local_name)" ] || [ "$(h_field "$h" kind)" = local ]; then bash "$SCAN" | sed "s/^/$h /"
    else h_pipe "$h" "$SCAN" 2>/dev/null | sed "s/^/$h /"; fi
  done
}
cmd_human() { cmd_scan | grep -E '^\S+\s+(HUMAN|BLOCK|STUCK)\b' || echo "(사람 입력 대기·차단 좌석 없음)"; }

cmd_doctor() {
  local ok=0
  for c in tmux fzf; do command -v "$c" >/dev/null && echo "  [✓] $c $(command -v $c)" || { echo "  [✗] $c 없음"; ok=1; }; done
  command -v tmuxc >/dev/null && echo "  [✓] tmuxc $(cat "$HOME/.tmuxc/current/core/VERSION" 2>/dev/null) (세트 — send 도달확인·save·restore·fork 규약)" || { echo "  [✗] tmuxc 없음 — tmm 은 tmuxc 와 세트. feature-pack/tmuxc 먼저 설치"; ok=1; }
  local tcv; tcv="$(cat "$HOME/.tmuxc/current/core/VERSION" 2>/dev/null || echo 0)"
  [ "$(printf '%s\n0.4.0\n' "$tcv" | sort -V | head -1)" = "0.4.0" ] && echo "  [✓] tmuxc fork (동일엔진 네이티브 분기)" \
    || echo "  [!] tmuxc $tcv < 0.4.0 — 동일엔진 fork 불가 (tmuxc 재설치; 크로스엔진 fork 는 동작)"
  [ -f "$MODELS_FILE" ] && echo "  [✓] models: $MODELS_FILE ($(grep -cvE '^\s*#|^\s*$' "$MODELS_FILE" 2>/dev/null) 별칭)" || echo "  [!] models 없음 → fork 모델 메뉴가 빔 ($MODELS_FILE — install.sh 가 예시 복사)"
  [ -f "$MODELS_GEN" ] && echo "  [✓] models.generated: $(grep -cvE '^\s*#|^\s*$' "$MODELS_GEN" 2>/dev/null)개 (opencode provider=$MODELS_PROVIDER)" || echo "  [!] models.generated 없음 → 'tmm models refresh' 로 라이브 목록 생성 (opencode=$MODELS_PROVIDER)"
  [ -n "$SCAN" ] && echo "  [✓] seat-scan: $SCAN" || { echo "  [✗] seat-scan 없음 (상태 열이 ? 로 나옴)"; ok=1; }
  [ -f "$CAT_FILE" ] && echo "  [✓] categories: $CAT_FILE" || echo "  [!] categories 없음 → 세션명 첫 토큰으로 자동 분류 ($CAT_FILE 에 규칙 작성 가능)"
  tmux ls >/dev/null 2>&1 && echo "  [✓] tmux 서버 ($(tmux ls | wc -l | tr -d ' ') 세션)" || echo "  [!] tmux 서버 없음"
  local fv; fv="$(fzf --version 2>/dev/null | cut -d' ' -f1)"
  if [ -n "$fv" ]; then
    [ "$(printf '%s\n0.54.0\n' "$fv" | sort -V | head -1)" = "0.54.0" ] && echo "  [✓] fzf $fv (--listen/--track/bell)" \
      || { echo "  [✗] fzf $fv < 0.54.0 — 자동 갱신·벨 불가 (brew upgrade fzf)"; ok=1; }
  fi
  command -v curl >/dev/null || { echo "  [✗] curl 없음 — 자동 갱신 불가"; ok=1; }
  [ -f "$DEAD_SCAN" ] && python3 -c 'import sys' 2>/dev/null && echo "  [✓] dead-scan: $DEAD_SCAN (종료 세션 $(python3 "$DEAD_SCAN" scan --since "$DEAD_SINCE0" 2>/dev/null | wc -l | tr -d ' ')건/${DEAD_SINCE0}h)" || { echo "  [✗] dead-scan 없음 또는 python3 없음 — 종료 뷰 불가"; ok=1; }
  [ -f "$HOME/.tmuxc/snapshots/latest.json" ] && echo "  [✓] tmuxc 스냅샷: $(readlink "$HOME/.tmuxc/snapshots/latest.json" | sed 's/.*snapshot-//;s/.json//')" || echo "  [!] tmuxc 스냅샷 없음 — SNAP 배지 없이 트랜스크립트만으로 복구"
  [ -x "$HOME/.headroom/claude-hr.sh" ] && echo "  [✓] headroom 래퍼 (복구 커맨드 경유)" || echo "  [!] headroom 래퍼 없음 — 복구는 bare claude"
  # 다른 버전으로 떠 있는 피커 = 업그레이드 전 코드가 물고 있는 좀비. 이어받지 않지만(0.8.5) 화면에는 계속 남는다
  local psess ps_stale=""
  while read -r psess; do
    [ -n "$psess" ] || continue
    [ "$(tmux show -t "=$psess:" -qv @tmm_ver 2>/dev/null)" = "$TMM_VERSION" ] || ps_stale+=" $psess"
  done < <(tmux list-sessions -F '#{session_name}' -f '#{@tmm_picker}' 2>/dev/null)
  [ -z "$ps_stale" ] || echo "  [!] 다른 버전으로 떠 있는 피커:$ps_stale — 옛 코드다. 그 화면에서 ^X 로 끝내면 다음 실행부터 새 코드"

  cache_init; echo "  cache: $CACHE (ttl ${CACHE_TTL}s) · state: $STATE/run-<pid> · pane:${AUTO_PREVIEW}s all:${AUTO}s bell:$BELL"
  return $ok
}

# ★폰 60열 기준 — fzf 는 헤더를 줄바꿈하지 않고 «자른다». 각 줄 표시폭(한글=2) 60 이내 (verify 가 잰다)
# 미리보기 창 배치: 전체 폭 <120 (폰) 아래 50% / ≥120 (PC) 오른쪽 55%. big = 같은 방향에서 크게↔기본 토글(상태 파일).
cmd_pw() {
  local w big=""; w="$(term_cols)"
  # 분할(0.8.0)이면 방향은 «목록 칸»(전체 − 분류 칸 − 경계) 폭으로 정한다 — 120열에 분류 칸 16 을 떼고도 오른쪽으로 두면 목록이 46칸이 됐다(실측 2026-10-12).
  split_active && w=$(( w - $(cat "$RUN/catw" 2>/dev/null || echo 11) - 1 ))
  if [ "${1:-}" = big ]; then [ -f "$RUN/pwbig" ] && rm -f "$RUN/pwbig" || : > "$RUN/pwbig"; fi
  [ -f "$RUN/pwbig" ] && big=1
  # 종료 뷰 미리보기의 첫 줄은 «[CC] 세션명 · cwd · 모델» 메타라 스크롤해도 붙잡아 둔다(~1).
  # 살아있는 좌석은 pane 원문이라 고정할 머리줄이 없다.
  local out hdr=""; [ "$(view_now)" = dead ] && hdr=",~1"
  if [ "$w" -ge 120 ]; then out="right,$([ -n "$big" ] && echo 75% || echo 55%),wrap-word,follow,noinfo,border-left$hdr"
  else out="down,$([ -n "$big" ] && echo 80% || echo 50%),wrap-word,follow,noinfo,border-top$hdr"; fi
  printf '%s' "$out" > "$RUN/pw"; printf '%s' "$out"
}

# 헤더 — 섹션별로 «키(청록 굵게) 설명(회색)» 쌍. 폰 60열 기준 한 줄 ≤60 표시폭(ANSI 제외, verify 가 잰다). 3~4줄.
K() { printf '\033[1;36m%s\033[0m\033[2m %s\033[0m' "$1" "$2"; }   # key + label
S() { printf '\033[33m%s\033[0m' "$1"; }                               # 섹션 표시
hdr_line() {  # <섹션|빈칸> <구분> <항목...> — 한 줄. 섹션이 비면 라벨 없이
  local sec="$1" sep="$2" out="" x first=1; shift 2
  [ -n "$sec" ] && out="$(S "$sec") "
  for x in "$@"; do if [ "$first" = 1 ]; then first=0; else out+="$sep"; fi; out+="$x"; done
  printf '%s\n' "$out"
}
hdr_live() {  # [narrow] — 좁은 헤더(분할 + 60열 폰 = 목록 48열)는 섹션 라벨 없이 한 칸 띄움, 긴 말은 짧게(attach→붙기, 메시지→쪽지)
  local n="${1:-}" sep="  " i=이동 s=정렬 h=화면 a=attach m=메시지
  [ -n "$n" ] && { sep=" "; i=""; s=""; h=""; a=붙기; m=쪽지; }
  hdr_line "$i" "$sep" "$(K ⏎ "$a")" "$(K ^S "$m")" "$(K ^K 닫기)" "$(K ^F fork)" "$(K ^D 종료)" "$(K ^X 끝)"
  hdr_line "$s" "$sep" "$(K ^T 최근)" "$(K ^W 대기)" "$(K ^G 분류)" "$(K ^H 대기만)" "$(K ^A 전체)"
  hdr_line "$h" "$sep" "$(K ^P/^O 미리보기)" "$(K ^U 자동)" "$(K ^R 갱신)" "$(K ^Y 경로)" "$(K ^/ 도움)"
  if ! split_active || ! tab_on; then hdr_line 탭 "  " "$(K ^V 목록↔탭)" "$(K Tab/→ 다음)" "$(K S-Tab/← 이전)"; fi
}
hdr_dead() {
  printf '%s %s  %s  %s  %s  %s\n' "$(S 복구)" "$(K ⏎ 1건)" "$(K ^B 선택복구)" "$(K ^F fork)" "$(K ^A 좌석뷰)" "$(K ^X 끝)"
  printf '%s %s  %s  %s  %s  %s\n' "$(S 창)" "$(K ^] +12h)" "$(K ^\\ -12h)" "$(K ^L 계보)" "$(K ^R 갱신)" "$(K ^Y 경로)"
  printf '%s %s  %s  %s  %s  %s\n' "$(S 정렬)" "$(K ^T 최근)" "$(K ^W SNAP)" "$(K ^G 분류)" "$(K ^P/^O 미리보기)"
}

cmd_tui() {
  command -v fzf >/dev/null || { echo "fzf 없음 → 숫자 메뉴 (brew install fzf 권장)"; menu; return; }
  local R="$SELF rows" M="$SELF mode" out key sel rows rc pinger sock
  export TMM_RUN="$STATE/run-$$"; RUN="$TMM_RUN"; mkdir -p "$RUN"; sock="$RUN/fzf.sock"
  printf '%s\n' "$AUTO_PREVIEW" > "$RUN/auto"; cmd_mode time; cmd_view live   # waitset 없음 = 첫 스캔은 기록만(진입 즉시 벨 방지)
  [ "${TMM_TAB:-1}" = 1 ] && : > "$RUN/tab"                                    # 탭이 기본 뷰 (0.7.1). 목록으로 시작하려면 TMM_TAB=0 — ^V 로 언제든 전환
  # 분할 화면(0.8.0) — tmux 안(피커 세션)이면 왼쪽에 분류 칸 pane. TMM_SPLIT=0 이면 0.7.x 탭 줄.
  if [ -n "${TMUX:-}" ] && [ -n "${TMUX_PANE:-}" ]; then
    printf '%s' "$TMUX_PANE" > "$RUN/mainpane"
    [ "${TMM_SPLIT:-1}" = 1 ] && [ -f "$RUN/tab" ] && split_open "$TMUX_PANE"
  fi
  trap 'kill "${pinger:-}" 2>/dev/null; split_close; rm -rf "$RUN"' EXIT
  _sig() { printf '%s SIG%s pid=%s cols=%s\n' "$(date +%FT%T)" "$1" "$$" "$(term_cols 2>/dev/null)" >> "$STATE/fzf-stderr.log"; exit 129; }
  for _s in HUP TERM QUIT; do trap "_sig $_s" "$_s"; done
  # ★attach/메시지는 fzf 밖에서 실행★ — execute() 안에서는 /dev/tty 를 못 잡아
  #   "open terminal failed: can't use /dev/tty". fzf 는 --expect 로 (키, 선택줄)만 돌려주고,
  #   이 루프가 attach → detach 후 다시 피커를 띄운다.
  # ★핑거도 fzf 한 번의 수명에 묶는다★ — attach 중(fzf 없음)엔 갱신이 없어야 하므로.
  while :; do
    rm -f "$sock"; auto_loop "$sock" & pinger=$!
    # --scheme=path: 구분자(-·#·/) 뒤 첫 글자에 보너스. 실측(16좌석·질의 5개)에서 4건 동일·1건 개선
    # (`v65m` → ft-v65-master 가 1위로). 좌석명이 ft-v65-master-sonnet#7 처럼 구분자로 쪼개져 있어 맞는다.
    out="$(fzf --ansi --delimiter=$'\t' --with-nth=1 --nth=1,3 --tiebreak=index --track --scheme=path \
      --layout=reverse --cycle --no-mouse --info=hidden --sync --listen="$sock" \
      --prompt="$( [ "$(view_now)" = dead ] && echo '종료> ' || { tab_on && echo '탭> ' || echo '좌석> '; })" --pointer='▶' \
      --header="$(cmd_header)" --header-first \
      --preview="$SELF preview {2} $PREVIEW_LINES" --preview-window="$(cmd_pw)" \
      --preview-wrap-sign='' \
      --bind "resize:transform($SELF pw-action)+transform-header($SELF header)" \
      --bind "start:transform($SELF pw-action)+transform-header($SELF header)+unbind(space)+transform($SELF boot-reload)" \
      --preview-label=' pane ' \
      --bind "focus:transform-preview-label($SELF plabel {2})" \
      --bind "result:transform-border-label($SELF blabel)" \
      --bind "load:transform($SELF onload)" \
      --border=top --border-label="$(cmd_blabel)" --border-label-pos=-3:top \
      --multi --expect=enter,ctrl-e,ctrl-s,ctrl-k,ctrl-f,double-click \
      --bind "tab:transform($SELF tabkey next {2})" \
      --bind "btab:transform($SELF tabkey prev {2})" \
      --bind "right:transform($SELF arrowkey next {2})" \
      --bind "left:transform($SELF arrowkey prev {2})" \
      --bind "ctrl-v:transform($SELF vtab)" \
      --bind "esc:transform($SELF esckey)" \
      --bind "bspace:transform($SELF bskey {q})" \
      --print-query --query="$(cat "$RUN/query.$(view_now)" 2>/dev/null)" \
      --bind "ctrl-h:execute-silent($M wait h)+reload(TMM_CUR={2} TMM_Q={q} $SELF rows-cur)+change-prompt(대기> )" \
      --bind "ctrl-a:transform($SELF vswitch live {q})" \
      --bind "ctrl-d:transform($SELF vswitch dead {q})" \
      --bind "ctrl-]:execute-silent($SELF since +)+reload(TMM_CUR={2} TMM_Q={q} $SELF rows-cur fresh)+transform-header($SELF header)" \
      --bind "ctrl-\\:execute-silent($SELF since -)+reload(TMM_CUR={2} TMM_Q={q} $SELF rows-cur fresh)+transform-header($SELF header)" \
      --bind "ctrl-l:execute-silent($SELF gen)+reload(TMM_CUR={2} TMM_Q={q} $SELF rows-cur fresh)+transform-header($SELF header)" \
      --bind "ctrl-t:execute-silent($M time)+reload(TMM_CUR={2} TMM_Q={q} $SELF rows-cur)+change-prompt(최근순> )" \
      --bind "ctrl-w:execute-silent($M wait)+reload(TMM_CUR={2} TMM_Q={q} $SELF rows-cur)+change-prompt(대기우선> )" \
      --bind "ctrl-g:execute-silent($M cat)+reload(TMM_CUR={2} TMM_Q={q} $SELF rows-cur)+change-prompt(카테고리> )" \
      --bind "ctrl-r:reload(TMM_CUR={2} TMM_Q={q} $SELF rows-cur fresh)+refresh-preview" \
      --bind "ctrl-u:execute-silent($SELF auto-cycle)+transform-header($SELF header)" \
      --bind "ctrl-p:toggle-preview" \
      --bind "ctrl-o:transform($SELF pw-action big)" \
      --bind "space:toggle" \
      --bind "ctrl-b:transform($SELF bkey)" \
      --bind "ctrl-y:execute($SELF idxp {2})" \
      --bind "ctrl-x:abort" \
      --bind "ctrl-/:transform-header($SELF header)" \
      2>>"$STATE/fzf-stderr.log" < <(cmd_rows_boot))"; rc=$?
    kill "$pinger" 2>/dev/null; wait "$pinger" 2>/dev/null; rm -f "$sock"
    case "$rc" in
      0)   ;;                                   # 선택 — 아래에서 키 처리
      130) return 0 ;;                          # ^X / Esc → 진짜 종료
      *)   printf '(화면이 끊겼습니다 rc=%s — 다시 엽니다. 로그: %s)\n' "$rc" "$STATE/fzf-stderr.log" >&2
           printf '%s exit=%s cols=%s\n' "$(date +%FT%T)" "$rc" "$(term_cols)" >> "$STATE/fzf-stderr.log"
           sleep 0.5; continue ;;                                   # 리사이즈 중 fzf 사망 등
    esac
    # --print-query 로 첫 줄은 «타이핑한 필터». 좌석에 붙었다 돌아와도, 뷰를 바꿔도 그대로 되살린다
    # (2026-09-16 사용자 요청: 「전환간에 카테고리나 검색을 유지」). 정렬·뷰는 이미 $RUN/mode·view 에 산다.
    # 키워드는 «뷰별»($RUN/query.live·query.dead) — ^A/^D 로 뷰를 바꿔도 다른 뷰의 키워드가 넘어오지 않는다(2026-09-30).
    printf '%s' "${out%%$'\n'*}" > "$RUN/query.$(view_now)"; out="${out#*$'\n'}"
    key="${out%%$'\n'*}"; rows="${out#*$'\n'}"; sel="$(printf '%s' "$rows" | head -1 | cut -f2)"
    # ^B = «지금 화면에 보이는(필터·정렬 적용된) 행 전부» 일괄 복구. select-all+accept 로 전 행이 out 에 실려 온다.
    if [ -f "$RUN/bulk" ]; then
      rm -f "$RUN/bulk"
      if [ "$(view_now)" = dead ]; then
        printf '%s\n' "$rows" > "$RUN/bulk-names"; cmd_restore_all --names-file "$RUN/bulk-names"
      else echo "(^B 는 종료 뷰 전용 — ^D 로 전환)"; sleep 1.2; fi
      continue
    fi
    [ -n "$sel" ] || continue
    [ "$(view_now)" = live ] && tabcur_set "$(cur_tab_key)" "$sel"      # 좌석에 붙었다 돌아오면 같은 세션에 커서
    if [ "$(view_now)" = dead ]; then
      case "$key" in
        ctrl-s) echo "(종료된 세션에는 메시지를 보낼 수 없음 — Enter 로 먼저 복구)"; sleep 1.5;;
        ctrl-k) echo "(이미 종료된 세션입니다)"; sleep 1.2;;
        ctrl-f) cmd_forkp "$sel";;                # 종료 세션에서도 fork(컨텍스트 승계) 가능
        *)      cmd_restore_one "$sel";;          # enter / ctrl-e / double-click → resume 복구 → attach, 떼면 dead 뷰로 복귀
      esac
    else
      case "$key" in
        ctrl-s) cmd_sendp "$sel";;
        ctrl-k) cmd_kill "$sel";;
        ctrl-f) cmd_forkp "$sel";;                # 라이브 좌석 fork(다른 에이전트로 이어받기)
        *)      cmd_attach "$sel";;                 # enter / ctrl-e / double-click → attach, detach 후 루프 재진입
      esac
    fi
  done
}

menu() {
  while :; do
    cat <<'EOF'

 ┌─ tmm ──────────────────────────────┐
 │ 1 세션 목록      5 전 좌석 스캔      │
 │ 2 attach         6 HUMAN 대기만     │
 │ 3 pane 읽기      7 tmuxc save       │
 │ 4 메시지 보내기  q 종료             │
 └────────────────────────────────────┘
EOF
    read -r -p " 선택: " c
    case "$c" in
      1) read -r -p " 필터(엔터=전체): " p; cmd_ls "$p";;
      2) read -r -p " 세션명: " n; cmd_attach "$n";;
      3) read -r -p " 세션명: " n; cmd_peek "$n";;
      4) read -r -p " 세션명: " n; read -r -p " 메시지: " m; cmd_send "$n" "$m";;
      5) cmd_scan;;
      6) cmd_human;;
      7) tmuxc save;;
      q|Q|"") exit 0;;
    esac
  done
}

case "${1:-}" in
  __lib)     return 0 2>/dev/null || exit 0;;   # source 용 — 함수만 정의하고 끝 (병렬 워커)
  "")        tui_wrap; cmd_tui;;
  rows)      cmd_rows "${2:-time}" "${3:-}" "${4:-}";;
  rows-boot) cmd_rows_boot;;                    # 부팅 첫 화면: 직전 스냅샷 즉시 → start 에서 갱신
  boot-reload) cmd_boot_reload;;
  rows-cur)  cmd_rows_cur "${2:-}";;            # 상태 파일의 현재 정렬 모드·뷰로 (^R·자동 갱신용)
  dead-rows) cmd_dead_rows "${2:-time}" "${3:-}";;
  view)      cmd_view "${2:-live}";;
  since)     cmd_since "${2:-+}";;
  gen)       cmd_gen;;
  dead)      shift; cmd_dead_ls "$@";;
  dp)        cmd_dead_preview "$2" "${3:-40}";;
  idx)       cmd_idx "${2:-}" "${3:-}";;        # 대화 기록 인덱스 경로 (라이브·종료)
  idxp)      cmd_idxp "${2:-}";;                # TUI ^Y 정보화면
  fork)      shift; cmd_fork "$@";;             # 소스 대화를 새 에이전트 세션으로 이어받기
  forkp)     cmd_forkp "${2:-}";;               # TUI ^F 프롬프트
  models)    shift; cmd_models "$@";;              # models [AG] | refresh [AG...] | find QUERY
  restore)   cmd_restore_one "$2" "${3:-}";;
  restore-all) shift; cmd_restore_all "$@";;      # 현재 창(--since 로 조정) 전부 — tmm dead --since 24 >/dev/null; tmm restore-all
  mode)      cmd_mode "${2:-time}" "${3:-}";;
  auto-cycle) cmd_auto_cycle;;
  header)    cmd_header;;
  plabel)    cmd_plabel "${2:-}";;               # 미리보기 라벨 = 커서 좌석의 온전한 이름 (focus)
  blabel)    cmd_blabel;;                        # 상단 테두리 라벨 = 버전 + 매치수 (result/load)
  bkey)      cmd_bkey;;                          # ^B 선택복구 모드 토글 (fzf transform 용 액션)
  vswitch)   cmd_vswitch "${2:-live}" "${3:-}";;     # ^A/^D 뷰 전환 (뷰별 키워드)
  vtab)      cmd_vtab;;                          # ^V 목록↔탭
  tabkey)    cmd_tabkey "${2:-next}" "${3:-}";;           # Tab/S-Tab: 다음/이전 탭 (분할이면 ignore)
  tabgo)     cmd_tabgo "${2:-}" "${3:-}" "${4:-}";;       # 분류 칸 → 이 카테고리로 (0.8.0) · 4번째 = 요청 번호(마지막 요청만 반영)
  esckey)    cmd_esckey;;                                 # Esc: 분할이면 분류 칸으로, 아니면 abort
  bskey)     cmd_bskey "${2:-}";;                         # ⌫: 빈 질의 + 분할이면 분류 칸으로
  catrows)   cmd_catrows;;                                # 분류 칸 fzf 의 행
  catpane)   cmd_catpane;;                                # 분류 칸 pane 본체(split_open 이 띄운다)
  catfocus)  cmd_catfocus "${2:-}";;                      # 분류 칸 focus → 목록 fzf 에 tabgo
  catgo)     cmd_catgo;;                                  # 분류 칸 ⏎ → 목록 칸으로
  catfwd)    cmd_catfwd "${2:-}";;                        # 분류 칸의 다른 키 → 목록 칸으로 넘김
  split-open)  split_open "${2:-}";;                      # [목록 pane id]
  split-close) split_close;;
  arrowkey)  cmd_arrowkey "${2:-next}" "${3:-}";;         # →/←: 탭 뷰면 Tab/S-Tab, 아니면 입력창 커서 이동
  onload)    cmd_onload;;                        # fzf load 이벤트 (라벨 + 탭 줄)
  dkey)      cmd_dkey "${2:-}" "${3:-}";;        # tmux C-a d 바인딩이 부른다 (피커 복귀/detach)
  pw)        cmd_pw "${2:-}";;                   # 미리보기 창 배치 (폭 기준)
  pw-action) printf 'change-preview-window(%s)' "$(cmd_pw "${2:-}")";;   # fzf transform() 용 액션 문자열
  __post)    cmd_post "$2" "$3";;                # 핑거 → fzf --listen 소켓 액션 전송
  ls|l)      shift; cmd_ls "$@";;
  a|attach)  cmd_attach "${2:-}" "${3:-}";;
  p|peek)    cmd_peek "${2:-}" "${3:-30}";;
  preview)   cmd_preview "$2" "${3:-}";;         # TUI 미리보기 (색·문단 재접기·바닥 상태줄 제거)
  __render)  render_pane;;                       # stdin 렌더 (verify 골든용)
  s|send)    n="$2"; shift 2; cmd_send "$n" "$@";;
  kill)      cmd_kill "${2:-}" "${3:-}";;
  sendp)     cmd_sendp "$2";;
  ss|scan)   shift; cmd_scan "$@";;
  h|human)   cmd_human;;
  save)      tmuxc save;;
  menu)      menu;;
  doctor)    cmd_doctor;;
  -h|--help|help) sed -n '2,32p' "$0";;
  *)         sed -n '2,32p' "$0"; exit 1;;
esac
