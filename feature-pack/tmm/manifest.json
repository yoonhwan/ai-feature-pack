{
  "name": "tmm",
  "version": "0.3.0",
  "title": "tmm — 모바일(SSH) tmux 좌석 TUI",
  "description": "폰(Termius 등 SSH 클라이언트)에서 수십 개 tmux 에이전트 세션을 커서로 고르고, pane 미리보기·마지막 메시지 시각·상태(HUMAN/BLOCK/STUCK/IDLE/BUSY)를 한 화면에 보며 attach·메시지 전송을 한다. fzf 기반. 사람 입력을 기다리는 좌석은 항상 최상단.",
  "category": "workflow",
  "os": ["darwin", "linux"],
  "install_time_minutes": 1,
  "requires_api_key": false,
  "requires_auth": false,
  "commands": [
    { "name": "tmm", "kind": "cli-binary", "path": "core/bin/tmm" },
    { "name": "seat-scan", "kind": "cli-support", "path": "core/libexec/seat-scan.sh" }
  ],
  "skill_surfaces": [],
  "runtime_targets": [
    { "runtime": "ssh-client", "kind": "execution", "target": "Termius Startup command: tmm", "status": "execution-only" }
  ],
  "hook_adapters": [],
  "private_state_exclusions": [".tmm", "categories", "*.cache"],
  "public_docs": ["README.md", "INSTALL.md"],
  "dependencies": {
    "required": ["bash>=4", "tmux>=3.2", "fzf>=0.54"],
    "optional": ["tmuxc", "tailscale"]
  },
  "supported_agents": {
    "automated_install": ["claude-code", "codex-cli"],
    "manual_install": ["gemini-cli", "opencode", "openclaw"],
    "limited": []
  },
  "spec_version": "1",
  "homepage": "https://github.com/yoonhwan/ai-feature-pack",
  "license": "MIT"
}
