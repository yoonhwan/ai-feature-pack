12
say() { printf '[h1b-db-fwd-start] %s\n' "$*"; }
13
die() { printf '[h1b-db-fwd-start] REJECT rc=%s %s\n' "$1" "$2" >&2; exit "$1"; }
14
GT="${GT:-11}"; G() { timeout "$GT" gcloud --account="$A" --project="$P" --quiet "$@"; }
15
