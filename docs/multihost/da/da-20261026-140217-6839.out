say "4/6 방화벽 $FW ($IAP_RANGE → tcp:$FWD_PORT · 태그 $TAG)"
177
GL 40 "${FW_CMD[@]}" >/dev/null 2>"$BK/err-fw.txt" || { tail -2 "$BK/err-fw.txt" | sed 's/^/        /'; die 5 "방화벽 생성 실패"; }
