dur = (p(sp)-p(st)).total_seconds(); dev = dur-int(mr)
36
print(("PASS" if abs(dev) <= int(tol) else "FAIL") + f" 가동 {dur/3600:.2f}h 편차 {dev/60:+.1f}분")
37
PY
38
)"
