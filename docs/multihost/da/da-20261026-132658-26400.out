# Next.js 웹 클라이언트 Dockerfile
# Cloud Run 배포용 (standalone 빌드)
# 빌드 컨텍스트: clients/web

FROM node:20-alpine AS base

# Install dependencies only when needed
FROM base AS deps
RUN apk add --no-cache libc6-compat
WORKDIR /app

# Copy package files
COPY package.json package-lock.json ./
RUN npm ci

# Rebuild the source code only when needed
FROM base AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .

# Next.js collects completely anonymous telemetry data about general usage.
# Learn more here: https://nextjs.org/telemetry
# Uncomment the following line in case you want to disable telemetry during the build.
ENV NEXT_TELEMETRY_DISABLED=1

# Build arguments for environment variables
ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_SSE_URL
ARG NEXT_PUBLIC_WS_URL
ARG NEXT_PUBLIC_BASE_URL
ARG NEXT_PUBLIC_SUPABASE_URL
ARG NEXT_PUBLIC_SUPABASE_ANON_KEY
# ★신 명칭 — 구 명칭을 «지우지 않고» 나란히 둔다★ (env-key-unify step 2).
# 브라우저 번들은 빌드타임 인라인이라 런타임 env 로는 못 닿는다. 이 ARG 가 없으면
# 코드가 신 명칭을 읽어도 값이 빈 문자열이 되어 «로그인만 조용히» 죽는다.
# Makefile:173 은 이미 이 build-arg 를 넘기고 있었는데 받는 ARG 가 없어 버려지고 있었다.
ARG NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY
ARG NEXT_PUBLIC_BUILD_TAG=local
ARG BUILD_VERSION=dev
# v65 default: app-config.ts 기본값이 이미 true(!/^(false|0)$/)라 이 셋을 안 넘겨도(env 빈 문자열도) 전환은 된다.
# 이 3개는 «전환에 필요»한 게 아니라 opt-out(false/0 명시) 주입 경로 확보용이다(DA-180 §3).
ARG NEXT_PUBLIC_V5_RT
ARG NEXT_PUBLIC_V6_RT
ARG NEXT_PUBLIC_V6_LST
# M0 같은 페이지 오디오 세션 복구 실험 게이트(DA-416 E1) — 이 ARG 가 없으면 위 사례처럼 cd-dev.yml
# build-arg 가 조용히 버려져 실험이 꺼진 채로 배포된다(관측만 안 되는 실패 · 행위는 그대로 off-safe).
ARG NEXT_PUBLIC_M0_RECOVER_EXPERIMENT
# E0 press 음원 수집 게이트(DA-478 조건 1) — 이 ARG 가 없으면 위 사례처럼 cd-dev.yml build-arg 가
# 조용히 버려져 수집이 꺼진 채로 배포된다(DA-480 결함 1).
ARG NEXT_PUBLIC_E0_CAPTURE_BUILD
# 토스 결제창 client key(판정 414) — 브라우저 번들 빌드타임 인라인이라 이 ARG 가 없으면 cd-dev.yml
# build-arg 가 조용히 버려져 충전 결제창이 «client key 미설정» 오류로만 뜬다.
ARG NEXT_PUBLIC_TOSS_CLIENT_KEY
# 게스트 JWT FE 전환 게이트(#896 ④ · 판정 475) — guest-credentials.ts 가 빌드타임 인라인으로 읽는다.
# 이 ARG 가 없으면 cd-dev.yml build-arg 가 조용히 버려져 플래그 OFF 번들이 배포된다.
ARG NEXT_PUBLIC_GUEST_JWT_ENABLED
# SSE 자격 헤더 운반 게이트(#896 · 판정 486) — sse-auth-url.ts 가 빌드타임 인라인으로 읽는다.
# 이 ARG 가 없으면 cd-dev.yml build-arg 가 조용히 버려져 플래그 OFF 번들이 배포된다.
ARG NEXT_PUBLIC_SSE_AUTH_HEADER
# 친 글(키보드) 입력 게이트(판정 1894) — use-typed-press.ts 가 빌드타임 인라인으로 읽는다.
# 이 ARG 가 없으면 cd-dev.yml build-arg 가 조용히 버려져 입력이 꺼진 채로 배포된다.
