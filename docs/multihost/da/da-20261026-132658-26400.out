ENV PYTHONUNBUFFERED=1

# Cloud Run injects PORT env var (default 8080)
# --proxy-headers: Cloud Run LB의 X-Forwarded-Proto=https 인식 → redirect URL도 https://
# --forwarded-allow-ips='*': Cloud Run 내부 proxy IP 전부 허용
CMD ["sh", "-c", "uvicorn gateway.main:app --host 0.0.0.0 --port ${PORT:-8000} --proxy-headers --forwarded-allow-ips='*'"]

