ENV NEXT_PUBLIC_E0_CAPTURE_BUILD=${NEXT_PUBLIC_E0_CAPTURE_BUILD}
ENV NEXT_PUBLIC_TOSS_CLIENT_KEY=${NEXT_PUBLIC_TOSS_CLIENT_KEY}
ENV NEXT_PUBLIC_GUEST_JWT_ENABLED=${NEXT_PUBLIC_GUEST_JWT_ENABLED}
ENV NEXT_PUBLIC_SSE_AUTH_HEADER=${NEXT_PUBLIC_SSE_AUTH_HEADER}
ENV NEXT_PUBLIC_PTT_KEYBOARD=${NEXT_PUBLIC_PTT_KEYBOARD}

RUN sed -i "s/__BUILD_VERSION__/${BUILD_VERSION}/g" \
