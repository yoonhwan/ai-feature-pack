ENV NEXT_PUBLIC_BUILD_TAG=${NEXT_PUBLIC_BUILD_TAG}
ENV NEXT_PUBLIC_V5_RT=${NEXT_PUBLIC_V5_RT}
ENV NEXT_PUBLIC_V6_RT=${NEXT_PUBLIC_V6_RT}
ENV NEXT_PUBLIC_V6_LST=${NEXT_PUBLIC_V6_LST}
