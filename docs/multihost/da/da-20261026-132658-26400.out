  grep -q "^export $nm=" "$ENVF" || { printf 'export %s=%q\n' "$nm" "$vl" >> "$ENVF"; SPEC_N=$((SPEC_N+1)); N=$((N+1)); }
207
done < <(sed -n '/^WORKER_ENV_SPEC=(/,/^)/p' "$WORK/repo/scripts/server/ready-check.sh" | grep -E '^[[:space:]]*"[A-Z0-9_]+=' | sed -E 's/^[[:space:]]*"//; s/"[[:space:]]*$//')
