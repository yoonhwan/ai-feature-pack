services:
  redis:
    image: redis:7-alpine
    ports:
      - "6379:6379"
    volumes:
      - redis_data:/data
    # maxmemory 는 CONFIG SET 이 아니라 기동 인자로 둔다 — CONFIG SET 은 재기동 시 0(무제한)으로 돌아간다.
    # noeviction: 가득 차면 쓰기가 시끄럽게 실패(raise). volatile-* 는 v5:session:* 를 무음 evict 할 수 있어 켜지 않는다.
    command: redis-server --appendonly yes --maxmemory 4gb --maxmemory-policy noeviction
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 10s
      timeout: 5s
      retries: 3



  gateway:
    build:
      context: .
      dockerfile: docker/gateway.Dockerfile
    ports:
      - "8080:8080"
    env_file:
      - .env
    environment:
      - PORT=8080
      - REDIS_HOST=redis
      - REDIS_PORT=6379
      - APP_NAME=BYZ-Agents
      - LOG_LEVEL=INFO
    depends_on:
      redis:
        condition: service_healthy
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:8080/health"]
      interval: 10s
      timeout: 5s
      retries: 3

  worker:
    build:
      context: .
      dockerfile: docker/worker.Dockerfile
    env_file:
      - .env
    environment:
      - REDIS_URL=redis://redis:6379/0
      - CHECKPOINTER_BACKEND=redis
      - STORE_BACKEND=redis
      - APP_NAME=BYZ-Agents
      - WORKER_NAME=worker-1
      - BATCH_SIZE=10
      - BLOCK_MS=5000
      - LOG_LEVEL=INFO
    depends_on:
      redis:
        condition: service_healthy
    deploy:
      replicas: 1

volumes:
  redis_data:


