COPY docs/architect/BRAIN_SYSTEM_ARCHITECTURE.md docs/architect/BRAIN_SYSTEM_ARCHITECTURE.md

ARG BUILD_VERSION=dev
ARG WEB_BASE_URL=
RUN find clients/web/public/static/ -name "*.html" \
    -exec sed -i "s/__BUILD_VERSION__/${BUILD_VERSION}/g" {} +
RUN sed -i "s|__WEB_BASE_URL__|${WEB_BASE_URL}|g" \
    clients/web/public/static/assets/shared/shared-auth.js

# ============================================
# Environment
# ============================================
