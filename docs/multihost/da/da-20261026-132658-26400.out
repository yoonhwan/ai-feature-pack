  FWD_OK="$(ms 15 "lsof -nP -iTCP:$fp -sTCP:LISTEN 2>/dev/null | wc -l | tr -d ' '")" || FWD_OK=0
222
  [ "$FWD_OK" -ge 1 ] 2>/dev/null || { kill "$(cat "$TUN_PIDF")" 2>/dev/null; rm -f "$TUN_PIDF"; die 4 "mini 에서 127.0.0.1:$fp 가 LISTEN 이 아니다"; }
