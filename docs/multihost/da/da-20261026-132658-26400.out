WORKDIR /app

# ============================================
# Layer 1: System packages (rarely changes)
# ============================================
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# ============================================
# Layer 2: Install uv package manager (rarely changes)
# ============================================
RUN pip install --no-cache-dir uv

# ============================================
# Layer 3: Install dependencies from lock file
# (rebuilds only when lock changes — ensures local venv == image parity)
# ============================================
COPY docker/requirements.lock docker/requirements.lock
RUN uv pip install --system -r docker/requirements.lock
# ★수리 어댑터 sslrootcert=system 전제★ — 번들 libpq 버전(>=16 이어야 system 지원)을 빌드 로그에 남긴다(설계 구현 게이트 ⑤).
RUN python -c "import psycopg; print('psycopg', psycopg.__version__, 'libpq', psycopg.pq.version())"
# 입력 예산 인코더를 이미지에 굽는다 — 런타임 첫 사용 때 HTTP 다운로드 0(빌드 때 받기 실패 = 빌드 실패)
ENV TIKTOKEN_CACHE_DIR=/opt/tiktoken
RUN python -c "import tiktoken; tiktoken.get_encoding('cl100k_base')" && test -n "$(ls -A /opt/tiktoken)"

# ============================================
# Layer 4: Copy source code (changes frequently)
# ============================================
ARG CACHEBUST=1
COPY proto/ proto/
COPY shared/ shared/
COPY gateway/ gateway/
COPY worker/ worker/
# 음성 보정 기준 문장 — CALIBRATION_DIR(gateway/routes/compat/calibration.py) 이 읽는 자리. 빠지면 /sentences 가 500 으로 표면화된다.
COPY data/calibration/ data/calibration/
# ★순수 코어만 싣는다★ — 소진율 판정을 「한 곳」에 두기 위해서다(DESIGN-OI7 §2).
# ops_cli/core/* 는 stdlib 만 쓴다(실측 2026-08-23). typer·rich 를 쓰는 CLI 표면
# (main/cli_bash/render/menu)은 «싣지 않는다» — 운영자 도구를 서버 이미지에 넣지 않는다.
COPY ops_cli/__init__.py ops_cli/__init__.py
COPY ops_cli/core/ ops_cli/core/
COPY clients/web/public/static/ clients/web/public/static/
COPY clients/spike/v5/ clients/spike/v5/
# ★schema_drift 의 «모집단 원본»★ — 이게 없으면 런타임 프로브가 영구 population_error 다.
