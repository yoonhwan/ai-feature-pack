ENV TIKTOKEN_CACHE_DIR=/opt/tiktoken
RUN python -c "import tiktoken; tiktoken.get_encoding('cl100k_base')" && test -n "$(ls -A /opt/tiktoken)"

# ============================================
# Layer 4: Copy source code (changes frequently)
# ============================================
COPY proto/ proto/
COPY shared/ shared/
COPY worker/ worker/
# worker/services/loom_reindex_loop.py 가 모듈 최상단에서 scripts.rag 를 import 한다 (scripts/ 전체 금지).
COPY scripts/rag/ scripts/rag/
# 챗 매 요청이 정본 문서와 대조한다(context_budget_canon_check.DOC_PATH) — 없으면 챗 기동 실패.
COPY docs/architect/BRAIN_SYSTEM_ARCHITECTURE.md docs/architect/BRAIN_SYSTEM_ARCHITECTURE.md

# ============================================
# Environment
# ============================================
ENV PYTHONPATH=/app
ENV PYTHONUNBUFFERED=1

# B3 (architect#23 OPTION ii): flag-on execution is SEALED — the C1c ingress orchestrator is
# not complete and has no real-Redis e2e evidence, so this image must not run the gated path.
# flag-off runs worker.main unchanged; flag-on refuses loudly (not a spoofable guard — a hard,
# documented seal). Shell form so $V6_C1C_TA_ENABLED is read at container start; exec forwards
# SIGTERM to worker.main.
CMD if [ "$V6_C1C_TA_ENABLED" = "1" ]; then echo "REFUSED: C1c-TA flag-on execution is sealed until the ingress orchestrator lands with real-Redis e2e evidence (worker/c1c_ta_entrypoint.py)" >&2; exit 1; else exec python -m worker.main; fi

